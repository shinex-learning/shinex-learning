<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-container {
            display: flex;
            min-height: 100vh;
            background: #f8f6fc;
        }
        .admin-sidebar {
            width: 250px;
            background: #1A0A2E;
            color: #fff;
            padding: 24px 0;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
        }
        .admin-sidebar .logo {
            padding: 0 24px 24px;
            font-size: 24px;
            font-weight: 800;
            color: #fff;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .admin-sidebar .logo span { color: #8B5CF6; }
        .admin-sidebar .nav {
            padding: 16px 0;
        }
        .admin-sidebar .nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 24px;
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            transition: all 0.2s;
            font-size: 14px;
        }
        .admin-sidebar .nav a:hover,
        .admin-sidebar .nav a.active {
            background: rgba(139, 92, 246, 0.2);
            color: #fff;
            border-left: 3px solid #8B5CF6;
        }
        .admin-sidebar .nav a .badge {
            background: #e74c3c;
            color: #fff;
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 12px;
            margin-left: auto;
        }
        .admin-main {
            margin-left: 250px;
            flex: 1;
            padding: 24px;
        }
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            background: #fff;
            padding: 16px 24px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }
        .admin-header h1 { font-size: 24px; }
        .admin-header .admin-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .admin-header .admin-user .logout {
            color: #e74c3c;
            text-decoration: none;
            font-weight: 600;
        }
        .admin-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }
        .admin-stat-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }
        .admin-stat-card .number {
            font-size: 32px;
            font-weight: 800;
            color: #1A0A2E;
        }
        .admin-stat-card .label {
            color: #5a4a70;
            font-size: 14px;
        }
        .admin-stat-card .icon { font-size: 24px; }
        .admin-section {
            background: #fff;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            margin-bottom: 24px;
        }
        .admin-section h2 {
            font-size: 18px;
            margin-bottom: 16px;
        }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
        }
        .admin-table th,
        .admin-table td {
            padding: 10px 12px;
            text-align: left;
            border-bottom: 1px solid #e8e3f0;
        }
        .admin-table th {
            font-weight: 600;
            color: #5a4a70;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .admin-table .badge {
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }
        .badge-success { background: #e8f5e9; color: #27ae60; }
        .badge-danger { background: #fde8e8; color: #e74c3c; }
        .badge-warning { background: #fef9e7; color: #f39c12; }
        .btn-sm {
            padding: 4px 12px;
            font-size: 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            text-decoration: none;
        }
        .btn-primary-sm { background: #8B5CF6; color: #fff; }
        .btn-danger-sm { background: #e74c3c; color: #fff; }
        .btn-success-sm { background: #27ae60; color: #fff; }
        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 16px;
        }
        .alert-success { background: #e8f5e9; color: #27ae60; border-left: 4px solid #27ae60; }
        .alert-error { background: #fde8e8; color: #e74c3c; border-left: 4px solid #e74c3c; }
        @media (max-width: 768px) {
            .admin-sidebar { display: none; }
            .admin-main { margin-left: 0; }
            .admin-stats { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="logo">SHINEX<span>.</span></div>
            <nav class="nav">
                <a href="/admin/dashboard" class="active">📊 Dashboard</a>
                <a href="/admin/students">👤 Students</a>
                <a href="/admin/courses">📚 Courses</a>
                <a href="/admin/services">💼 Services</a>
                <a href="/admin/messages">✉️ Messages <span class="badge"><%= unreadCount || 0 %></span></a>
                <a href="/admin/manage-admins">🔐 Manage Admins</a>
                <a href="/admin/logout" style="color: #e74c3c; margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 16px;">🚪 Logout</a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <div class="admin-header">
                <h1>Dashboard</h1>
                <div class="admin-user">
                    <span>Welcome, <%= admin ? admin.firstName : 'Admin' %></span>
                    <a href="/admin/logout" class="logout">Logout</a>
                </div>
            </div>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-error"><%= messages.error %></div>
            <% } %>

            <!-- Stats -->
            <div class="admin-stats">
                <div class="admin-stat-card">
                    <div class="icon">👤</div>
                    <div class="number"><%= totalStudents || 0 %></div>
                    <div class="label">Total Students</div>
                </div>
                <div class="admin-stat-card">
                    <div class="icon">📚</div>
                    <div class="number"><%= totalCourses || 0 %></div>
                    <div class="label">Total Courses</div>
                </div>
                <div class="admin-stat-card">
                    <div class="icon">📖</div>
                    <div class="number"><%= totalClasses || 0 %></div>
                    <div class="label">Total Classes</div>
                </div>
                <div class="admin-stat-card">
                    <div class="icon">✉️</div>
                    <div class="number"><%= unreadCount || 0 %></div>
                    <div class="label">Unread Messages</div>
                </div>
            </div>

            <!-- Recent Students -->
            <div class="admin-section">
                <h2>Recent Students</h2>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Course</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users && users.filter(u => !u.isAdmin).length > 0) { %>
                            <% users.filter(u => !u.isAdmin).slice(0, 5).forEach(student => { %>
                                <tr>
                                    <td><%= student.studentId %></td>
                                    <td><%= student.firstName + ' ' + student.lastName %></td>
                                    <td><%= student.email %></td>
                                    <td><%= student.courseName || 'Not Enrolled' %></td>
                                    <td><span class="badge badge-success"><%= student.isVerified ? 'Verified' : 'Unverified' %></span></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align: center; color: #5a4a70;">No students yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Recent Messages -->
            <div class="admin-section">
                <h2>Recent Messages</h2>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>From</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (messages && messages.length > 0) { %>
                            <% messages.slice(0, 5).forEach(msg => { %>
                                <tr>
                                    <td><%= msg.name %></td>
                                    <td><%= msg.subject %></td>
                                    <td><span class="badge <%= msg.status === 'unread' ? 'badge-danger' : msg.status === 'replied' ? 'badge-success' : 'badge-warning' %>"><%= msg.status %></span></td>
                                    <td><a href="/admin/messages/<%= msg.id %>" class="btn-sm btn-primary-sm">View</a></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="4" style="text-align: center; color: #5a4a70;">No messages yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</body>
</html>