<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-layout {
            display: flex;
            gap: 24px;
            max-width: 1400px;
            margin: 0 auto;
        }
        .admin-sidebar {
            width: 240px;
            min-width: 200px;
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            transition: all 0.3s ease;
        }
        body.dark-mode .admin-sidebar {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .admin-sidebar .sidebar-title {
            border-color: var(--dark-border);
        }
        .admin-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        .admin-nav li {
            margin: 0;
        }
        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .admin-nav a:hover {
            background: var(--primary-bg);
            color: var(--primary);
        }
        .admin-nav a.active {
            background: var(--primary-bg);
            color: var(--primary);
            border-left-color: var(--primary);
        }
        body.dark-mode .admin-nav a:hover {
            background: #2a1a4a;
        }
        body.dark-mode .admin-nav a.active {
            background: #2a1a4a;
        }
        .admin-content {
            flex: 1;
            min-width: 0;
        }
        .admin-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 12px;
            margin-bottom: 24px;
        }
        .admin-stat {
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 16px 20px;
            transition: all 0.3s ease;
        }
        body.dark-mode .admin-stat {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-stat .stat-number {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--primary);
        }
        .admin-stat .stat-label {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-weight: 500;
            margin-top: 2px;
        }
        .admin-stat .stat-icon {
            float: right;
            font-size: 1.8rem;
            color: var(--primary-bg);
            opacity: 0.5;
        }
        .admin-card {
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 20px 24px;
            margin-bottom: 16px;
        }
        body.dark-mode .admin-card {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 8px;
        }
        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }
        .admin-badge.success {
            background: #d5f5e3;
            color: #27ae60;
        }
        .admin-badge.danger {
            background: #fadbd8;
            color: #e74c3c;
        }
        .admin-badge.warning {
            background: #fef9e7;
            color: #f39c12;
        }
        body.dark-mode .admin-badge.success {
            background: #1a3a2a;
            color: #7dcea0;
        }
        body.dark-mode .admin-badge.danger {
            background: #3a1a1a;
            color: #f1948a;
        }
        body.dark-mode .admin-badge.warning {
            background: #3a2a1a;
            color: #f7dc6f;
        }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }
        .admin-table th {
            text-align: left;
            padding: 8px 12px;
            border-bottom: 2px solid #ede8f5;
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        body.dark-mode .admin-table th {
            border-color: var(--dark-border);
        }
        .admin-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .admin-table td {
            border-color: var(--dark-border);
        }
        .admin-table tr:hover {
            background: var(--primary-bg);
        }
        body.dark-mode .admin-table tr:hover {
            background: #1a1a1a;
        }
        @media (max-width: 768px) {
            .admin-layout {
                flex-direction: column;
            }
            .admin-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
            }
            .admin-stats {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <div class="admin-layout">
                <!-- ===== Admin Sidebar ===== -->
                <aside class="admin-sidebar">
                    <div class="sidebar-title"><i class="fas fa-crown"></i> Admin Panel</div>
                    <ul class="admin-nav">
                        <li><a href="/admin/dashboard" class="active"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="/admin/students"><i class="fas fa-users"></i> Students</a></li>
                        <li><a href="/admin/courses"><i class="fas fa-book"></i> Courses</a></li>
                        <li><a href="/admin/services"><i class="fas fa-concierge-bell"></i> Services</a></li>
                        <li><a href="/admin/messages"><i class="fas fa-envelope"></i> Messages <span class="badge badge-red" style="font-size:0.6rem; padding:1px 8px;"><%= unreadCount || 0 %></span></a></li>
                        <li><a href="/admin/manage-admins"><i class="fas fa-user-shield"></i> Admins</a></li>
                        <li><a href="/admin/logout" style="color:#e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </aside>

                <!-- ===== Admin Content ===== -->
                <div class="admin-content">
                    <h2 style="font-size:1.5rem; font-weight:700; margin:0 0 4px;">👋 Welcome, <%= admin.firstName %>!</h2>
                    <p style="color:var(--text-muted); margin-bottom:20px;">Here's an overview of your platform.</p>

                    <!-- Stats -->
                    <div class="admin-stats">
                        <div class="admin-stat">
                            <span class="stat-icon"><i class="fas fa-users"></i></span>
                            <div class="stat-number"><%= totalStudents || 0 %></div>
                            <div class="stat-label">Total Students</div>
                        </div>
                        <div class="admin-stat">
                            <span class="stat-icon"><i class="fas fa-book"></i></span>
                            <div class="stat-number"><%= totalCourses || 0 %></div>
                            <div class="stat-label">Total Courses</div>
                        </div>
                        <div class="admin-stat">
                            <span class="stat-icon"><i class="fas fa-user-graduate"></i></span>
                            <div class="stat-number"><%= totalEnrollments || 0 %></div>
                            <div class="stat-label">Enrollments</div>
                        </div>
                        <div class="admin-stat">
                            <span class="stat-icon"><i class="fas fa-layer-group"></i></span>
                            <div class="stat-number"><%= totalClasses || 0 %></div>
                            <div class="stat-label">Total Classes</div>
                        </div>
                        <div class="admin-stat">
                            <span class="stat-icon"><i class="fas fa-concierge-bell"></i></span>
                            <div class="stat-number"><%= totalServices || 0 %></div>
                            <div class="stat-label">Services</div>
                        </div>
                        <div class="admin-stat">
                            <span class="stat-icon"><i class="fas fa-envelope"></i></span>
                            <div class="stat-number"><%= unreadCount || 0 %></div>
                            <div class="stat-label">Unread Messages</div>
                        </div>
                    </div>

                    <!-- Students by Course -->
                    <div class="admin-card">
                        <h4><i class="fas fa-chart-bar"></i> Students by Course</h4>
                        <% if (courses && courses.length > 0) { %>
                            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px,1fr)); gap:8px; margin-top:8px;">
                                <% courses.forEach(c => { 
                                    const data = studentsByCourse[c.id];
                                    const count = data ? data.count : 0;
                                %>
                                    <div style="background:var(--primary-bg); padding:8px 14px; border-radius:8px; display:flex; justify-content:space-between; align-items:center;">
                                        <span style="font-size:0.85rem; font-weight:500;"><%= c.title %></span>
                                        <span class="badge badge-purple"><%= count %></span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p style="color:var(--text-muted);">No courses available yet.</p>
                        <% } %>
                    </div>

                    <!-- Recent Activity / Quick Actions -->
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                        <div class="admin-card">
                            <h4><i class="fas fa-bolt"></i> Quick Actions</h4>
                            <div style="display:flex; flex-direction:column; gap:8px;">
                                <a href="/admin/courses" class="btn btn-secondary btn-sm btn-block">Manage Courses</a>
                                <a href="/admin/students" class="btn btn-secondary btn-sm btn-block">View Students</a>
                                <a href="/admin/messages" class="btn btn-secondary btn-sm btn-block">Check Messages <span class="badge badge-red" style="font-size:0.6rem;"><%= unreadCount || 0 %></span></a>
                            </div>
                        </div>
                        <div class="admin-card">
                            <h4><i class="fas fa-info-circle"></i> System Info</h4>
                            <p style="font-size:0.85rem; color:var(--text-muted); margin:4px 0;">
                                <strong>Total Users:</strong> <%= users ? users.length : 0 %>
                            </p>
                            <p style="font-size:0.85rem; color:var(--text-muted); margin:4px 0;">
                                <strong>Admins:</strong> <%= users ? users.filter(u => u.isAdmin).length : 0 %>
                            </p>
                            <p style="font-size:0.85rem; color:var(--text-muted); margin:4px 0;">
                                <strong>Platform:</strong> SHINEX Learning Circle
                            </p>
                            <p style="font-size:0.85rem; color:var(--text-muted); margin:4px 0;">
                                <strong>Version:</strong> 4.0
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>