<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <%- include('../partials/header', { user: admin, showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
                <h2 style="font-size: 1.6rem; font-weight: 800; color: #1A0A2E;">
                    <i class="fas fa-shield-alt" style="color: #8B5CF6;"></i> Admin Dashboard
                </h2>
                <span class="badge badge-purple" style="font-size: 0.8rem;">
                    <i class="fas fa-user-cog"></i> <%= admin.fullName %>
                </span>
            </div>

            <div class="admin-stats">
                <div class="admin-stat-box"><div class="num"><%= totalStudents %></div><div class="lbl"><i class="fas fa-users"></i> Students</div></div>
                <div class="admin-stat-box"><div class="num"><%= totalCourses %></div><div class="lbl"><i class="fas fa-book"></i> Courses</div></div>
                <div class="admin-stat-box"><div class="num"><%= totalEnrollments %></div><div class="lbl"><i class="fas fa-user-graduate"></i> Enrollments</div></div>
                <div class="admin-stat-box"><div class="num"><%= totalClasses %></div><div class="lbl"><i class="fas fa-list-ul"></i> Classes</div></div>
            </div>

            <div class="card">
                <h3 class="admin-section-title"><i class="fas fa-users"></i> Students by Course</h3>
                <div style="overflow-x: auto;">
                    <table class="admin-table">
                        <thead><tr><th>Course</th><th>Level</th><th>Students</th><th>Actions</th></tr></thead>
                        <tbody>
                            <% if (Object.keys(studentsByCourse).length > 0) { %>
                                <% Object.values(studentsByCourse).forEach(item => { %>
                                    <tr>
                                        <td><strong><%= item.course.title %></strong></td>
                                        <td><span class="badge badge-purple"><%= item.course.level %></span></td>
                                        <td><%= item.students.length %></td>
                                        <td><a href="/admin/students" class="btn btn-secondary btn-xs"><i class="fas fa-eye"></i> View</a></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="4" style="text-align: center; color: #7a6a8f;">No students enrolled yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px;">
                <a href="/admin/courses" class="btn btn-primary"><i class="fas fa-plus-circle"></i> Manage Courses</a>
                <a href="/admin/students" class="btn btn-secondary"><i class="fas fa-users"></i> View All Students</a>
                <a href="/" class="btn btn-outline"><i class="fas fa-home"></i> Back to Site</a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>