<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %> | SHINEX Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           ADMIN SERVICE EDIT PAGE STYLES
           ============================================================ */
        
        /* ----- Admin Layout ----- */
        .admin-layout {
            display: flex;
            gap: var(--spacing-lg);
            max-width: 1400px;
            margin: 0 auto;
        }
        
        /* ----- Admin Sidebar ----- */
        .admin-sidebar {
            width: 260px;
            min-width: 220px;
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .admin-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        
        .admin-nav li {
            margin: 0;
        }
        
        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        
        .admin-nav a:hover {
            background: var(--purple-bg);
            color: var(--purple-primary);
        }
        
        .admin-nav a.active {
            background: var(--purple-bg);
            color: var(--purple-primary);
            border-left-color: var(--purple-primary);
        }
        
        .admin-nav a i {
            width: 20px;
            text-align: center;
        }
        
        .admin-nav a.logout-link {
            color: var(--text-error);
        }
        
        .admin-nav a.logout-link:hover {
            background: var(--bg-alert-error);
            color: var(--text-error);
        }
        
        /* ----- Admin Content ----- */
        .admin-content {
            flex: 1;
            min-width: 0;
        }
        
        /* ----- Admin Cards ----- */
        .admin-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-lg);
            margin-bottom: var(--spacing-md);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .admin-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        .admin-card .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-sm);
            margin-bottom: var(--spacing-md);
        }
        
        .admin-card .card-header h4 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .admin-card .card-header h4 i {
            color: var(--purple-primary);
        }
        
        /* ----- Page Header ----- */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-sm);
            margin-bottom: var(--spacing-md);
        }
        
        .page-header .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        
        .page-header .page-subtitle {
            color: var(--text-muted);
            margin: 2px 0 0 0;
            font-size: 0.9rem;
        }
        
        .page-header .header-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        
        /* ----- Form ----- */
        .form-group {
            margin-bottom: var(--spacing-md);
        }
        
        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 4px;
            color: var(--text-primary);
        }
        
        .form-group label .required {
            color: var(--text-error);
        }
        
        .form-group label .optional {
            color: var(--text-muted);
            font-weight: 400;
        }
        
        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            font-family: inherit;
            transition: all 0.3s ease;
            background: var(--bg-input);
            color: var(--text-primary);
        }
        
        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            border-color: var(--purple-primary);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
            outline: none;
        }
        
        .form-group textarea {
            resize: vertical;
            min-height: 80px;
        }
        
        .form-group .help-text {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 4px;
        }
        
        .form-group .help-text i {
            margin-right: 4px;
        }
        
        .form-actions {
            display: flex;
            gap: var(--spacing-sm);
            flex-wrap: wrap;
            margin-top: var(--spacing-sm);
        }
        
        .form-actions .btn {
            min-width: 120px;
        }
        
        /* ----- Preview Box ----- */
        .preview-box {
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            padding: var(--spacing-md);
            border-left: 4px solid var(--purple-primary);
            transition: all 0.3s ease;
        }
        
        .preview-box:hover {
            border-left-color: var(--purple-dark);
        }
        
        .preview-box .preview-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-sm);
        }
        
        .preview-box .preview-header .preview-name {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        
        .preview-box .preview-header .preview-price {
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--purple-primary);
        }
        
        .preview-box .preview-description {
            margin: var(--spacing-sm) 0 0 0;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        .preview-box .preview-badges {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            margin-top: var(--spacing-sm);
        }
        
        /* ----- Category Badges ----- */
        .badge-category {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 12px;
            border-radius: var(--radius-full);
            font-size: 0.7rem;
            font-weight: 600;
        }
        
        .badge-category.registration {
            background: var(--purple-bg);
            color: var(--purple-primary);
        }
        
        .badge-category.design {
            background: var(--bg-alert-warning);
            color: var(--text-warning);
        }
        
        .badge-category.campaign {
            background: var(--bg-alert-success);
            color: var(--text-success);
        }
        
        .badge-category.website {
            background: var(--bg-alert-info);
            color: #1a5276;
        }
        
        .badge-category.other {
            background: var(--bg-card-secondary);
            color: var(--text-muted);
        }
        
        body.dark-mode .badge-category.website {
            color: #85c1e9;
        }
        
        /* ----- Status Badge ----- */
        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 12px;
            border-radius: var(--radius-full);
            font-size: 0.7rem;
            font-weight: 600;
        }
        
        .badge-status.active {
            background: var(--bg-alert-success);
            color: var(--text-success);
        }
        
        .badge-status.inactive {
            background: var(--bg-alert-error);
            color: var(--text-error);
        }
        
        /* ----- Delete Area ----- */
        .delete-area {
            display: flex;
            justify-content: flex-end;
            margin-top: var(--spacing-md);
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 1024px) {
            .admin-layout {
                flex-direction: column;
            }
            
            .admin-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
                max-height: 0;
                overflow: hidden;
                padding: 0;
                transition: max-height 0.3s ease, padding 0.3s ease;
                box-shadow: none;
            }
            
            .admin-sidebar.open {
                max-height: 600px;
                padding: 12px 0;
                overflow-y: auto;
            }
            
            .admin-sidebar-toggle {
                display: flex !important;
            }
        }
        
        @media (max-width: 768px) {
            .admin-card {
                padding: var(--spacing-md);
            }
            
            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .page-header .header-actions {
                width: 100%;
            }
            
            .page-header .header-actions .btn {
                flex: 1;
                justify-content: center;
            }
            
            .preview-box .preview-header {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .form-actions {
                flex-direction: column;
            }
            
            .form-actions .btn {
                width: 100%;
                justify-content: center;
                min-width: unset;
            }
            
            .delete-area {
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <!-- ===== ADMIN HEADER (Built-in) ===== -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:12px 24px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:1000; box-shadow:0 2px 15px rgba(139,92,246,0.3);">
        <div style="display:flex; align-items:center; gap:12px;">
            <!-- Back Button -->
            <a href="/admin/services" style="color:rgba(255,255,255,0.8); text-decoration:none; padding:4px 10px; border-radius:8px; transition:all 0.3s ease; font-size:14px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
            <div>
                <div style="font-weight:700; font-size:16px; color:#fff;">SHINEX <span style="opacity:0.7; font-weight:400;">Admin</span></div>
                <div style="font-size:7px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
            </div>
        </div>
        <div style="display:flex; gap:12px; align-items:center;">
            <span style="color:rgba(255,255,255,0.9); font-size:13px;">
                <i class="fas fa-user"></i> <%= admin && admin.firstName ? admin.firstName : 'Admin' %>
            </span>
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light');" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:6px 12px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon"></i>
            </button>
            <a href="/admin/logout" style="color:#fff; text-decoration:none; background:rgba(255,255,255,0.15); padding:6px 14px; border-radius:20px; font-size:13px; transition:all 0.3s ease;">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="container">

            <!-- Flash Messages -->
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success">
                    <i class="fas fa-check-circle"></i> <%= messages.success %>
                </div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error">
                    <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                </div>
            <% } %>

            <!-- ===== ADMIN LAYOUT ===== -->
            <div class="admin-layout">

                <!-- ===== SIDEBAR ===== -->
                <aside class="admin-sidebar" id="adminSidebar">
                    <div class="sidebar-title"><i class="fas fa-crown"></i> Admin Panel</div>
                    <ul class="admin-nav">
                        <li><a href="/admin/dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="/admin/students"><i class="fas fa-users"></i> Students</a></li>
                        <li><a href="/admin/courses"><i class="fas fa-book"></i> Courses</a></li>
                        <li><a href="/admin/services" class="active"><i class="fas fa-concierge-bell"></i> Services</a></li>
                        <li><a href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                        <li><a href="/admin/manage-admins"><i class="fas fa-user-shield"></i> Admins</a></li>
                        <li><a href="/admin/logout" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </aside>

                <!-- ===== CONTENT ===== -->
                <div class="admin-content">

                    <!-- Page Header -->
                    <div class="page-header">
                        <div>
                            <h1 class="page-title">
                                <i class="fas fa-edit" style="color:var(--purple-primary);"></i> 
                                Edit Service
                            </h1>
                            <p class="page-subtitle">
                                <i class="fas fa-concierge-bell"></i> 
                                Update service details for "<%= service.name %>"
                            </p>
                        </div>
                        <div class="header-actions">
                            <a href="/admin/services" class="btn btn-secondary btn-sm">
                                <i class="fas fa-arrow-left"></i> Back to Services
                            </a>
                            <button class="btn btn-secondary btn-sm admin-sidebar-toggle" onclick="toggleSidebar()" style="display:none;">
                                <i class="fas fa-bars"></i> Menu
                            </button>
                        </div>
                    </div>

                    <!-- ===== EDIT FORM ===== -->
                    <div class="admin-card">
                        <form action="/admin/services/edit/<%= service.id %>" method="POST" id="serviceForm">
                            
                            <!-- Service Name -->
                            <div class="form-group">
                                <label for="serviceName">
                                    Service Name <span class="required">*</span>
                                </label>
                                <input 
                                    type="text" 
                                    id="serviceName" 
                                    name="name" 
                                    value="<%= service.name %>" 
                                    placeholder="e.g. TASUED Registration Service"
                                    required
                                    oninput="updatePreview()"
                                >
                                <div class="help-text">
                                    <i class="fas fa-info-circle"></i> 
                                    The name that will be displayed to users
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="form-group">
                                <label for="serviceDescription">
                                    Description <span class="optional">(optional)</span>
                                </label>
                                <textarea 
                                    id="serviceDescription" 
                                    name="description" 
                                    rows="3" 
                                    placeholder="Describe what this service includes..."
                                    oninput="updatePreview()"
                                ><%= service.description || '' %></textarea>
                                <div class="help-text">
                                    <i class="fas fa-info-circle"></i> 
                                    A brief description of the service
                                </div>
                            </div>

                            <!-- Price -->
                            <div class="form-group">
                                <label for="servicePrice">
                                    Price (₦) <span class="required">*</span>
                                </label>
                                <input 
                                    type="number" 
                                    id="servicePrice" 
                                    name="price" 
                                    value="<%= service.price %>" 
                                    placeholder="20000"
                                    required
                                    min="0"
                                    step="100"
                                    oninput="updatePreview()"
                                >
                                <div class="help-text">
                                    <i class="fas fa-info-circle"></i> 
                                    Price in Nigerian Naira (₦)
                                </div>
                            </div>

                            <!-- Category -->
                            <div class="form-group">
                                <label for="serviceCategory">Category</label>
                                <select id="serviceCategory" name="category" onchange="updatePreview()">
                                    <option value="registration" <%= service.category === 'registration' ? 'selected' : '' %>>Registration</option>
                                    <option value="design" <%= service.category === 'design' ? 'selected' : '' %>>Design</option>
                                    <option value="campaign" <%= service.category === 'campaign' ? 'selected' : '' %>>Campaign</option>
                                    <option value="website" <%= service.category === 'website' ? 'selected' : '' %>>Website</option>
                                    <option value="other" <%= service.category === 'other' ? 'selected' : '' %>>Other</option>
                                </select>
                                <div class="help-text">
                                    <i class="fas fa-info-circle"></i> 
                                    Category helps organize services
                                </div>
                            </div>

                            <!-- Status Display -->
                            <div class="form-group">
                                <label>Current Status</label>
                                <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                                    <span class="badge-status <%= service.isActive ? 'active' : 'inactive' %>">
                                        <i class="fas <%= service.isActive ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                                        <%= service.isActive ? 'Active' : 'Inactive' %>
                                    </span>
                                    <span style="font-size:0.8rem; color:var(--text-muted);">
                                        <i class="fas fa-info-circle"></i> 
                                        Toggle status on the 
                                        <a href="/admin/services" style="color:var(--purple-primary);">services list page</a>
                                    </span>
                                </div>
                            </div>

                            <!-- Form Actions -->
                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Update Service
                                </button>
                                <a href="/admin/services" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Cancel
                                </a>
                            </div>
                            
                        </form>
                    </div>

                    <!-- ===== SERVICE PREVIEW ===== -->
                    <div class="admin-card">
                        <div class="card-header">
                            <h4><i class="fas fa-eye"></i> Service Preview</h4>
                            <span class="badge badge-purple">
                                <i class="fas fa-sync-alt"></i> Live Preview
                            </span>
                        </div>
                        
                        <div class="preview-box" id="previewBox">
                            <div class="preview-header">
                                <h5 class="preview-name" id="previewName">
                                    <%= service.name %>
                                </h5>
                                <div class="preview-price" id="previewPrice">
                                    ₦<%= service.price.toLocaleString() %>
                                </div>
                            </div>
                            <p class="preview-description" id="previewDescription">
                                <%= service.description || 'No description available.' %>
                            </p>
                            <div class="preview-badges">
                                <span class="badge-category <%= service.category || 'other' %>" id="previewCategory">
                                    <i class="fas fa-tag"></i> 
                                    <%= service.category ? service.category.charAt(0).toUpperCase() + service.category.slice(1) : 'Other' %>
                                </span>
                                <span class="badge-status <%= service.isActive ? 'active' : 'inactive' %>">
                                    <i class="fas <%= service.isActive ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                                    <%= service.isActive ? 'Active' : 'Inactive' %>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- ===== DELETE ===== -->
                    <div class="delete-area">
                        <form action="/admin/services/delete/<%= service.id %>" method="GET" style="display:inline;" 
                              onsubmit="return confirm('⚠️ Are you sure you want to delete this service?\n\nService: <%= service.name %>\nPrice: ₦<%= service.price.toLocaleString() %>\n\nThis action cannot be undone.');">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash-alt"></i> Delete Service
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:40px;">
        <div style="max-width:1200px; margin:0 auto; padding:0 20px; text-align:center; font-size:0.8rem; color:rgba(255,255,255,0.6);">
            &copy; 2026 SHINEX Learning Circle. All rights reserved.
        </div>
    </footer>

    <script>
        // ============================================================
        // LIVE PREVIEW UPDATE
        // ============================================================
        
        function updatePreview() {
            // Get form values
            const name = document.getElementById('serviceName').value || 'Service Name';
            const description = document.getElementById('serviceDescription').value || 'No description available.';
            const price = document.getElementById('servicePrice').value || '0';
            const category = document.getElementById('serviceCategory').value || 'other';
            
            // Category labels
            const categoryLabels = {
                'registration': 'Registration',
                'design': 'Design',
                'campaign': 'Campaign',
                'website': 'Website',
                'other': 'Other'
            };
            
            // Update preview elements
            document.getElementById('previewName').textContent = name;
            document.getElementById('previewDescription').textContent = description;
            document.getElementById('previewPrice').textContent = '₦' + parseInt(price).toLocaleString();
            
            // Update category badge
            const categoryBadge = document.getElementById('previewCategory');
            categoryBadge.className = 'badge-category ' + category;
            categoryBadge.innerHTML = '<i class="fas fa-tag"></i> ' + (categoryLabels[category] || 'Other');
        }
        
        // ============================================================
        // SIDEBAR TOGGLE (Mobile)
        // ============================================================
        
        function toggleSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            if (sidebar) {
                sidebar.classList.toggle('open');
            }
        }
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
        }
        
        // ============================================================
        // AUTO DISMISS FLASH MESSAGES
        // ============================================================
        
        document.querySelectorAll('.flash-message').forEach(msg => {
            setTimeout(() => {
                msg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                msg.style.opacity = '0';
                msg.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    if (msg.parentNode) msg.remove();
                }, 500);
            }, 5000);
        });
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('🔐 SHINEX Admin Panel');
        console.log('✏️ Editing Service: <%= service.name %>');
        console.log('💰 Price: ₦<%= service.price.toLocaleString() %>');
        console.log('📂 Category: <%= service.category || "Other" %>');
        console.log('📊 Status: <%= service.isActive ? "Active" : "Inactive" %>');
    </script>

</body>
</html>