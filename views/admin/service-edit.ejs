<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Service – SHINEX Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-layout {
            display: flex;
            gap: 24px;
            max-width: 1400px;
            margin: 0 auto;
        }
        .admin-sidebar {
            width: 240px;
            min-width: 200px;
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            transition: all 0.3s ease;
        }
        body.dark-mode .admin-sidebar {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .admin-sidebar .sidebar-title {
            border-color: var(--dark-border);
        }
        .admin-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        .admin-nav li {
            margin: 0;
        }
        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .admin-nav a:hover {
            background: var(--primary-bg);
            color: var(--primary);
        }
        .admin-nav a.active {
            background: var(--primary-bg);
            color: var(--primary);
            border-left-color: var(--primary);
        }
        body.dark-mode .admin-nav a:hover {
            background: #2a1a4a;
        }
        body.dark-mode .admin-nav a.active {
            background: #2a1a4a;
        }
        .admin-content {
            flex: 1;
            min-width: 0;
        }
        .admin-card {
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 20px 24px;
            margin-bottom: 16px;
        }
        body.dark-mode .admin-card {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 8px;
        }
        .preview-box {
            background: var(--primary-bg);
            border-radius: 10px;
            padding: 16px 20px;
            margin-top: 8px;
            border-left: 4px solid var(--primary);
        }
        body.dark-mode .preview-box {
            background: #1a1a1a;
        }
        @media (max-width: 768px) {
            .admin-layout {
                flex-direction: column;
            }
            .admin-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <div class="admin-layout">
                <!-- ===== Admin Sidebar ===== -->
                <aside class="admin-sidebar">
                    <div class="sidebar-title"><i class="fas fa-crown"></i> Admin Panel</div>
                    <ul class="admin-nav">
                        <li><a href="/admin/dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="/admin/students"><i class="fas fa-users"></i> Students</a></li>
                        <li><a href="/admin/courses"><i class="fas fa-book"></i> Courses</a></li>
                        <li><a href="/admin/services" class="active"><i class="fas fa-concierge-bell"></i> Services</a></li>
                        <li><a href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                        <li><a href="/admin/manage-admins"><i class="fas fa-user-shield"></i> Admins</a></li>
                        <li><a href="/admin/logout" style="color:#e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </aside>

                <!-- ===== Admin Content ===== -->
                <div class="admin-content">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:16px;">
                        <div>
                            <h2 style="font-size:1.5rem; font-weight:700; margin:0 0 2px;">✏️ Edit Service</h2>
                            <p style="color:var(--text-muted); margin:0;">Update service details.</p>
                        </div>
                        <a href="/admin/services" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to Services
                        </a>
                    </div>

                    <!-- Edit Service Form -->
                    <div class="admin-card">
                        <form action="/admin/services/edit/<%= service.id %>" method="POST">
                            <div class="settings-group">
                                <label for="serviceName">Service Name <span style="color:red;">*</span></label>
                                <input type="text" id="serviceName" name="name" value="<%= service.name %>" required>
                            </div>
                            <div class="settings-group">
                                <label for="serviceDescription">Description</label>
                                <textarea id="serviceDescription" name="description" rows="3"><%= service.description || '' %></textarea>
                            </div>
                            <div class="settings-group">
                                <label for="servicePrice">Price (₦) <span style="color:red;">*</span></label>
                                <input type="number" id="servicePrice" name="price" value="<%= service.price %>" required>
                            </div>
                            <div class="settings-group">
                                <label for="serviceCategory">Category</label>
                                <select id="serviceCategory" name="category">
                                    <option value="registration" <%= service.category === 'registration' ? 'selected' : '' %>>Registration</option>
                                    <option value="design" <%= service.category === 'design' ? 'selected' : '' %>>Design</option>
                                    <option value="campaign" <%= service.category === 'campaign' ? 'selected' : '' %>>Campaign</option>
                                    <option value="website" <%= service.category === 'website' ? 'selected' : '' %>>Website</option>
                                    <option value="other" <%= service.category === 'other' ? 'selected' : '' %>>Other</option>
                                </select>
                            </div>
                            <div class="settings-group">
                                <label>Status</label>
                                <div style="display:flex; align-items:center; gap:12px;">
                                    <span class="badge <%= service.isActive ? 'badge-green' : 'badge-red' %>">
                                        <%= service.isActive ? '✅ Active' : '❌ Inactive' %>
                                    </span>
                                    <span style="font-size:0.8rem; color:var(--text-muted);">Toggle status on the services list page.</span>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Update Service
                            </button>
                            <a href="/admin/services" class="btn btn-secondary" style="margin-left:8px;">Cancel</a>
                        </form>
                    </div>

                    <!-- Preview -->
                    <div class="admin-card">
                        <h4><i class="fas fa-eye"></i> Service Preview</h4>
                        <div class="preview-box">
                            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap;">
                                <div>
                                    <h5 style="font-size:1.1rem; font-weight:700; margin:0;"><%= service.name %></h5>
                                    <span class="badge <%= service.category === 'registration' ? 'badge-purple' : 
                                                      service.category === 'design' ? 'badge-gold' : 
                                                      service.category === 'campaign' ? 'badge-green' : 
                                                      service.category === 'website' ? 'badge-dark' : 'badge' %>">
                                        <%= service.category ? service.category.charAt(0).toUpperCase() + service.category.slice(1) : 'Other' %>
                                    </span>
                                    <span class="badge <%= service.isActive ? 'badge-green' : 'badge-red' %>">
                                        <%= service.isActive ? 'Active' : 'Inactive' %>
                                    </span>
                                </div>
                                <div style="font-weight:700; font-size:1.2rem; color:var(--primary);">
                                    ₦<%= service.price.toLocaleString() %>
                                </div>
                            </div>
                            <p style="margin:8px 0 0; color:var(--text-muted);"><%= service.description || 'No description available.' %></p>
                        </div>
                    </div>

                    <!-- Delete -->
                    <div style="text-align:right; margin-top:8px;">
                        <form action="/admin/services/delete/<%= service.id %>" method="GET" style="display:inline;" onsubmit="return confirm('⚠️ Delete this service? This cannot be undone.');">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash-alt"></i> Delete Service
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>