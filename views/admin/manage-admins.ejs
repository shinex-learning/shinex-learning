<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %> | SHINEX Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           ADMIN MANAGE ADMINS PAGE STYLES
           ============================================================ */
        
        /* ----- Admin Layout ----- */
        .admin-layout {
            display: flex;
            gap: var(--spacing-lg);
            max-width: 1400px;
            margin: 0 auto;
        }
        
        /* ----- Admin Sidebar ----- */
        .admin-sidebar {
            width: 260px;
            min-width: 220px;
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .admin-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid var(--border-color);
        }
        
        .admin-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        
        .admin-nav li {
            margin: 0;
        }
        
        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        
        .admin-nav a:hover {
            background: var(--purple-bg);
            color: var(--purple-primary);
        }
        
        .admin-nav a.active {
            background: var(--purple-bg);
            color: var(--purple-primary);
            border-left-color: var(--purple-primary);
        }
        
        .admin-nav a i {
            width: 20px;
            text-align: center;
        }
        
        .admin-nav a.logout-link {
            color: var(--text-error);
        }
        
        .admin-nav a.logout-link:hover {
            background: var(--bg-alert-error);
            color: var(--text-error);
        }
        
        /* ----- Admin Content ----- */
        .admin-content {
            flex: 1;
            min-width: 0;
        }
        
        /* ----- Admin Cards ----- */
        .admin-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-lg);
            margin-bottom: var(--spacing-md);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .admin-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        .admin-card .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-sm);
            margin-bottom: var(--spacing-md);
        }
        
        .admin-card .card-header h4 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .admin-card .card-header h4 i {
            color: var(--purple-primary);
        }
        
        /* ----- Page Header ----- */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-sm);
            margin-bottom: var(--spacing-md);
        }
        
        .page-header .page-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        
        .page-header .page-subtitle {
            color: var(--text-muted);
            margin: 2px 0 0 0;
            font-size: 0.9rem;
        }
        
        /* ----- Table ----- */
        .table-wrapper {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        
        .admin-table th {
            text-align: left;
            padding: 10px 14px;
            border-bottom: 2px solid var(--border-color);
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }
        
        .admin-table td {
            padding: 10px 14px;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }
        
        .admin-table tr {
            transition: background 0.2s ease;
        }
        
        .admin-table tr:hover {
            background: var(--purple-bg);
        }
        
        .admin-table .admin-name {
            font-weight: 600;
            color: var(--text-primary);
        }
        
        .admin-table .admin-email {
            color: var(--text-secondary);
            font-size: 0.85rem;
        }
        
        .admin-table .admin-id {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-family: monospace;
        }
        
        /* ----- Badges ----- */
        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 14px;
            border-radius: var(--radius-full);
            font-size: 0.7rem;
            font-weight: 600;
        }
        
        .role-badge.super-admin {
            background: var(--bg-alert-warning);
            color: var(--text-warning);
        }
        
        .role-badge.admin {
            background: var(--bg-alert-info);
            color: #1a5276;
        }
        
        body.dark-mode .role-badge.super-admin {
            background: #3a2a1a;
            color: #f7dc6f;
        }
        
        body.dark-mode .role-badge.admin {
            background: #1a2a3a;
            color: #85c1e9;
        }
        
        /* ----- Protected Badge ----- */
        .protected-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.7rem;
            color: var(--text-muted);
        }
        
        .protected-badge i {
            color: var(--text-warning);
        }
        
        /* ----- User Grid for "Make Admin" ----- */
        .user-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: var(--spacing-sm);
        }
        
        .user-grid-item {
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            padding: var(--spacing-sm) var(--spacing-md);
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }
        
        .user-grid-item:hover {
            border-color: var(--purple-primary);
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }
        
        .user-grid-item .user-info {
            flex: 1;
        }
        
        .user-grid-item .user-info .user-name {
            font-weight: 600;
            color: var(--text-primary);
            font-size: 0.9rem;
        }
        
        .user-grid-item .user-info .user-email {
            font-size: 0.75rem;
            color: var(--text-muted);
            display: block;
        }
        
        .user-grid-item .user-actions .btn {
            padding: 4px 12px;
            font-size: 0.7rem;
            min-height: 30px;
        }
        
        /* ----- Stats Grid ----- */
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-md);
        }
        
        .stat-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-md);
            text-align: center;
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .stat-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        .stat-card .stat-number {
            font-size: 2rem;
            font-weight: 800;
            color: var(--purple-primary);
            line-height: 1.2;
        }
        
        .stat-card .stat-label {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 2px;
        }
        
        .stat-card.purple .stat-number {
            color: var(--purple-primary);
        }
        
        .stat-card.muted .stat-number {
            color: var(--text-muted);
        }
        
        /* ----- Alert Note ----- */
        .alert-note {
            background: var(--bg-alert-warning);
            border-radius: var(--radius-sm);
            padding: var(--spacing-sm) var(--spacing-md);
            font-size: 0.85rem;
            border-left: 4px solid var(--text-warning);
            margin-bottom: var(--spacing-md);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .alert-note i {
            color: var(--text-warning);
            font-size: 1.1rem;
        }
        
        .alert-note .note-text {
            color: var(--text-primary);
        }
        
        .alert-note .note-text strong {
            color: var(--text-warning);
        }
        
        body.dark-mode .alert-note {
            background: #2a2a1a;
        }
        
        /* ----- Empty State ----- */
        .empty-state {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-lg);
            color: var(--text-muted);
        }
        
        .empty-state i {
            font-size: 48px;
            color: var(--text-light);
            margin-bottom: var(--spacing-md);
            display: block;
            opacity: 0.5;
        }
        
        .empty-state h4 {
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .empty-state p {
            margin: 0;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 1024px) {
            .admin-layout {
                flex-direction: column;
            }
            
            .admin-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
                max-height: 0;
                overflow: hidden;
                padding: 0;
                transition: max-height 0.3s ease, padding 0.3s ease;
                box-shadow: none;
            }
            
            .admin-sidebar.open {
                max-height: 600px;
                padding: 12px 0;
                overflow-y: auto;
            }
            
            .admin-sidebar-toggle {
                display: flex !important;
            }
        }
        
        @media (max-width: 768px) {
            .admin-card {
                padding: var(--spacing-md);
            }
            
            .page-header {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .admin-table {
                font-size: 0.75rem;
            }
            
            .admin-table th,
            .admin-table td {
                padding: 6px 8px;
            }
            
            .admin-table th:nth-child(3),
            .admin-table td:nth-child(3) {
                display: none;
            }
            
            .user-grid {
                grid-template-columns: 1fr;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 480px) {
            .admin-table th:nth-child(4),
            .admin-table td:nth-child(4) {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- ===== ADMIN HEADER (Built-in) ===== -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:12px 24px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:1000; box-shadow:0 2px 15px rgba(139,92,246,0.3);">
        <div style="display:flex; align-items:center; gap:12px;">
            <!-- Back Button -->
            <a href="/admin/dashboard" style="color:rgba(255,255,255,0.8); text-decoration:none; padding:4px 10px; border-radius:8px; transition:all 0.3s ease; font-size:14px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
            <div>
                <div style="font-weight:700; font-size:16px; color:#fff;">SHINEX <span style="opacity:0.7; font-weight:400;">Admin</span></div>
                <div style="font-size:7px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
            </div>
        </div>
        <div style="display:flex; gap:12px; align-items:center;">
            <span style="color:rgba(255,255,255,0.9); font-size:13px;">
                <i class="fas fa-user"></i> <%= admin && admin.firstName ? admin.firstName : 'Admin' %>
            </span>
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light');" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:6px 12px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon"></i>
            </button>
            <a href="/admin/logout" style="color:#fff; text-decoration:none; background:rgba(255,255,255,0.15); padding:6px 14px; border-radius:20px; font-size:13px; transition:all 0.3s ease;">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="container">

            <!-- Flash Messages -->
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success">
                    <i class="fas fa-check-circle"></i> <%= messages.success %>
                </div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error">
                    <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                </div>
            <% } %>

            <!-- ===== ADMIN LAYOUT ===== -->
            <div class="admin-layout">

                <!-- ===== SIDEBAR ===== -->
                <aside class="admin-sidebar" id="adminSidebar">
                    <div class="sidebar-title"><i class="fas fa-crown"></i> Admin Panel</div>
                    <ul class="admin-nav">
                        <li><a href="/admin/dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="/admin/students"><i class="fas fa-users"></i> Students</a></li>
                        <li><a href="/admin/courses"><i class="fas fa-book"></i> Courses</a></li>
                        <li><a href="/admin/services"><i class="fas fa-concierge-bell"></i> Services</a></li>
                        <li><a href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                        <li><a href="/admin/manage-admins" class="active"><i class="fas fa-user-shield"></i> Admins</a></li>
                        <li><a href="/admin/logout" class="logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </aside>

                <!-- ===== CONTENT ===== -->
                <div class="admin-content">

                    <!-- Page Header -->
                    <div class="page-header">
                        <div>
                            <h1 class="page-title">
                                <i class="fas fa-user-shield" style="color:var(--purple-primary);"></i> 
                                Manage Admins
                            </h1>
                            <p class="page-subtitle">
                                <i class="fas fa-info-circle"></i> 
                                <%= admins ? admins.length : 0 %> admins • 
                                <%= nonAdmins ? nonAdmins.length : 0 %> regular users
                            </p>
                        </div>
                        <div style="display:flex; gap:8px;">
                            <button class="btn btn-secondary btn-sm admin-sidebar-toggle" onclick="toggleSidebar()" style="display:none;">
                                <i class="fas fa-bars"></i> Menu
                            </button>
                        </div>
                    </div>

                    <!-- ===== ALERT NOTE ===== -->
                    <div class="alert-note">
                        <i class="fas fa-info-circle"></i>
                        <div class="note-text">
                            <strong>Super Admin Protected:</strong> 
                            The main admin (<strong>balogunmustaphaaddeji@gmail.com</strong>) cannot be removed.
                        </div>
                    </div>

                    <!-- ===== CURRENT ADMINS TABLE ===== -->
                    <div class="admin-card">
                        <div class="card-header">
                            <h4><i class="fas fa-user-shield"></i> Current Admins</h4>
                            <span class="badge badge-purple">
                                <i class="fas fa-users"></i> <%= admins ? admins.length : 0 %> Total
                            </span>
                        </div>

                        <div class="table-wrapper">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th><i class="fas fa-user"></i> Name</th>
                                        <th><i class="fas fa-envelope"></i> Email</th>
                                        <th><i class="fas fa-id-card"></i> Student ID</th>
                                        <th><i class="fas fa-tag"></i> Role</th>
                                        <th><i class="fas fa-cog"></i> Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (admins && admins.length > 0) { %>
                                        <% admins.forEach(a => { %>
                                            <tr>
                                                <td>
                                                    <div class="admin-name">
                                                        <i class="fas fa-user-circle" style="color:var(--purple-primary);"></i>
                                                        <%= a.firstName %> <%= a.lastName %>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="admin-email">
                                                        <%= a.email %>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="admin-id"><%= a.studentId || 'N/A' %></span>
                                                </td>
                                                <td>
                                                    <% if (a.email === 'balogunmustaphaaddeji@gmail.com') { %>
                                                        <span class="role-badge super-admin">
                                                            <i class="fas fa-crown"></i> Super Admin
                                                        </span>
                                                    <% } else { %>
                                                        <span class="role-badge admin">
                                                            <i class="fas fa-user-shield"></i> Admin
                                                        </span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (a.email !== 'balogunmustaphaaddeji@gmail.com') { %>
                                                        <form action="/admin/remove-admin/<%= a.id %>" method="POST" style="display:inline;" onsubmit="return confirm('⚠️ Remove admin privileges from <%= a.firstName %> <%= a.lastName %>?');">
                                                            <button type="submit" class="btn btn-danger btn-sm" style="padding:4px 12px; font-size:0.7rem;">
                                                                <i class="fas fa-user-minus"></i> Remove
                                                            </button>
                                                        </form>
                                                    <% } else { %>
                                                        <span class="protected-badge">
                                                            <i class="fas fa-lock"></i> Protected
                                                        </span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5">
                                                <div class="empty-state" style="padding:var(--spacing-md);">
                                                    <i class="fas fa-user-shield"></i>
                                                    <h4>No Admins Found</h4>
                                                    <p>There are no admin users in the system.</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ===== MAKE ADMIN ===== -->
                    <div class="admin-card">
                        <div class="card-header">
                            <h4><i class="fas fa-user-plus"></i> Make User an Admin</h4>
                            <span class="badge badge-dark">
                                <i class="fas fa-users"></i> <%= nonAdmins ? nonAdmins.length : 0 %> Available
                            </span>
                        </div>

                        <% if (nonAdmins && nonAdmins.length > 0) { %>
                            <div class="user-grid">
                                <% nonAdmins.forEach(u => { %>
                                    <div class="user-grid-item">
                                        <div class="user-info">
                                            <div class="user-name">
                                                <i class="fas fa-user" style="color:var(--purple-primary);"></i>
                                                <%= u.firstName %> <%= u.lastName %>
                                            </div>
                                            <span class="user-email"><%= u.email %></span>
                                        </div>
                                        <div class="user-actions">
                                            <form action="/admin/make-admin/<%= u.id %>" method="POST" style="display:inline;" onsubmit="return confirm('⚠️ Make <%= u.firstName %> <%= u.lastName %> an admin?');">
                                                <button type="submit" class="btn btn-primary btn-sm" title="Make Admin">
                                                    <i class="fas fa-user-shield"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="empty-state" style="padding:var(--spacing-md);">
                                <i class="fas fa-check-circle" style="color:var(--text-success);"></i>
                                <h4 style="color:var(--text-success);">All Users Are Admins</h4>
                                <p>There are no regular users to promote.</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- ===== STATS ===== -->
                    <div class="stats-grid">
                        <div class="stat-card purple">
                            <div class="stat-number"><%= admins ? admins.length : 0 %></div>
                            <div class="stat-label">
                                <i class="fas fa-user-shield" style="color:var(--purple-primary);"></i> 
                                Total Admins
                            </div>
                        </div>
                        <div class="stat-card muted">
                            <div class="stat-number"><%= nonAdmins ? nonAdmins.length : 0 %></div>
                            <div class="stat-label">
                                <i class="fas fa-user"></i> 
                                Regular Users
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:40px;">
        <div style="max-width:1200px; margin:0 auto; padding:0 20px; text-align:center; font-size:0.8rem; color:rgba(255,255,255,0.6);">
            &copy; 2026 SHINEX Learning Circle. All rights reserved.
        </div>
    </footer>

    <script>
        // ============================================================
        // SIDEBAR TOGGLE (Mobile)
        // ============================================================
        
        function toggleSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            if (sidebar) {
                sidebar.classList.toggle('open');
            }
        }
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
        }
        
        // ============================================================
        // AUTO DISMISS FLASH MESSAGES
        // ============================================================
        
        document.querySelectorAll('.flash-message').forEach(msg => {
            setTimeout(() => {
                msg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                msg.style.opacity = '0';
                msg.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    if (msg.parentNode) msg.remove();
                }, 500);
            }, 5000);
        });
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('🔐 SHINEX Admin Panel');
        console.log('👑 Manage Admins');
        console.log('👥 Total Admins: <%= admins ? admins.length : 0 %>');
        console.log('👤 Regular Users: <%= nonAdmins ? nonAdmins.length : 0 %>');
