<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Admins – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <%- include('../partials/header', { user: null, showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
                <h2 style="font-size: 1.6rem; font-weight: 800; color: #1A0A2E;">
                    <i class="fas fa-user-shield" style="color: #8B5CF6;"></i> Manage Admins
                </h2>
                <a href="/admin/dashboard" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
            </div>

            <!-- Current Admins -->
            <div class="card" style="margin-bottom: 20px;">
                <h4 style="font-weight: 700; color: #1A0A2E; margin-bottom: 12px;">
                    <i class="fas fa-users" style="color: #8B5CF6;"></i> Current Admins (<%= admins.length %>)
                </h4>
                <div style="overflow-x: auto;">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% admins.forEach(a => { %>
                                <tr>
                                    <td><%= a.firstName %> <%= a.lastName %></td>
                                    <td><%= a.email %></td>
                                    <td>
                                        <% if (a.email !== 'admin@shinex.com') { %>
                                            <form action="/admin/remove-admin/<%= a.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Remove admin privileges from this user?');">
                                                <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-user-minus"></i> Remove</button>
                                            </form>
                                        <% } else { %>
                                            <span style="color: #7a6a8f; font-size: 0.8rem;"><i class="fas fa-star" style="color: #f39c12;"></i> Default Admin</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Make New Admin -->
            <div class="card">
                <h4 style="font-weight: 700; color: #1A0A2E; margin-bottom: 12px;">
                    <i class="fas fa-user-plus" style="color: #8B5CF6;"></i> Make User Admin
                </h4>
                <div style="overflow-x: auto;">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% nonAdmins.forEach(u => { %>
                                <tr>
                                    <td><%= u.firstName %> <%= u.lastName %></td>
                                    <td><%= u.email %></td>
                                    <td>
                                        <form action="/admin/make-admin/<%= u.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Make this user an admin?');">
                                            <button type="submit" class="btn btn-primary btn-xs"><i class="fas fa-user-plus"></i> Make Admin</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                            <% if (nonAdmins.length === 0) { %>
                                <tr><td colspan="3" style="text-align: center; color: #7a6a8f;">No non-admin users available.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>