<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Admins – SHINEX Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-layout {
            display: flex;
            gap: 24px;
            max-width: 1400px;
            margin: 0 auto;
        }
        .admin-sidebar {
            width: 240px;
            min-width: 200px;
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            transition: all 0.3s ease;
        }
        body.dark-mode .admin-sidebar {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .admin-sidebar .sidebar-title {
            border-color: var(--dark-border);
        }
        .admin-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        .admin-nav li {
            margin: 0;
        }
        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .admin-nav a:hover {
            background: var(--primary-bg);
            color: var(--primary);
        }
        .admin-nav a.active {
            background: var(--primary-bg);
            color: var(--primary);
            border-left-color: var(--primary);
        }
        body.dark-mode .admin-nav a:hover {
            background: #2a1a4a;
        }
        body.dark-mode .admin-nav a.active {
            background: #2a1a4a;
        }
        .admin-content {
            flex: 1;
            min-width: 0;
        }
        .admin-card {
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 20px 24px;
            margin-bottom: 16px;
        }
        body.dark-mode .admin-card {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 8px;
        }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        .admin-table th {
            text-align: left;
            padding: 8px 12px;
            border-bottom: 2px solid #ede8f5;
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        body.dark-mode .admin-table th {
            border-color: var(--dark-border);
        }
        .admin-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #ede8f5;
            vertical-align: middle;
        }
        body.dark-mode .admin-table td {
            border-color: var(--dark-border);
        }
        .admin-table tr:hover {
            background: var(--primary-bg);
        }
        body.dark-mode .admin-table tr:hover {
            background: #1a1a1a;
        }
        .admin-table .badge {
            font-size: 0.65rem;
            padding: 2px 10px;
        }
        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }
        .admin-badge.super {
            background: #fef9e7;
            color: #f39c12;
        }
        .admin-badge.admin {
            background: #d6eaf8;
            color: #1a5276;
        }
        body.dark-mode .admin-badge.super {
            background: #3a2a1a;
            color: #f7dc6f;
        }
        body.dark-mode .admin-badge.admin {
            background: #1a2a3a;
            color: #85c1e9;
        }
        .main-admin-note {
            background: #fef9e7;
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 0.8rem;
            color: #7d6608;
            border-left: 4px solid #f39c12;
        }
        body.dark-mode .main-admin-note {
            background: #2a2a1a;
            color: #f7dc6f;
        }
        @media (max-width: 768px) {
            .admin-layout {
                flex-direction: column;
            }
            .admin-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
            }
            .admin-table {
                font-size: 0.75rem;
            }
            .admin-table th,
            .admin-table td {
                padding: 6px 8px;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <div class="admin-layout">
                <!-- ===== Admin Sidebar ===== -->
                <aside class="admin-sidebar">
                    <div class="sidebar-title"><i class="fas fa-crown"></i> Admin Panel</div>
                    <ul class="admin-nav">
                        <li><a href="/admin/dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="/admin/students"><i class="fas fa-users"></i> Students</a></li>
                        <li><a href="/admin/courses"><i class="fas fa-book"></i> Courses</a></li>
                        <li><a href="/admin/services"><i class="fas fa-concierge-bell"></i> Services</a></li>
                        <li><a href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                        <li><a href="/admin/manage-admins" class="active"><i class="fas fa-user-shield"></i> Admins</a></li>
                        <li><a href="/admin/logout" style="color:#e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </aside>

                <!-- ===== Admin Content ===== -->
                <div class="admin-content">
                    <h2 style="font-size:1.5rem; font-weight:700; margin:0 0 2px;">👑 Manage Admins</h2>
                    <p style="color:var(--text-muted); margin-bottom:16px;">Add or remove admin privileges for users.</p>

                    <!-- Main Admin Note -->
                    <div class="main-admin-note" style="margin-bottom:16px;">
                        <i class="fas fa-info-circle"></i> 
                        The main admin (<strong>balogunmustaphaaddeji@gmail.com</strong>) cannot be removed.
                    </div>

                    <!-- Current Admins -->
                    <div class="admin-card">
                        <h4><i class="fas fa-user-shield"></i> Current Admins</h4>
                        <div style="overflow-x:auto;">
                            <table class="admin-table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Student ID</th>
                                        <th>Role</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (admins && admins.length > 0) { %>
                                        <% admins.forEach(a => { %>
                                            <tr>
                                                <td><strong><%= a.firstName %> <%= a.lastName %></strong></td>
                                                <td><%= a.email %></td>
                                                <td><%= a.studentId || 'N/A' %></td>
                                                <td>
                                                    <% if (a.email === 'balogunmustaphaaddeji@gmail.com') { %>
                                                        <span class="admin-badge super"><i class="fas fa-crown"></i> Super Admin</span>
                                                    <% } else { %>
                                                        <span class="admin-badge admin"><i class="fas fa-user-shield"></i> Admin</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (a.email !== 'balogunmustaphaaddeji@gmail.com') { %>
                                                        <form action="/admin/remove-admin/<%= a.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Remove admin privileges from <%= a.firstName %> <%= a.lastName %>?');">
                                                            <button type="submit" class="btn btn-danger btn-sm" style="padding:2px 10px; font-size:0.7rem;">
                                                                <i class="fas fa-user-minus"></i> Remove
                                                            </button>
                                                        </form>
                                                    <% } else { %>
                                                        <span style="font-size:0.7rem; color:var(--text-muted);">
                                                            <i class="fas fa-lock"></i> Protected
                                                        </span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" style="text-align:center; padding:20px; color:var(--text-muted);">
                                                No admins found.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Make Admin -->
                    <div class="admin-card">
                        <h4><i class="fas fa-user-plus"></i> Make User an Admin</h4>
                        <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">
                            Select a user to grant admin privileges.
                        </p>

                        <% if (nonAdmins && nonAdmins.length > 0) { %>
                            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px,1fr)); gap:8px;">
                                <% nonAdmins.forEach(u => { %>
                                    <div style="background:var(--primary-bg); border-radius:8px; padding:10px 14px; display:flex; justify-content:space-between; align-items:center;">
                                        <div>
                                            <span style="font-weight:500;"><%= u.firstName %> <%= u.lastName %></span>
                                            <span style="font-size:0.75rem; color:var(--text-muted); display:block;"><%= u.email %></span>
                                        </div>
                                        <form action="/admin/make-admin/<%= u.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Make <%= u.firstName %> <%= u.lastName %> an admin?');">
                                            <button type="submit" class="btn btn-primary btn-sm" style="padding:2px 10px; font-size:0.7rem;">
                                                <i class="fas fa-user-shield"></i>
                                            </button>
                                        </form>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p style="color:var(--text-muted); text-align:center; padding:12px;">
                                <i class="fas fa-check-circle" style="color:#27ae60;"></i>
                                All users are already admins.
                            </p>
                        <% } %>
                    </div>

                    <!-- Total Stats -->
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                        <div class="admin-card" style="text-align:center;">
                            <h4 style="margin:0; font-size:1.5rem; color:var(--primary);">
                                <%= admins ? admins.length : 0 %>
                            </h4>
                            <p style="margin:0; color:var(--text-muted);">Total Admins</p>
                        </div>
                        <div class="admin-card" style="text-align:center;">
                            <h4 style="margin:0; font-size:1.5rem; color:var(--text-muted);">
                                <%= nonAdmins ? nonAdmins.length : 0 %>
                            </h4>
                            <p style="margin:0; color:var(--text-muted);">Regular Users</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>