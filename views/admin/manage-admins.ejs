<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Manage Admins – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .admin-list-wrap { overflow-x: auto; }
        .default-admin-badge { background: #f39c12; color: #fff; padding: 2px 10px; border-radius: 20px; font-size:0.6rem; font-weight:600; margin-left:6px; }
        @media (max-width: 480px) {
            .admin-table { font-size: 0.7rem; }
            .admin-table th, .admin-table td { padding: 4px 6px; }
        }
    </style>
</head>
<body>
    <%- include('../partials/header', { user: null, showBack: true }) %>

    <main class="main-content">
        <div class="container">

            <% if (messages && messages.error) { %>
                <div class="alert alert-danger" style="margin-bottom:12px;"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success" style="margin-bottom:12px;"><%= messages.success %></div>
            <% } %>

            <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:16px;">
                <h2 style="font-size:1.4rem; font-weight:800; color:#1A0A2E; margin:0;">
                    <i class="fas fa-user-shield" style="color:#8B5CF6;"></i> Manage Admins
                </h2>
                <a href="/admin/dashboard" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back to Admin</a>
            </div>

            <!-- Current Admins -->
            <div class="card" style="margin-bottom:16px; padding:16px 18px;">
                <h4 style="font-weight:700; color:#1A0A2E; font-size:1rem; margin:0 0 10px 0;">
                    <i class="fas fa-users-cog" style="color:#8B5CF6;"></i> Current Admins (<%= admins.length %>)
                </h4>
                <div class="admin-list-wrap">
                    <table class="admin-table">
                        <thead><tr><th>Name</th><th>Email</th><th>Status</th><th>Action</th></tr></thead>
                        <tbody>
                            <% if (admins.length > 0) { %>
                                <% admins.forEach(function(a) { %>
                                    <tr>
                                        <td><strong><%= a.firstName %> <%= a.lastName %></strong></td>
                                        <td><%= a.email %></td>
                                        <td>
                                            <% if (a.email === 'admin@shinex.com') { %>
                                                <span class="default-admin-badge"><i class="fas fa-star"></i> Default</span>
                                            <% } else { %>
                                                <span class="badge badge-purple" style="font-size:0.6rem;">Admin</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (a.email !== 'admin@shinex.com') { %>
                                                <form action="/admin/remove-admin/<%= a.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Remove admin privileges from this user?');">
                                                    <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-user-minus"></i> Remove</button>
                                                </form>
                                            <% } else { %>
                                                <span style="color:#7a6a8f; font-size:0.7rem;"><i class="fas fa-lock"></i> Protected</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="4" style="text-align:center; color:#7a6a8f; padding:12px;">No admin users found.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Make New Admin -->
            <div class="card" style="padding:16px 18px;">
                <h4 style="font-weight:700; color:#1A0A2E; font-size:1rem; margin:0 0 10px 0;">
                    <i class="fas fa-user-plus" style="color:#8B5CF6;"></i> Make User Admin
                </h4>
                <p style="font-size:0.85rem; color:#7a6a8f; margin:0 0 10px 0;">Select a user from the list below to make them an admin.</p>
                <div class="admin-list-wrap">
                    <table class="admin-table">
                        <thead><tr><th>Name</th><th>Email</th><th>Course</th><th>Action</th></tr></thead>
                        <tbody>
                            <% if (nonAdmins.length > 0) { %>
                                <% nonAdmins.forEach(function(u) { %>
                                    <tr>
                                        <td><%= u.firstName %> <%= u.lastName %></td>
                                        <td><%= u.email %></td>
                                        <td>
                                            <% if (u.courseId) { %>
                                                <span class="badge badge-green" style="font-size:0.6rem;">Enrolled</span>
                                            <% } else { %>
                                                <span style="color:#b0a3c4; font-size:0.7rem;">No course</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <form action="/admin/make-admin/<%= u.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Make this user an admin?');">
                                                <button type="submit" class="btn btn-primary btn-xs"><i class="fas fa-user-shield"></i> Make Admin</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="4" style="text-align:center; color:#7a6a8f; padding:12px;">
                                    <i class="fas fa-check-circle" style="color:#27ae60;"></i> No non-admin users available.
                                </td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>