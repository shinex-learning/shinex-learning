<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Students – SHINEX Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-layout {
            display: flex;
            gap: 24px;
            max-width: 1400px;
            margin: 0 auto;
        }
        .admin-sidebar {
            width: 240px;
            min-width: 200px;
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            transition: all 0.3s ease;
        }
        body.dark-mode .admin-sidebar {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .admin-sidebar .sidebar-title {
            border-color: var(--dark-border);
        }
        .admin-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        .admin-nav li {
            margin: 0;
        }
        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .admin-nav a:hover {
            background: var(--primary-bg);
            color: var(--primary);
        }
        .admin-nav a.active {
            background: var(--primary-bg);
            color: var(--primary);
            border-left-color: var(--primary);
        }
        body.dark-mode .admin-nav a:hover {
            background: #2a1a4a;
        }
        body.dark-mode .admin-nav a.active {
            background: #2a1a4a;
        }
        .admin-content {
            flex: 1;
            min-width: 0;
        }
        .admin-card {
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 20px 24px;
            margin-bottom: 16px;
        }
        body.dark-mode .admin-card {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 8px;
        }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        .admin-table th {
            text-align: left;
            padding: 8px 12px;
            border-bottom: 2px solid #ede8f5;
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        body.dark-mode .admin-table th {
            border-color: var(--dark-border);
        }
        .admin-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #ede8f5;
            vertical-align: middle;
        }
        body.dark-mode .admin-table td {
            border-color: var(--dark-border);
        }
        .admin-table tr:hover {
            background: var(--primary-bg);
        }
        body.dark-mode .admin-table tr:hover {
            background: #1a1a1a;
        }
        .admin-table .badge {
            font-size: 0.65rem;
            padding: 2px 10px;
        }
        .search-box {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }
        .search-box input {
            flex: 1;
            min-width: 200px;
        }
        @media (max-width: 768px) {
            .admin-layout {
                flex-direction: column;
            }
            .admin-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
            }
            .admin-table {
                font-size: 0.75rem;
            }
            .admin-table th,
            .admin-table td {
                padding: 6px 8px;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <div class="admin-layout">
                <!-- ===== Admin Sidebar ===== -->
                <aside class="admin-sidebar">
                    <div class="sidebar-title"><i class="fas fa-crown"></i> Admin Panel</div>
                    <ul class="admin-nav">
                        <li><a href="/admin/dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="/admin/students" class="active"><i class="fas fa-users"></i> Students</a></li>
                        <li><a href="/admin/courses"><i class="fas fa-book"></i> Courses</a></li>
                        <li><a href="/admin/services"><i class="fas fa-concierge-bell"></i> Services</a></li>
                        <li><a href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                        <li><a href="/admin/manage-admins"><i class="fas fa-user-shield"></i> Admins</a></li>
                        <li><a href="/admin/logout" style="color:#e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </aside>

                <!-- ===== Admin Content ===== -->
                <div class="admin-content">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:16px;">
                        <div>
                            <h2 style="font-size:1.5rem; font-weight:700; margin:0 0 2px;">👥 Manage Students</h2>
                            <p style="color:var(--text-muted); margin:0;">View and manage all registered students.</p>
                        </div>
                        <div style="font-size:0.9rem; color:var(--text-muted);">
                            <i class="fas fa-users"></i> Total: <strong><%= students ? students.length : 0 %></strong>
                        </div>
                    </div>

                    <!-- Search -->
                    <div class="search-box">
                        <input type="text" id="studentSearch" placeholder="Search by name, email, or Student ID..." onkeyup="filterStudents()">
                        <select id="courseFilter" onchange="filterStudents()" style="width:auto; min-width:150px;">
                            <option value="">All Courses</option>
                            <% if (courseMap) { %>
                                <% Object.values(courseMap).forEach(c => { %>
                                    <option value="<%= c %>"><%= c %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <!-- Students Table -->
                    <div class="admin-card" style="overflow-x:auto;">
                        <table class="admin-table" id="studentTable">
                            <thead>
                                <tr>
                                    <th>Student ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Course</th>
                                    <th>Level</th>
                                    <th>Status</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (students && students.length > 0) { %>
                                    <% students.forEach(s => { %>
                                        <tr class="student-row" data-course="<%= s.courseName || '' %>" data-name="<%= s.firstName + ' ' + s.lastName %>" data-id="<%= s.studentId %>">
                                            <td><strong><%= s.studentId || 'N/A' %></strong></td>
                                            <td><%= s.firstName || '' %> <%= s.lastName || '' %></td>
                                            <td><%= s.email || '' %></td>
                                            <td><%= s.courseName || 'Not enrolled' %></td>
                                            <td><span class="badge badge-purple"><%= s.learningLevel || 'Beginner' %></span></td>
                                            <td>
                                                <span class="badge <%= s.isVerified ? 'badge-green' : 'badge-red' %>">
                                                    <%= s.isVerified ? '✅ Verified' : '❌ Unverified' %>
                                                </span>
                                            </td>
                                            <td style="font-size:0.8rem;"><%= new Date(s.createdAt).toLocaleDateString() %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" style="text-align:center; padding:30px; color:var(--text-muted);">
                                            <i class="fas fa-users" style="font-size:2rem; display:block; margin-bottom:8px; opacity:0.3;"></i>
                                            No students registered yet.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        function filterStudents() {
            const search = document.getElementById('studentSearch').value.toLowerCase();
            const course = document.getElementById('courseFilter').value;
            const rows = document.querySelectorAll('.student-row');
            
            rows.forEach(row => {
                const name = row.getAttribute('data-name').toLowerCase();
                const id = row.getAttribute('data-id').toLowerCase();
                const rowCourse = row.getAttribute('data-course');
                
                let show = true;
                if (search && !name.includes(search) && !id.includes(search)) {
                    show = false;
                }
                if (course && rowCourse !== course) {
                    show = false;
                }
                row.style.display = show ? '' : 'none';
            });
        }
    </script>

    <script src="/js/main.js"></script>
</body>
</html>