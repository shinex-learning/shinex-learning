<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .admin-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }
        .admin-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #ede8f5;
            text-align: center;
            transition: all 0.3s ease;
        }
        body.dark-mode .admin-card {
            background: #1a1a1a;
            border-color: #333;
        }
        .admin-card:hover {
            border-color: #8B5CF6;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.08);
        }
        .admin-card .icon {
            font-size: 2.2rem;
            color: #8B5CF6;
        }
        .admin-card .number {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-dark);
            margin: 4px 0 0 0;
        }
        body.dark-mode .admin-card .number {
            color: #fff;
        }
        .admin-card .label {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 0 0 8px 0;
        }
        .admin-card .btn-sm {
            padding: 6px 16px;
            font-size: 0.75rem;
            border-radius: 30px;
        }
        .admin-stats {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 10px;
            margin-top: 12px;
        }
        .admin-stat-item {
            background: var(--primary-bg);
            border-radius: 10px;
            padding: 10px 14px;
            text-align: center;
        }
        body.dark-mode .admin-stat-item {
            background: #2a1a4a;
        }
        .admin-stat-item .stat-number {
            font-size: 1.3rem;
            font-weight: 800;
            color: #8B5CF6;
        }
        .admin-stat-item .stat-label {
            font-size: 0.6rem;
            color: var(--text-muted);
        }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
        }
        .admin-table th {
            text-align: left;
            padding: 8px 10px;
            border-bottom: 2px solid #ede8f5;
            font-weight: 600;
            color: var(--text-dark);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .admin-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #ede8f5;
            font-size: 0.85rem;
            color: var(--text-dark);
        }
        body.dark-mode .admin-table th,
        body.dark-mode .admin-table td {
            border-color: #333;
            color: var(--text-light);
        }
        .admin-table tr:hover td {
            background: var(--primary-bg);
        }
        body.dark-mode .admin-table tr:hover td {
            background: #2a1a4a;
        }
        .badge-status {
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.6rem;
            font-weight: 600;
        }
        .badge-status.enrolled {
            background: #d5f5e3;
            color: #27ae60;
        }
        .badge-status.not-enrolled {
            background: #fadbd8;
            color: #e74c3c;
        }
        .badge-status.admin {
            background: #d6eaf8;
            color: #2e86c1;
        }
        @media (max-width: 600px) {
            .admin-grid { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 400px) {
            .admin-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <%- include('../partials/admin-header') %>

    <main style="padding:24px 0 40px;">
        <div class="container">
            <!-- ===== WELCOME ===== -->
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:16px;">
                <div>
                    <h1 style="font-size:1.4rem; font-weight:800; color:var(--text-dark); margin:0;">
                        <i class="fas fa-shield-alt" style="color:#8B5CF6;"></i> Admin Dashboard
                    </h1>
                    <p style="color:var(--text-muted); font-size:0.9rem; margin:2px 0 0;">
                        Welcome back, <strong style="color:var(--text-dark);"><%= admin ? admin.firstName : 'Admin' %></strong>!
                    </p>
                </div>
                <a href="/admin/logout" class="btn btn-danger btn-sm">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>

            <!-- ===== STATISTICS ===== -->
            <div class="admin-stats">
                <div class="admin-stat-item">
                    <div class="stat-number"><%= totalStudents || 0 %></div>
                    <div class="stat-label">Students</div>
                </div>
                <div class="admin-stat-item">
                    <div class="stat-number"><%= totalCourses || 0 %></div>
                    <div class="stat-label">Courses</div>
                </div>
                <div class="admin-stat-item">
                    <div class="stat-number"><%= totalEnrollments || 0 %></div>
                    <div class="stat-label">Enrollments</div>
                </div>
                <div class="admin-stat-item">
                    <div class="stat-number"><%= totalClasses || 0 %></div>
                    <div class="stat-label">Classes</div>
                </div>
                <div class="admin-stat-item">
                    <div class="stat-number"><%= unreadCount || 0 %></div>
                    <div class="stat-label">
                        <i class="fas fa-envelope" style="color:#e74c3c;"></i> Unread
                    </div>
                </div>
                <div class="admin-stat-item">
                    <div class="stat-number"><%= totalServices || 0 %></div>
                    <div class="stat-label">Services</div>
                </div>
            </div>

            <!-- ===== ADMIN CARDS ===== -->
            <div class="admin-grid">
                <!-- Students -->
                <div class="admin-card">
                    <div class="icon"><i class="fas fa-users"></i></div>
                    <div class="number"><%= totalStudents || 0 %></div>
                    <div class="label">Students</div>
                    <a href="/admin/students" class="btn btn-primary btn-sm">Manage</a>
                </div>

                <!-- Courses -->
                <div class="admin-card">
                    <div class="icon"><i class="fas fa-book-open"></i></div>
                    <div class="number"><%= totalCourses || 0 %></div>
                    <div class="label">Courses</div>
                    <a href="/admin/courses" class="btn btn-primary btn-sm">Manage</a>
                </div>

                <!-- Services -->
                <div class="admin-card">
                    <div class="icon"><i class="fas fa-cogs"></i></div>
                    <div class="number"><%= totalServices || 0 %></div>
                    <div class="label">Services</div>
                    <a href="/admin/services" class="btn btn-primary btn-sm">Manage</a>
                </div>

                <!-- ===== MESSAGES CARD ===== -->
                <div class="admin-card" style="border-color: <%= unreadCount > 0 ? '#e74c3c' : '#ede8f5' %>;">
                    <div class="icon"><i class="fas fa-envelope"></i></div>
                    <div class="number" style="color: <%= unreadCount > 0 ? '#e74c3c' : '#8B5CF6' %>;">
                        <%= unreadCount || 0 %>
                    </div>
                    <div class="label">
                        Messages
                        <% if (unreadCount > 0) { %>
                            <span style="background:#e74c3c; color:#fff; padding:0 8px; border-radius:10px; font-size:0.6rem;">
                                <%= unreadCount %> new
                            </span>
                        <% } %>
                    </div>
                    <a href="/admin/messages" class="btn btn-primary btn-sm">View</a>
                </div>

                <!-- Admins -->
                <div class="admin-card">
                    <div class="icon"><i class="fas fa-user-shield"></i></div>
                    <div class="number"><%= admins ? admins.length : 0 %></div>
                    <div class="label">Admins</div>
                    <a href="/admin/manage-admins" class="btn btn-primary btn-sm">Manage</a>
                </div>

                <!-- System -->
                <div class="admin-card">
                    <div class="icon"><i class="fas fa-server"></i></div>
                    <div class="number" style="font-size:1rem;">SLC</div>
                    <div class="label">System Status</div>
                    <span style="color:#27ae60; font-size:0.8rem;"><i class="fas fa-circle"></i> Online</span>
                </div>
            </div>

            <!-- ===== RECENT STUDENTS ===== -->
            <div class="card" style="margin-top:20px; padding:16px 18px;">
                <h4 style="font-weight:700; color:var(--text-dark); font-size:1rem; margin:0 0 8px 0;">
                    <i class="fas fa-user-graduate" style="color:#8B5CF6;"></i> Recent Students
                </h4>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Email</th>
                            <th>Course</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (students && students.length > 0) { %>
                            <% students.slice(0, 10).forEach(function(s) { %>
                                <tr>
                                    <td><%= s.firstName %> <%= s.lastName %></td>
                                    <td><%= s.email %></td>
                                    <td><%= s.courseName || 'Not enrolled' %></td>
                                    <td>
                                        <% if (s.courseName) { %>
                                            <span class="badge-status enrolled">Enrolled</span>
                                        <% } else { %>
                                            <span class="badge-status not-enrolled">Not enrolled</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="4" style="text-align:center; color:var(--text-muted);">No students yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <%- include('../partials/admin-footer') %>
    <script src="/js/script.js"></script>
</body>
</html>