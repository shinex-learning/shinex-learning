<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin – Edit Course</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('../partials/header', { user: null, showBack: true }) %>

    <main class="main-content">
        <div class="container" style="max-width: 860px;">

            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
                <h2 style="font-size: 1.5rem; font-weight: 800; color: #1A0A2E;">
                    <i class="fas fa-edit" style="color: #8B5CF6;"></i> Edit Course
                </h2>
                <a href="/admin/courses" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Back to Courses
                </a>
            </div>

            <!-- Course Details -->
            <div class="card" style="margin-bottom: 24px;">
                <h4 style="font-weight: 700; color: #1A0A2E; margin-bottom: 12px;">Course Details</h4>
                <form action="/admin/courses/edit/<%= course.id %>" method="POST" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <input type="text" name="title" class="form-control" value="<%= course.title %>" required>
                    <input type="text" name="description" class="form-control" value="<%= course.description %>" required>
                    <select name="level" class="form-control" required>
                        <option value="Beginner" <%= course.level === 'Beginner' ? 'selected' : '' %>>Beginner</option>
                        <option value="Intermediate" <%= course.level === 'Intermediate' ? 'selected' : '' %>>Intermediate</option>
                        <option value="Advanced" <%= course.level === 'Advanced' ? 'selected' : '' %>>Advanced</option>
                    </select>
                    <input type="text" name="duration" class="form-control" value="<%= course.duration %>" required>
                    <button type="submit" class="btn btn-primary" style="grid-column: 1 / -1;">
                        <i class="fas fa-save"></i> Update Course
                    </button>
                </form>
            </div>

            <!-- Course Review (BIG TEXTAREA) -->
<div class="card" style="margin-bottom: 24px; border-left: 4px solid #8B5CF6;">
    <h4 style="font-weight: 700; color: #1A0A2E; margin-bottom: 12px;">
        <i class="fas fa-edit" style="color: #8B5CF6;"></i> Course Review / Notes
    </h4>
    <form action="/admin/courses/review/<%= course.id %>" method="POST">
        <textarea name="review" class="form-control" rows="8" style="font-size: 16px; min-height: 200px; width: 100%;" placeholder="Write your review, notes, or feedback about this course..."><%= course.review || '' %></textarea>
        <button type="submit" class="btn btn-primary" style="margin-top: 10px;">
            <i class="fas fa-save"></i> Save Review
        </button>
    </form>
</div>

            <!-- Add Lesson -->
            <div class="card" style="margin-bottom: 24px; background: #f8f6fc;">
                <h4 style="font-weight: 700; color: #1A0A2E; margin-bottom: 12px;">
                    <i class="fas fa-plus-circle" style="color: #8B5CF6;"></i> Add Lesson
                </h4>
                <form action="/admin/courses/<%= course.id %>/lessons/add" method="POST" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <input type="text" name="title" class="form-control" placeholder="Lesson Title" required>
                    <input type="text" name="content" class="form-control" placeholder="Lesson Content / Description" required>
                    <input type="url" name="videoUrl" class="form-control" placeholder="YouTube Video URL (optional)">
                    <input type="url" name="externalLink" class="form-control" placeholder="External Resource URL (optional)">
                    <button type="submit" class="btn btn-success" style="grid-column: 1 / -1;">
                        <i class="fas fa-plus"></i> Add Lesson
                    </button>
                </form>
            </div>

            <!-- Lessons List -->
            <div class="card">
                <h4 style="font-weight: 700; color: #1A0A2E; margin-bottom: 12px;">
                    <i class="fas fa-list-ul"></i> Lessons (<%= course.lessons ? course.lessons.length : 0 %>)
                </h4>
                <% if (course.lessons && course.lessons.length > 0) { %>
                    <% course.lessons.forEach(function(lesson, idx) { %>
                        <div class="lesson-item" style="flex-wrap: wrap;">
                            <div style="flex:1; min-width: 160px;">
                                <div><strong><%= idx + 1 %>. <%= lesson.title %></strong></div>
                                <div style="font-size: 0.85rem; color: #7a6a8f;"><%= lesson.content %></div>
                                <% if (lesson.videoUrl) { %>
                                    <div style="font-size: 0.8rem; color: #8B5CF6;"><i class="fab fa-youtube"></i> <%= lesson.videoUrl %></div>
                                <% } %>
                                <% if (lesson.externalLink) { %>
                                    <div style="font-size: 0.8rem; color: #2d7a4a;"><i class="fas fa-external-link-alt"></i> <%= lesson.externalLink %></div>
                                <% } %>
                            </div>
                            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                <!-- Edit inline -->
                                <form action="/admin/courses/<%= course.id %>/lessons/edit/<%= lesson.id %>" method="POST" style="display: inline-flex; gap: 4px; flex-wrap: wrap;">
                                    <input type="text" name="title" value="<%= lesson.title %>" class="form-control" style="width: 120px; padding: 4px 8px; font-size: 0.8rem;" required>
                                    <input type="text" name="content" value="<%= lesson.content %>" class="form-control" style="width: 140px; padding: 4px 8px; font-size: 0.8rem;" required>
                                    <input type="url" name="videoUrl" value="<%= lesson.videoUrl || '' %>" class="form-control" style="width: 120px; padding: 4px 8px; font-size: 0.8rem;" placeholder="Video URL">
                                    <input type="url" name="externalLink" value="<%= lesson.externalLink || '' %>" class="form-control" style="width: 120px; padding: 4px 8px; font-size: 0.8rem;" placeholder="External Link">
                                    <button type="submit" class="btn btn-primary btn-xs"><i class="fas fa-save"></i></button>
                                </form>
                                <form action="/admin/courses/<%= course.id %>/lessons/delete/<%= lesson.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Delete this lesson?');">
                                    <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="color: #7a6a8f;">No lessons yet. Add one above.</p>
                <% } %>
            </div>

            <!-- Test -->
            <div class="card" style="margin-top: 20px; border: 2px solid #f7d44a;">
                <h4 style="font-weight: 700; color: #1A0A2E;">
                    <i class="fas fa-pencil-alt" style="color: #f39c12;"></i> Course Test
                </h4>
                <p style="color: #7a6a8f; font-size: 0.9rem;">
                    <%= course.test && course.test.questions ? course.test.questions.length : 0 %> questions added.
                </p>

                <!-- Add Test Question -->
                <form action="/admin/courses/<%= course.id %>/test" method="POST" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px;">
                    <input type="text" name="question" class="form-control" placeholder="Question" required style="grid-column: 1 / -1;">
                    <input type="text" name="option1" class="form-control" placeholder="Option A" required>
                    <input type="text" name="option2" class="form-control" placeholder="Option B" required>
                    <input type="text" name="option3" class="form-control" placeholder="Option C" required>
                    <input type="text" name="option4" class="form-control" placeholder="Option D" required>
                    <select name="correct" class="form-control" required>
                        <option value="">Correct Answer</option>
                        <option value="0">A</option>
                        <option value="1">B</option>
                        <option value="2">C</option>
                        <option value="3">D</option>
                    </select>
                    <button type="submit" class="btn btn-primary" style="grid-column: 1 / -1;">
                        <i class="fas fa-plus"></i> Add Question
                    </button>
                </form>

                <!-- List test questions -->
                <% if (course.test && course.test.questions && course.test.questions.length > 0) { %>
                    <div style="margin-top: 12px;">
                        <% course.test.questions.forEach(function(q, idx) { %>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #ede8f5;">
                                <span><strong><%= idx+1 %>.</strong> <%= q.question %></span>
                                <form action="/admin/courses/<%= course.id %>/test/delete/<%= q.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Delete this question?');">
                                    <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>