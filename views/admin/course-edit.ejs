<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Edit Course – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .level-card {
            background: #f8f6fc;
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 10px;
            border: 1px solid #ede8f5;
        }
        .level-card .level-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }
        .level-card .level-name {
            font-weight: 600;
            color: #1A0A2E;
        }
        .level-card .level-duration {
            font-size: 0.8rem;
            color: #7a6a8f;
        }
        .level-card .level-actions {
            display: flex;
            gap: 4px;
        }
        body.dark-mode .level-card {
            background: #2a2a2a;
            border-color: #444;
        }
        body.dark-mode .level-card .level-name {
            color: #e0e0e0;
        }
        .add-level-form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .add-level-form .full-width {
            grid-column: 1 / -1;
        }
        @media (max-width: 480px) {
            .add-level-form {
                grid-template-columns: 1fr;
            }
            .level-card {
                padding: 10px 12px;
            }
            .admin-table {
                font-size: 0.7rem;
            }
            .admin-table th,
            .admin-table td {
                padding: 4px 6px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header', { user: null, showBack: true }) %>

    <main class="main-content">
        <div class="container" style="max-width:900px;">

            <!-- ===== MESSAGES ===== -->
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger" style="margin-bottom:12px;"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success" style="margin-bottom:12px;"><%= messages.success %></div>
            <% } %>

            <!-- ===== HEADER ===== -->
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:16px;">
                <h2 style="font-size:1.3rem; font-weight:800; color:#1A0A2E; margin:0;">
                    <i class="fas fa-edit" style="color:#8B5CF6;"></i> Edit Course
                </h2>
                <a href="/admin/courses" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
            </div>

            <!-- ===== COURSE DETAILS ===== -->
            <div class="card" style="margin-bottom:16px; padding:16px 18px;">
                <h4 style="font-weight:700; color:#1A0A2E; font-size:1rem; margin:0 0 10px 0;">Course Details</h4>
                <form action="/admin/courses/edit/<%= course.id %>" method="POST" style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                    <input type="text" name="title" class="form-control" value="<%= course.title %>" required style="grid-column:1/-1;">
                    <input type="text" name="description" class="form-control" value="<%= course.description %>" required>
                    <input type="text" name="duration" class="form-control" value="<%= course.duration %>" required>
                    <textarea name="review" class="form-control" rows="3" placeholder="Course Review / Notes" style="grid-column:1/-1; resize:vertical;"><%= course.review || '' %></textarea>
                    <button type="submit" class="btn btn-primary" style="grid-column:1/-1; padding:12px;">
                        <i class="fas fa-save"></i> Update Course
                    </button>
                </form>
            </div>

            <!-- ===== ADD LEVEL ===== -->
            <div class="card" style="margin-bottom:16px; background:#f8f6fc; border:2px solid #8B5CF6; padding:16px 18px;">
                <h4 style="font-weight:700; color:#1A0A2E; font-size:1rem; margin:0 0 10px 0;">
                    <i class="fas fa-layer-group" style="color:#8B5CF6;"></i> Add New Level
                </h4>
                <form action="/admin/courses/<%= course.id %>/levels/add" method="POST" class="add-level-form">
                    <input type="text" name="name" class="form-control" placeholder="Level Name (e.g. Beginner)" required>
                    <input type="text" name="duration" class="form-control" placeholder="Duration (e.g. 4 hours)" required>
                    <button type="submit" class="btn btn-success full-width" style="grid-column:1/-1; padding:10px;">
                        <i class="fas fa-plus"></i> Add Level
                    </button>
                </form>
            </div>

            <!-- ===== LEVELS LIST ===== -->
            <div class="card" style="margin-bottom:16px; padding:16px 18px;">
                <h4 style="font-weight:700; color:#1A0A2E; font-size:1rem; margin:0 0 10px 0;">
                    <i class="fas fa-list"></i> Levels (<%= course.levels ? course.levels.length : 0 %>)
                </h4>

                <% if (course.levels && course.levels.length > 0) { %>
                    <% course.levels.forEach(function(level) { %>
                        <div class="level-card">
                            <div class="level-header">
                                <div>
                                    <span class="level-name"><%= level.name %></span>
                                    <span class="level-duration"><i class="far fa-clock"></i> <%= level.duration %></span>
                                    <span style="font-size:0.75rem; color:#7a6a8f; margin-left:8px;">
                                        <i class="fas fa-book"></i> 
                                        <% let lessonCount = 0; let classCount = 0; %>
                                        <% if (level.lessons) { %>
                                            <% level.lessons.forEach(function(l) { %>
                                                <% lessonCount++; %>
                                                <% if (l.classes) { classCount += l.classes.length; } %>
                                            <% }); %>
                                        <% } %>
                                        <%= lessonCount %> lessons • <%= classCount %> classes
                                    </span>
                                </div>
                                <div class="level-actions">
                                    <a href="/admin/levels/edit/<%= course.id %>/<%= level.id %>" class="btn btn-secondary btn-xs">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <form action="/admin/courses/<%= course.id %>/levels/delete/<%= level.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this level?');">
                                        <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="color:#7a6a8f; font-size:0.85rem; text-align:center; padding:12px 0;">
                        <i class="fas fa-info-circle"></i> No levels yet. Add your first level above!
                    </p>
                <% } %>
            </div>

        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>