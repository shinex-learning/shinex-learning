<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin – Edit Course</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('../partials/header', { user: null, showBack: true }) %>

    <main class="main-content">
        <div class="container" style="max-width: 900px;">

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 16px;">
                <h2 style="font-size: 1.3rem; font-weight: 800; color: #1A0A2E;">
                    <i class="fas fa-edit" style="color: #8B5CF6;"></i> Edit Course
                </h2>
                <a href="/admin/courses" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
            </div>

            <!-- Course details -->
            <div class="card" style="margin-bottom: 16px;">
                <form action="/admin/courses/edit/<%= course.id %>" method="POST" style="display: grid; grid-template-columns: 1fr; gap: 10px;">
                    <input type="text" name="title" class="form-control" value="<%= course.title %>" required>
                    <input type="text" name="description" class="form-control" value="<%= course.description %>" required>
                    <select name="level" class="form-control" required>
                        <option value="Beginner" <%= course.level==='Beginner' ? 'selected' : '' %>>Beginner</option>
                        <option value="Intermediate" <%= course.level==='Intermediate' ? 'selected' : '' %>>Intermediate</option>
                        <option value="Advanced" <%= course.level==='Advanced' ? 'selected' : '' %>>Advanced</option>
                    </select>
                    <input type="text" name="duration" class="form-control" value="<%= course.duration %>" required>
                    <button type="submit" class="btn btn-primary">Update Course</button>
                </form>
            </div>

            <!-- ======= ADD LESSON ======= -->
            <div class="card" style="margin-bottom: 16px; background: #f8f6fc; border: 2px solid #8B5CF6;">
                <h4 style="font-weight: 700; color: #1A0A2E; font-size: 1rem; margin-bottom: 10px;">
                    <i class="fas fa-plus-circle" style="color: #8B5CF6;"></i> Add New Lesson
                </h4>
                <form action="/admin/courses/<%= course.id %>/lessons/add" method="POST" style="display: grid; gap: 10px;">
                    <input type="text" name="title" class="form-control" placeholder="Lesson title" required>
                    <input type="text" name="description" class="form-control" placeholder="Lesson description (optional)">
                    <button type="submit" class="btn btn-success"><i class="fas fa-plus"></i> Add Lesson</button>
                </form>
            </div>

            <!-- ======= LIST LESSONS & CLASSES ======= -->
            <% if (course.lessons && course.lessons.length > 0) { %>
                <% course.lessons.forEach(function(lesson, lIdx) { %>
                    <div class="card" style="margin-bottom: 16px; border-left: 4px solid #8B5CF6;">
                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                            <h4 style="margin:0; font-size: 1.05rem;"><%= (lIdx+1) %>. <%= lesson.title %></h4>
                            <form action="/admin/courses/<%= course.id %>/lessons/delete/<%= lesson.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this lesson?');">
                                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                        <% if (lesson.description) { %>
                            <p style="color: #7a6a8f; font-size: 0.85rem;"><%= lesson.description %></p>
                        <% } %>

                        <!-- Add Class form -->
                        <div style="background: #f0ebfb; padding: 12px; border-radius: 8px; margin: 12px 0;">
                            <h5 style="font-size: 0.95rem; margin-bottom: 8px;">
                                <i class="fas fa-plus-circle" style="color: #8B5CF6;"></i> Add Class to this Lesson
                            </h5>
                            <form action="/admin/courses/<%= course.id %>/lessons/<%= lesson.id %>/classes/add" method="POST" style="display: grid; gap: 8px;">
                                <input type="text" name="title" class="form-control" placeholder="Class title (e.g., What is Cybersecurity)" required>
                                <textarea name="content" class="form-control" rows="6" placeholder="Write class content here. Use HTML tags for formatting." required></textarea>
                                <div style="display: grid; grid-template-columns: 1fr; gap: 8px;">
                                    <input type="url" name="imageUrl" class="form-control" placeholder="Image URL (optional)">
                                    <input type="url" name="videoUrl" class="form-control" placeholder="YouTube URL (optional)">
                                    <input type="url" name="externalLink" class="form-control" placeholder="External link (optional)">
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Add Class</button>
                            </form>
                        </div>

                        <!-- List classes -->
                        <% if (lesson.classes && lesson.classes.length > 0) { %>
                            <ul style="list-style: none; padding-left: 0;">
                                <% lesson.classes.forEach(function(cls, cIdx) { %>
                                    <li style="background: #f9fafb; padding: 10px; border-radius: 8px; margin-bottom: 8px; border: 1px solid #ede8f5;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px;">
                                            <strong style="font-size: 0.95rem;"><%= (lIdx+1) %>.<%= (cIdx+1) %> <%= cls.title %></strong>
                                            <form action="/admin/courses/<%= course.id %>/lessons/<%= lesson.id %>/classes/delete/<%= cls.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this class?');">
                                                <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </div>
                                        <!-- Edit class inline -->
                                        <form action="/admin/courses/<%= course.id %>/lessons/<%= lesson.id %>/classes/edit/<%= cls.id %>" method="POST" style="margin-top: 8px; display: grid; gap: 6px;">
                                            <input type="text" name="title" class="form-control" value="<%= cls.title %>" required>
                                            <textarea name="content" class="form-control" rows="4"><%= cls.content %></textarea>
                                            <div style="display: grid; grid-template-columns: 1fr; gap: 6px;">
                                                <input type="url" name="imageUrl" class="form-control" value="<%= cls.imageUrl || '' %>" placeholder="Image URL">
                                                <input type="url" name="videoUrl" class="form-control" value="<%= cls.videoUrl || '' %>" placeholder="YouTube URL">
                                                <input type="url" name="externalLink" class="form-control" value="<%= cls.externalLink || '' %>" placeholder="External link">
                                            </div>
                                            <button type="submit" class="btn btn-secondary btn-sm"><i class="fas fa-save"></i> Update Class</button>
                                        </form>
                                        <!-- Preview content -->
                                        <div style="margin-top: 6px; font-size: 0.85rem; color:#4a3a60; border-left: 3px solid #8B5CF6; padding-left: 10px;">
                                            <%- cls.content || 'No content' %>
                                        </div>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } else { %>
                            <p style="color: #7a6a8f; font-style:italic; font-size: 0.85rem;">No classes yet in this lesson.</p>
                        <% } %>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="color: #7a6a8f;">No lessons yet. Add one above.</p>
            <% } %>

        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>