<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Course – SHINEX Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-layout {
            display: flex;
            gap: 24px;
            max-width: 1400px;
            margin: 0 auto;
        }
        .admin-sidebar {
            width: 240px;
            min-width: 200px;
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            transition: all 0.3s ease;
        }
        body.dark-mode .admin-sidebar {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .admin-sidebar .sidebar-title {
            border-color: var(--dark-border);
        }
        .admin-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        .admin-nav li {
            margin: 0;
        }
        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .admin-nav a:hover {
            background: var(--primary-bg);
            color: var(--primary);
        }
        .admin-nav a.active {
            background: var(--primary-bg);
            color: var(--primary);
            border-left-color: var(--primary);
        }
        body.dark-mode .admin-nav a:hover {
            background: #2a1a4a;
        }
        body.dark-mode .admin-nav a.active {
            background: #2a1a4a;
        }
        .admin-content {
            flex: 1;
            min-width: 0;
        }
        .admin-card {
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 20px 24px;
            margin-bottom: 16px;
        }
        body.dark-mode .admin-card {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 8px;
        }
        .level-item {
            background: var(--primary-bg);
            border-radius: 10px;
            padding: 16px 20px;
            margin-bottom: 12px;
            border: 1px solid #ede8f5;
        }
        body.dark-mode .level-item {
            background: #1a1a1a;
            border-color: var(--dark-border);
        }
        .level-item .level-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }
        .level-item .level-header h5 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }
        .level-item .level-header .level-actions {
            display: flex;
            gap: 6px;
        }
        .level-item .level-detail {
            margin-top: 8px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .level-item .lesson-item {
            background: var(--bg-light);
            border-radius: 8px;
            padding: 10px 14px;
            margin: 6px 0;
            border: 1px solid #ede8f5;
        }
        body.dark-mode .level-item .lesson-item {
            background: #1a1a1a;
            border-color: var(--dark-border);
        }
        .level-item .lesson-item .lesson-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
        }
        .level-item .lesson-item .lesson-header h6 {
            font-size: 0.9rem;
            font-weight: 600;
            margin: 0;
        }
        .level-item .class-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 8px 4px 20px;
            border-bottom: 1px solid #ede8f5;
            font-size: 0.85rem;
        }
        body.dark-mode .level-item .class-item {
            border-color: var(--dark-border);
        }
        .level-item .class-item:last-child {
            border-bottom: none;
        }
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.open {
            display: flex;
        }
        .modal-box {
            background: var(--bg-light);
            border-radius: var(--radius);
            padding: 32px 28px;
            max-width: 550px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        body.dark-mode .modal-box {
            background: var(--dark-card);
        }
        .modal-box h3 {
            font-size: 1.2rem;
            font-weight: 700;
            margin: 0 0 16px;
        }
        .modal-close {
            float: right;
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
        }
        .modal-close:hover {
            color: var(--text-dark);
        }
        body.dark-mode .modal-close:hover {
            color: var(--text-light);
        }
        @media (max-width: 768px) {
            .admin-layout {
                flex-direction: column;
            }
            .admin-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <div class="admin-layout">
                <!-- ===== Admin Sidebar ===== -->
                <aside class="admin-sidebar">
                    <div class="sidebar-title"><i class="fas fa-crown"></i> Admin Panel</div>
                    <ul class="admin-nav">
                        <li><a href="/admin/dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="/admin/students"><i class="fas fa-users"></i> Students</a></li>
                        <li><a href="/admin/courses" class="active"><i class="fas fa-book"></i> Courses</a></li>
                        <li><a href="/admin/services"><i class="fas fa-concierge-bell"></i> Services</a></li>
                        <li><a href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                        <li><a href="/admin/manage-admins"><i class="fas fa-user-shield"></i> Admins</a></li>
                        <li><a href="/admin/logout" style="color:#e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </aside>

                <!-- ===== Admin Content ===== -->
                <div class="admin-content">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:16px;">
                        <div>
                            <h2 style="font-size:1.5rem; font-weight:700; margin:0 0 2px;">✏️ Edit Course: <%= course.title %></h2>
                            <p style="color:var(--text-muted); margin:0;">Manage levels, lessons, and classes.</p>
                        </div>
                        <a href="/admin/courses" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to Courses
                        </a>
                    </div>

                    <!-- Course Details -->
                    <div class="admin-card">
                        <h4><i class="fas fa-info-circle"></i> Course Information</h4>
                        <form action="/admin/courses/edit/<%= course.id %>" method="POST">
                            <div class="grid-2" style="gap:12px;">
                                <div class="settings-group">
                                    <label for="title">Title</label>
                                    <input type="text" id="title" name="title" value="<%= course.title %>">
                                </div>
                                <div class="settings-group">
                                    <label for="duration">Duration</label>
                                    <input type="text" id="duration" name="duration" value="<%= course.duration || '' %>">
                                </div>
                                <div class="settings-group" style="grid-column:1/-1;">
                                    <label for="description">Description</label>
                                    <textarea id="description" name="description" rows="2"><%= course.description || '' %></textarea>
                                </div>
                                <div class="settings-group">
                                    <label for="level">Level</label>
                                    <select id="level" name="level">
                                        <option value="Beginner" <%= course.level === 'Beginner' ? 'selected' : '' %>>Beginner</option>
                                        <option value="Intermediate" <%= course.level === 'Intermediate' ? 'selected' : '' %>>Intermediate</option>
                                        <option value="Advanced" <%= course.level === 'Advanced' ? 'selected' : '' %>>Advanced</option>
                                    </select>
                                </div>
                                <div class="settings-group">
                                    <label for="review">Review</label>
                                    <textarea id="review" name="review" rows="2"><%= course.review || '' %></textarea>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Update Course
                            </button>
                        </form>
                    </div>

                    <!-- Levels -->
                    <div class="admin-card">
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:12px;">
                            <h4 style="margin:0;"><i class="fas fa-layer-group"></i> Levels</h4>
                            <button class="btn btn-primary btn-sm" onclick="openAddLevel()">
                                <i class="fas fa-plus"></i> Add Level
                            </button>
                        </div>

                        <% if (course.levels && course.levels.length > 0) { %>
                            <% course.levels.forEach((level, li) => { %>
                                <div class="level-item">
                                    <div class="level-header">
                                        <h5>Level <%= li+1 %>: <%= level.name %></h5>
                                        <div class="level-actions">
                                            <a href="/admin/levels/edit/<%= course.id %>/<%= level.id %>" class="btn btn-primary btn-sm" style="padding:2px 10px; font-size:0.7rem;">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form action="/admin/courses/<%= course.id %>/levels/delete/<%= level.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this level?');">
                                                <button type="submit" class="btn btn-danger btn-sm" style="padding:2px 10px; font-size:0.7rem;">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="level-detail">
                                        <span><i class="far fa-clock"></i> <%= level.duration || 'Flexible' %></span>
                                        <span style="margin-left:12px;">
                                            <i class="fas fa-book-open"></i> 
                                            <%= level.lessons ? level.lessons.reduce((acc, l) => acc + (l.classes ? l.classes.length : 0), 0) : 0 %> classes
                                        </span>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p style="color:var(--text-muted); text-align:center; padding:20px;">
                                No levels yet. Click "Add Level" to get started.
                            </p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- ===== ADD LEVEL MODAL ===== -->
    <div class="modal-overlay" id="addLevelModal">
        <div class="modal-box">
            <button class="modal-close" onclick="closeModal('addLevelModal')">&times;</button>
            <h3><i class="fas fa-plus-circle" style="color:var(--primary);"></i> Add New Level</h3>
            <form action="/admin/courses/<%= course.id %>/levels/add" method="POST">
                <div class="settings-group">
                    <label for="levelName">Level Name <span style="color:red;">*</span></label>
                    <input type="text" id="levelName" name="name" placeholder="e.g. Introduction to Cybersecurity" required>
                </div>
                <div class="settings-group">
                    <label for="levelDuration">Duration <span style="color:red;">*</span></label>
                    <input type="text" id="levelDuration" name="duration" placeholder="e.g. 2 weeks" required>
                </div>
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-save"></i> Add Level
                </button>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        function openAddLevel() {
            document.getElementById('addLevelModal').classList.add('open');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('open');
        }

        document.querySelectorAll('.modal-overlay').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('open');
                }
            });
        });
    </script>

    <script src="/js/main.js"></script>
</body>
</html>