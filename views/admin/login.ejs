<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            background: var(--bg-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        .admin-login-container {
            max-width: 420px;
            width: 100%;
            padding: 20px;
        }
        .admin-login-box {
            background: var(--bg-light);
            border-radius: 16px;
            padding: 40px 32px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        body.dark-mode .admin-login-box {
            background: var(--dark-card);
        }
        .admin-logo {
            text-align: center;
            margin-bottom: 24px;
        }
        .admin-logo .logo {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 20px;
            letter-spacing: 1px;
        }
        .admin-logo h2 {
            margin: 8px 0 0;
            font-weight: 700;
            font-size: 1.4rem;
        }
        .admin-logo p {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin: 2px 0 0;
        }
    </style>
</head>
<body>
    <div class="admin-login-container">
        <div class="admin-login-box">
            <div class="admin-logo">
                <div class="logo">SLC</div>
                <h2>Admin Panel</h2>
                <p>SHINEX Learning Circle</p>
            </div>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <form action="/shinex-admin" method="POST">
                <div class="settings-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="admin@shinex.ng" required>
                </div>
                <div class="settings-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" placeholder="Enter your password" required>
                </div>
                <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:8px;">
                    <i class="fas fa-shield-alt"></i> Login as Admin
                </button>
            </form>

            <div style="text-align:center; margin-top:16px; font-size:0.85rem; color:var(--text-muted);">
                <a href="/" style="color:var(--primary); font-weight:600;">
                    <i class="fas fa-arrow-left"></i> Back to Website
                </a>
            </div>
        </div>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>