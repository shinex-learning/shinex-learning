<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-login-container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: #f8f6fc;
        }
        .admin-login-card {
            background: #fff;
            border-radius: 16px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }
        .admin-login-card h1 {
            font-size: 28px;
            color: #1A0A2E;
            margin-bottom: 8px;
        }
        .admin-login-card p {
            color: #5a4a70;
            margin-bottom: 24px;
        }
        .admin-login-card .form-group {
            margin-bottom: 16px;
        }
        .admin-login-card label {
            display: block;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 4px;
            color: #1A0A2E;
        }
        .admin-login-card .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e8e3f0;
            border-radius: 8px;
            font-size: 14px;
            transition: border-color 0.2s;
        }
        .admin-login-card .form-control:focus {
            outline: none;
            border-color: #8B5CF6;
        }
        .admin-login-card .btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #8B5CF6, #6a3dcf);
            color: #fff;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        .admin-login-card .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
        }
        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-weight: 500;
        }
        .alert-error {
            background: #fde8e8;
            color: #e74c3c;
            border-left: 4px solid #e74c3c;
        }
        .alert-success {
            background: #e8f5e9;
            color: #27ae60;
            border-left: 4px solid #27ae60;
        }
        .admin-logo {
            text-align: center;
            margin-bottom: 24px;
        }
        .admin-logo h1 {
            font-size: 32px;
            font-weight: 800;
            color: #8B5CF6;
        }
        .admin-logo span {
            font-size: 14px;
            color: #5a4a70;
        }
    </style>
</head>
<body>
    <div class="admin-login-container">
        <div class="admin-login-card">
            <div class="admin-logo">
                <h1>SHINEX</h1>
                <span>Admin Panel</span>
            </div>

            <% if (messages && messages.error) { %>
                <div class="alert alert-error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>

            <form action="/shinex-admin" method="POST">
                <div class="form-group">
                    <label for="email">Admin Email</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="admin@shinex.com" required>
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
                </div>
                <button type="submit" class="btn">Login to Admin</button>
            </form>
        </div>
    </div>
</body>
</html>