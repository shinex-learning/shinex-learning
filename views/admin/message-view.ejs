<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Message – SHINEX Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-layout {
            display: flex;
            gap: 24px;
            max-width: 1400px;
            margin: 0 auto;
        }
        .admin-sidebar {
            width: 240px;
            min-width: 200px;
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            transition: all 0.3s ease;
        }
        body.dark-mode .admin-sidebar {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .admin-sidebar .sidebar-title {
            border-color: var(--dark-border);
        }
        .admin-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        .admin-nav li {
            margin: 0;
        }
        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .admin-nav a:hover {
            background: var(--primary-bg);
            color: var(--primary);
        }
        .admin-nav a.active {
            background: var(--primary-bg);
            color: var(--primary);
            border-left-color: var(--primary);
        }
        body.dark-mode .admin-nav a:hover {
            background: #2a1a4a;
        }
        body.dark-mode .admin-nav a.active {
            background: #2a1a4a;
        }
        .admin-content {
            flex: 1;
            min-width: 0;
        }
        .admin-card {
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 20px 24px;
            margin-bottom: 16px;
        }
        body.dark-mode .admin-card {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 8px;
        }
        .message-detail {
            padding: 12px 0;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .message-detail {
            border-color: var(--dark-border);
        }
        .message-detail:last-child {
            border-bottom: none;
        }
        .message-detail .label {
            font-weight: 600;
            font-size: 0.8rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .message-detail .value {
            font-size: 1rem;
            margin-top: 2px;
        }
        .message-detail .value.message-body {
            background: var(--primary-bg);
            padding: 12px 16px;
            border-radius: 8px;
            white-space: pre-wrap;
            line-height: 1.8;
        }
        body.dark-mode .message-detail .value.message-body {
            background: #1a1a1a;
        }
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 16px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .status-badge.unread {
            background: #fadbd8;
            color: #922b21;
        }
        .status-badge.read {
            background: #d6eaf8;
            color: #1a5276;
        }
        .status-badge.replied {
            background: #d5f5e3;
            color: #1a7a4a;
        }
        body.dark-mode .status-badge.unread {
            background: #3a1a1a;
            color: #f1948a;
        }
        body.dark-mode .status-badge.read {
            background: #1a2a3a;
            color: #85c1e9;
        }
        body.dark-mode .status-badge.replied {
            background: #1a3a2a;
            color: #7dcea0;
        }
        .reply-box {
            background: var(--primary-bg);
            padding: 16px 20px;
            border-radius: 10px;
            margin-top: 12px;
        }
        body.dark-mode .reply-box {
            background: #1a1a1a;
        }
        .reply-box textarea {
            min-height: 100px;
        }
        @media (max-width: 768px) {
            .admin-layout {
                flex-direction: column;
            }
            .admin-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <div class="admin-layout">
                <!-- ===== Admin Sidebar ===== -->
                <aside class="admin-sidebar">
                    <div class="sidebar-title"><i class="fas fa-crown"></i> Admin Panel</div>
                    <ul class="admin-nav">
                        <li><a href="/admin/dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="/admin/students"><i class="fas fa-users"></i> Students</a></li>
                        <li><a href="/admin/courses"><i class="fas fa-book"></i> Courses</a></li>
                        <li><a href="/admin/services"><i class="fas fa-concierge-bell"></i> Services</a></li>
                        <li><a href="/admin/messages" class="active"><i class="fas fa-envelope"></i> Messages</a></li>
                        <li><a href="/admin/manage-admins"><i class="fas fa-user-shield"></i> Admins</a></li>
                        <li><a href="/admin/logout" style="color:#e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </aside>

                <!-- ===== Admin Content ===== -->
                <div class="admin-content">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:16px;">
                        <div>
                            <h2 style="font-size:1.5rem; font-weight:700; margin:0 0 2px;">📩 Message Details</h2>
                            <p style="color:var(--text-muted); margin:0;">View and reply to this message.</p>
                        </div>
                        <a href="/admin/messages" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to Messages
                        </a>
                    </div>

                    <!-- Message Details -->
                    <div class="admin-card">
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:12px;">
                            <span class="status-badge <%= message.status %>">
                                <% if (message.status === 'unread') { %>
                                    <i class="fas fa-circle" style="color:#e74c3c; font-size:0.5rem;"></i> Unread
                                <% } else if (message.status === 'read') { %>
                                    <i class="fas fa-check-circle" style="color:#3498db; font-size:0.5rem;"></i> Read
                                <% } else { %>
                                    <i class="fas fa-check-double" style="color:#27ae60; font-size:0.5rem;"></i> Replied
                                <% } %>
                            </span>
                            <span style="font-size:0.8rem; color:var(--text-muted);">
                                Received: <%= new Date(message.createdAt).toLocaleString() %>
                            </span>
                        </div>

                        <div class="message-detail">
                            <div class="label">From</div>
                            <div class="value"><strong><%= message.name || 'Anonymous' %></strong></div>
                        </div>

                        <div class="message-detail">
                            <div class="label">Email</div>
                            <div class="value"><%= message.email || 'N/A' %></div>
                        </div>

                        <div class="message-detail">
                            <div class="label">Subject</div>
                            <div class="value"><%= message.subject || 'No subject' %></div>
                        </div>

                        <div class="message-detail">
                            <div class="label">Message</div>
                            <div class="value message-body"><%= message.message || 'No message content.' %></div>
                        </div>

                        <% if (message.adminReply) { %>
                            <div class="message-detail" style="background:#e8f5e9; padding:12px 16px; border-radius:8px; margin-top:8px; border-left:4px solid #4CAF50;">
                                <div class="label" style="color:#2E7D32;">Admin Reply</div>
                                <div class="value" style="color:#1B5E20;"><%= message.adminReply %></div>
                                <div style="font-size:0.8rem; color:var(--text-muted); margin-top:4px;">
                                    Replied on: <%= new Date(message.repliedAt).toLocaleString() %>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Reply Form -->
                    <div class="admin-card" id="reply">
                        <h4><i class="fas fa-reply"></i> Reply to <%= message.name %></h4>
                        <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">
                            Your reply will be sent directly to the user's email address.
                        </p>

                        <form action="/admin/messages/reply/<%= message.id %>" method="POST">
                            <div class="settings-group">
                                <label for="reply">Your Reply <span style="color:red;">*</span></label>
                                <textarea id="reply" name="reply" rows="5" placeholder="Type your reply here..." required></textarea>
                                <p class="help-text">The user will receive this reply via email.</p>
                            </div>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-paper-plane"></i> Send Reply
                            </button>
                            <a href="/admin/messages" class="btn btn-secondary" style="margin-left:8px;">
                                Cancel
                            </a>
                        </form>
                    </div>

                    <!-- Delete Button -->
                    <div style="text-align:right;">
                        <form action="/admin/messages/delete/<%= message.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this message?');">
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash-alt"></i> Delete Message
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>