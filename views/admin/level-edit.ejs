<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Level - SHINEX Admin</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-container { display: flex; min-height: 100vh; background: #f8f6fc; }
        .admin-sidebar { width: 250px; background: #1A0A2E; color: #fff; padding: 24px 0; position: fixed; height: 100vh; overflow-y: auto; }
        .admin-sidebar .logo { padding: 0 24px 24px; font-size: 24px; font-weight: 800; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .admin-sidebar .logo span { color: #8B5CF6; }
        .admin-sidebar .nav a { display: flex; align-items: center; gap: 12px; padding: 12px 24px; color: rgba(255,255,255,0.7); text-decoration: none; transition: all 0.2s; font-size: 14px; }
        .admin-sidebar .nav a:hover, .admin-sidebar .nav a.active { background: rgba(139,92,246,0.2); color: #fff; border-left: 3px solid #8B5CF6; }
        .admin-main { margin-left: 250px; flex: 1; padding: 24px; }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; background: #fff; padding: 16px 24px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        .admin-header h1 { font-size: 24px; }
        .admin-section { background: #fff; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); margin-bottom: 24px; }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 4px; }
        .form-control { width: 100%; padding: 10px 14px; border: 2px solid #e8e3f0; border-radius: 8px; font-size: 14px; transition: border-color 0.2s; }
        .form-control:focus { outline: none; border-color: #8B5CF6; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .btn { padding: 10px 24px; background: linear-gradient(135deg, #8B5CF6, #6a3dcf); color: #fff; border: none; border-radius: 30px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
        .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(139,92,246,0.3); }
        .btn-danger { background: #e74c3c; }
        .btn-danger:hover { background: #c0392b; }
        .btn-sm { padding: 4px 12px; font-size: 12px; border-radius: 6px; border: none; cursor: pointer; text-decoration: none; display: inline-block; }
        .btn-primary-sm { background: #8B5CF6; color: #fff; }
        .btn-danger-sm { background: #e74c3c; color: #fff; }
        .btn-success-sm { background: #27ae60; color: #fff; }
        .lesson-card { background: #f8f6fc; border-radius: 8px; padding: 16px; margin-bottom: 12px; }
        .lesson-card h3 { font-size: 16px; margin-bottom: 4px; }
        .lesson-card p { font-size: 13px; color: #5a4a70; margin: 0 0 8px 0; }
        .class-item { background: #fff; padding: 10px 14px; border-radius: 6px; margin: 6px 0; display: flex; justify-content: space-between; align-items: center; border-left: 3px solid #8B5CF6; }
        .class-item .class-title { font-weight: 500; }
        .class-item .class-actions { display: flex; gap: 6px; }
        .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; }
        .alert-success { background: #e8f5e9; color: #27ae60; border-left: 4px solid #27ae60; }
        .alert-error { background: #fde8e8; color: #e74c3c; border-left: 4px solid #e74c3c; }
        @media (max-width: 768px) { .admin-sidebar { display: none; } .admin-main { margin-left: 0; } .form-row { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="admin-container">
        <aside class="admin-sidebar">
            <div class="logo">SHINEX<span>.</span></div>
            <nav class="nav">
                <a href="/admin/dashboard">📊 Dashboard</a>
                <a href="/admin/students">👤 Students</a>
                <a href="/admin/courses" class="active">📚 Courses</a>
                <a href="/admin/services">💼 Services</a>
                <a href="/admin/messages">✉️ Messages</a>
                <a href="/admin/manage-admins">🔐 Manage Admins</a>
                <a href="/admin/logout" style="color: #e74c3c; margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 16px;">🚪 Logout</a>
            </nav>
        </aside>

        <main class="admin-main">
            <div class="admin-header">
                <h1>Level: <%= level.name %></h1>
                <a href="/admin/courses/edit/<%= course.id %>" class="btn-sm btn-primary-sm">← Back to Course</a>
            </div>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-error"><%= messages.error %></div>
            <% } %>

            <!-- Add Lesson -->
            <div class="admin-section">
                <h2>Add New Lesson</h2>
                <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/add" method="POST">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="lessonTitle">Lesson Title</label>
                            <input type="text" id="lessonTitle" name="title" class="form-control" placeholder="e.g. Introduction to HTML" required>
                        </div>
                        <div class="form-group">
                            <label for="lessonDescription">Description (optional)</label>
                            <input type="text" id="lessonDescription" name="description" class="form-control" placeholder="Brief description">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm" style="padding: 8px 20px;">Add Lesson</button>
                </form>
            </div>

            <!-- Lessons & Classes -->
            <div class="admin-section">
                <h2>Lessons & Classes</h2>
                <% if (level.lessons && level.lessons.length > 0) { %>
                    <% level.lessons.forEach(lesson => { %>
                        <div class="lesson-card">
                            <h3><%= lesson.title %></h3>
                            <p><%= lesson.description || 'No description' %></p>
                            
                            <!-- Add Class Form -->
                            <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/<%= lesson.id %>/classes/add" method="POST" enctype="multipart/form-data" style="margin: 12px 0;">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="classTitle_<%= lesson.id %>">Class Title</label>
                                        <input type="text" id="classTitle_<%= lesson.id %>" name="title" class="form-control" placeholder="e.g. What is HTML?" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="classImage_<%= lesson.id %>">Image (optional)</label>
                                        <input type="file" id="classImage_<%= lesson.id %>" name="classImage" class="form-control" accept="image/*">
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="classVideo_<%= lesson.id %>">Video URL (optional)</label>
                                        <input type="text" id="classVideo_<%= lesson.id %>" name="videoUrl" class="form-control" placeholder="https://youtube.com/watch?v=...">
                                    </div>
                                    <div class="form-group">
                                        <label for="classLink_<%= lesson.id %>">External Link (optional)</label>
                                        <input type="text" id="classLink_<%= lesson.id %>" name="externalLink" class="form-control" placeholder="https://example.com">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="classContent_<%= lesson.id %>">Content</label>
                                    <textarea id="classContent_<%= lesson.id %>" name="content" class="form-control" rows="3" placeholder="Class content..." required></textarea>
                                </div>
                                <button type="submit" class="btn-sm btn-success-sm">Add Class</button>
                            </form>

                            <!-- Existing Classes -->
                            <% if (lesson.classes && lesson.classes.length > 0) { %>
                                <div style="margin-top: 12px;">
                                    <strong>Classes:</strong>
                                    <% lesson.classes.forEach(cls => { %>
                                        <div class="class-item">
                                            <span class="class-title"><%= cls.title %></span>
                                            <div class="class-actions">
                                                <a href="#" class="btn-sm btn-primary-sm" onclick="alert('Edit class: <%= cls.id %>')">Edit</a>
                                                <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/<%= lesson.id %>/classes/delete/<%= cls.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Delete this class?')">
                                                    <button type="submit" class="btn-sm btn-danger-sm">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>

                            <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/delete/<%= lesson.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Delete this lesson?')">
                                <button type="submit" class="btn-sm btn-danger-sm" style="margin-top: 8px;">Delete Lesson</button>
                            </form>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: #5a4a70;">No lessons added yet.</p>
                <% } %>
            </div>
        </main>
    </div>
</body>
</html>