<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Level – SHINEX Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-layout {
            display: flex;
            gap: 24px;
            max-width: 1400px;
            margin: 0 auto;
        }
        .admin-sidebar {
            width: 240px;
            min-width: 200px;
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            transition: all 0.3s ease;
        }
        body.dark-mode .admin-sidebar {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .admin-sidebar .sidebar-title {
            border-color: var(--dark-border);
        }
        .admin-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        .admin-nav li {
            margin: 0;
        }
        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .admin-nav a:hover {
            background: var(--primary-bg);
            color: var(--primary);
        }
        .admin-nav a.active {
            background: var(--primary-bg);
            color: var(--primary);
            border-left-color: var(--primary);
        }
        body.dark-mode .admin-nav a:hover {
            background: #2a1a4a;
        }
        body.dark-mode .admin-nav a.active {
            background: #2a1a4a;
        }
        .admin-content {
            flex: 1;
            min-width: 0;
        }
        .admin-card {
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 20px 24px;
            margin-bottom: 16px;
        }
        body.dark-mode .admin-card {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 8px;
        }
        .lesson-item {
            background: var(--primary-bg);
            border-radius: 10px;
            padding: 16px 20px;
            margin-bottom: 12px;
            border: 1px solid #ede8f5;
        }
        body.dark-mode .lesson-item {
            background: #1a1a1a;
            border-color: var(--dark-border);
        }
        .lesson-item .lesson-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }
        .lesson-item .lesson-header h5 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }
        .lesson-item .lesson-header .lesson-actions {
            display: flex;
            gap: 6px;
        }
        .class-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 8px 6px 16px;
            border-bottom: 1px solid #ede8f5;
            font-size: 0.85rem;
        }
        body.dark-mode .class-item {
            border-color: var(--dark-border);
        }
        .class-item:last-child {
            border-bottom: none;
        }
        .class-item .class-info {
            flex: 1;
        }
        .class-item .class-actions {
            display: flex;
            gap: 4px;
        }
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.open {
            display: flex;
        }
        .modal-box {
            background: var(--bg-light);
            border-radius: var(--radius);
            padding: 32px 28px;
            max-width: 600px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        body.dark-mode .modal-box {
            background: var(--dark-card);
        }
        .modal-box h3 {
            font-size: 1.2rem;
            font-weight: 700;
            margin: 0 0 16px;
        }
        .modal-close {
            float: right;
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
        }
        .modal-close:hover {
            color: var(--text-dark);
        }
        body.dark-mode .modal-close:hover {
            color: var(--text-light);
        }
        .test-question-item {
            background: #fef9e7;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 8px;
            border-left: 4px solid #f39c12;
        }
        body.dark-mode .test-question-item {
            background: #2a2a1a;
        }
        .test-question-item .q-text {
            font-weight: 600;
        }
        .test-question-item .q-options {
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        @media (max-width: 768px) {
            .admin-layout {
                flex-direction: column;
            }
            .admin-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <div class="admin-layout">
                <!-- ===== Admin Sidebar ===== -->
                <aside class="admin-sidebar">
                    <div class="sidebar-title"><i class="fas fa-crown"></i> Admin Panel</div>
                    <ul class="admin-nav">
                        <li><a href="/admin/dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="/admin/students"><i class="fas fa-users"></i> Students</a></li>
                        <li><a href="/admin/courses" class="active"><i class="fas fa-book"></i> Courses</a></li>
                        <li><a href="/admin/services"><i class="fas fa-concierge-bell"></i> Services</a></li>
                        <li><a href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                        <li><a href="/admin/manage-admins"><i class="fas fa-user-shield"></i> Admins</a></li>
                        <li><a href="/admin/logout" style="color:#e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </aside>

                <!-- ===== Admin Content ===== -->
                <div class="admin-content">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:16px;">
                        <div>
                            <h2 style="font-size:1.5rem; font-weight:700; margin:0 0 2px;">✏️ Edit Level: <%= level.name %></h2>
                            <p style="color:var(--text-muted); margin:0;">
                                Course: <strong><%= course.title %></strong> 
                                | Manage lessons, classes, and test questions.
                            </p>
                        </div>
                        <a href="/admin/courses/edit/<%= course.id %>" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to Course
                        </a>
                    </div>

                    <!-- ===== LESSONS ===== -->
                    <div class="admin-card">
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:12px;">
                            <h4 style="margin:0;"><i class="fas fa-book-open"></i> Lessons & Classes</h4>
                            <button class="btn btn-primary btn-sm" onclick="openModal('addLessonModal')">
                                <i class="fas fa-plus"></i> Add Lesson
                            </button>
                        </div>

                        <% if (level.lessons && level.lessons.length > 0) { %>
                            <% level.lessons.forEach((lesson, li) => { %>
                                <div class="lesson-item">
                                    <div class="lesson-header">
                                        <h5>Lesson <%= li+1 %>: <%= lesson.title %></h5>
                                        <div class="lesson-actions">
                                            <button class="btn btn-primary btn-sm" onclick="openAddClass('<%= course.id %>','<%= level.id %>','<%= lesson.id %>')" style="padding:2px 10px; font-size:0.7rem;">
                                                <i class="fas fa-plus"></i> Class
                                            </button>
                                            <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/delete/<%= lesson.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this lesson?');">
                                                <button type="submit" class="btn btn-danger btn-sm" style="padding:2px 10px; font-size:0.7rem;">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <% if (lesson.description) { %>
                                        <p style="font-size:0.85rem; color:var(--text-muted); margin:4px 0 8px;"><%= lesson.description %></p>
                                    <% } %>
                                    <div>
                                        <% if (lesson.classes && lesson.classes.length > 0) { %>
                                            <% lesson.classes.forEach(cls => { %>
                                                <div class="class-item">
                                                    <div class="class-info">
                                                        <span><%= cls.title %></span>
                                                        <% if (cls.imageUrl) { %>
                                                            <span class="badge badge-purple" style="font-size:0.6rem;"><i class="fas fa-image"></i></span>
                                                        <% } %>
                                                        <% if (cls.videoUrl) { %>
                                                            <span class="badge badge-dark" style="font-size:0.6rem;"><i class="fas fa-video"></i></span>
                                                        <% } %>
                                                        <% if (cls.externalLink) { %>
                                                            <span class="badge badge-gold" style="font-size:0.6rem;"><i class="fas fa-link"></i></span>
                                                        <% } %>
                                                    </div>
                                                    <div class="class-actions">
                                                        <button class="btn btn-primary btn-sm" onclick="openEditClass('<%= course.id %>','<%= level.id %>','<%= lesson.id %>','<%= cls.id %>','<%= cls.title %>','<%= cls.content %>','<%= cls.imageUrl || '' %>','<%= cls.videoUrl || '' %>','<%= cls.externalLink || '' %>')" style="padding:2px 8px; font-size:0.65rem;">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                        <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/<%= lesson.id %>/classes/delete/<%= cls.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this class?');">
                                                            <button type="submit" class="btn btn-danger btn-sm" style="padding:2px 8px; font-size:0.65rem;">
                                                                <i class="fas fa-trash-alt"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <p style="font-size:0.8rem; color:var(--text-muted); padding:8px 0;">No classes yet.</p>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p style="color:var(--text-muted); text-align:center; padding:20px;">
                                No lessons yet. Click "Add Lesson" to get started.
                            </p>
                        <% } %>
                    </div>

                    <!-- ===== LEVEL TEST ===== -->
                    <div class="admin-card">
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:12px;">
                            <h4 style="margin:0;"><i class="fas fa-pencil-alt"></i> Level Test</h4>
                            <button class="btn btn-gold btn-sm" onclick="openModal('addTestModal')">
                                <i class="fas fa-plus"></i> Add Question
                            </button>
                        </div>

                        <% if (level.test && level.test.questions && level.test.questions.length > 0) { %>
                            <% level.test.questions.forEach((q, qi) => { %>
                                <div class="test-question-item">
                                    <div style="display:flex; justify-content:space-between; align-items:start; flex-wrap:wrap;">
                                        <div>
                                            <div class="q-text"><%= qi+1 %>. <%= q.question %></div>
                                            <div class="q-options">
                                                <% q.options.forEach((opt, oi) => { %>
                                                    <span style="<%= oi === q.correct ? 'color:#27ae60; font-weight:700;' : '' %>">
                                                        <%= String.fromCharCode(65 + oi) %>. <%= opt %>
                                                        <%= oi === q.correct ? ' ✅' : '' %>
                                                    </span>
                                                    <% if (oi < q.options.length - 1) { %> | <% } %>
                                                <% }) %>
                                            </div>
                                        </div>
                                        <form action="/admin/levels/<%= course.id %>/<%= level.id %>/test/delete/<%= q.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this test question?');">
                                            <button type="submit" class="btn btn-danger btn-sm" style="padding:2px 10px; font-size:0.7rem;">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p style="color:var(--text-muted); text-align:center; padding:12px;">
                                No test questions yet. Add questions to test students.
                            </p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- ===== ADD LESSON MODAL ===== -->
    <div class="modal-overlay" id="addLessonModal">
        <div class="modal-box">
            <button class="modal-close" onclick="closeModal('addLessonModal')">&times;</button>
            <h3><i class="fas fa-plus-circle" style="color:var(--primary);"></i> Add New Lesson</h3>
            <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/add" method="POST">
                <div class="settings-group">
                    <label for="lessonTitle">Lesson Title <span style="color:red;">*</span></label>
                    <input type="text" id="lessonTitle" name="title" placeholder="e.g. Introduction to Networking" required>
                </div>
                <div class="settings-group">
                    <label for="lessonDescription">Description (optional)</label>
                    <textarea id="lessonDescription" name="description" rows="2" placeholder="Brief description of this lesson..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-save"></i> Add Lesson
                </button>
            </form>
        </div>
    </div>

    <!-- ===== ADD CLASS MODAL ===== -->
    <div class="modal-overlay" id="addClassModal">
        <div class="modal-box">
            <button class="modal-close" onclick="closeModal('addClassModal')">&times;</button>
            <h3><i class="fas fa-plus-circle" style="color:var(--primary);"></i> Add New Class</h3>
            <form id="addClassForm" action="" method="POST">
                <div class="settings-group">
                    <label for="classTitle">Class Title <span style="color:red;">*</span></label>
                    <input type="text" id="classTitle" name="title" placeholder="e.g. Understanding IP Addresses" required>
                </div>
                <div class="settings-group">
                    <label for="classContent">Content <span style="color:red;">*</span></label>
                    <textarea id="classContent" name="content" rows="5" placeholder="Write the class content here. Supports markdown-like formatting: ## headings, **bold**, *italic*, - lists, --- horizontal rules..." required></textarea>
                    <p class="help-text">Use ## for headings, **bold**, *italic*, - for bullet lists, --- for horizontal rules.</p>
                </div>
                <div class="settings-group">
                    <label for="imageUrl">Image URL (optional)</label>
                    <input type="text" id="imageUrl" name="imageUrl" placeholder="https://example.com/image.jpg">
                </div>
                <div class="settings-group">
                    <label for="videoUrl">Video URL (optional)</label>
                    <input type="text" id="videoUrl" name="videoUrl" placeholder="https://www.youtube.com/embed/VIDEO_ID">
                </div>
                <div class="settings-group">
                    <label for="externalLink">External Link (optional)</label>
                    <input type="text" id="externalLink" name="externalLink" placeholder="https://example.com/resource">
                </div>
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-save"></i> Add Class
                </button>
            </form>
        </div>
    </div>

    <!-- ===== EDIT CLASS MODAL ===== -->
    <div class="modal-overlay" id="editClassModal">
        <div class="modal-box">
            <button class="modal-close" onclick="closeModal('editClassModal')">&times;</button>
            <h3><i class="fas fa-edit" style="color:var(--primary);"></i> Edit Class</h3>
            <form id="editClassForm" action="" method="POST">
                <div class="settings-group">
                    <label for="editClassTitle">Class Title <span style="color:red;">*</span></label>
                    <input type="text" id="editClassTitle" name="title" required>
                </div>
                <div class="settings-group">
                    <label for="editClassContent">Content <span style="color:red;">*</span></label>
                    <textarea id="editClassContent" name="content" rows="5" required></textarea>
                </div>
                <div class="settings-group">
                    <label for="editImageUrl">Image URL (optional)</label>
                    <input type="text" id="editImageUrl" name="imageUrl">
                </div>
                <div class="settings-group">
                    <label for="editVideoUrl">Video URL (optional)</label>
                    <input type="text" id="editVideoUrl" name="videoUrl">
                </div>
                <div class="settings-group">
                    <label for="editExternalLink">External Link (optional)</label>
                    <input type="text" id="editExternalLink" name="externalLink">
                </div>
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-save"></i> Update Class
                </button>
            </form>
        </div>
    </div>

    <!-- ===== ADD TEST QUESTION MODAL ===== -->
    <div class="modal-overlay" id="addTestModal">
        <div class="modal-box">
            <button class="modal-close" onclick="closeModal('addTestModal')">&times;</button>
            <h3><i class="fas fa-plus-circle" style="color:#f39c12;"></i> Add Test Question</h3>
            <form action="/admin/levels/<%= course.id %>/<%= level.id %>/test/add" method="POST">
                <div class="settings-group">
                    <label for="testQuestion">Question <span style="color:red;">*</span></label>
                    <input type="text" id="testQuestion" name="question" placeholder="e.g. What is the OSI model?" required>
                </div>
                <div class="settings-group">
                    <label for="option1">Option A <span style="color:red;">*</span></label>
                    <input type="text" id="option1" name="option1" placeholder="First option" required>
                </div>
                <div class="settings-group">
                    <label for="option2">Option B <span style="color:red;">*</span></label>
                    <input type="text" id="option2" name="option2" placeholder="Second option" required>
                </div>
                <div class="settings-group">
                    <label for="option3">Option C <span style="color:red;">*</span></label>
                    <input type="text" id="option3" name="option3" placeholder="Third option" required>
                </div>
                <div class="settings-group">
                    <label for="option4">Option D <span style="color:red;">*</span></label>
                    <input type="text" id="option4" name="option4" placeholder="Fourth option" required>
                </div>
                <div class="settings-group">
                    <label for="correct">Correct Answer <span style="color:red;">*</span></label>
                    <select id="correct" name="correct" required>
                        <option value="0">A</option>
                        <option value="1">B</option>
                        <option value="2">C</option>
                        <option value="3">D</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-gold btn-block">
                    <i class="fas fa-save"></i> Add Question
                </button>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        function openModal(id) {
            document.getElementById(id).classList.add('open');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('open');
        }

        function openAddClass(courseId, levelId, lessonId) {
            const form = document.getElementById('addClassForm');
            form.action = `/admin/levels/${courseId}/${levelId}/lessons/${lessonId}/classes/add`;
            openModal('addClassModal');
        }

        function openEditClass(courseId, levelId, lessonId, classId, title, content, imageUrl, videoUrl, externalLink) {
            const form = document.getElementById('editClassForm');
            form.action = `/admin/levels/${courseId}/${levelId}/lessons/${lessonId}/classes/edit/${classId}`;
            
            document.getElementById('editClassTitle').value = title;
            document.getElementById('editClassContent').value = content;
            document.getElementById('editImageUrl').value = imageUrl || '';
            document.getElementById('editVideoUrl').value = videoUrl || '';
            document.getElementById('editExternalLink').value = externalLink || '';
            
            openModal('editClassModal');
        }

        document.querySelectorAll('.modal-overlay').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('open');
                }
            });
        });
    </script>

    <script src="/js/main.js"></script>
</body>
</html>