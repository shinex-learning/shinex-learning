<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Edit Level – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .lesson-card {
            background: #f8f6fc;
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 10px;
            border: 1px solid #ede8f5;
        }
        .lesson-card .lesson-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }
        .lesson-card .lesson-title {
            font-weight: 600;
            color: #1A0A2E;
        }
        body.dark-mode .lesson-card {
            background: #2a2a2a;
            border-color: #444;
        }
        body.dark-mode .lesson-card .lesson-title {
            color: #e0e0e0;
        }
        .class-item {
            background: #fff;
            padding: 8px 12px;
            border-radius: 6px;
            margin-bottom: 6px;
            border: 1px solid #ede8f5;
        }
        body.dark-mode .class-item {
            background: #1e1e1e;
            border-color: #333;
        }
        .class-item .class-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
        }
        .class-item .class-title {
            font-size: 0.85rem;
            color: #4a3a60;
        }
        body.dark-mode .class-item .class-title {
            color: #c0b0d0;
        }
        .class-item .class-actions {
            display: flex;
            gap: 4px;
        }
        .class-content-preview {
            font-size: 0.8rem;
            color: #7a6a8f;
            margin-top: 4px;
            border-left: 3px solid #8B5CF6;
            padding-left: 8px;
            max-height: 60px;
            overflow: hidden;
        }
        body.dark-mode .class-content-preview {
            color: #a090b0;
        }
        .add-form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .add-form .full-width {
            grid-column: 1 / -1;
        }
        .test-question-item {
            background: #fffbf0;
            padding: 10px 14px;
            border-radius: 8px;
            margin-bottom: 6px;
            border: 1px solid #f7d44a;
        }
        body.dark-mode .test-question-item {
            background: #2a251a;
            border-color: #f39c12;
        }
        .test-question-item .q-text {
            font-weight: 600;
            color: #1A0A2E;
        }
        body.dark-mode .test-question-item .q-text {
            color: #f0f0f0;
        }
        .test-question-item .q-options {
            font-size: 0.8rem;
            color: #7a6a8f;
            margin-top: 4px;
        }
        body.dark-mode .test-question-item .q-options {
            color: #a090b0;
        }
        @media (max-width: 480px) {
            .add-form {
                grid-template-columns: 1fr;
            }
            .lesson-card {
                padding: 10px 12px;
            }
            .class-item {
                padding: 6px 10px;
            }
            .admin-table {
                font-size: 0.7rem;
            }
            .admin-table th,
            .admin-table td {
                padding: 4px 6px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header', { user: null, showBack: true }) %>

    <main class="main-content">
        <div class="container" style="max-width:950px;">

            <!-- ===== MESSAGES ===== -->
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger" style="margin-bottom:12px;"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success" style="margin-bottom:12px;"><%= messages.success %></div>
            <% } %>

            <!-- ===== HEADER ===== -->
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:16px;">
                <h2 style="font-size:1.3rem; font-weight:800; color:#1A0A2E; margin:0;">
                    <i class="fas fa-layer-group" style="color:#8B5CF6;"></i> Edit Level: <%= level.name %>
                </h2>
                <a href="/admin/courses/edit/<%= course.id %>" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Back to Course
                </a>
            </div>

            <!-- ===== LEVEL DETAILS ===== -->
            <div class="card" style="margin-bottom:16px; padding:16px 18px;">
                <h4 style="font-weight:700; color:#1A0A2E; font-size:1rem; margin:0 0 10px 0;">
                    <i class="fas fa-info-circle" style="color:#8B5CF6;"></i> Level Details
                </h4>
                <div style="display:flex; flex-wrap:wrap; gap:6px; font-size:0.9rem;">
                    <span><strong>Name:</strong> <%= level.name %></span>
                    <span style="margin-left:16px;"><strong>Duration:</strong> <%= level.duration %></span>
                    <span style="margin-left:16px;">
                        <strong>Lessons:</strong> <%= level.lessons ? level.lessons.length : 0 %>
                    </span>
                    <span style="margin-left:16px;">
                        <strong>Classes:</strong> 
                        <% let totalClasses = 0; %>
                        <% if (level.lessons) { %>
                            <% level.lessons.forEach(function(l) { %>
                                <% if (l.classes) { totalClasses += l.classes.length; } %>
                            <% }); %>
                        <% } %>
                        <%= totalClasses %>
                    </span>
                </div>
            </div>

            <!-- ===== ADD LESSON ===== -->
            <div class="card" style="margin-bottom:16px; background:#f8f6fc; border:2px solid #8B5CF6; padding:16px 18px;">
                <h4 style="font-weight:700; color:#1A0A2E; font-size:1rem; margin:0 0 10px 0;">
                    <i class="fas fa-plus-circle" style="color:#8B5CF6;"></i> Add New Lesson
                </h4>
                <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/add" method="POST" class="add-form">
                    <input type="text" name="title" class="form-control" placeholder="Lesson Title" required>
                    <input type="text" name="description" class="form-control" placeholder="Lesson Description (optional)">
                    <button type="submit" class="btn btn-success full-width" style="grid-column:1/-1; padding:10px;">
                        <i class="fas fa-plus"></i> Add Lesson
                    </button>
                </form>
            </div>

            <!-- ===== LESSONS & CLASSES ===== -->
            <div class="card" style="margin-bottom:16px; padding:16px 18px;">
                <h4 style="font-weight:700; color:#1A0A2E; font-size:1rem; margin:0 0 10px 0;">
                    <i class="fas fa-list-ul"></i> Lessons & Classes
                </h4>

                <% if (level.lessons && level.lessons.length > 0) { %>
                    <% level.lessons.forEach(function(lesson, lIdx) { %>
                        <div class="lesson-card">
                            <div class="lesson-header">
                                <div>
                                    <span class="lesson-title"><%= (lIdx+1) %>. <%= lesson.title %></span>
                                    <% if (lesson.description) { %>
                                        <span style="font-size:0.8rem; color:#7a6a8f; margin-left:8px;">
                                            <i class="fas fa-info-circle"></i> <%= lesson.description %>
                                        </span>
                                    <% } %>
                                    <span style="font-size:0.75rem; color:#7a6a8f; margin-left:8px;">
                                        <i class="fas fa-book"></i> <%= lesson.classes ? lesson.classes.length : 0 %> classes
                                    </span>
                                </div>
                                <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/delete/<%= lesson.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this lesson and all its classes?');">
                                    <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>

                            <!-- ===== ADD CLASS TO THIS LESSON ===== -->
                            <div style="background:#f0ebfb; padding:10px; border-radius:8px; margin:8px 0;">
                                <h5 style="font-size:0.85rem; margin:0 0 6px 0;">
                                    <i class="fas fa-plus-circle" style="color:#8B5CF6;"></i> Add Class to this Lesson
                                </h5>
                                <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/<%= lesson.id %>/classes/add" method="POST" style="display:grid; gap:8px;">
                                    <input type="text" name="title" class="form-control" placeholder="Class Title" required>
                                    <textarea name="content" class="form-control" rows="4" placeholder="Class Content (use markdown-style formatting)" required style="resize:vertical;"></textarea>
                                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                                        <input type="url" name="imageUrl" class="form-control" placeholder="Image URL (optional)">
                                        <input type="url" name="videoUrl" class="form-control" placeholder="YouTube URL (optional)">
                                        <input type="url" name="externalLink" class="form-control" placeholder="External Link (optional)" style="grid-column:1/-1;">
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Add Class</button>
                                </form>
                            </div>

                            <!-- ===== LIST CLASSES ===== -->
                            <% if (lesson.classes && lesson.classes.length > 0) { %>
                                <% lesson.classes.forEach(function(cls, cIdx) { %>
                                    <div class="class-item">
                                        <div class="class-header">
                                            <div>
                                                <span class="class-title"><strong><%= (lIdx+1) %>.<%= (cIdx+1) %></strong> <%= cls.title %></span>
                                            </div>
                                            <div class="class-actions">
                                                <button class="btn btn-secondary btn-xs" onclick="toggleEditClass('<%= cls.id %>')">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <form action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/<%= lesson.id %>/classes/delete/<%= cls.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this class?');">
                                                    <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                                                </form>
                                            </div>
                                        </div>

                                        <!-- Class Content Preview -->
                                        <div class="class-content-preview">
                                            <%- cls.content ? cls.content.substring(0, 150) + (cls.content.length > 150 ? '...' : '') : 'No content' %>
                                        </div>

                                        <!-- ===== EDIT CLASS FORM (hidden by default) ===== -->
                                        <form id="edit-class-<%= cls.id %>" action="/admin/levels/<%= course.id %>/<%= level.id %>/lessons/<%= lesson.id %>/classes/edit/<%= cls.id %>" method="POST" style="display:none; margin-top:8px; padding-top:8px; border-top:1px solid #ede8f5; grid-template-columns:1fr 1fr; gap:8px;">
                                            <input type="text" name="title" class="form-control" value="<%= cls.title %>" required style="grid-column:1/-1;">
                                            <textarea name="content" class="form-control" rows="3" style="grid-column:1/-1; resize:vertical;"><%= cls.content %></textarea>
                                            <input type="url" name="imageUrl" class="form-control" value="<%= cls.imageUrl || '' %>" placeholder="Image URL">
                                            <input type="url" name="videoUrl" class="form-control" value="<%= cls.videoUrl || '' %>" placeholder="YouTube URL">
                                            <input type="url" name="externalLink" class="form-control" value="<%= cls.externalLink || '' %>" placeholder="External Link" style="grid-column:1/-1;">
                                            <button type="submit" class="btn btn-primary btn-sm" style="grid-column:1/-1;"><i class="fas fa-save"></i> Update Class</button>
                                        </form>
                                    </div>
                                <% }); %>
                            <% } else { %>
                                <p style="color:#7a6a8f; font-style:italic; font-size:0.8rem; margin:4px 0;">No classes yet in this lesson.</p>
                            <% } %>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="color:#7a6a8f; text-align:center; padding:12px 0;">
                        <i class="fas fa-info-circle"></i> No lessons yet. Add your first lesson above!
                    </p>
                <% } %>
            </div>

            <!-- ===== TEST SECTION ===== -->
            <div class="card" style="margin-bottom:16px; padding:16px 18px; border:2px solid #f7d44a;">
                <h4 style="font-weight:700; color:#1A0A2E; font-size:1rem; margin:0 0 10px 0;">
                    <i class="fas fa-pencil-alt" style="color:#f39c12;"></i> Course Test
                </h4>
                <p style="font-size:0.85rem; color:#7a6a8f; margin:0 0 10px 0;">
                    <%= level.test && level.test.questions ? level.test.questions.length : 0 %> questions added.
                </p>

                <!-- ===== ADD TEST QUESTION ===== -->
                <form action="/admin/levels/<%= course.id %>/<%= level.id %>/test/add" method="POST" style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                    <input type="text" name="question" class="form-control" placeholder="Question" required style="grid-column:1/-1;">
                    <input type="text" name="option1" class="form-control" placeholder="Option A" required>
                    <input type="text" name="option2" class="form-control" placeholder="Option B" required>
                    <input type="text" name="option3" class="form-control" placeholder="Option C" required>
                    <input type="text" name="option4" class="form-control" placeholder="Option D" required>
                    <select name="correct" class="form-control" required>
                        <option value="">Correct Answer</option>
                        <option value="0">A</option>
                        <option value="1">B</option>
                        <option value="2">C</option>
                        <option value="3">D</option>
                    </select>
                    <button type="submit" class="btn btn-primary" style="grid-column:1/-1; padding:10px;">
                        <i class="fas fa-plus"></i> Add Question
                    </button>
                </form>

                <!-- ===== LIST TEST QUESTIONS ===== -->
                <% if (level.test && level.test.questions && level.test.questions.length > 0) { %>
                    <div style="margin-top:12px;">
                        <% level.test.questions.forEach(function(q, idx) { %>
                            <div class="test-question-item">
                                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px;">
                                    <div>
                                        <div class="q-text"><%= idx+1 %>. <%= q.question %></div>
                                        <div class="q-options">
                                            A: <%= q.options[0] %> | B: <%= q.options[1] %> | C: <%= q.options[2] %> | D: <%= q.options[3] %>
                                            <span style="color:#27ae60; margin-left:8px;">
                                                <i class="fas fa-check"></i> Answer: <%= ['A', 'B', 'C', 'D'][q.correct] %>
                                            </span>
                                        </div>
                                    </div>
                                    <form action="/admin/levels/<%= course.id %>/<%= level.id %>/test/delete/<%= q.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Delete this question?');">
                                        <button type="submit" class="btn btn-danger btn-xs"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>

        </div>
    </main>

    <%- include('../partials/footer') %>

    <script>
        function toggleEditClass(classId) {
            const form = document.getElementById('edit-class-' + classId);
            if (form) {
                if (form.style.display === 'none' || form.style.display === '') {
                    form.style.display = 'grid';
                } else {
                    form.style.display = 'none';
                }
            }
        }
    </script>
</body>
</html>