<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin – Courses</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('../partials/header', { user: null, showBack: false }) %>

    <main class="main-content">
        <div class="container">

            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
                <h2 style="font-size: 1.6rem; font-weight: 800; color: #1A0A2E;">
                    <i class="fas fa-book" style="color: #8B5CF6;"></i> Manage Courses
                </h2>
                <a href="/admin/dashboard" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Back to Admin
                </a>
            </div>

            <!-- Add Course Form with Preview -->
            <div class="card" style="margin-bottom: 24px; background: #f8f6fc; border: 2px solid #8B5CF6;">
                <h4 style="font-weight: 700; color: #1A0A2E; margin-bottom: 12px;">
                    <i class="fas fa-plus-circle" style="color: #8B5CF6;"></i> Add New Course
                </h4>
                
                <form action="/admin/courses/add" method="POST" id="courseForm">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <input type="text" name="title" class="form-control" placeholder="Course Title" required>
                        <input type="text" name="description" class="form-control" placeholder="Short Description" required>
                        <select name="level" class="form-control" required>
                            <option value="">Select Level</option>
                            <option value="Beginner">Beginner</option>
                            <option value="Intermediate">Intermediate</option>
                            <option value="Advanced">Advanced</option>
                        </select>
                        <input type="text" name="duration" class="form-control" placeholder="e.g. 4 hours" required>
                    </div>
                    
                    <!-- Review Box - BIG TEXTAREA -->
                    <div style="margin-top: 12px;">
                        <label style="font-weight: 600; color: #2d1a4a; margin-bottom: 5px; display: block;">
                            <i class="fas fa-edit" style="color: #8B5CF6;"></i> Course Review / Notes
                        </label>
                        <textarea name="review" class="form-control" rows="6" style="font-size: 16px; min-height: 150px;" placeholder="Write your review or notes about this course..."></textarea>
                    </div>
                    
                    <button type="submit" class="btn btn-primary" style="margin-top: 12px; width: 100%; font-size: 1.1rem; padding: 14px;">
                        <i class="fas fa-save"></i> Add Course
                    </button>
                </form>
            </div>

            <!-- Course List -->
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 12px;">
                    <h4 style="font-weight: 700; color: #1A0A2E;">
                        <i class="fas fa-list"></i> All Courses (<%= courses.length %>)
                    </h4>
                    
                    <!-- Delete All Courses Button -->
                    <form action="/admin/courses/delete-all" method="POST" style="display: inline;" onsubmit="return confirm('⚠️ Delete ALL courses? This cannot be undone!');">
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash"></i> Delete All
                        </button>
                    </form>
                </div>
                
                <div style="overflow-x: auto;">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Level</th>
                                <th>Duration</th>
                                <th>Lessons</th>
                                <th>Review</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% courses.forEach(c => { %>
                                <tr>
                                    <td><strong><%= c.title %></strong></td>
                                    <td><span class="badge badge-purple"><%= c.level %></span></td>
                                    <td><%= c.duration %></td>
                                    <td><%= c.lessons ? c.lessons.length : 0 %></td>
                                    <td style="max-width: 200px; font-size: 0.85rem; color: #5a4a70;">
                                        <%= c.review ? c.review.substring(0, 60) + (c.review.length > 60 ? '...' : '') : 'No review' %>
                                    </td>
                                    <td>
                                        <div class="actions">
                                            <a href="/admin/courses/edit/<%= c.id %>" class="btn btn-secondary btn-xs">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form action="/admin/courses/delete/<%= c.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Delete this course?');">
                                                <button type="submit" class="btn btn-danger btn-xs">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                            <% if (courses.length === 0) { %>
                                <tr><td colspan="6" style="text-align: center; color: #7a6a8f; padding: 30px;">
                                    <i class="fas fa-plus-circle" style="font-size: 2rem; color: #8B5CF6; display: block; margin-bottom: 10px;"></i>
                                    No courses yet. Add your first course above!
                                </td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>