<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Services - SHINEX Admin</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-container { display: flex; min-height: 100vh; background: #f8f6fc; }
        .admin-sidebar { width: 250px; background: #1A0A2E; color: #fff; padding: 24px 0; position: fixed; height: 100vh; overflow-y: auto; }
        .admin-sidebar .logo { padding: 0 24px 24px; font-size: 24px; font-weight: 800; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .admin-sidebar .logo span { color: #8B5CF6; }
        .admin-sidebar .nav a { display: flex; align-items: center; gap: 12px; padding: 12px 24px; color: rgba(255,255,255,0.7); text-decoration: none; transition: all 0.2s; font-size: 14px; }
        .admin-sidebar .nav a:hover, .admin-sidebar .nav a.active { background: rgba(139,92,246,0.2); color: #fff; border-left: 3px solid #8B5CF6; }
        .admin-main { margin-left: 250px; flex: 1; padding: 24px; }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; background: #fff; padding: 16px 24px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
        .admin-header h1 { font-size: 24px; }
        .admin-section { background: #fff; border-radius: 12px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); margin-bottom: 24px; }
        .admin-table { width: 100%; border-collapse: collapse; }
        .admin-table th, .admin-table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #e8e3f0; }
        .admin-table th { font-weight: 600; color: #5a4a70; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
        .btn-sm { padding: 4px 12px; font-size: 12px; border-radius: 6px; border: none; cursor: pointer; text-decoration: none; display: inline-block; }
        .btn-primary-sm { background: #8B5CF6; color: #fff; }
        .btn-danger-sm { background: #e74c3c; color: #fff; }
        .btn-success-sm { background: #27ae60; color: #fff; }
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 4px; }
        .form-control { width: 100%; padding: 10px 14px; border: 2px solid #e8e3f0; border-radius: 8px; font-size: 14px; transition: border-color 0.2s; }
        .form-control:focus { outline: none; border-color: #8B5CF6; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .btn { padding: 10px 24px; background: linear-gradient(135deg, #8B5CF6, #6a3dcf); color: #fff; border: none; border-radius: 30px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
        .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(139,92,246,0.3); }
        .badge { padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 600; }
        .badge-success { background: #e8f5e9; color: #27ae60; }
        .badge-danger { background: #fde8e8; color: #e74c3c; }
        .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; }
        .alert-success { background: #e8f5e9; color: #27ae60; border-left: 4px solid #27ae60; }
        .alert-error { background: #fde8e8; color: #e74c3c; border-left: 4px solid #e74c3c; }
        @media (max-width: 768px) { .admin-sidebar { display: none; } .admin-main { margin-left: 0; } .form-row { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="admin-container">
        <aside class="admin-sidebar">
            <div class="logo">SHINEX<span>.</span></div>
            <nav class="nav">
                <a href="/admin/dashboard">📊 Dashboard</a>
                <a href="/admin/students">👤 Students</a>
                <a href="/admin/courses">📚 Courses</a>
                <a href="/admin/services" class="active">💼 Services</a>
                <a href="/admin/messages">✉️ Messages</a>
                <a href="/admin/manage-admins">🔐 Manage Admins</a>
                <a href="/admin/logout" style="color: #e74c3c; margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 16px;">🚪 Logout</a>
            </nav>
        </aside>

        <main class="admin-main">
            <div class="admin-header">
                <h1>Manage Services</h1>
                <span><%= services ? services.length : 0 %> total</span>
            </div>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-error"><%= messages.error %></div>
            <% } %>

            <!-- Add Service -->
            <div class="admin-section">
                <h2>Add New Service</h2>
                <form action="/admin/services/add" method="POST">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name">Service Name</label>
                            <input type="text" id="name" name="name" class="form-control" placeholder="e.g. Graphic Design" required>
                        </div>
                        <div class="form-group">
                            <label for="price">Price (₦)</label>
                            <input type="number" id="price" name="price" class="form-control" placeholder="0">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="category">Category</label>
                            <select id="category" name="category" class="form-control">
                                <option value="registration">Registration</option>
                                <option value="design">Design</option>
                                <option value="campaign">Campaign</option>
                                <option value="website">Website</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="description">Description</label>
                            <input type="text" id="description" name="description" class="form-control" placeholder="Brief description">
                        </div>
                    </div>
                    <button type="submit" class="btn">Add Service</button>
                </form>
            </div>

            <!-- Service List -->
            <div class="admin-section">
                <h2>All Services</h2>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (services && services.length > 0) { %>
                            <% services.forEach(service => { %>
                                <tr>
                                    <td><strong><%= service.name %></strong></td>
                                    <td><%= service.category %></td>
                                    <td>₦<%= service.price.toLocaleString() %></td>
                                    <td><span class="badge <%= service.isActive ? 'badge-success' : 'badge-danger' %>"><%= service.isActive ? 'Active' : 'Inactive' %></span></td>
                                    <td>
                                        <a href="/admin/services/edit/<%= service.id %>" class="btn-sm btn-primary-sm">Edit</a>
                                        <form action="/admin/services/toggle/<%= service.id %>" method="POST" style="display: inline;">
                                            <button type="submit" class="btn-sm <%= service.isActive ? 'btn-danger-sm' : 'btn-success-sm' %>"><%= service.isActive ? 'Deactivate' : 'Activate' %></button>
                                        </form>
                                        <a href="/admin/services/delete/<%= service.id %>" class="btn-sm btn-danger-sm" onclick="return confirm('Delete this service?')">Delete</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align: center; color: #5a4a70; padding: 40px;">No services added yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</body>
</html>