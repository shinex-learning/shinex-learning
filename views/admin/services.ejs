<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Services – SHINEX Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-layout {
            display: flex;
            gap: 24px;
            max-width: 1400px;
            margin: 0 auto;
        }
        .admin-sidebar {
            width: 240px;
            min-width: 200px;
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            transition: all 0.3s ease;
        }
        body.dark-mode .admin-sidebar {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .admin-sidebar .sidebar-title {
            border-color: var(--dark-border);
        }
        .admin-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        .admin-nav li {
            margin: 0;
        }
        .admin-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .admin-nav a:hover {
            background: var(--primary-bg);
            color: var(--primary);
        }
        .admin-nav a.active {
            background: var(--primary-bg);
            color: var(--primary);
            border-left-color: var(--primary);
        }
        body.dark-mode .admin-nav a:hover {
            background: #2a1a4a;
        }
        body.dark-mode .admin-nav a.active {
            background: #2a1a4a;
        }
        .admin-content {
            flex: 1;
            min-width: 0;
        }
        .admin-card {
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 20px 24px;
            margin-bottom: 16px;
        }
        body.dark-mode .admin-card {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .admin-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 8px;
        }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }
        .admin-table th {
            text-align: left;
            padding: 8px 12px;
            border-bottom: 2px solid #ede8f5;
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        body.dark-mode .admin-table th {
            border-color: var(--dark-border);
        }
        .admin-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #ede8f5;
            vertical-align: middle;
        }
        body.dark-mode .admin-table td {
            border-color: var(--dark-border);
        }
        .admin-table tr:hover {
            background: var(--primary-bg);
        }
        body.dark-mode .admin-table tr:hover {
            background: #1a1a1a;
        }
        .admin-table .badge {
            font-size: 0.65rem;
            padding: 2px 10px;
        }
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 999;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.open {
            display: flex;
        }
        .modal-box {
            background: var(--bg-light);
            border-radius: var(--radius);
            padding: 32px 28px;
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        body.dark-mode .modal-box {
            background: var(--dark-card);
        }
        .modal-box h3 {
            font-size: 1.2rem;
            font-weight: 700;
            margin: 0 0 16px;
        }
        .modal-close {
            float: right;
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-muted);
        }
        .modal-close:hover {
            color: var(--text-dark);
        }
        body.dark-mode .modal-close:hover {
            color: var(--text-light);
        }
        .service-card {
            background: var(--bg-light);
            border-radius: var(--radius);
            border: 1px solid #ede8f5;
            padding: 16px 20px;
            margin-bottom: 12px;
            transition: all 0.3s ease;
        }
        body.dark-mode .service-card {
            background: var(--dark-card);
            border-color: var(--dark-border);
        }
        .service-card:hover {
            border-color: var(--primary);
            box-shadow: var(--shadow);
        }
        .service-card .service-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }
        .service-card .service-header h5 {
            font-size: 1rem;
            font-weight: 700;
            margin: 0;
        }
        .service-card .service-header .service-actions {
            display: flex;
            gap: 6px;
        }
        .service-card .service-details {
            margin-top: 6px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        @media (max-width: 768px) {
            .admin-layout {
                flex-direction: column;
            }
            .admin-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <div class="admin-layout">
                <!-- ===== Admin Sidebar ===== -->
                <aside class="admin-sidebar">
                    <div class="sidebar-title"><i class="fas fa-crown"></i> Admin Panel</div>
                    <ul class="admin-nav">
                        <li><a href="/admin/dashboard"><i class="fas fa-chart-pie"></i> Dashboard</a></li>
                        <li><a href="/admin/students"><i class="fas fa-users"></i> Students</a></li>
                        <li><a href="/admin/courses"><i class="fas fa-book"></i> Courses</a></li>
                        <li><a href="/admin/services" class="active"><i class="fas fa-concierge-bell"></i> Services</a></li>
                        <li><a href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
                        <li><a href="/admin/manage-admins"><i class="fas fa-user-shield"></i> Admins</a></li>
                        <li><a href="/admin/logout" style="color:#e74c3c;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                    </ul>
                </aside>

                <!-- ===== Admin Content ===== -->
                <div class="admin-content">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; margin-bottom:16px;">
                        <div>
                            <h2 style="font-size:1.5rem; font-weight:700; margin:0 0 2px;">🛠️ Manage Services</h2>
                            <p style="color:var(--text-muted); margin:0;">Add, edit, or delete services offered.</p>
                        </div>
                        <button class="btn btn-primary" onclick="openModal('addServiceModal')">
                            <i class="fas fa-plus"></i> Add Service
                        </button>
                    </div>

                    <!-- Services List -->
                    <div class="admin-card">
                        <% if (services && services.length > 0) { %>
                            <% services.forEach(service => { %>
                                <div class="service-card">
                                    <div class="service-header">
                                        <div>
                                            <h5><%= service.name %></h5>
                                            <span class="badge <%= service.category === 'registration' ? 'badge-purple' : 
                                                              service.category === 'design' ? 'badge-gold' : 
                                                              service.category === 'campaign' ? 'badge-green' : 
                                                              service.category === 'website' ? 'badge-dark' : 'badge' %>">
                                                <%= service.category ? service.category.charAt(0).toUpperCase() + service.category.slice(1) : 'Other' %>
                                            </span>
                                            <span class="badge <%= service.isActive ? 'badge-green' : 'badge-red' %>">
                                                <%= service.isActive ? '✅ Active' : '❌ Inactive' %>
                                            </span>
                                            <span style="font-weight:700; color:var(--primary); margin-left:8px;">
                                                ₦<%= service.price.toLocaleString() %>
                                            </span>
                                        </div>
                                        <div class="service-actions">
                                            <a href="/admin/services/edit/<%= service.id %>" class="btn btn-primary btn-sm" style="padding:2px 10px; font-size:0.7rem;">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form action="/admin/services/toggle/<%= service.id %>" method="POST" style="display:inline;">
                                                <button type="submit" class="btn btn-secondary btn-sm" style="padding:2px 10px; font-size:0.7rem;">
                                                    <i class="fas <%= service.isActive ? 'fa-eye-slash' : 'fa-eye' %>"></i>
                                                </button>
                                            </form>
                                            <form action="/admin/services/delete/<%= service.id %>" method="GET" style="display:inline;" onsubmit="return confirm('Delete this service?');">
                                                <button type="submit" class="btn btn-danger btn-sm" style="padding:2px 10px; font-size:0.7rem;">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="service-details">
                                        <p style="margin:4px 0;"><%= service.description || 'No description available.' %></p>
                                        <p style="font-size:0.7rem; color:var(--text-muted); margin:0;">
                                            Added: <%= new Date(service.createdAt).toLocaleDateString() %>
                                        </p>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p style="color:var(--text-muted); text-align:center; padding:30px;">
                                <i class="fas fa-concierge-bell" style="font-size:2rem; display:block; margin-bottom:8px; opacity:0.3;"></i>
                                No services added yet.
                            </p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- ===== ADD SERVICE MODAL ===== -->
    <div class="modal-overlay" id="addServiceModal">
        <div class="modal-box">
            <button class="modal-close" onclick="closeModal('addServiceModal')">&times;</button>
            <h3><i class="fas fa-plus-circle" style="color:var(--primary);"></i> Add New Service</h3>
            <form action="/admin/services/add" method="POST">
                <div class="settings-group">
                    <label for="serviceName">Service Name <span style="color:red;">*</span></label>
                    <input type="text" id="serviceName" name="name" placeholder="e.g. TASUED Registration" required>
                </div>
                <div class="settings-group">
                    <label for="serviceDescription">Description</label>
                    <textarea id="serviceDescription" name="description" rows="3" placeholder="Service description..."></textarea>
                </div>
                <div class="settings-group">
                    <label for="servicePrice">Price (₦) <span style="color:red;">*</span></label>
                    <input type="number" id="servicePrice" name="price" placeholder="e.g. 20000" required>
                </div>
                <div class="settings-group">
                    <label for="serviceCategory">Category</label>
                    <select id="serviceCategory" name="category">
                        <option value="registration">Registration</option>
                        <option value="design">Design</option>
                        <option value="campaign">Campaign</option>
                        <option value="website">Website</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-save"></i> Add Service
                </button>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        function openModal(id) {
            document.getElementById(id).classList.add('open');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('open');
        }

        document.querySelectorAll('.modal-overlay').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('open');
                }
            });
        });
    </script>

    <script src="/js/main.js"></script>
</body>
</html>