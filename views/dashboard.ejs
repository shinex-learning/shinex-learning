<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHINEX – Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/header', { user, showBack: false }) %>

    <main class="main-content">
        <div class="container">

            <!-- Welcome -->
            <div class="card card-purple" style="margin-bottom: 24px; padding: 32px 36px;">
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h2 style="font-size: 1.8rem; font-weight: 700; color: #fff;">
                            👋 Welcome, <%= user.firstName %>!
                        </h2>
                        <p style="color: #d4c4f0; margin-top: 4px;">
                            <i class="fas fa-envelope" style="margin-right: 6px;"></i> <%= user.email %>
                        </p>
                    </div>
                    <div>
                        <span class="badge badge-gold" style="font-size: 0.8rem;">
                            <i class="fas fa-user-graduate"></i> <%= user.experienceLevel || 'Not set' %>
                        </span>
                    </div>
                </div>
            </div>

            <% if (enrolledCourse) { %>
                <!-- Enrolled Course -->
                <div class="card" style="margin-bottom: 24px; border-left: 5px solid #8B5CF6;">
                    <div style="display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
                        <div>
                            <h3 style="font-size: 1.3rem; font-weight: 700; color: #1A0A2E;">
                                <i class="fas fa-book-open" style="color: #8B5CF6; margin-right: 8px;"></i>
                                <%= enrolledCourse.title %>
                            </h3>
                            <p style="color: #7a6a8f; font-size: 0.9rem;">
                                <span class="badge badge-purple"><%= enrolledCourse.level %></span>
                                <span style="margin-left: 12px;"><i class="far fa-clock"></i> <%= enrolledCourse.duration %></span>
                            </p>
                        </div>
                        <a href="/course" class="btn btn-primary btn-sm">
                            <i class="fas fa-arrow-right"></i> Go to Course
                        </a>
                    </div>

                    <!-- Progress -->
                    <div style="margin-top: 16px;">
                        <div style="display: flex; justify-content: space-between; font-size: 0.9rem; font-weight: 500; color: #2d1a4a;">
                            <span>Progress</span>
                            <span><%= completedLessons %> / <%= totalLessons %> lessons • <%= progress %>%</span>
                        </div>
                        <div class="progress-wrap" style="margin-top: 6px; height: 12px;">
                            <div class="progress-fill" style="width: <%= progress %>%;"></div>
                        </div>
                    </div>
                </div>

                <!-- Quick lesson list -->
                <div class="card">
                    <h4 style="font-weight: 700; color: #1A0A2E; margin-bottom: 12px;">
                        <i class="fas fa-list-ul" style="color: #8B5CF6; margin-right: 8px;"></i>
                        Lessons
                    </h4>
                    <% if (enrolledCourse.lessons && enrolledCourse.lessons.length > 0) { %>
                        <% enrolledCourse.lessons.forEach(lesson => { %>
                            <div class="lesson-item">
                                <span class="lesson-title">
                                    <%= lesson.title %>
                                </span>
                                <span class="lesson-status">
                                    <% if (user.progress && user.progress[lesson.id]) { %>
                                        <span class="completed"><i class="fas fa-check-circle"></i> Done</span>
                                    <% } else { %>
                                        <span class="pending"><i class="far fa-circle"></i> Pending</span>
                                    <% } %>
                                </span>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p style="color: #7a6a8f;">No lessons yet for this course.</p>
                    <% } %>
                </div>

            <% } else { %>
                <!-- No course enrolled -->
                <div class="card" style="text-align: center; padding: 40px 24px;">
                    <div style="font-size: 3rem; color: #d4c4f0; margin-bottom: 12px;">
                        <i class="fas fa-book-open"></i>
                    </div>
                    <h3 style="font-size: 1.3rem; color: #1A0A2E;">No Course Enrolled</h3>
                    <p style="color: #7a6a8f; max-width: 400px; margin: 8px auto 20px;">
                        You haven't enrolled in any course yet. Please contact the admin to get started.
                    </p>
                    <a href="/" class="btn btn-primary">
                        <i class="fas fa-home"></i> Browse Courses
                    </a>
                </div>
            <% } %>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>