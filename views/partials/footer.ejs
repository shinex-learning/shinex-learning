<!-- ============================================================
     AI BOT – FLOATING WIDGET (Global)
     ============================================================ -->
<div class="ai-bot" id="aiBot">
    <button class="ai-bot-btn" id="aiBotBtn" aria-label="Ask AI Tutor">
        🤖
        <span class="ai-bot-pulse"></span>
    </button>
</div>

<div class="ai-chat-modal" id="aiChatModal">
    <div class="ai-chat-header">
        <h4>🤖 AI Tutor</h4>
        <button class="ai-chat-close" id="aiChatClose">&times;</button>
    </div>
    <div class="ai-chat-body" id="aiChatBody">
        <div class="ai-chat-messages" id="aiChatMessages">
            <div class="ai-chat-msg bot">👋 Hi! I'm your SHINEX AI Tutor. Ask me anything about your courses, tech, or careers.</div>
        </div>
    </div>
    <div class="ai-chat-footer">
        <input type="text" id="aiChatInput" placeholder="Type your question..." autocomplete="off">
        <button class="btn btn-primary" id="aiChatSend">Send</button>
    </div>
</div>