<!-- ============================================================
     HEADER – MOBILE
     ============================================================ -->
<header class="header" style="padding:8px 12px; flex-wrap:nowrap;">
    <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
        <% if (showBack) { %>
            <a href="javascript:history.back()" class="back-btn" style="font-size:0.75rem; padding:4px 8px;">
                <i class="fas fa-arrow-left"></i>
            </a>
        <% } %>
        <a href="/" class="logo-container" style="gap:8px;">
            <div class="logo" style="width:32px; height:32px; font-size:10px;">SLC</div>
            <div style="line-height:1.1;">
                <div class="logo-text" style="font-size:13px;">SHINEX<span>.</span></div>
                <div class="logo-sub" style="font-size:6px;">LEARNING</div>
            </div>
        </a>
    </div>

    <div class="header-actions" style="gap:4px; flex-wrap:nowrap;">
        <!-- Dark Mode Toggle (mobile) -->
        <button class="dark-toggle" id="darkToggleMobile" aria-label="Toggle dark mode" style="padding:4px 8px; font-size:1rem;">
            🌙
        </button>

        <!-- User / Auth -->
        <% if (user) { %>
            <a href="/dashboard" class="btn btn-secondary btn-sm" style="min-height:30px; padding:2px 10px; font-size:0.7rem;">
                <i class="fas fa-user"></i>
            </a>
            <a href="/logout" class="btn btn-danger btn-sm" style="min-height:30px; padding:2px 10px; font-size:0.7rem;">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        <% } else { %>
            <a href="/login" class="btn btn-secondary btn-sm" style="min-height:30px; padding:2px 10px; font-size:0.7rem;">
                Login
            </a>
            <a href="/register" class="btn btn-primary btn-sm" style="min-height:30px; padding:2px 10px; font-size:0.7rem;">
                Register
            </a>
        <% } %>
    </div>
</header>