<!-- ============================================================
     HEADER – MOBILE VERSION
     Optimized for small screens
     ============================================================ -->
<header class="header" style="padding:10px 12px; flex-wrap:wrap; gap:6px;">
    <a href="/" class="logo-container" style="gap:8px;">
        <div class="logo" style="width:36px; height:36px; font-size:11px;">SLC</div>
        <div>
            <div class="logo-text" style="font-size:15px;">SHINEX<span>.</span></div>
            <div class="logo-sub" style="font-size:7px;">LEARNING CIRCLE</div>
        </div>
    </a>

    <div class="header-actions" style="gap:4px; flex-wrap:wrap;">
        <!-- Text Size Slider (Smaller) -->
        <div class="text-size-control" style="padding:2px 8px;">
            <label style="font-size:0.6rem;"><i class="fas fa-font"></i></label>
            <input type="range" id="textSizeSliderMobile" min="12" max="24" value="16" step="1" style="width:50px;">
            <span class="text-size-value" id="textSizeValueMobile" style="font-size:0.6rem; min-width:24px;">16px</span>
        </div>

        <!-- Dark Mode Toggle (Icon only) -->
        <button class="dark-toggle" id="darkToggleMobile" aria-label="Toggle dark mode" style="font-size:1rem; padding:4px 6px;">
            🌙
        </button>

        <!-- Settings Link (Icon only on small screens) -->
        <a href="/settings" class="btn btn-secondary btn-sm" style="min-height:32px; padding:4px 10px; border-radius:30px; font-size:0.75rem;">
            <i class="fas fa-cog"></i>
        </a>
    </div>
</header>