<!-- ============================================================
     ADMIN HEADER – Desktop Only
     ============================================================ -->
<header style="
    background: var(--purple-gradient);
    padding: 12px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 15px rgba(139, 92, 246, 0.3);
    transition: all 0.3s ease;
">
    <!-- Left Section: Logo + Back Button -->
    <div style="
        display: flex;
        align-items: center;
        gap: 12px;
    ">
        <!-- Back Button -->
        <% if (showBack) { %>
            <a href="javascript:history.back()" style="
                color: rgba(255,255,255,0.8);
                text-decoration: none;
                padding: 6px 14px;
                border-radius: 8px;
                transition: all 0.3s ease;
                font-size: 0.85rem;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                background: rgba(255,255,255,0.1);
            ">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        <% } %>
        
        <!-- Logo -->
        <a href="/admin/dashboard" style="
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        ">
            <div style="
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: rgba(255,255,255,0.15);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                font-size: 12px;
                letter-spacing: 1px;
                flex-shrink: 0;
                transition: all 0.3s ease;
            ">
                SLC
            </div>
            <div>
                <div style="
                    font-size: 16px;
                    font-weight: 700;
                    color: #fff;
                    line-height: 1.2;
                ">
                    SHINEX<span style="color: rgba(255,255,255,0.8);">.</span>
                </div>
                <div style="
                    font-size: 7px;
                    font-weight: 600;
                    color: rgba(255,255,255,0.6);
                    letter-spacing: 2px;
                    margin-top: -2px;
                ">
                    ADMIN PANEL
                </div>
            </div>
        </a>
    </div>

    <!-- Right Section: Dark Mode + Admin Info + Logout -->
    <div style="
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    ">
        <!-- Dark Mode Toggle -->
        <button class="dark-toggle" id="darkToggle" aria-label="Toggle dark mode" style="
            background: rgba(255,255,255,0.1);
            border: none;
            font-size: 1rem;
            cursor: pointer;
            padding: 6px 14px;
            border-radius: 30px;
            color: #fff;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        ">
            <i class="fas fa-moon"></i>
            <span class="toggle-label" style="font-size: 0.7rem; font-weight: 600;">Dark</span>
        </button>

        <!-- Admin Info -->
        <span style="
            color: rgba(255,255,255,0.85);
            font-size: 0.85rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        ">
            <i class="fas fa-user-shield" style="color: rgba(255,255,255,0.7);"></i>
            <%= admin ? admin.firstName : 'Admin' %>
        </span>

        <!-- Logout Button -->
        <a href="/admin/logout" style="
            background: rgba(255,255,255,0.15);
            color: #fff;
            text-decoration: none;
            padding: 6px 16px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.3s ease;
            border: 1px solid rgba(255,255,255,0.1);
        ">
            <i class="fas fa-sign-out-alt"></i> Logout
        </a>
    </div>
</header>

<!-- ============================================================
     ADMIN HEADER SCRIPTS
     ============================================================ -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ============================================================
        // DARK MODE TOGGLE
        // ============================================================
        
        const darkToggle = document.getElementById('darkToggle');
        
        if (darkToggle) {
            // Check saved theme
            if (localStorage.getItem('shinex-theme') === 'dark') {
                document.body.classList.add('dark-mode');
                updateDarkToggle(darkToggle, true);
            }
            
            darkToggle.addEventListener('click', function() {
                const isDark = document.body.classList.toggle('dark-mode');
                localStorage.setItem('shinex-theme', isDark ? 'dark' : 'light');
                updateDarkToggle(this, isDark);
            });
        }
        
        function updateDarkToggle(button, isDark) {
            const icon = button.querySelector('i');
            const label = button.querySelector('.toggle-label');
            
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
            if (label) {
                label.textContent = isDark ? 'Light' : 'Dark';
            }
        }
        
        // ============================================================
        // KEYBOARD SHORTCUT: Ctrl+Shift+D for Dark Mode
        // ============================================================
        
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.shiftKey && e.key === 'D') {
                e.preventDefault();
                const toggle = document.getElementById('darkToggle');
                if (toggle) toggle.click();
            }
        });
    });
</script>