<!-- ============================================================
     ADMIN HEADER – Desktop Only
     ============================================================ -->
<header class="header" style="background: linear-gradient(135deg, #1A0A2E, #2a1a4a);">
    <div style="display:flex; align-items:center; gap:12px;">
        <% if (showBack) { %>
            <a href="javascript:history.back()" class="back-btn" title="Go Back">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        <% } %>
        
        <a href="/admin/dashboard" class="logo-container">
            <div class="logo" style="background: rgba(139,92,246,0.3);">SLC</div>
            <div>
                <div class="logo-text" style="font-size:16px;">SHINEX<span style="color:#8B5CF6;">.</span></div>
                <div class="logo-sub" style="color:rgba(255,255,255,0.5);">ADMIN PANEL</div>
            </div>
        </a>
    </div>

    <div class="header-actions">
        <!-- Dark Mode Toggle -->
        <button class="dark-toggle" id="darkToggle" aria-label="Toggle dark mode" style="background:rgba(255,255,255,0.1);">
            🌙 <span class="toggle-label">Dark</span>
        </button>

        <!-- Admin Info -->
        <span style="color:rgba(255,255,255,0.8); font-size:0.8rem; font-weight:500;">
            <i class="fas fa-user-shield" style="color:#8B5CF6;"></i> <%= admin ? admin.firstName : 'Admin' %>
        </span>

        <!-- Logout -->
        <a href="/admin/logout" class="btn btn-danger btn-sm" style="min-height:36px; padding:6px 16px; border-radius:30px; background:#e74c3c; color:#fff;">
            <i class="fas fa-sign-out-alt"></i> Logout
        </a>
    </div>
</header>