<!-- ============================================================
   SHINEX LOADING ANIMATION
   ============================================================ -->

<div id="shinex-loader" style="
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #f8f7fc;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: opacity 0.5s ease;
">
    <div style="
        width: 60px;
        height: 60px;
        border: 4px solid #ede8f5;
        border-top-color: #8B5CF6;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    "></div>
    <p style="
        margin-top: 16px;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        color: #8B5CF6;
        font-size: 1rem;
        letter-spacing: 0.5px;
    ">
        <i class="fas fa-graduation-cap" style="margin-right: 8px;"></i>
        SHINEX Learning Circle
    </p>
    <p style="
        margin-top: 4px;
        font-family: 'Inter', sans-serif;
        font-size: 0.8rem;
        color: #7a6a8f;
    ">Loading...</p>
</div>

<style>
    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<script>
    // Hide loader when page is fully loaded
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            const loader = document.getElementById('shinex-loader');
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(function() {
                    loader.style.display = 'none';
                }, 500);
            }
        }, 300);
    });

    // Show loader when navigating away (for link clicks)
    document.addEventListener('click', function(e) {
        const target = e.target.closest('a');
        if (target && target.href && !target.target && !target.download) {
            // Only show for internal links
            const currentOrigin = window.location.origin;
            if (target.href.startsWith(currentOrigin) || target.href.startsWith('/')) {
                const loader = document.getElementById('shinex-loader');
                if (loader) {
                    loader.style.display = 'flex';
                    loader.style.opacity = '1';
                }
            }
        }
    });
</script>