<!-- ============================================================
     ADMIN AI BOT (Optional – can be removed if not needed)
     ============================================================ -->
<div class="ai-bot" id="aiBot" style="
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 999;
    cursor: pointer;
">
    <button class="ai-bot-btn" id="aiBotBtn" aria-label="Ask AI Tutor" style="
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: var(--purple-gradient);
        color: #fff;
        border: none;
        font-size: 22px;
        box-shadow: 0 8px 30px rgba(139, 92, 246, 0.4);
        cursor: pointer;
        position: relative;
        z-index: 2;
        transition: all 0.3s ease;
    ">
        🤖
        <span class="ai-bot-pulse" style="
            position: absolute;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(139, 92, 246, 0.3);
            animation: pulseRing 2s ease-out infinite;
            z-index: 1;
            top: 0;
            left: 0;
        "></span>
    </button>
</div>

<!-- AI Chat Modal -->
<div class="ai-chat-modal" id="aiChatModal" style="
    position: fixed;
    bottom: 100px;
    right: 30px;
    width: 380px;
    max-width: calc(100vw - 40px);
    max-height: 500px;
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-xl);
    z-index: 1000;
    display: none;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.3s ease;
">
    <div class="ai-chat-header" style="
        padding: 14px 18px;
        background: var(--purple-gradient);
        color: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
    ">
        <h4 style="
            font-size: 0.95rem;
            font-weight: 700;
            margin: 0;
            color: #fff;
        ">
            🤖 AI Tutor
        </h4>
        <button class="ai-chat-close" id="aiChatClose" style="
            background: none;
            border: none;
            color: #fff;
            font-size: 1.2rem;
            cursor: pointer;
            padding: 4px;
            transition: all 0.3s ease;
        ">
            &times;
        </button>
    </div>
    <div class="ai-chat-body" id="aiChatBody" style="
        padding: 16px 18px;
        flex: 1;
        overflow-y: auto;
        max-height: 300px;
        background: var(--bg-page);
    ">
        <div class="ai-chat-messages" id="aiChatMessages" style="
            display: flex;
            flex-direction: column;
            gap: 8px;
        ">
            <div class="ai-chat-msg bot" style="
                padding: 10px 14px;
                border-radius: var(--radius-md);
                font-size: 0.9rem;
                max-width: 85%;
                line-height: 1.5;
                background: var(--purple-bg);
                color: var(--text-primary);
                align-self: flex-start;
                border-bottom-left-radius: 4px;
            ">
                👋 Hi Admin! I'm your SHINEX AI Tutor. Ask me anything about the platform, courses, or any topic!
            </div>
        </div>
    </div>
    <div class="ai-chat-footer" style="
        padding: 12px 18px;
        border-top: 1px solid var(--border-color);
        display: flex;
        gap: 8px;
        background: var(--bg-card);
    ">
        <input type="text" id="aiChatInput" placeholder="Type your question..." autocomplete="off" style="
            flex: 1;
            padding: 8px 12px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            font-size: 0.85rem;
            background: var(--bg-input);
            color: var(--text-primary);
            transition: all 0.3s ease;
        ">
        <button class="btn btn-primary" id="aiChatSend" style="
            padding: 8px 16px;
            border: none;
            border-radius: var(--radius-full);
            background: var(--purple-primary);
            color: #fff;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        ">
            Send
        </button>
    </div>
</div>

<!-- ============================================================
     ADMIN FOOTER SCRIPTS
     ============================================================ -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ============================================================
        // AI BOT
        // ============================================================
        
        const botBtn = document.getElementById('aiBotBtn');
        const chatModal = document.getElementById('aiChatModal');
        const chatClose = document.getElementById('aiChatClose');
        const chatInput = document.getElementById('aiChatInput');
        const chatSend = document.getElementById('aiChatSend');
        const chatMessages = document.getElementById('aiChatMessages');
        
        if (botBtn && chatModal) {
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    if (chatInput) chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
        }
        
        if (chatClose) {
            chatClose.addEventListener('click', function() {
                chatModal.classList.remove('open');
                chatModal.style.display = 'none';
            });
        }
        
        // Close modal on click outside
        document.addEventListener('click', function(e) {
            if (chatModal && chatModal.classList.contains('open')) {
                if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                }
            }
        });
        
        // ============================================================
        // AI CHAT FUNCTIONALITY
        // ============================================================
        
        function addChatMessage(text, type) {
            if (!chatMessages) return;
            
            const div = document.createElement('div');
            div.className = 'ai-chat-msg ' + type;
            
            let formatted = text;
            formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
            formatted = formatted.replace(/\n/g, '<br>');
            div.innerHTML = formatted;
            
            // Style based on type
            if (type === 'bot') {
                div.style.cssText = `
                    padding: 10px 14px;
                    border-radius: var(--radius-md);
                    font-size: 0.9rem;
                    max-width: 85%;
                    line-height: 1.5;
                    background: var(--purple-bg);
                    color: var(--text-primary);
                    align-self: flex-start;
                    border-bottom-left-radius: 4px;
                `;
            } else {
                div.style.cssText = `
                    padding: 10px 14px;
                    border-radius: var(--radius-md);
                    font-size: 0.9rem;
                    max-width: 85%;
                    line-height: 1.5;
                    background: var(--purple-primary);
                    color: #fff;
                    align-self: flex-end;
                    border-bottom-right-radius: 4px;
                `;
            }
            
            chatMessages.appendChild(div);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }
        
        function sendMessage() {
            if (!chatInput || !chatSend) return;
            
            const message = chatInput.value.trim();
            if (!message) return;
            
            addChatMessage(message, 'user');
            chatInput.value = '';
            chatInput.disabled = true;
            chatSend.disabled = true;
            
            // Show loading
            const loadingMsg = document.createElement('div');
            loadingMsg.className = 'ai-chat-msg bot';
            loadingMsg.innerHTML = '⏳ Thinking...';
            loadingMsg.style.cssText = `
                padding: 10px 14px;
                border-radius: var(--radius-md);
                font-size: 0.9rem;
                max-width: 85%;
                line-height: 1.5;
                background: var(--purple-bg);
                color: var(--text-primary);
                align-self: flex-start;
                border-bottom-left-radius: 4px;
            `;
            loadingMsg.id = 'aiChatLoading';
            chatMessages.appendChild(loadingMsg);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            
            fetch('/api/ai-tutor', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userPrompt: message })
            })
            .then(response => response.json())
            .then(data => {
                const loading = document.getElementById('aiChatLoading');
                if (loading) loading.remove();
                
                if (data.error) {
                    addChatMessage('❌ ' + data.error, 'bot');
                } else {
                    addChatMessage(data.answer, 'bot');
                }
                chatInput.disabled = false;
                chatSend.disabled = false;
                chatInput.focus();
            })
            .catch(error => {
                const loading = document.getElementById('aiChatLoading');
                if (loading) loading.remove();
                addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                chatInput.disabled = false;
                chatSend.disabled = false;
            });
        }
        
        if (chatSend) {
            chatSend.addEventListener('click', sendMessage);
        }
        
        if (chatInput) {
            chatInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    sendMessage();
                }
            });
        }
    });
</script>

<!-- ============================================================
     KEYBOARD SHORTCUTS (Admin)
     ============================================================ -->
<script>
    document.addEventListener('keydown', function(e) {
        // Ctrl+Shift+D to toggle dark mode
        if (e.ctrlKey && e.shiftKey && e.key === 'D') {
            e.preventDefault();
            document.body.classList.toggle('dark-mode');
            localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light');
        }
        
        // Escape to close chat
        if (e.key === 'Escape') {
            const chatModal = document.getElementById('aiChatModal');
            if (chatModal && chatModal.classList.contains('open')) {
                chatModal.classList.remove('open');
                chatModal.style.display = 'none';
            }
        }
    });
</script>