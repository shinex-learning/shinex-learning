<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verification Failed – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container" style="max-width:500px;">
            <div class="card" style="text-align:center; padding:40px 30px; border:2px solid #e74c3c;">
                <div style="font-size:4rem; color:#e74c3c; margin-bottom:16px;">
                    <i class="fas fa-times-circle"></i>
                </div>
                <h1 style="font-size:1.6rem; font-weight:800; color:#e74c3c; margin:0 0 8px 0;">
                    Verification Failed ❌
                </h1>
                <p style="color:var(--text-muted); font-size:1rem; margin:0 0 16px 0;">
                    The verification link is invalid or has expired.
                </p>
                <p style="color:var(--text-muted); font-size:0.9rem; margin:0 0 16px 0;">
                    Please contact support or try registering again.
                </p>
                <a href="/register" class="btn btn-primary">
                    <i class="fas fa-user-plus"></i> Register Again
                </a>
            </div>
        </div>
    </main>

    <%- include(getFooter()) %>
    <script src="/js/script.js"></script>
</body>
</html>