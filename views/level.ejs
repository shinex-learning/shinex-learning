<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= level.name %> – <%= course.title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container" style="max-width:1400px;">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <div class="level-container">
                <!-- ===== SIDEBAR ===== -->
                <aside class="sidebar" id="levelSidebar">
                    <div class="sidebar-header">
                        <span><%= level.name %></span>
                        <span class="level-badge"><%= totalClasses || 0 %> classes</span>
                    </div>
                    <div class="sidebar-nav">
                        <% if (level.lessons && level.lessons.length) { %>
                            <% level.lessons.forEach((lesson, li) => { %>
                                <div class="sidebar-lesson">
                                    <div class="lesson-header <%= (currentLesson && currentLesson.id === lesson.id) ? 'active' : '' %>">
                                        <span class="lesson-number">L<%= li+1 %></span>
                                        <span class="lesson-title"><%= lesson.title %></span>
                                    </div>
                                    <ul class="class-list">
                                        <% lesson.classes.forEach((cls, ci) => { 
                                            // Find matching class from allClasses array
                                            const classData = allClasses.find(c => c.id === cls.id);
                                            if (!classData) return;
                                        %>
                                            <li class="class-item <%= (classData.completed) ? 'completed' : '' %> <%= (currentClass && currentClass.id === cls.id) ? 'active' : '' %>">
                                                <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= cls.id %>" 
                                                   class="class-link <%= (classData.locked) ? 'locked' : '' %> <%= (classData.completed) ? 'completed' : '' %>"
                                                   <% if (classData.locked) { %> onclick="return false;" <% } %>>
                                                    <span class="class-number"><%= ci+1 %></span>
                                                    <span class="class-title"><%= cls.title %></span>
                                                    <% if (classData.completed) { %>
                                                        <span class="class-status"><i class="fas fa-check-circle" style="color:#27ae60;"></i></span>
                                                    <% } else if (classData.locked) { %>
                                                        <span class="class-status"><i class="fas fa-lock lock-icon"></i></span>
                                                    <% } else { %>
                                                        <span class="class-status"><i class="far fa-circle" style="color:#b0a3c4;"></i></span>
                                                    <% } %>
                                                </a>
                                            </li>
                                        <% }) %>
                                    </ul>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div style="padding:12px 16px; color:var(--text-muted); font-size:0.85rem;">
                                No lessons yet.
                            </div>
                        <% } %>
                    </div>

                    <!-- Sidebar Progress -->
                    <div style="padding:12px 16px; border-top:1px solid #ede8f5; margin-top:4px;">
                        <div style="display:flex; justify-content:space-between; font-size:0.75rem; font-weight:600;">
                            <span>Progress</span>
                            <span><%= completedClasses %>/<%= totalClasses %></span>
                        </div>
                        <div class="progress-wrap" style="height:4px; margin-top:4px;">
                            <div class="progress-fill" style="width:<%= progress || 0 %>%;"></div>
                        </div>
                        <div style="font-size:0.7rem; color:var(--text-muted); margin-top:4px;">
                            <i class="fas fa-star" style="color:var(--primary);"></i> <%= score || 0 %> points
                        </div>
                    </div>
                </aside>

                <!-- ===== MAIN CONTENT ===== -->
                <div class="level-content">
                    <!-- Content Header -->
                    <div class="content-header">
                        <div>
                            <h1><%= currentClass ? currentClass.title : 'Select a class' %></h1>
                            <span style="font-size:0.8rem; color:var(--text-muted);">
                                <i class="fas fa-book-open"></i> 
                                <%= currentLesson ? currentLesson.title : 'Lesson' %>
                            </span>
                        </div>
                        <div>
                            <span class="level-name-badge"><%= level.name %></span>
                        </div>
                    </div>

                    <!-- Content Body -->
                    <div class="content-body">
                        <% if (currentClass) { %>
                            <!-- Class Content -->
                            <div class="class-content">
                                <%= currentClass.content ? currentClass.content : '<p>No content available for this class.</p>' %>
                            </div>

                            <!-- Images -->
                            <% if (currentClass.imageUrl) { %>
                                <div class="class-image">
                                    <img src="<%= currentClass.imageUrl %>" alt="<%= currentClass.title %>" loading="lazy">
                                </div>
                            <% } %>

                            <!-- Video -->
                            <% if (currentClass.videoUrl) { %>
                                <div class="class-video">
                                    <iframe src="<%= currentClass.videoUrl %>" frameborder="0" allowfullscreen></iframe>
                                </div>
                            <% } %>

                            <!-- External Link -->
                            <% if (currentClass.externalLink) { %>
                                <div class="class-external">
                                    <a href="<%= currentClass.externalLink %>" target="_blank" class="btn btn-secondary btn-sm">
                                        <i class="fas fa-external-link-alt"></i> Open External Resource
                                    </a>
                                </div>
                            <% } %>

                            <!-- Class Status -->
                            <div class="class-status-bar">
                                <% if (currentClass.completed) { %>
                                    <span class="status-completed"><i class="fas fa-check-circle"></i> Completed</span>
                                <% } else if (currentClass.locked) { %>
                                    <span class="status-pending"><i class="fas fa-lock"></i> Locked – Complete previous class</span>
                                <% } else { %>
                                    <span class="status-pending"><i class="far fa-circle"></i> Not completed</span>
                                <% } %>
                            </div>

                        <% } else { %>
                            <div class="empty-state" style="padding:40px 20px;">
                                <span class="empty-icon">📚</span>
                                <h3>No Classes Yet</h3>
                                <p>This level is still being built. Check back soon.</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Navigation Buttons -->
                    <div class="content-footer">
                        <div class="nav-buttons">
                            <div>
                                <% if (prevClassId) { %>
                                    <a href="/level/<%= course.id %>/<%= level.id %>/prev/<%= prevClassId %>" class="btn btn-secondary btn-sm">
                                        <i class="fas fa-arrow-left"></i> Previous
                                    </a>
                                <% } else { %>
                                    <span class="btn btn-secondary btn-sm" style="opacity:0.4; cursor:not-allowed;">
                                        <i class="fas fa-arrow-left"></i> Previous
                                    </span>
                                <% } %>
                            </div>

                            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                <!-- Complete & Next button -->
                                <% if (currentClass && !currentClass.completed && !currentClass.locked) { %>
                                    <a href="/level/<%= course.id %>/<%= level.id %>/next/<%= currentClass.id %>" class="btn btn-success btn-sm">
                                        <i class="fas fa-check"></i> Complete &amp; Next
                                    </a>
                                <% } else if (currentClass && currentClass.completed) { %>
                                    <span class="btn btn-success btn-sm" style="opacity:0.6; cursor:default;">
                                        <i class="fas fa-check-circle"></i> Completed
                                    </span>
                                <% } else if (currentClass && currentClass.locked) { %>
                                    <span class="btn btn-secondary btn-sm" style="opacity:0.5; cursor:not-allowed;">
                                        <i class="fas fa-lock"></i> Locked
                                    </span>
                                <% } %>

                                <!-- Next button (without completing) -->
                                <% if (nextClassId && !nextLocked) { %>
                                    <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= nextClassId %>" class="btn btn-primary btn-sm">
                                        Next <i class="fas fa-arrow-right"></i>
                                    </a>
                                <% } else if (nextClassId && nextLocked) { %>
                                    <span class="btn btn-secondary btn-sm" style="opacity:0.5; cursor:not-allowed;">
                                        <i class="fas fa-lock"></i> Next Locked
                                    </span>
                                <% } else if (!nextClassId) { %>
                                    <span class="btn btn-secondary btn-sm" style="opacity:0.4; cursor:not-allowed;">
                                        <i class="fas fa-check"></i> All Complete!
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div class="progress-bar-wrapper">
                            <div class="progress-label">
                                <span>Level Progress</span>
                                <span><%= completedClasses %>/<%= totalClasses %> classes · <%= progress || 0 %>%</span>
                            </div>
                            <div class="progress-wrap" style="height:6px;">
                                <div class="progress-fill" style="width:<%= progress || 0 %>%;"></div>
                            </div>
                            <div class="score-display">
                                <i class="fas fa-star" style="color:var(--primary);"></i> <%= score || 0 %> points earned
                            </div>
                        </div>
                    </div>

                    <!-- ===== LEVEL TEST ===== -->
                    <% if (level.test && level.test.questions && level.test.questions.length > 0) { 
                        // Check if user already took this test
                        const testResult = user && user.testResults && user.testResults[level.id];
                    %>
                        <div class="test-section" style="margin-top:24px;">
                            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap;">
                                <div>
                                    <h4><i class="fas fa-pencil-alt"></i> Level Test</h4>
                                    <p>Test your knowledge after completing all classes.</p>
                                </div>
                                <% if (testResult) { %>
                                    <span class="badge <%= testResult.passed ? 'badge-green' : 'badge-red' %>">
                                        <%= testResult.score %>/<%= testResult.total %> 
                                        (<%= Math.round((testResult.score/testResult.total)*100) %>%)
                                        <%= testResult.passed ? '✅ Passed' : '❌ Failed' %>
                                    </span>
                                <% } %>
                            </div>

                            <% if (testResult) { %>
                                <div style="padding:12px; background:var(--primary-bg); border-radius:8px; margin-top:8px;">
                                    <p style="margin:0;">
                                        <strong>Your result:</strong> <%= testResult.score %> out of <%= testResult.total %> correct.
                                        <%= testResult.passed ? '🎉 Congratulations, you passed this level!' : '📚 Keep reviewing the material and try again.' %>
                                    </p>
                                    <p style="font-size:0.8rem; color:var(--text-muted); margin:4px 0 0;">
                                        Completed on: <%= new Date(testResult.date).toLocaleDateString() %>
                                    </p>
                                </div>
                            <% } else if (completedClasses === totalClasses && totalClasses > 0) { %>
                                <form action="/level/<%= course.id %>/<%= level.id %>/test/submit" method="POST" style="margin-top:12px;">
                                    <% level.test.questions.forEach((q, qi) => { %>
                                        <div class="test-question">
                                            <p class="q-text"><%= qi+1 %>. <%= q.question %></p>
                                            <div class="test-options">
                                                <% q.options.forEach((opt, oi) => { %>
                                                    <label>
                                                        <input type="radio" name="q_<%= q.id %>" value="<%= oi %>" required>
                                                        <%= opt %>
                                                    </label>
                                                <% }) %>
                                            </div>
                                        </div>
                                    <% }) %>
                                    <button type="submit" class="btn btn-gold" style="margin-top:8px;">
                                        <i class="fas fa-paper-plane"></i> Submit Test
                                    </button>
                                </form>
                            <% } else { %>
                                <p style="font-size:0.9rem; color:var(--text-muted); margin-top:8px;">
                                    <i class="fas fa-info-circle"></i> 
                                    Complete all classes (<%= completedClasses %>/<%= totalClasses %>) to unlock the test.
                                </p>
                            <% } %>
                        </div>
                    <% } %>

                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>