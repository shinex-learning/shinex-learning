<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= level.name %> – <%= course.title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           LEVEL PAGE STYLES
           ============================================================ */
        
        /* ----- Layout ----- */
        .level-container {
            display: flex;
            gap: var(--spacing-lg);
            max-width: 1400px;
            margin: 0 auto;
        }
        
        /* ----- Sidebar ----- */
        .sidebar {
            width: 300px;
            min-width: 260px;
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: 12px 0;
            height: fit-content;
            max-height: 80vh;
            overflow-y: auto;
            position: sticky;
            top: 80px;
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .sidebar::-webkit-scrollbar {
            width: 4px;
        }
        
        .sidebar::-webkit-scrollbar-track {
            background: var(--bg-card-secondary);
            border-radius: var(--radius-full);
        }
        
        .sidebar::-webkit-scrollbar-thumb {
            background: var(--purple-primary);
            border-radius: var(--radius-full);
        }
        
        .sidebar .sidebar-header {
            padding: 0 14px 10px 14px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .sidebar .sidebar-header .sidebar-title {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text-primary);
        }
        
        .sidebar .sidebar-header .level-badge {
            font-size: 0.65rem;
            background: var(--purple-primary);
            color: #fff;
            padding: 2px 12px;
            border-radius: var(--radius-full);
            font-weight: 600;
        }
        
        .sidebar .sidebar-nav {
            padding: 6px 0;
        }
        
        .sidebar .sidebar-lesson {
            margin-bottom: 2px;
        }
        
        .sidebar .sidebar-lesson .lesson-header {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            font-weight: 600;
            font-size: 0.8rem;
            color: var(--text-primary);
            background: var(--bg-card-secondary);
            border-left: 3px solid transparent;
            transition: all 0.2s ease;
            cursor: default;
        }
        
        .sidebar .sidebar-lesson .lesson-header.active {
            border-left-color: var(--purple-primary);
            background: var(--purple-bg);
        }
        
        .sidebar .sidebar-lesson .lesson-header .lesson-number {
            font-weight: 700;
            color: var(--purple-primary);
            min-width: 22px;
            font-size: 0.75rem;
        }
        
        .sidebar .sidebar-lesson .lesson-header .lesson-title {
            flex: 1;
            font-size: 0.8rem;
        }
        
        .sidebar .sidebar-lesson .class-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        
        .sidebar .sidebar-lesson .class-list .class-item {
            padding: 0;
            border-bottom: 1px solid var(--border-color);
        }
        
        .sidebar .sidebar-lesson .class-list .class-item:last-child {
            border-bottom: none;
        }
        
        .sidebar .sidebar-lesson .class-list .class-item .class-link {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px 5px 32px;
            font-size: 0.78rem;
            color: var(--text-secondary);
            transition: all 0.2s ease;
            cursor: pointer;
            text-decoration: none;
        }
        
        .sidebar .sidebar-lesson .class-list .class-item .class-link:hover:not(.locked) {
            background: var(--purple-bg);
        }
        
        .sidebar .sidebar-lesson .class-list .class-item .class-link.locked {
            color: var(--text-light) !important;
            cursor: not-allowed;
        }
        
        .sidebar .sidebar-lesson .class-list .class-item .class-link .class-number {
            font-weight: 600;
            color: var(--purple-primary);
            min-width: 28px;
            font-size: 0.7rem;
        }
        
        .sidebar .sidebar-lesson .class-list .class-item .class-link .class-title-text {
            flex: 1;
        }
        
        .sidebar .sidebar-lesson .class-list .class-item .class-link .class-status {
            font-size: 0.7rem;
        }
        
        .sidebar .sidebar-lesson .class-list .class-item.active .class-link {
            background: var(--purple-bg);
            border-left: 3px solid var(--purple-primary);
            padding-left: 29px;
        }
        
        .sidebar .sidebar-lesson .class-list .class-item.completed .class-link {
            color: var(--text-success);
        }
        
        .sidebar .sidebar-lesson .class-list .class-item.completed .class-link .class-number {
            color: var(--text-success);
        }
        
        .sidebar .sidebar-progress {
            padding: 12px 14px;
            border-top: 1px solid var(--border-color);
            margin-top: 4px;
        }
        
        .sidebar .sidebar-progress .progress-header {
            display: flex;
            justify-content: space-between;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-primary);
        }
        
        .sidebar .sidebar-progress .progress-bar {
            height: 4px;
            background: var(--bg-card-secondary);
            border-radius: var(--radius-full);
            overflow: hidden;
            margin-top: 4px;
        }
        
        .sidebar .sidebar-progress .progress-bar .progress-fill {
            height: 100%;
            background: var(--purple-gradient);
            border-radius: var(--radius-full);
            transition: width 0.6s ease;
        }
        
        .sidebar .sidebar-progress .score-display {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 4px;
        }
        
        .sidebar .sidebar-progress .score-display i {
            color: var(--purple-primary);
            margin-right: 4px;
        }
        
        /* ----- Main Content ----- */
        .level-content {
            flex: 1;
            min-width: 0;
        }
        
        /* ----- Content Header ----- */
        .content-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            background: var(--bg-card);
            border-radius: var(--radius-lg) var(--radius-lg) 0 0;
            border: 1px solid var(--border-color);
            border-bottom: none;
            transition: all 0.3s ease;
            flex-wrap: wrap;
            gap: 8px;
        }
        
        .content-header .header-left h1 {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        
        .content-header .header-left .lesson-name {
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        
        .content-header .header-left .lesson-name i {
            margin-right: 4px;
        }
        
        .content-header .level-badge {
            background: var(--purple-primary);
            color: #fff;
            padding: 4px 14px;
            border-radius: var(--radius-full);
            font-size: 0.7rem;
            font-weight: 600;
            white-space: nowrap;
        }
        
        /* ----- Content Body ----- */
        .content-body {
            background: var(--bg-card);
            padding: var(--spacing-lg);
            border: 1px solid var(--border-color);
            border-top: none;
            border-radius: 0 0 var(--radius-lg) var(--radius-lg);
            transition: all 0.3s ease;
        }
        
        .content-body .class-content {
            font-size: 1.05rem;
            line-height: 1.9;
            color: var(--text-secondary);
        }
        
        .content-body .class-content h1,
        .content-body .class-content h2,
        .content-body .class-content h3 {
            color: var(--text-primary);
            margin-top: 1.2rem;
            margin-bottom: 0.5rem;
        }
        
        .content-body .class-content p {
            margin-bottom: 0.8rem;
        }
        
        .content-body .class-content ul,
        .content-body .class-content ol {
            padding-left: 1.5rem;
            margin-bottom: 0.8rem;
        }
        
        .content-body .class-content li {
            margin-bottom: 0.3rem;
        }
        
        .content-body .class-content strong,
        .content-body .class-content b {
            font-weight: 700;
            color: var(--text-primary);
        }
        
        .content-body .class-content hr {
            border: none;
            border-top: 2px solid var(--border-color);
            margin: 1rem 0;
        }
        
        .content-body .class-image {
            margin: var(--spacing-sm) 0;
        }
        
        .content-body .class-image img {
            max-width: 100%;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }
        
        .content-body .class-video {
            margin: var(--spacing-sm) 0;
        }
        
        .content-body .class-video iframe {
            width: 100%;
            border-radius: var(--radius-sm);
            aspect-ratio: 16/9;
            border: 1px solid var(--border-color);
        }
        
        .content-body .class-external {
            margin: var(--spacing-sm) 0;
        }
        
        .content-body .class-external .btn-external {
            padding: 8px 20px;
            border-radius: var(--radius-full);
            background: var(--bg-card-secondary);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            text-decoration: none;
            display: inline-block;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .content-body .class-external .btn-external:hover {
            border-color: var(--purple-primary);
            color: var(--purple-primary);
        }
        
        .content-body .class-external .btn-external i {
            margin-right: 6px;
        }
        
        .content-body .class-status-bar {
            margin-top: var(--spacing-md);
            padding-top: var(--spacing-sm);
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
            font-size: 0.85rem;
        }
        
        .content-body .class-status-bar .status-completed {
            color: var(--text-success);
            font-weight: 600;
        }
        
        .content-body .class-status-bar .status-pending {
            color: var(--text-muted);
            font-weight: 600;
        }
        
        .content-body .class-status-bar .status-locked {
            color: var(--text-light);
            font-weight: 600;
        }
        
        /* ----- Content Footer ----- */
        .content-footer {
            margin-top: var(--spacing-md);
            padding: var(--spacing-md);
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }
        
        .content-footer .nav-buttons {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: var(--spacing-sm);
            flex-wrap: wrap;
        }
        
        .content-footer .nav-buttons .btn {
            min-width: 120px;
            justify-content: center;
        }
        
        .content-footer .nav-buttons .nav-right {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        
        .content-footer .progress-wrapper {
            margin-top: var(--spacing-md);
            padding-top: var(--spacing-sm);
            border-top: 1px solid var(--border-color);
        }
        
        .content-footer .progress-wrapper .progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--text-primary);
            margin-bottom: 4px;
        }
        
        .content-footer .progress-wrapper .progress-bar {
            height: 6px;
            background: var(--bg-card-secondary);
            border-radius: var(--radius-full);
            overflow: hidden;
        }
        
        .content-footer .progress-wrapper .progress-bar .progress-fill {
            height: 100%;
            background: var(--purple-gradient);
            border-radius: var(--radius-full);
            transition: width 0.6s ease;
        }
        
        .content-footer .progress-wrapper .score-display {
            margin-top: 4px;
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        
        .content-footer .progress-wrapper .score-display i {
            color: var(--purple-primary);
            margin-right: 4px;
        }
        
        /* ----- Test Section ----- */
        .test-section {
            margin-top: var(--spacing-lg);
            padding: var(--spacing-lg);
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 2px solid var(--text-warning);
            transition: all 0.3s ease;
        }
        
        .test-section .test-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-sm);
        }
        
        .test-section .test-header h4 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        
        .test-section .test-header h4 i {
            color: var(--text-warning);
            margin-right: 6px;
        }
        
        .test-section .test-header p {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin: 0;
        }
        
        .test-section .test-header .test-badge {
            padding: 4px 16px;
            border-radius: var(--radius-full);
            font-weight: 600;
            font-size: 0.8rem;
        }
        
        .test-section .test-header .test-badge.passed {
            background: var(--bg-alert-success);
            color: var(--text-success);
        }
        
        .test-section .test-header .test-badge.failed {
            background: var(--bg-alert-error);
            color: var(--text-error);
        }
        
        .test-section .test-result {
            padding: var(--spacing-sm) var(--spacing-md);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            margin-top: var(--spacing-sm);
        }
        
        .test-section .test-result .result-text {
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--text-primary);
        }
        
        .test-section .test-result .result-text .score {
            color: var(--purple-primary);
        }
        
        .test-section .test-result .result-message {
            color: var(--text-secondary);
            margin: 4px 0 0 0;
            font-size: 0.9rem;
        }
        
        .test-section .test-result .result-date {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 4px 0 0 0;
        }
        
        .test-section .test-question {
            padding: var(--spacing-sm) 0;
            border-bottom: 1px solid var(--border-color);
        }
        
        .test-section .test-question:last-child {
            border-bottom: none;
        }
        
        .test-section .test-question .q-text {
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .test-section .test-options {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-top: 4px;
        }
        
        .test-section .test-options label {
            font-weight: 400;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: var(--radius-sm);
            transition: all 0.2s ease;
            color: var(--text-secondary);
        }
        
        .test-section .test-options label:hover {
            background: var(--purple-bg);
        }
        
        .test-section .test-options input[type="radio"] {
            width: auto;
            accent-color: var(--purple-primary);
            cursor: pointer;
        }
        
        .test-section .btn-submit-test {
            margin-top: var(--spacing-sm);
            padding: 10px 32px;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: var(--radius-full);
            background: var(--text-warning);
            color: #fff;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .test-section .btn-submit-test:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3);
        }
        
        .test-section .test-locked {
            margin-top: var(--spacing-sm);
            font-size: 0.9rem;
            color: var(--text-muted);
        }
        
        .test-section .test-locked i {
            margin-right: 6px;
        }
        
        /* ----- Empty State ----- */
        .empty-state {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-md);
        }
        
        .empty-state .empty-icon {
            font-size: 3rem;
            display: block;
            margin-bottom: var(--spacing-sm);
            opacity: 0.5;
        }
        
        .empty-state h3 {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .empty-state p {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin: 0;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 1024px) {
            .level-container {
                flex-direction: column;
            }
            
            .sidebar {
                width: 100%;
                min-width: unset;
                max-height: 300px;
                position: relative;
                top: 0;
            }
        }
        
        @media (max-width: 768px) {
            .content-header {
                flex-direction: column;
                align-items: flex-start;
                padding: var(--spacing-md);
            }
            
            .content-body {
                padding: var(--spacing-md);
            }
            
            .content-body .class-content {
                font-size: 0.95rem;
            }
            
            .content-footer .nav-buttons {
                flex-direction: column;
                align-items: stretch;
            }
            
            .content-footer .nav-buttons .btn {
                min-width: unset;
                width: 100%;
            }
            
            .content-footer .nav-buttons .nav-right {
                flex-direction: column;
            }
            
            .test-section {
                padding: var(--spacing-md);
            }
            
            .test-section .test-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>

    <!-- ===== HEADER ===== -->
    <%- include('partials/header', { showBack: true }) %>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="container">
            <div style="max-width:1400px; margin:0 auto;">

                <!-- ===== FLASH MESSAGES ===== -->
                <% if (messages && messages.success) { %>
                    <div class="alert alert-success flash-message" data-type="success">
                        <i class="fas fa-check-circle"></i> <%= messages.success %>
                    </div>
                <% } %>
                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger flash-message" data-type="error">
                        <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                    </div>
                <% } %>

                <!-- ===== LEVEL CONTAINER ===== -->
                <div class="level-container">

                    <!-- ===== SIDEBAR ===== -->
                    <aside class="sidebar" id="levelSidebar">
                        <!-- Sidebar Header -->
                        <div class="sidebar-header">
                            <span class="sidebar-title"><i class="fas fa-layer-group"></i> <%= level.name %></span>
                            <span class="level-badge"><%= totalClasses || 0 %> classes</span>
                        </div>

                        <!-- Sidebar Navigation -->
                        <div class="sidebar-nav">
                            <% if (level.lessons && level.lessons.length > 0) { %>
                                <% level.lessons.forEach((lesson, lessonIndex) => { %>
                                    <div class="sidebar-lesson">
                                        <div class="lesson-header <%= (currentLesson && currentLesson.id === lesson.id) ? 'active' : '' %>">
                                            <span class="lesson-number"><%= lessonIndex + 1 %></span>
                                            <span class="lesson-title"><%= lesson.title %></span>
                                        </div>
                                        <ul class="class-list">
                                            <% if (lesson.classes && lesson.classes.length > 0) { %>
                                                <% lesson.classes.forEach((cls, classIndex) => { 
                                                    const classData = allClasses ? allClasses.find(c => c.id === cls.id) : null;
                                                    if (!classData) return;
                                                %>
                                                    <li class="class-item <%= classData.completed ? 'completed' : '' %> <%= (currentClass && currentClass.id === cls.id) ? 'active' : '' %>">
                                                        <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= cls.id %>" 
                                                           class="class-link <%= classData.locked ? 'locked' : '' %>"
                                                           <% if (classData.locked) { %> onclick="return false;" <% } %>>
                                                            <span class="class-number"><%= classIndex + 1 %></span>
                                                            <span class="class-title-text"><%= cls.title %></span>
                                                            <span class="class-status">
                                                                <% if (classData.completed) { %>
                                                                    <i class="fas fa-check-circle" style="color:var(--text-success);"></i>
                                                                <% } else if (classData.locked) { %>
                                                                    <i class="fas fa-lock" style="color:var(--text-light);"></i>
                                                                <% } else { %>
                                                                    <i class="far fa-circle" style="color:var(--text-muted);"></i>
                                                                <% } %>
                                                            </span>
                                                        </a>
                                                    </li>
                                                <% }) %>
                                            <% } else { %>
                                                <li style="padding:4px 14px 4px 32px; font-size:0.75rem; color:var(--text-muted);">
                                                    <i class="fas fa-info-circle"></i> No classes
                                                </li>
                                            <% } %>
                                        </ul>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div style="padding:12px 16px; color:var(--text-muted); font-size:0.85rem;">
                                    <i class="fas fa-info-circle"></i> No lessons yet.
                                </div>
                            <% } %>
                        </div>

                        <!-- Sidebar Progress -->
                        <div class="sidebar-progress">
                            <div class="progress-header">
                                <span>Progress</span>
                                <span><%= completedClasses %>/<%= totalClasses %></span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: <%= progress || 0 %>%;"></div>
                            </div>
                            <div class="score-display">
                                <i class="fas fa-star"></i> <%= score || 0 %> points
                            </div>
                        </div>
                    </aside>

                    <!-- ===== MAIN CONTENT ===== -->
                    <div class="level-content">

                        <!-- ===== CONTENT HEADER ===== -->
                        <div class="content-header">
                            <div class="header-left">
                                <h1><%= currentClass ? currentClass.title : 'Select a class' %></h1>
                                <div class="lesson-name">
                                    <i class="fas fa-book-open"></i> 
                                    <%= currentLesson ? currentLesson.title : 'Lesson' %>
                                </div>
                            </div>
                            <div>
                                <span class="level-badge"><%= level.name %></span>
                            </div>
                        </div>

                        <!-- ===== CONTENT BODY ===== -->
                        <div class="content-body">
                            <% if (currentClass) { %>
                                
                                <!-- Class Content -->
                                <div class="class-content">
                                    <%= currentClass.content ? currentClass.content : '<p>No content available for this class.</p>' %>
                                </div>

                                <!-- Images -->
                                <% if (currentClass.imageUrl) { %>
                                    <div class="class-image">
                                        <img src="<%= currentClass.imageUrl %>" alt="<%= currentClass.title %>" loading="lazy">
                                    </div>
                                <% } %>

                                <!-- Video -->
                                <% if (currentClass.videoUrl) { %>
                                    <div class="class-video">
                                        <iframe src="<%= currentClass.videoUrl %>" frameborder="0" allowfullscreen></iframe>
                                    </div>
                                <% } %>

                                <!-- External Link -->
                                <% if (currentClass.externalLink) { %>
                                    <div class="class-external">
                                        <a href="<%= currentClass.externalLink %>" target="_blank" class="btn-external">
                                            <i class="fas fa-external-link-alt"></i> Open External Resource
                                        </a>
                                    </div>
                                <% } %>

                                <!-- Class Status -->
                                <div class="class-status-bar">
                                    <% if (currentClass.completed) { %>
                                        <span class="status-completed"><i class="fas fa-check-circle"></i> Completed</span>
                                    <% } else if (currentClass.locked) { %>
                                        <span class="status-locked"><i class="fas fa-lock"></i> Locked – Complete previous class</span>
                                    <% } else { %>
                                        <span class="status-pending"><i class="far fa-circle"></i> Not completed</span>
                                    <% } %>
                                </div>

                            <% } else { %>
                                <div class="empty-state">
                                    <span class="empty-icon">📚</span>
                                    <h3>No Classes Yet</h3>
                                    <p>This level is still being built. Check back soon.</p>
                                </div>
                            <% } %>
                        </div>

                        <!-- ===== CONTENT FOOTER ===== -->
                        <div class="content-footer">
                            <div class="nav-buttons">
                                <!-- Previous Button -->
                                <div>
                                    <% if (prevClassId) { %>
                                        <a href="/level/<%= course.id %>/<%= level.id %>/prev/<%= prevClassId %>" class="btn btn-secondary">
                                            <i class="fas fa-arrow-left"></i> Previous
                                        </a>
                                    <% } else { %>
                                        <span class="btn btn-secondary" style="opacity:0.4; cursor:not-allowed;">
                                            <i class="fas fa-arrow-left"></i> Previous
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Right Side: Complete & Next -->
                                <div class="nav-right">
                                    <!-- Complete & Next -->
                                    <% if (currentClass && !currentClass.completed && !currentClass.locked) { %>
                                        <a href="/level/<%= course.id %>/<%= level.id %>/next/<%= currentClass.id %>" class="btn btn-success">
                                            <i class="fas fa-check"></i> Complete &amp; Next
                                        </a>
                                    <% } else if (currentClass && currentClass.completed) { %>
                                        <span class="btn btn-success" style="opacity:0.6; cursor:default;">
                                            <i class="fas fa-check-circle"></i> Completed
                                        </span>
                                    <% } else if (currentClass && currentClass.locked) { %>
                                        <span class="btn btn-secondary" style="opacity:0.5; cursor:not-allowed;">
                                            <i class="fas fa-lock"></i> Locked
                                        </span>
                                    <% } %>

                                    <!-- Next -->
                                    <% if (nextClassId && !nextLocked) { %>
                                        <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= nextClassId %>" class="btn btn-primary">
                                            Next <i class="fas fa-arrow-right"></i>
                                        </a>
                                    <% } else if (nextClassId && nextLocked) { %>
                                        <span class="btn btn-secondary" style="opacity:0.5; cursor:not-allowed;">
                                            <i class="fas fa-lock"></i> Locked
                                        </span>
                                    <% } else if (!nextClassId) { %>
                                        <span class="btn btn-secondary" style="opacity:0.4; cursor:not-allowed;">
                                            <i class="fas fa-check"></i> Complete!
                                        </span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Progress -->
                            <div class="progress-wrapper">
                                <div class="progress-label">
                                    <span>Level Progress</span>
                                    <span><%= completedClasses %>/<%= totalClasses %> classes · <%= progress || 0 %>%</span>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill" style="width: <%= progress || 0 %>%;"></div>
                                </div>
                                <div class="score-display">
                                    <i class="fas fa-star"></i> <%= score || 0 %> points earned
                                </div>
                            </div>
                        </div>

                        <!-- ===== LEVEL TEST ===== -->
                        <% if (level.test && level.test.questions && level.test.questions.length > 0) { 
                            const testResult = user && user.testResults && user.testResults[level.id];
                        %>
                            <div class="test-section">
                                <div class="test-header">
                                    <div>
                                        <h4><i class="fas fa-pencil-alt"></i> Level Test</h4>
                                        <p>Test your knowledge after completing all classes.</p>
                                    </div>
                                    <% if (testResult) { %>
                                        <span class="test-badge <%= testResult.passed ? 'passed' : 'failed' %>">
                                            <%= testResult.score %>/<%= testResult.total %> 
                                            (<%= Math.round((testResult.score/testResult.total)*100) %>%)
                                            <%= testResult.passed ? '✅ Passed' : '❌ Failed' %>
                                        </span>
                                    <% } %>
                                </div>

                                <% if (testResult) { %>
                                    <div class="test-result">
                                        <div class="result-text">
                                            <strong>Your result:</strong> <span class="score"><%= testResult.score %></span> out of <span class="score"><%= testResult.total %></span> correct.
                                        </div>
                                        <div class="result-message">
                                            <%= testResult.passed ? '🎉 Congratulations, you passed this level!' : '📚 Keep reviewing the material and try again.' %>
                                        </div>
                                        <div class="result-date">
                                            Completed on: <%= new Date(testResult.date).toLocaleDateString() %>
                                        </div>
                                    </div>
                                <% } else if (completedClasses === totalClasses && totalClasses > 0) { %>
                                    <form action="/level/<%= course.id %>/<%= level.id %>/test/submit" method="POST">
                                        <% level.test.questions.forEach((q, qIndex) => { %>
                                            <div class="test-question">
                                                <p class="q-text"><%= qIndex + 1 %>. <%= q.question %></p>
                                                <div class="test-options">
                                                    <% q.options.forEach((opt, oIndex) => { %>
                                                        <label>
                                                            <input type="radio" name="q_<%= q.id %>" value="<%= oIndex %>" required>
                                                            <%= opt %>
                                                        </label>
                                                    <% }) %>
                                                </div>
                                            </div>
                                        <% }) %>
                                        <button type="submit" class="btn-submit-test">
                                            <i class="fas fa-paper-plane"></i> Submit Test
                                        </button>
                                    </form>
                                <% } else { %>
                                    <div class="test-locked">
                                        <i class="fas fa-lock"></i> 
                                        Complete all classes (<%= completedClasses %>/<%= totalClasses %>) to unlock the test.
                                    </div>
                                <% } %>
                            </div>
                        <% } %>

                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>
</body>
</html>