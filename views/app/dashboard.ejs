<%
let totalClasses = 0;
let completedClasses = 0;
let certificatesEarned = 0;
let progress = 0;
let coursesEnrolled = 0;

if (user && user.courseId) {
    const enrolledCourse = courses ? courses.find(c => c.id === user.courseId) : null;
    if (enrolledCourse && enrolledCourse.levels && user.progress) {
        enrolledCourse.levels.forEach(level => {
            if (level.lessons) {
                level.lessons.forEach(lesson => {
                    if (lesson.classes) {
                        lesson.classes.forEach(cls => {
                            totalClasses++;
                            if (user.progress && user.progress[cls.id]) completedClasses++;
                        });
                    }
                });
            }
        });
        certificatesEarned = Math.floor(completedClasses / 10);
        progress = totalClasses > 0 ? Math.round((completedClasses / totalClasses) * 100) : 0;
    }
    coursesEnrolled = 1;
}

const body = `
<section class="dashboard-welcome">
    <div class="welcome-card">
        <div class="welcome-text">
            <h2>Welcome back, <span><%= user ? user.firstName : 'Student' %></span></h2>
            <p>Keep learning today!</p>
        </div>
        <div class="welcome-avatar">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
    </div>
</section>

<section class="dashboard-stats">
    <div class="stats-grid-2">
        <div class="stat-card-lg">
            <div class="stat-icon-lg"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
            <div class="stat-info">
                <div class="stat-number-lg"><%= progress %>%</div>
                <div class="stat-label-lg">Your Progress</div>
                <div class="progress-bar"><div class="progress-fill" style="width: <%= progress %>%"></div></div>
            </div>
        </div>
        <div class="stat-card-lg">
            <div class="stat-icon-lg"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg></div>
            <div class="stat-info">
                <div class="stat-number-lg"><%= coursesEnrolled %></div>
                <div class="stat-label-lg">Courses Enrolled</div>
            </div>
        </div>
        <div class="stat-card-lg">
            <div class="stat-icon-lg"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
            <div class="stat-info">
                <div class="stat-number-lg"><%= completedClasses %></div>
                <div class="stat-label-lg">Lessons Completed</div>
            </div>
        </div>
        <div class="stat-card-lg">
            <div class="stat-icon-lg"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg></div>
            <div class="stat-info">
                <div class="stat-number-lg"><%= certificatesEarned %></div>
                <div class="stat-label-lg">Certificates Earned</div>
            </div>
        </div>
    </div>
</section>

<section class="dashboard-courses">
    <div class="section-header">
        <h2>Your Courses</h2>
        <a href="/app/courses" class="view-all-link">View all <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    </div>
    <div class="courses-grid">
        <% if (user && user.courseId) { 
            const enrolledCourse = courses ? courses.find(c => c.id === user.courseId) : null;
            if (enrolledCourse) { 
                let lessonCount = 0;
                if (enrolledCourse.levels) {
                    enrolledCourse.levels.forEach(level => {
                        if (level.lessons) {
                            level.lessons.forEach(lesson => {
                                if (lesson.classes) lessonCount += lesson.classes.length;
                            });
                        }
                    });
                }
        %>
            <div class="course-card">
                <div class="course-image" style="background: linear-gradient(135deg, #8B5CF6, #6a3dcf);">
                    <span class="course-level"><%= enrolledCourse.level || 'Beginner' %></span>
                </div>
                <div class="course-info">
                    <h3><%= enrolledCourse.title %></h3>
                    <div class="course-meta">
                        <span class="meta-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> <%= lessonCount %> Lessons</span>
                        <span class="meta-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> <%= enrolledCourse.duration || 'Flexible' %></span>
                    </div>
                    <div class="course-progress-small">
                        <span>Progress: <%= progress %>%</span>
                        <div class="progress-bar-small"><div class="progress-fill-small" style="width: <%= progress %>%"></div></div>
                    </div>
                    <a href="/app/course/<%= enrolledCourse.id %>" class="btn btn-primary btn-sm btn-block">Continue Learning</a>
                </div>
            </div>
        <% } else { %>
            <div class="empty-state"><p>You haven't enrolled in any course yet.</p><a href="/app/courses" class="btn btn-primary btn-sm" style="margin-top: 12px;">Browse Courses</a></div>
        <% } %>
        <% } else { %>
            <div class="empty-state"><p>You haven't enrolled in any course yet.</p><a href="/app/courses" class="btn btn-primary btn-sm" style="margin-top: 12px;">Browse Courses</a></div>
        <% } %>
    </div>
</section>
`;
%>
<%- include('../partials/app-layout', { body: body, user: user, title: title, messages: messages }) %>