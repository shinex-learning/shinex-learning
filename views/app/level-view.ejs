<%
const body = `
<section class="level-header">
    <div class="level-header-content">
        <a href="/app/course/<%= course.id %>" class="level-back">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            Back to Course
        </a>
        <h1><%= level.name %></h1>
        <p><%= course.title %></p>
    </div>
</section>

<section class="level-progress">
    <div class="level-progress-card">
        <div class="level-progress-header">
            <span>Level Progress</span>
            <span class="level-progress-percent"><%= progress %>%</span>
        </div>
        <div class="progress-bar"><div class="progress-fill" style="width: <%= progress %>%"></div></div>
        <div class="level-progress-stats">
            <span><%= completedClasses %> / <%= totalClasses %> classes completed</span>
            <span><%= score %> points</span>
        </div>
    </div>
</section>

<section class="level-classes">
    <h2>Classes</h2>
    <div class="classes-list">
        <% allClasses.forEach((cls, index) => { %>
            <div class="class-item <%= cls.completed ? 'completed' : '' %> <%= cls.locked ? 'locked' : '' %>">
                <div class="class-status">
                    <% if (cls.completed) { %>
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#27ae60" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="16 8 10 14 8 12"/></svg>
                    <% } else if (cls.locked) { %>
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7a6a8f" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                    <% } else { %>
                        <div class="class-number"><%= index + 1 %></div>
                    <% } %>
                </div>
                <div class="class-info">
                    <h4><%= cls.title %></h4>
                    <span class="class-lesson"><%= cls.lessonTitle %></span>
                </div>
                <div class="class-action">
                    <% if (cls.completed) { %>
                        <span class="class-done">Done</span>
                    <% } else if (cls.locked) { %>
                        <span class="class-locked">Locked</span>
                    <% } else { %>
                        <a href="/app/level/<%= course.id %>/<%= level.id %>?classId=<%= cls.id %>" class="btn btn-primary btn-sm">Start</a>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</section>
`;
%>
<%- include('../partials/app-layout', { body: body, user: user, title: title, messages: messages }) %>