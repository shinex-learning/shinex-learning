<%
const body = `
<div class="verify-container">
    <div class="verify-card error-card">
        <div class="verify-icon error-icon">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <h1>Verification Failed</h1>
        <p><%= messages && messages.error ? messages.error : 'Invalid or expired verification token.' %></p>
        <div class="verify-actions">
            <a href="/app/register" class="btn btn-primary btn-block">Register Again</a>
            <a href="/app/login" class="btn btn-secondary btn-block">Back to Login</a>
        </div>
    </div>
</div>
`;
%>
<%- include('../partials/app-layout', { body: body, user: user, title: title, messages: messages }) %>