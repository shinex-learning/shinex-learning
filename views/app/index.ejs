<%
const totalCourses = courses ? courses.length : 0;
const body = `
<section class="hero-section">
    <div class="hero-gradient">
        <div class="hero-content">
            <div class="brand-badge">SHINEX Learning Circle</div>
            <h1 class="hero-title">Learn Skills.<br><span>Build Knowledge.</span><br>Shape Your Future.</h1>
            <p class="hero-subtitle">SHINEX Learning Circle (SLC) is your trusted online learning platform. Study at your own pace and earn certificates.</p>
            <div class="hero-actions">
                <a href="/app/courses" class="btn btn-primary btn-block">Explore Courses</a>
                <a href="#how-it-works" class="btn btn-outline btn-block">How It Works</a>
            </div>
        </div>
    </div>
</section>

<section class="stats-section">
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg></div>
            <div class="stat-number"><%= totalCourses %></div>
            <div class="stat-label">Courses Available</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2"><path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg></div>
            <div class="stat-number">500+</div>
            <div class="stat-label">Students Enrolled</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg></div>
            <div class="stat-number">100+</div>
            <div class="stat-label">Video Lessons</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg></div>
            <div class="stat-number">24/7</div>
            <div class="stat-label">AI Tutor Support</div>
        </div>
    </div>
</section>

<section class="courses-section">
    <div class="section-header">
        <h2>Popular Courses</h2>
        <a href="/app/courses" class="view-all-link">View all <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    </div>
    <div class="courses-grid">
        <% if (courses && courses.length > 0) { %>
            <% courses.slice(0, 6).forEach(course => { 
                let lessonCount = 0;
                if (course.levels) {
                    course.levels.forEach(level => {
                        if (level.lessons) {
                            level.lessons.forEach(lesson => {
                                if (lesson.classes) lessonCount += lesson.classes.length;
                            });
                        }
                    });
                }
            %>
                <div class="course-card">
                    <div class="course-image" style="background: linear-gradient(135deg, #8B5CF6, #6a3dcf);">
                        <span class="course-level"><%= course.level || 'Beginner' %></span>
                    </div>
                    <div class="course-info">
                        <h3><%= course.title %></h3>
                        <div class="course-meta">
                            <span class="meta-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> <%= lessonCount %> Lessons</span>
                            <span class="meta-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> <%= course.duration || 'Flexible' %></span>
                        </div>
                        <a href="/app/course/<%= course.id %>" class="btn btn-primary btn-sm btn-block">Start Learning</a>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="empty-state"><p>No courses available yet. Check back soon!</p></div>
        <% } %>
    </div>
</section>
`;
%>
<%- include('../partials/app-layout', { body: body, user: user, title: title, messages: messages }) %>