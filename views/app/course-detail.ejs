<%
let totalClasses = 0;
let completedClasses = 0;
let progress = 0;
if (course.levels && user && user.progress) {
    course.levels.forEach(level => {
        if (level.lessons) {
            level.lessons.forEach(lesson => {
                if (lesson.classes) {
                    lesson.classes.forEach(cls => {
                        totalClasses++;
                        if (user.progress && user.progress[cls.id]) completedClasses++;
                    });
                }
            });
        }
    });
}
progress = totalClasses > 0 ? Math.round((completedClasses / totalClasses) * 100) : 0;
%>

<!-- Course Header -->
<section class="course-detail-header">
    <div class="course-detail-banner" style="background: linear-gradient(135deg, #8B5CF6, #6a3dcf);">
        <div class="course-detail-overlay">
            <span class="course-detail-level"><%= course.level || 'Beginner' %></span>
            <h1><%= course.title %></h1>
            <p><%= course.description || 'Learn essential skills in this comprehensive course.' %></p>
            <div class="course-detail-meta">
                <span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    <%= totalClasses %> Lessons
                </span>
                <span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    <%= course.duration || 'Flexible' %>
                </span>
            </div>
        </div>
    </div>
</section>

<!-- Progress -->
<section class="course-detail-progress">
    <div class="progress-card">
        <div class="progress-header">
            <span>Your Progress</span>
            <span class="progress-percent"><%= progress %>%</span>
        </div>
        <div class="progress-bar">
            <div class="progress-fill" style="width: <%= progress %>%"></div>
        </div>
        <div class="progress-stats">
            <span><%= completedClasses %> / <%= totalClasses %> lessons completed</span>
            <span><%= completedClasses * 10 %> points earned</span>
        </div>
    </div>
</section>

<!-- Levels -->
<section class="course-detail-levels">
    <h2>Course Levels</h2>
    <div class="levels-list">
        <% if (course.levels && course.levels.length > 0) { %>
            <% course.levels.forEach(level => { 
                let levelClasses = 0;
                let levelCompleted = 0;
                if (level.lessons) {
                    level.lessons.forEach(lesson => {
                        if (lesson.classes) {
                            lesson.classes.forEach(cls => {
                                levelClasses++;
                                if (user && user.progress && user.progress[cls.id]) levelCompleted++;
                            });
                        }
                    });
                }
                let levelProgress = levelClasses > 0 ? Math.round((levelCompleted / levelClasses) * 100) : 0;
            %>
                <a href="/app/level/<%= course.id %>/<%= level.id %>" class="level-item">
                    <div class="level-info">
                        <div class="level-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2">
                                <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                            </svg>
                        </div>
                        <div>
                            <h4><%= level.name %></h4>
                            <span class="level-meta"><%= level.duration || 'Self-paced' %> • <%= levelClasses %> lessons</span>
                        </div>
                    </div>
                    <div class="level-right">
                        <span class="level-progress-text"><%= levelProgress %>%</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7a6a8f" stroke-width="2">
                            <path d="M9 18l6-6-6-6"/>
                        </svg>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <div class="empty-state">
                <p>No levels available for this course.</p>
            </div>
        <% } %>
    </div>
</section>