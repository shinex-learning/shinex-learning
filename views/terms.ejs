<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Terms & Conditions – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           TERMS & CONDITIONS STYLES
           ============================================================ */
        
        .terms-container {
            max-width: 900px;
            margin: 0 auto;
        }
        
        /* ----- Page Header ----- */
        .terms-header {
            margin-bottom: var(--spacing-lg);
        }
        
        .terms-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .terms-header h1 i {
            color: var(--purple-primary);
        }
        
        .terms-header .last-updated {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin: 0;
        }
        
        .terms-header .last-updated strong {
            color: var(--text-secondary);
        }
        
        /* ----- Terms Card ----- */
        .terms-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-xl) var(--spacing-lg);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .terms-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        /* ----- Sections ----- */
        .terms-card .section {
            margin-bottom: var(--spacing-lg);
        }
        
        .terms-card .section:last-child {
            margin-bottom: 0;
        }
        
        .terms-card .section .section-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--purple-primary);
            margin: 0 0 6px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .terms-card .section .section-title .section-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--purple-bg);
            color: var(--purple-primary);
            font-size: 0.7rem;
            font-weight: 700;
            flex-shrink: 0;
        }
        
        .terms-card .section p {
            font-size: 0.95rem;
            line-height: 1.8;
            color: var(--text-secondary);
            margin: 0 0 8px 0;
        }
        
        .terms-card .section p:last-child {
            margin-bottom: 0;
        }
        
        .terms-card .section ul {
            padding-left: var(--spacing-md);
            margin: 4px 0 0 0;
        }
        
        .terms-card .section ul li {
            font-size: 0.95rem;
            line-height: 1.8;
            color: var(--text-secondary);
            margin-bottom: 4px;
        }
        
        .terms-card .section ul li strong {
            color: var(--text-primary);
        }
        
        .terms-card .section a {
            color: var(--purple-primary);
            text-decoration: none;
            font-weight: 500;
        }
        
        .terms-card .section a:hover {
            text-decoration: underline;
        }
        
        .terms-card .section .contact-list {
            list-style: none;
            padding: 0;
            margin: 4px 0 0 0;
        }
        
        .terms-card .section .contact-list li {
            font-size: 0.95rem;
            line-height: 1.8;
            color: var(--text-secondary);
            padding: 4px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .terms-card .section .contact-list li i {
            color: var(--purple-primary);
            width: 20px;
            text-align: center;
        }
        
        .terms-card .section .contact-list li a {
            color: var(--purple-primary);
            text-decoration: none;
        }
        
        .terms-card .section .contact-list li a:hover {
            text-decoration: underline;
        }
        
        /* ----- Divider ----- */
        .terms-card .section-divider {
            height: 1px;
            background: var(--border-color);
            margin: var(--spacing-md) 0;
        }
        
        /* ----- Back Link ----- */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.95rem;
            margin-top: var(--spacing-md);
            transition: all 0.3s ease;
        }
        
        .back-link:hover {
            color: var(--purple-primary);
        }
        
        .back-link i {
            font-size: 0.85rem;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 768px) {
            .terms-header h1 {
                font-size: 1.5rem;
            }
            
            .terms-card {
                padding: var(--spacing-md);
            }
            
            .terms-card .section .section-title {
                font-size: 1rem;
            }
            
            .terms-card .section p,
            .terms-card .section ul li,
            .terms-card .section .contact-list li {
                font-size: 0.88rem;
            }
        }
        
        @media (max-width: 480px) {
            .terms-card {
                padding: var(--spacing-sm);
            }
            
            .terms-card .section .section-title {
                font-size: 0.9rem;
            }
            
            .terms-card .section .section-title .section-number {
                width: 22px;
                height: 22px;
                font-size: 0.6rem;
            }
        }
    </style>
</head>
<body>

