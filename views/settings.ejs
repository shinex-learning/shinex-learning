<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container" style="max-width:1200px;">
            <h2 style="font-size:1.8rem; font-weight:700; margin:0 0 4px;">⚙️ Settings</h2>
            <p style="color:var(--text-muted); margin-bottom:20px;">Manage your account, preferences, and learning experience.</p>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <!-- Settings Layout -->
            <div class="settings-layout">
                <!-- ===== LEFT SIDEBAR ===== -->
                <aside class="settings-sidebar">
                    <div class="settings-toggle-btn" id="settingsToggle" style="display:none;">
                        <i class="fas fa-bars"></i> Menu
                    </div>
                    <div class="sidebar-title">Settings</div>
                    <ul class="settings-nav">
                        <li><a href="#" data-target="profile" class="active"><i class="fas fa-user"></i> Profile</a></li>
                        <li><a href="#" data-target="account"><i class="fas fa-key"></i> Account</a></li>
                        <li><a href="#" data-target="security"><i class="fas fa-shield-alt"></i> Security</a></li>
                        <li><a href="#" data-target="appearance"><i class="fas fa-palette"></i> Appearance</a></li>
                        <li><a href="#" data-target="notifications"><i class="fas fa-bell"></i> Notifications</a></li>
                        <li><a href="#" data-target="privacy"><i class="fas fa-lock"></i> Privacy</a></li>
                        <li><a href="#" data-target="learning"><i class="fas fa-graduation-cap"></i> Learning</a></li>
                        <li><a href="#" data-target="billing"><i class="fas fa-credit-card"></i> Billing</a></li>
                        <li><a href="#" data-target="support"><i class="fas fa-headset"></i> Support</a></li>
                        <li><a href="#" data-target="danger"><i class="fas fa-exclamation-triangle" style="color:#e74c3c;"></i> <span style="color:#e74c3c;">Danger Zone</span></a></li>
                    </ul>
                </aside>

                <!-- ===== RIGHT CONTENT ===== -->
                <div class="settings-content">

                    <!-- ====== 1. PROFILE ====== -->
                    <section class="settings-section active" id="profile">
                        <div class="settings-card">
                            <h3><i class="fas fa-user"></i> Profile</h3>
                            <p>Update your personal information.</p>
                            <form id="profileForm">
                                <div class="grid-2" style="gap:14px;">
                                    <div class="settings-group">
                                        <label for="firstName">First Name</label>
                                        <input type="text" id="firstName" name="firstName" value="<%= user.firstName || '' %>">
                                    </div>
                                    <div class="settings-group">
                                        <label for="lastName">Last Name</label>
                                        <input type="text" id="lastName" name="lastName" value="<%= user.lastName || '' %>">
                                    </div>
                                    <div class="settings-group" style="grid-column:1/-1;">
                                        <label for="bio">Bio</label>
                                        <textarea id="bio" name="bio" rows="3" placeholder="Tell us about yourself..."><%= user.bio || '' %></textarea>
                                    </div>
                                    <div class="settings-group">
                                        <label>Student ID</label>
                                        <input type="text" value="<%= user.studentId || '' %>" disabled style="background:#f0f0f0;">
                                    </div>
                                    <div class="settings-group">
                                        <label>Email</label>
                                        <input type="email" value="<%= user.email || '' %>" disabled style="background:#f0f0f0;">
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Save Profile
                                </button>
                            </form>
                        </div>
                    </section>

                    <!-- ====== 2. ACCOUNT ====== -->
                    <section class="settings-section" id="account">
                        <div class="settings-card">
                            <h3><i class="fas fa-key"></i> Account</h3>
                            <p>Change your password and manage account settings.</p>
                            <form id="passwordForm">
                                <div class="settings-group">
                                    <label for="currentPassword">Current Password</label>
                                    <input type="password" id="currentPassword" name="currentPassword" placeholder="Enter current password">
                                </div>
                                <div class="grid-2" style="gap:14px;">
                                    <div class="settings-group">
                                        <label for="newPassword">New Password</label>
                                        <input type="password" id="newPassword" name="newPassword" placeholder="Min 6 characters">
                                    </div>
                                    <div class="settings-group">
                                        <label for="confirmPassword">Confirm New Password</label>
                                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password">
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Change Password
                                </button>
                            </form>
                        </div>
                    </section>

                    <!-- ====== 3. SECURITY ====== -->
                    <section class="settings-section" id="security">
                        <div class="settings-card">
                            <h3><i class="fas fa-shield-alt"></i> Security</h3>
                            <p>Protect your account with additional security measures.</p>
                            <div class="settings-group">
                                <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                                    <label style="margin:0; font-weight:600;">Two-Factor Authentication (2FA)</label>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <input type="checkbox" id="twoFactorSetting" name="twoFactorEnabled" 
                                               <%= user.twoFactorEnabled ? 'checked' : '' %> style="width:auto;">
                                        <span style="font-size:0.85rem; color:var(--text-muted);">
                                            <%= user.twoFactorEnabled ? '✅ Enabled' : '❌ Disabled' %>
                                        </span>
                                    </div>
                                </div>
                                <p class="help-text">Add an extra layer of security to your account.</p>
                            </div>
                            <div class="settings-group" style="margin-top:12px;">
                                <button id="logoutAllBtn" class="btn btn-secondary">
                                    <i class="fas fa-sign-out-alt"></i> Logout from All Sessions
                                </button>
                                <p class="help-text">This will log you out from all active devices.</p>
                            </div>
                        </div>
                    </section>

                    <!-- ====== 4. APPEARANCE ====== -->
                    <section class="settings-section" id="appearance">
                        <div class="settings-card">
                            <h3><i class="fas fa-palette"></i> Appearance</h3>
                            <p>Customize how SHINEX looks for you.</p>
                            <div class="settings-group">
                                <label for="darkModeSetting">Dark Mode</label>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <input type="checkbox" id="darkModeSetting" name="darkMode" 
                                           <%= user.darkMode ? 'checked' : '' %> style="width:auto;">
                                    <span style="font-size:0.85rem; color:var(--text-muted);">
                                        <i class="fas <%= user.darkMode ? 'fa-moon' : 'fa-sun' %>"></i>
                                        <%= user.darkMode ? 'Dark mode enabled' : 'Light mode enabled' %>
                                    </span>
                                </div>
                                <p class="help-text">Toggle between light and dark mode.</p>
                            </div>
                            <div class="settings-group" style="margin-top:12px;">
                                <label>Text Size</label>
                                <div class="text-size-control" style="background:var(--primary-bg); padding:6px 14px; border-radius:30px; display:inline-flex; align-items:center; gap:10px;">
                                    <i class="fas fa-font" style="color:var(--primary);"></i>
                                    <input type="range" class="text-size-slider" min="12" max="24" value="<%= user.textSize || 16 %>" step="1" style="width:120px;">
                                    <span class="text-size-value" style="font-weight:700; color:var(--primary);"><%= user.textSize || 16 %>px</span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ====== 5. NOTIFICATIONS ====== -->
                    <section class="settings-section" id="notifications">
                        <div class="settings-card">
                            <h3><i class="fas fa-bell"></i> Notifications</h3>
                            <p>Choose how and when you receive updates.</p>
                            <div class="settings-group">
                                <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                                    <input type="checkbox" id="emailNotifications" name="emailNotifications" 
                                           class="notification-checkbox" <%= user.emailNotifications ? 'checked' : '' %> style="width:auto;">
                                    <label for="emailNotifications" style="margin:0; font-weight:600;">Email Notifications</label>
                                </div>
                                <p class="help-text">Receive updates about your courses and account via email.</p>
                            </div>
                            <div class="settings-group">
                                <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                                    <input type="checkbox" id="browserNotifications" name="browserNotifications" 
                                           class="notification-checkbox" <%= user.browserNotifications ? 'checked' : '' %> style="width:auto;">
                                    <label for="browserNotifications" style="margin:0; font-weight:600;">Browser Notifications</label>
                                </div>
                                <p class="help-text">Show notifications in your browser.</p>
                            </div>
                            <div class="settings-group">
                                <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                                    <input type="checkbox" id="courseUpdates" name="courseUpdates" 
                                           class="notification-checkbox" <%= user.courseUpdates ? 'checked' : '' %> style="width:auto;">
                                    <label for="courseUpdates" style="margin:0; font-weight:600;">Course Updates</label>
                                </div>
                                <p class="help-text">Get notified about new content and course announcements.</p>
                            </div>
                        </div>
                    </section>

                    <!-- ====== 6. PRIVACY ====== -->
                    <section class="settings-section" id="privacy">
                        <div class="settings-card">
                            <h3><i class="fas fa-lock"></i> Privacy</h3>
                            <p>Control who can see your information.</p>
                            <div class="settings-group">
                                <label for="profileVisibility">Profile Visibility</label>
                                <select id="profileVisibility" name="profileVisibility">
                                    <option value="public" <%= user.profileVisibility === 'public' ? 'selected' : '' %>>Public – Anyone can see</option>
                                    <option value="private" <%= user.profileVisibility === 'private' ? 'selected' : '' %>>Private – Only you and admins</option>
                                </select>
                                <p class="help-text">Choose who can view your profile and activity.</p>
                            </div>
                        </div>
                    </section>

                    <!-- ====== 7. LEARNING ====== -->
                    <section class="settings-section" id="learning">
                        <div class="settings-card">
                            <h3><i class="fas fa-graduation-cap"></i> Learning Settings</h3>
                            <p>Customize your learning experience.</p>
                            <div class="settings-group">
                                <label for="learningLevel">Preferred Learning Level</label>
                                <select id="learningLevel" name="learningLevel">
                                    <option value="Beginner" <%= user.learningLevel === 'Beginner' ? 'selected' : '' %>>🌱 Beginner</option>
                                    <option value="Intermediate" <%= user.learningLevel === 'Intermediate' ? 'selected' : '' %>>🌿 Intermediate</option>
                                    <option value="Advanced" <%= user.learningLevel === 'Advanced' ? 'selected' : '' %>>🚀 Advanced</option>
                                </select>
                            </div>
                            <div class="settings-group">
                                <label for="learningInterests">Learning Interests</label>
                                <textarea id="learningInterests" name="learningInterests" rows="3" placeholder="What topics interest you? e.g. Cybersecurity, Web Development, Data Science..."><%= user.learningInterests || '' %></textarea>
                                <p class="help-text">Tell us what you want to learn so we can recommend relevant courses.</p>
                            </div>
                        </div>
                    </section>

                    <!-- ====== 8. BILLING ====== -->
                    <section class="settings-section" id="billing">
                        <div class="settings-card">
                            <h3><i class="fas fa-credit-card"></i> Billing</h3>
                            <p>Manage your subscription and payments.</p>
                            <div class="settings-group" style="text-align:center; padding:20px 0;">
                                <i class="fas fa-credit-card" style="font-size:3rem; color:var(--text-muted);"></i>
                                <h4 style="margin:8px 0 4px;">Free Plan</h4>
                                <p style="color:var(--text-muted);">You're currently on the free plan.</p>
                                <p style="font-size:0.85rem; color:var(--text-muted);">All courses are free for a limited time.</p>
                            </div>
                        </div>
                    </section>

                    <!-- ====== 9. SUPPORT ====== -->
                    <section class="settings-section" id="support">
                        <div class="settings-card">
                            <h3><i class="fas fa-headset"></i> Help & Support</h3>
                            <p>Need help? We're here for you.</p>
                            <div class="settings-group" style="display:flex; flex-direction:column; gap:12px;">
                                <a href="/faq" class="btn btn-secondary btn-block">
                                    <i class="fas fa-question-circle"></i> View FAQs
                                </a>
                                <a href="/contact" class="btn btn-primary btn-block">
                                    <i class="fas fa-envelope"></i> Contact Support
                                </a>
                                <div style="text-align:center; padding:12px; background:var(--primary-bg); border-radius:8px;">
                                    <p style="margin:0; font-size:0.85rem;">
                                        <i class="fas fa-phone" style="color:var(--primary);"></i>
                                        +234 800 SHINEX
                                    </p>
                                    <p style="margin:0; font-size:0.8rem; color:var(--text-muted);">
                                        Mon-Fri, 9AM - 6PM WAT
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ====== 10. DANGER ZONE ====== -->
                    <section class="settings-section" id="danger">
                        <div class="settings-card">
                            <div class="danger-zone">
                                <h4><i class="fas fa-exclamation-triangle"></i> Danger Zone</h4>
                                <p>Once you delete your account, there is no going back. Please be certain.</p>
                                <button id="deleteAccountBtn" class="btn-danger-zone">
                                    <i class="fas fa-trash-alt"></i> Delete Account
                                </button>
                            </div>
                        </div>
                    </section>

                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>