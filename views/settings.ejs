<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           SETTINGS PAGE STYLES
           ============================================================ */
        
        .settings-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ----- Page Header ----- */
        .settings-page-header {
            margin-bottom: var(--spacing-lg);
        }
        
        .settings-page-header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        
        .settings-page-header h1 i {
            color: var(--purple-primary);
        }
        
        .settings-page-header p {
            color: var(--text-secondary);
            margin: 4px 0 0 0;
            font-size: 0.95rem;
        }
        
        /* ----- Settings Layout ----- */
        .settings-layout {
            display: flex;
            gap: var(--spacing-lg);
        }
        
        /* ----- Sidebar ----- */
        .settings-sidebar {
            width: 260px;
            min-width: 220px;
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: 12px 0;
            height: fit-content;
            position: sticky;
            top: 80px;
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .settings-sidebar .sidebar-title {
            padding: 8px 18px 12px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid var(--border-color);
        }
        
        .settings-sidebar .settings-nav {
            list-style: none;
            padding: 4px 0;
            margin: 0;
        }
        
        .settings-sidebar .settings-nav li {
            margin: 0;
        }
        
        .settings-sidebar .settings-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        
        .settings-sidebar .settings-nav a:hover {
            background: var(--purple-bg);
            color: var(--purple-primary);
        }
        
        .settings-sidebar .settings-nav a.active {
            background: var(--purple-bg);
            color: var(--purple-primary);
            border-left-color: var(--purple-primary);
        }
        
        .settings-sidebar .settings-nav a i {
            width: 20px;
            text-align: center;
        }
        
        .settings-sidebar .settings-nav a.danger-link {
            color: var(--text-error);
        }
        
        .settings-sidebar .settings-nav a.danger-link:hover {
            background: var(--bg-alert-error);
            color: var(--text-error);
        }
        
        .settings-sidebar .settings-nav a.danger-link.active {
            background: var(--bg-alert-error);
            color: var(--text-error);
            border-left-color: var(--text-error);
        }
        
        /* ----- Settings Toggle Button (Mobile) ----- */
        .settings-toggle-btn {
            display: none;
            background: none;
            border: none;
            font-size: 1.1rem;
            color: var(--text-primary);
            padding: 8px;
            cursor: pointer;
            width: 100%;
            text-align: left;
            padding: 10px 18px;
            font-weight: 600;
        }
        
        /* ----- Settings Content ----- */
        .settings-content {
            flex: 1;
            min-width: 0;
        }
        
        /* ----- Settings Sections ----- */
        .settings-section {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        
        .settings-section.active {
            display: block;
        }
        
        @keyframes fadeIn {
            0% { opacity: 0; transform: translateY(10px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        
        /* ----- Settings Cards ----- */
        .settings-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-lg);
            margin-bottom: var(--spacing-md);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .settings-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        .settings-card h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .settings-card h3 i {
            color: var(--purple-primary);
        }
        
        .settings-card .card-subtitle {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin: 0 0 var(--spacing-md) 0;
        }
        
        /* ----- Form Groups ----- */
        .settings-group {
            margin-bottom: var(--spacing-md);
        }
        
        .settings-group label {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-primary);
            display: block;
            margin-bottom: 4px;
        }
        
        .settings-group input,
        .settings-group textarea,
        .settings-group select {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            font-family: inherit;
            transition: all 0.3s ease;
            background: var(--bg-input);
            color: var(--text-primary);
        }
        
        .settings-group input:focus,
        .settings-group textarea:focus,
        .settings-group select:focus {
            border-color: var(--purple-primary);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
            outline: none;
        }
        
        .settings-group input:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        
        .settings-group textarea {
            resize: vertical;
            min-height: 80px;
        }
        
        .settings-group .help-text {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 4px;
        }
        
        .settings-group .help-text i {
            margin-right: 4px;
        }
        
        /* ----- Toggle Switch ----- */
        .toggle-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        
        .toggle-wrapper input[type="checkbox"] {
            width: 44px;
            height: 24px;
            appearance: none;
            background: var(--bg-card-secondary);
            border: 2px solid var(--border-color);
            border-radius: var(--radius-full);
            position: relative;
            cursor: pointer;
            transition: all 0.3s ease;
            flex-shrink: 0;
            padding: 0;
        }
        
        .toggle-wrapper input[type="checkbox"]:checked {
            background: var(--purple-primary);
            border-color: var(--purple-primary);
        }
        
        .toggle-wrapper input[type="checkbox"]::before {
            content: '';
            position: absolute;
            width: 16px;
            height: 16px;
            background: #fff;
            border-radius: 50%;
            top: 2px;
            left: 2px;
            transition: all 0.3s ease;
        }
        
        .toggle-wrapper input[type="checkbox"]:checked::before {
            left: 22px;
        }
        
        .toggle-wrapper .toggle-label {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-primary);
            cursor: pointer;
        }
        
        .toggle-wrapper .toggle-status {
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        
        /* ----- Text Size Slider ----- */
        .text-size-control {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 6px 16px;
            background: var(--bg-card-secondary);
            border-radius: var(--radius-full);
            border: 1px solid var(--border-color);
        }
        
        .text-size-control i {
            color: var(--purple-primary);
        }
        
        .text-size-control input[type="range"] {
            width: 120px;
            height: 4px;
            -webkit-appearance: none;
            appearance: none;
            background: var(--border-color);
            border-radius: var(--radius-full);
            outline: none;
            padding: 0;
            border: none;
            cursor: pointer;
        }
        
        .text-size-control input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--purple-primary);
            cursor: pointer;
            border: 2px solid #fff;
            box-shadow: 0 2px 8px rgba(139, 92, 246, 0.3);
        }
        
        .text-size-control input[type="range"]::-moz-range-thumb {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--purple-primary);
            cursor: pointer;
            border: 2px solid #fff;
        }
        
        .text-size-control .text-size-value {
            font-weight: 700;
            color: var(--purple-primary);
            min-width: 40px;
            text-align: center;
        }
        
        /* ----- Danger Zone ----- */
        .danger-zone {
            border: 2px solid var(--text-error);
            border-radius: var(--radius-lg);
            padding: var(--spacing-lg);
            background: var(--bg-alert-error);
            transition: all 0.3s ease;
        }
        
        .danger-zone h4 {
            color: var(--text-error);
            font-size: 1rem;
            font-weight: 700;
            margin: 0 0 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .danger-zone p {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin: 0 0 var(--spacing-md) 0;
        }
        
        .btn-danger-zone {
            padding: 10px 28px;
            border: none;
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 0.9rem;
            background: var(--text-error);
            color: #fff;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .btn-danger-zone:hover {
            background: #c0392b;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
        }
        
        .btn-danger-zone i {
            margin-right: 6px;
        }
        
        /* ----- Buttons ----- */
        .btn {
            padding: 10px 24px;
            border: none;
            border-radius: var(--radius-full);
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        
        .btn-primary {
            background: var(--purple-gradient);
            color: #fff;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .btn-secondary {
            background: var(--bg-card-secondary);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
        }
        
        .btn-secondary:hover {
            border-color: var(--purple-primary);
            color: var(--purple-primary);
        }
        
        .btn-block {
            width: 100%;
            justify-content: center;
        }
        
        /* ----- Billing Section ----- */
        .billing-card {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-md);
        }
        
        .billing-card .billing-icon {
            font-size: 3rem;
            color: var(--text-muted);
            display: block;
            margin-bottom: var(--spacing-sm);
        }
        
        .billing-card h4 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 8px 0 4px 0;
        }
        
        .billing-card p {
            color: var(--text-secondary);
            margin: 0;
        }
        
        /* ----- Support Section ----- */
        .support-contact {
            text-align: center;
            padding: var(--spacing-md);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }
        
        .support-contact .support-phone {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
        }
        
        .support-contact .support-phone i {
            color: var(--purple-primary);
            margin-right: 6px;
        }
        
        .support-contact .support-hours {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 4px 0 0 0;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 1024px) {
            .settings-layout {
                flex-direction: column;
            }
            
            .settings-sidebar {
                width: 100%;
                min-width: unset;
                position: relative;
                top: 0;
                max-height: 0;
                overflow: hidden;
                padding: 0;
                transition: max-height 0.3s ease, padding 0.3s ease;
                box-shadow: none;
            }
            
            .settings-sidebar.open {
                max-height: 500px;
                padding: 12px 0;
                overflow-y: auto;
            }
            
            .settings-toggle-btn {
                display: block;
            }
        }
        
        @media (max-width: 768px) {
            .settings-card {
                padding: var(--spacing-md);
            }
            
            .settings-page-header h1 {
                font-size: 1.4rem;
            }
            
            .text-size-control {
                flex-wrap: wrap;
                justify-content: center;
            }
            
            .danger-zone {
                padding: var(--spacing-md);
            }
        }
        
        @media (max-width: 480px) {
            .toggle-wrapper {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .settings-card h3 {
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>

    <!-- ===== HEADER ===== -->
    <%- include('partials/header', { showBack: true }) %>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="container">
            <div class="settings-container">

                <!-- ===== PAGE HEADER ===== -->
                <div class="settings-page-header">
                    <h1><i class="fas fa-cog"></i> Settings</h1>
                    <p>Manage your account, preferences, and learning experience.</p>
                </div>

                <!-- ===== FLASH MESSAGES ===== -->
                <% if (messages && messages.success) { %>
                    <div class="alert alert-success flash-message" data-type="success">
                        <i class="fas fa-check-circle"></i> <%= messages.success %>
                    </div>
                <% } %>
                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger flash-message" data-type="error">
                        <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                    </div>
                <% } %>

                <!-- ===== SETTINGS LAYOUT ===== -->
                <div class="settings-layout">

                    <!-- ===== SIDEBAR ===== -->
                    <aside class="settings-sidebar" id="settingsSidebar">
                        <button class="settings-toggle-btn" id="settingsToggle">
                            <i class="fas fa-bars"></i> Menu
                        </button>
                        <div class="sidebar-title"><i class="fas fa-sliders-h"></i> Settings</div>
                        <ul class="settings-nav">
                            <li><a href="#" data-target="profile" class="active"><i class="fas fa-user"></i> Profile</a></li>
                            <li><a href="#" data-target="account"><i class="fas fa-key"></i> Account</a></li>
                            <li><a href="#" data-target="security"><i class="fas fa-shield-alt"></i> Security</a></li>
                            <li><a href="#" data-target="appearance"><i class="fas fa-palette"></i> Appearance</a></li>
                            <li><a href="#" data-target="notifications"><i class="fas fa-bell"></i> Notifications</a></li>
                            <li><a href="#" data-target="privacy"><i class="fas fa-lock"></i> Privacy</a></li>
                            <li><a href="#" data-target="learning"><i class="fas fa-graduation-cap"></i> Learning</a></li>
                            <li><a href="#" data-target="billing"><i class="fas fa-credit-card"></i> Billing</a></li>
                            <li><a href="#" data-target="support"><i class="fas fa-headset"></i> Support</a></li>
                            <li><a href="#" data-target="danger" class="danger-link"><i class="fas fa-exclamation-triangle"></i> Danger Zone</a></li>
                        </ul>
                    </aside>

                    <!-- ===== CONTENT ===== -->
                    <div class="settings-content">

                        <!-- ===== PROFILE ===== -->
                        <section class="settings-section active" id="profile">
                            <div class="settings-card">
                                <h3><i class="fas fa-user"></i> Profile</h3>
                                <p class="card-subtitle">Update your personal information.</p>
                                <form id="profileForm">
                                    <div class="grid-2" style="gap:14px;">
                                        <div class="settings-group">
                                            <label for="firstName">First Name</label>
                                            <input type="text" id="firstName" name="firstName" value="<%= user.firstName || '' %>">
                                        </div>
                                        <div class="settings-group">
                                            <label for="lastName">Last Name</label>
                                            <input type="text" id="lastName" name="lastName" value="<%= user.lastName || '' %>">
                                        </div>
                                        <div class="settings-group" style="grid-column:1/-1;">
                                            <label for="bio">Bio</label>
                                            <textarea id="bio" name="bio" rows="3" placeholder="Tell us about yourself..."><%= user.bio || '' %></textarea>
                                        </div>
                                        <div class="settings-group">
                                            <label>Student ID</label>
                                            <input type="text" value="<%= user.studentId || '' %>" disabled>
                                        </div>
                                        <div class="settings-group">
                                            <label>Email</label>
                                            <input type="email" value="<%= user.email || '' %>" disabled>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save"></i> Save Profile
                                    </button>
                                </form>
                            </div>
                        </section>

                        <!-- ===== ACCOUNT ===== -->
                        <section class="settings-section" id="account">
                            <div class="settings-card">
                                <h3><i class="fas fa-key"></i> Account</h3>
                                <p class="card-subtitle">Change your password and manage account settings.</p>
                                <form id="passwordForm">
                                    <div class="settings-group">
                                        <label for="currentPassword">Current Password</label>
                                        <input type="password" id="currentPassword" name="currentPassword" placeholder="Enter current password">
                                    </div>
                                    <div class="grid-2" style="gap:14px;">
                                        <div class="settings-group">
                                            <label for="newPassword">New Password</label>
                                            <input type="password" id="newPassword" name="newPassword" placeholder="Min 6 characters">
                                        </div>
                                        <div class="settings-group">
                                            <label for="confirmPassword">Confirm New Password</label>
                                            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password">
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save"></i> Change Password
                                    </button>
                                </form>
                            </div>
                        </section>

                        <!-- ===== SECURITY ===== -->
                        <section class="settings-section" id="security">
                            <div class="settings-card">
                                <h3><i class="fas fa-shield-alt"></i> Security</h3>
                                <p class="card-subtitle">Protect your account with additional security measures.</p>
                                
                                <div class="settings-group">
                                    <div class="toggle-wrapper">
                                        <input type="checkbox" id="twoFactorSetting" name="twoFactorEnabled" 
                                               <%= user.twoFactorEnabled ? 'checked' : '' %>>
                                        <label for="twoFactorSetting" class="toggle-label">Two-Factor Authentication (2FA)</label>
                                        <span class="toggle-status">
                                            <%= user.twoFactorEnabled ? '✅ Enabled' : '❌ Disabled' %>
                                        </span>
                                    </div>
                                    <p class="help-text">
                                        <i class="fas fa-info-circle"></i> Add an extra layer of security to your account.
                                    </p>
                                </div>
                                
                                <div class="settings-group" style="margin-top:12px;">
                                    <button id="logoutAllBtn" class="btn btn-secondary">
                                        <i class="fas fa-sign-out-alt"></i> Logout from All Sessions
                                    </button>
                                    <p class="help-text">
                                        <i class="fas fa-info-circle"></i> This will log you out from all active devices.
                                    </p>
                                </div>
                            </div>
                        </section>

                        <!-- ===== APPEARANCE ===== -->
                        <section class="settings-section" id="appearance">
                            <div class="settings-card">
                                <h3><i class="fas fa-palette"></i> Appearance</h3>
                                <p class="card-subtitle">Customize how SHINEX looks for you.</p>
                                
                                <div class="settings-group">
                                    <div class="toggle-wrapper">
                                        <input type="checkbox" id="darkModeSetting" name="darkMode" 
                                               <%= user.darkMode ? 'checked' : '' %>>
                                        <label for="darkModeSetting" class="toggle-label">
                                            <i class="fas <%= user.darkMode ? 'fa-moon' : 'fa-sun' %>"></i>
                                            Dark Mode
                                        </label>
                                        <span class="toggle-status">
                                            <%= user.darkMode ? 'Enabled' : 'Disabled' %>
                                        </span>
                                    </div>
                                    <p class="help-text">
                                        <i class="fas fa-info-circle"></i> Toggle between light and dark mode.
                                    </p>
                                </div>
                                
                                <div class="settings-group" style="margin-top:12px;">
                                    <label>Text Size</label>
                                    <div class="text-size-control">
                                        <i class="fas fa-font"></i>
                                        <input type="range" class="text-size-slider" min="12" max="24" value="<%= user.textSize || 16 %>" step="1">
                                        <span class="text-size-value"><%= user.textSize || 16 %>px</span>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- ===== NOTIFICATIONS ===== -->
                        <section class="settings-section" id="notifications">
                            <div class="settings-card">
                                <h3><i class="fas fa-bell"></i> Notifications</h3>
                                <p class="card-subtitle">Choose how and when you receive updates.</p>
                                
                                <div class="settings-group">
                                    <div class="toggle-wrapper">
                                        <input type="checkbox" id="emailNotifications" name="emailNotifications" 
                                               class="notification-checkbox" <%= user.emailNotifications ? 'checked' : '' %>>
                                        <label for="emailNotifications" class="toggle-label">
                                            <i class="fas fa-envelope"></i> Email Notifications
                                        </label>
                                    </div>
                                    <p class="help-text">Receive updates about your courses and account via email.</p>
                                </div>
                                
                                <div class="settings-group">
                                    <div class="toggle-wrapper">
                                        <input type="checkbox" id="browserNotifications" name="browserNotifications" 
                                               class="notification-checkbox" <%= user.browserNotifications ? 'checked' : '' %>>
                                        <label for="browserNotifications" class="toggle-label">
                                            <i class="fas fa-browser"></i> Browser Notifications
                                        </label>
                                    </div>
                                    <p class="help-text">Show notifications in your browser.</p>
                                </div>
                                
                                <div class="settings-group">
                                    <div class="toggle-wrapper">
                                        <input type="checkbox" id="courseUpdates" name="courseUpdates" 
                                               class="notification-checkbox" <%= user.courseUpdates ? 'checked' : '' %>>
                                        <label for="courseUpdates" class="toggle-label">
                                            <i class="fas fa-graduation-cap"></i> Course Updates
                                        </label>
                                    </div>
                                    <p class="help-text">Get notified about new content and course announcements.</p>
                                </div>
                            </div>
                        </section>

                        <!-- ===== PRIVACY ===== -->
                        <section class="settings-section" id="privacy">
                            <div class="settings-card">
                                <h3><i class="fas fa-lock"></i> Privacy</h3>
                                <p class="card-subtitle">Control who can see your information.</p>
                                
                                <div class="settings-group">
                                    <label for="profileVisibility">Profile Visibility</label>
                                    <select id="profileVisibility" name="profileVisibility">
                                        <option value="public" <%= user.profileVisibility === 'public' ? 'selected' : '' %>>Public – Anyone can see</option>
                                        <option value="private" <%= user.profileVisibility === 'private' ? 'selected' : '' %>>Private – Only you and admins</option>
                                    </select>
                                    <p class="help-text">
                                        <i class="fas fa-info-circle"></i> Choose who can view your profile and activity.
                                    </p>
                                </div>
                            </div>
                        </section>

                        <!-- ===== LEARNING ===== -->
                        <section class="settings-section" id="learning">
                            <div class="settings-card">
                                <h3><i class="fas fa-graduation-cap"></i> Learning Settings</h3>
                                <p class="card-subtitle">Customize your learning experience.</p>
                                
                                <div class="settings-group">
                                    <label for="learningLevel">Preferred Learning Level</label>
                                    <select id="learningLevel" name="learningLevel">
                                        <option value="Beginner" <%= user.learningLevel === 'Beginner' ? 'selected' : '' %>>🌱 Beginner</option>
                                        <option value="Intermediate" <%= user.learningLevel === 'Intermediate' ? 'selected' : '' %>>🌿 Intermediate</option>
                                        <option value="Advanced" <%= user.learningLevel === 'Advanced' ? 'selected' : '' %>>🚀 Advanced</option>
                                    </select>
                                </div>
                                
                                <div class="settings-group">
                                    <label for="learningInterests">Learning Interests</label>
                                    <textarea id="learningInterests" name="learningInterests" rows="3" placeholder="What topics interest you? e.g. Cybersecurity, Web Development, Data Science..."><%= user.learningInterests || '' %></textarea>
                                    <p class="help-text">
                                        <i class="fas fa-info-circle"></i> Tell us what you want to learn so we can recommend relevant courses.
                                    </p>
                                </div>
                            </div>
                        </section>

                        <!-- ===== BILLING ===== -->
                        <section class="settings-section" id="billing">
                            <div class="settings-card billing-card">
                                <h3><i class="fas fa-credit-card"></i> Billing</h3>
                                <p class="card-subtitle">Manage your subscription and payments.</p>
                                
                                <span class="billing-icon"><i class="fas fa-credit-card"></i></span>
                                <h4>Free Plan</h4>
                                <p>You're currently on the free plan.</p>
                                <p style="font-size:0.85rem; color:var(--text-muted);">All courses are free for a limited time.</p>
                            </div>
                        </section>

                        <!-- ===== SUPPORT ===== -->
                        <section class="settings-section" id="support">
                            <div class="settings-card">
                                <h3><i class="fas fa-headset"></i> Help & Support</h3>
                                <p class="card-subtitle">Need help? We're here for you.</p>
                                
                                <div class="settings-group" style="display:flex; flex-direction:column; gap:12px;">
                                    <a href="/faq" class="btn btn-secondary btn-block">
                                        <i class="fas fa-question-circle"></i> View FAQs
                                    </a>
                                    <a href="/contact" class="btn btn-primary btn-block">
                                        <i class="fas fa-envelope"></i> Contact Support
                                    </a>
                                    <div class="support-contact">
                                        <p class="support-phone">
                                            <i class="fas fa-phone"></i> +234 802 505 2852
                                        </p>
                                        <p class="support-hours">
                                            <i class="far fa-clock"></i> Mon-Fri, 9AM - 6PM WAT
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- ===== DANGER ZONE ===== -->
                        <section class="settings-section" id="danger">
                            <div class="settings-card">
                                <div class="danger-zone">
                                    <h4><i class="fas fa-exclamation-triangle"></i> Danger Zone</h4>
                                    <p>Once you delete your account, there is no going back. All your data, progress, and courses will be permanently removed. Please be certain.</p>
                                    <button id="deleteAccountBtn" class="btn-danger-zone">
                                        <i class="fas fa-trash-alt"></i> Delete Account
                                    </button>
                                </div>
                            </div>
                        </section>

                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>
</body>
</html>