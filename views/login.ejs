<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login – SHINEX</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* ===== DARK MODE FIXES FOR LOGIN ===== */
        body.dark-mode .card {
            background: #1a1a1a !important;
            border-color: #333 !important;
        }
        body.dark-mode .card h2,
        body.dark-mode .card p,
        body.dark-mode .card label {
            color: #ffffff !important;
        }
        body.dark-mode .card input {
            background: #2a2a2a !important;
            border-color: #444 !important;
            color: #ffffff !important;
        }
        body.dark-mode .card input::placeholder {
            color: #888888 !important;
        }
        body.dark-mode .card .btn-primary {
            background: #8B5CF6 !important;
            color: #ffffff !important;
        }
        body.dark-mode .card .alert-success {
            background: #1a3a2a !important;
            color: #7dcea0 !important;
        }
        body.dark-mode .card .alert-danger {
            background: #3a1a1a !important;
            color: #f1948a !important;
        }
        body.dark-mode .card a {
            color: #a78bfa !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content" style="display:flex; align-items:center; justify-content:center; min-height:70vh;">
        <div class="container" style="max-width:460px;">
            <div class="card" style="padding:32px 28px; box-shadow:var(--shadow);">
                <h2 style="font-size:1.8rem; font-weight:700; margin:0 0 4px; text-align:center;">Welcome Back</h2>
                <p style="text-align:center; color:var(--text-muted); margin-bottom:24px;">Login with your Student ID or Email</p>

                <% if (messages && messages.success) { %>
                    <div class="alert alert-success"><%= messages.success %></div>
                <% } %>
                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger"><%= messages.error %></div>
                <% } %>

                <form action="/login" method="POST">
                    <div class="settings-group">
                        <label for="identifier">Student ID or Email</label>
                        <input type="text" id="identifier" name="identifier" placeholder="e.g. SLC-2026-01-001 or email@example.com" required>
                    </div>
                    <div class="settings-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Enter your password" required>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:8px;">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </button>
                </form>

                <div style="text-align:center; margin-top:16px; font-size:0.9rem;">
                    <p style="color:var(--text-muted);">Don't have an account? <a href="/register" style="color:var(--primary); font-weight:600;">Register here</a></p>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>