<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ============================================================
           LOGIN PAGE STYLES
           ============================================================ */
        
        /* ----- Auth Wrapper ----- */
        .auth-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 70vh;
            padding: var(--spacing-lg);
        }
        
        /* ----- Auth Box ----- */
        .auth-box {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: var(--spacing-xl) var(--spacing-lg);
            max-width: 420px;
            width: 100%;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-md);
            transition: all 0.3s ease;
        }
        
        .auth-box:hover {
            box-shadow: var(--shadow-lg);
        }
        
        /* ----- Logo ----- */
        .auth-box .auth-logo {
            text-align: center;
            margin-bottom: var(--spacing-md);
        }
        
        .auth-box .auth-logo .logo-icon {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--purple-gradient);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 18px;
            letter-spacing: 1px;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
            margin-bottom: var(--spacing-sm);
        }
        
        .auth-box .auth-logo h1 {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-primary);
            margin: 0;
        }
        
        .auth-box .auth-logo h1 span {
            color: var(--purple-primary);
        }
        
        .auth-box .auth-logo p {
            color: var(--text-muted);
            font-size: 0.7rem;
            margin: 0;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        
        /* ----- Titles ----- */
        .auth-box .auth-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            text-align: center;
            margin: 0 0 4px 0;
        }
        
        .auth-box .auth-subtitle {
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-align: center;
            margin: 0 0 var(--spacing-lg) 0;
        }
        
        /* ----- Form ----- */
        .auth-box .form-group {
            margin-bottom: var(--spacing-md);
        }
        
        .auth-box .form-group label {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-primary);
            display: block;
            margin-bottom: 4px;
        }
        
        .auth-box .form-group label i {
            color: var(--purple-primary);
            margin-right: 6px;
        }
        
        .auth-box .form-group input {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            font-family: inherit;
            transition: all 0.3s ease;
            background: var(--bg-input);
            color: var(--text-primary);
        }
        
        .auth-box .form-group input:focus {
            border-color: var(--purple-primary);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
            outline: none;
        }
        
        .auth-box .form-group input::placeholder {
            color: var(--text-muted);
        }
        
        .auth-box .form-group .help-text {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 4px;
        }
        
        .auth-box .form-group .help-text i {
            margin-right: 4px;
        }
        
        /* ----- Password Toggle ----- */
        .auth-box .password-wrapper {
            position: relative;
            width: 100%;
        }
        
        .auth-box .password-wrapper input {
            width: 100%;
            padding-right: 44px !important;
        }
        
        .auth-box .password-wrapper .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 1.1rem;
            padding: 4px 6px;
            transition: all 0.3s ease;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .auth-box .password-wrapper .toggle-password:hover {
            color: var(--purple-primary);
        }
        
        /* ----- Login Button ----- */
        .auth-box .btn-auth {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: var(--radius-full);
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            background: var(--purple-gradient);
            color: #fff;
            margin-top: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .auth-box .btn-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .auth-box .btn-auth i {
            font-size: 1rem;
        }
        
        /* ----- Alerts ----- */
        .auth-box .alert {
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            margin-bottom: var(--spacing-sm);
            text-align: center;
            border-left: 4px solid;
        }
        
        .auth-box .alert-danger {
            background: var(--bg-alert-error);
            color: var(--text-error);
            border-left-color: var(--text-error);
        }
        
        .auth-box .alert-success {
            background: var(--bg-alert-success);
            color: var(--text-success);
            border-left-color: var(--text-success);
        }
        
        /* ----- Footer ----- */
        .auth-box .auth-footer {
            text-align: center;
            margin-top: var(--spacing-md);
            padding-top: var(--spacing-md);
            border-top: 1px solid var(--border-color);
        }
        
        .auth-box .auth-footer p {
            color: var(--text-secondary);
            font-size: 0.85rem;
            margin: 0;
        }
        
        .auth-box .auth-footer a {
            color: var(--purple-primary);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .auth-box .auth-footer a:hover {
            text-decoration: underline;
        }
        
        /* ----- SLC Note ----- */
        .auth-box .slc-note {
            text-align: center;
            font-size: 0.65rem;
            color: var(--text-muted);
            margin-top: var(--spacing-sm);
            padding-top: var(--spacing-sm);
            border-top: 1px solid var(--border-color);
        }
        
        .auth-box .slc-note i {
            color: var(--purple-primary);
            margin-right: 4px;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 480px) {
            .auth-box {
                padding: var(--spacing-lg) var(--spacing-md);
            }
            
            .auth-box .auth-logo h1 {
                font-size: 1.3rem;
            }
            
            .auth-box .auth-title {
                font-size: 1rem;
            }
            
            .auth-box .btn-auth {
                font-size: 0.9rem;
                padding: 10px;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    PAGE LOADER
    ============================================================ -->
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <!-- ===== HEADER ===== -->
    <%- include(getHeader()) %>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="container">
            <div class="auth-wrapper">

                <!-- ===== AUTH BOX ===== -->
                <div class="auth-box">

                    <!-- Logo -->
                    <div class="auth-logo">
                        <div class="logo-icon">SLC</div>
                        <h1>SHINEX<span>.</span></h1>
                        <p>Learning Circle</p>
                    </div>

                    <!-- Titles -->
                    <div class="auth-title">Welcome Back</div>
                    <div class="auth-subtitle">Login with your Student ID or Email</div>

                    <!-- Flash Messages -->
                    <% if (messages && messages.error) { %>
                        <div class="alert alert-danger flash-message" data-type="error">
                            <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                        </div>
                    <% } %>
                    <% if (messages && messages.success) { %>
                        <div class="alert alert-success flash-message" data-type="success">
                            <i class="fas fa-check-circle"></i> <%= messages.success %>
                        </div>
                    <% } %>

                    <!-- Login Form -->
                    <form action="/login" method="POST">
                        
                        <!-- Identifier -->
                        <div class="form-group">
                            <label for="identifier">
                                <i class="fas fa-id-card"></i> Student ID or Email
                            </label>
                            <input 
                                type="text" 
                                id="identifier" 
                                name="identifier" 
                                placeholder="e.g. SLC-2026-01-001 or email@example.com" 
                                required
                                autocomplete="username"
                                autofocus
                            >
                            <div class="help-text">
                                <i class="fas fa-info-circle"></i> Enter your Student ID or registered email
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="form-group">
                            <label for="loginPassword">
                                <i class="fas fa-lock"></i> Password
                            </label>
                            <div class="password-wrapper">
                                <input 
                                    type="password" 
                                    id="loginPassword" 
                                    name="password" 
                                    placeholder="Enter your password" 
                                    required
                                    autocomplete="current-password"
                                >
                                <button type="button" class="toggle-password" onclick="togglePassword('loginPassword', this)" aria-label="Toggle password visibility">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Submit -->
                        <button type="submit" class="btn-auth">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </button>
                    </form>

                    <!-- Footer -->
                    <div class="auth-footer">
                        <p>Don't have an account? <a href="/register">Register Now</a></p>
                    </div>

                    <!-- SLC Note -->
                    <div class="slc-note">
                        <i class="fas fa-shield-alt"></i> SHINEX Learning Circle
                    </div>

                </div>

            </div>
        </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <%- include(getFooter()) %>

    <script>
        // ============================================================
        // PASSWORD VISIBILITY TOGGLE
        // ============================================================
        
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            if (!input) return;
            
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
        }
        
        // ============================================================
        // AUTO DISMISS FLASH MESSAGES
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.flash-message').forEach(msg => {
                setTimeout(() => {
                    msg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    msg.style.opacity = '0';
                    msg.style.transform = 'translateY(-10px)';
                    setTimeout(() => {
                        if (msg.parentNode) msg.remove();
                    }, 500);
                }, 5000);
            });
        });
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('🔐 SHINEX Login Page');
        console.log('📧 Login with Student ID or Email');
        console.log('💡 Forgot password? Contact support');
    </script>

    <script src="/js/main.js"></script>
</body>
</html>