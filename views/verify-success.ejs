<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Verified – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container" style="max-width:500px;">
            <div class="card" style="text-align:center; padding:40px 30px; border:2px solid #27ae60;">
                <div style="font-size:4rem; color:#27ae60; margin-bottom:16px;">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h1 style="font-size:1.6rem; font-weight:800; color:#27ae60; margin:0 0 8px 0;">
                    Email Verified! ✅
                </h1>
                <p style="color:var(--text-muted); font-size:1rem; margin:0 0 8px 0;">
                    Your email has been successfully verified.
                </p>
                <% if (user) { %>
                    <p style="color:var(--text-dark); font-size:0.9rem; margin:0 0 16px 0;">
                        Welcome, <strong><%= user.firstName %></strong>! Your Student ID is: 
                        <strong style="color:#8B5CF6;"><%= user.studentId %></strong>
                    </p>
                <% } %>
                <a href="/login" class="btn btn-primary">
                    <i class="fas fa-sign-in-alt"></i> Login Now
                </a>
            </div>
        </div>
    </main>

    <%- include(getFooter()) %>
    <script src="/js/script.js"></script>
</body>
</html>