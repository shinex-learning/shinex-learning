<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Verified – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ============================================================
           VERIFICATION SUCCESS STYLES
           ============================================================ */
        
        .success-container {
            max-width: 550px;
            margin: 0 auto;
        }
        
        /* ----- Success Card ----- */
        .success-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 3px solid var(--text-success);
            padding: var(--spacing-xl) var(--spacing-lg);
            text-align: center;
            box-shadow: var(--shadow-lg);
            transition: all 0.3s ease;
        }
        
        .success-card:hover {
            box-shadow: var(--shadow-xl);
        }
        
        /* ----- Success Icon ----- */
        .success-card .success-icon {
            font-size: 4.5rem;
            color: var(--text-success);
            margin-bottom: var(--spacing-md);
            display: block;
            animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        
        @keyframes popIn {
            0% { transform: scale(0) rotate(-10deg); opacity: 0; }
            70% { transform: scale(1.1) rotate(2deg); }
            100% { transform: scale(1) rotate(0deg); opacity: 1; }
        }
        
        /* ----- Title ----- */
        .success-card .success-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-success);
            margin: 0 0 8px 0;
        }
        
        .success-card .success-subtitle {
            color: var(--text-secondary);
            font-size: 1.05rem;
            margin: 0 0 4px 0;
        }
        
        .success-card .success-message {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin: 0 0 var(--spacing-md) 0;
            line-height: 1.6;
        }
        
        /* ----- User Info Box ----- */
        .success-card .user-info-box {
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            padding: var(--spacing-md);
            margin: var(--spacing-md) 0;
            border: 1px solid var(--border-color);
            text-align: left;
        }
        
        .success-card .user-info-box .user-name {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
            text-align: center;
        }
        
        .success-card .user-info-box .user-name i {
            color: var(--purple-primary);
            margin-right: 6px;
        }
        
        .success-card .user-info-box .info-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 0.9rem;
            border-bottom: 1px solid var(--border-color);
        }
        
        .success-card .user-info-box .info-row:last-child {
            border-bottom: none;
        }
        
        .success-card .user-info-box .info-label {
            color: var(--text-muted);
            font-weight: 500;
        }
        
        .success-card .user-info-box .info-label i {
            margin-right: 6px;
            color: var(--purple-primary);
        }
        
        .success-card .user-info-box .info-value {
            color: var(--text-primary);
            font-weight: 600;
        }
        
        .success-card .user-info-box .info-value.student-id {
            color: var(--purple-primary);
        }
        
        /* ----- Action Buttons ----- */
        .success-card .success-actions {
            display: flex;
            gap: var(--spacing-sm);
            justify-content: center;
            flex-wrap: wrap;
            margin-top: var(--spacing-sm);
        }
        
        .success-card .success-actions .btn {
            padding: 10px 28px;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: var(--radius-full);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }
        
        .success-card .success-actions .btn-primary {
            background: var(--purple-gradient);
            color: #fff;
            border: none;
        }
        
        .success-card .success-actions .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .success-card .success-actions .btn-secondary {
            background: var(--bg-card-secondary);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
        }
        
        .success-card .success-actions .btn-secondary:hover {
            border-color: var(--purple-primary);
            color: var(--purple-primary);
        }
        
        .success-card .success-actions .btn i {
            font-size: 0.9rem;
        }
        
        /* ----- Confetti Container ----- */
        .confetti-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9999;
            overflow: hidden;
        }
        
        .confetti-container .confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            animation: confettiFall linear forwards;
        }
        
        @keyframes confettiFall {
            0% { transform: translateY(-10px) rotate(0deg); opacity: 1; }
            100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
        }
        
        /* ----- Toast ----- */
        .toast-message {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            padding: 12px 24px;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 0.9rem;
            z-index: 99999;
            max-width: 90%;
            text-align: center;
            box-shadow: var(--shadow-lg);
            animation: slideDown 0.4s ease;
        }
        
        @keyframes slideDown {
            0% { opacity: 0; transform: translateX(-50%) translateY(-20px); }
            100% { opacity: 1; transform: translateX(-50%) translateY(0); }
        }
        
        .toast-success {
            background: var(--text-success);
            color: #fff;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 480px) {
            .success-card {
                padding: var(--spacing-lg) var(--spacing-md);
            }
            
            .success-card .success-title {
                font-size: 1.3rem;
            }
            
            .success-card .success-icon {
                font-size: 3.5rem;
            }
            
            .success-card .success-subtitle {
                font-size: 0.95rem;
            }
            
            .success-card .user-info-box .info-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 2px;
            }
            
            .success-card .success-actions {
                flex-direction: column;
            }
            
            .success-card .success-actions .btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    PAGE LOADER
    ============================================================ -->
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <!-- ===== HEADER ===== -->
    <%- include(getHeader()) %>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="container">
            <div class="success-container">

                <!-- ===== SUCCESS CARD ===== -->
                <div class="success-card">

                    <!-- Success Icon -->
                    <span class="success-icon">
                        <i class="fas fa-check-circle"></i>
                    </span>

                    <!-- Title -->
                    <h1 class="success-title">Email Verified! ✅</h1>
                    <p class="success-subtitle">Your email has been successfully verified.</p>
                    <p class="success-message">
                        You can now access all courses and start your learning journey.
                    </p>

                    <!-- User Info -->
                    <% if (user) { %>
                        <div class="user-info-box">
                            <p class="user-name">
                                <i class="fas fa-user-circle"></i> Welcome, <%= user.firstName %>!
                            </p>
                            <div class="info-row">
                                <span class="info-label"><i class="fas fa-id-card"></i> Student ID</span>
                                <span class="info-value student-id"><%= user.studentId %></span>
                            </div>
                            <div class="info-row">
                                <span class="info-label"><i class="fas fa-graduation-cap"></i> Course</span>
                                <span class="info-value"><%= user.courseName %></span>
                            </div>
                            <div class="info-row">
                                <span class="info-label"><i class="fas fa-envelope"></i> Email</span>
                                <span class="info-value"><%= user.email %></span>
                            </div>
                            <div class="info-row">
                                <span class="info-label"><i class="fas fa-check-circle" style="color:var(--text-success);"></i> Status</span>
                                <span class="info-value" style="color:var(--text-success);">✅ Verified</span>
                            </div>
                        </div>
                    <% } %>

                    <!-- Action Buttons -->
                    <div class="success-actions">
                        <a href="/dashboard" class="btn btn-primary">
                            <i class="fas fa-tachometer-alt"></i> Go to Dashboard
                        </a>
                        <a href="/" class="btn btn-secondary">
                            <i class="fas fa-home"></i> Home
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </main>

    <!-- ============================================================
    CONFETTI ANIMATION
    ============================================================ -->
    <div class="confetti-container" id="confettiContainer"></div>

    <!-- ===== FOOTER ===== -->
    <%- include(getFooter()) %>

    <script>
        // ============================================================
        // CONFETTI ANIMATION
        // ============================================================
        
        function createConfetti() {
            const container = document.getElementById('confettiContainer');
            const colors = ['#8B5CF6', '#6a3dcf', '#a78bfa', '#27ae60', '#f39c12', '#e74c3c', '#3498db', '#1abc9c', '#9b59b6', '#2ecc71'];
            
            for (let i = 0; i < 60; i++) {
                const confetti = document.createElement('div');
                confetti.className = 'confetti';
                confetti.style.left = Math.random() * 100 + '%';
                confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
                confetti.style.width = (Math.random() * 8 + 4) + 'px';
                confetti.style.height = (Math.random() * 8 + 4) + 'px';
                confetti.style.animationDuration = (Math.random() * 2 + 2) + 's';
                confetti.style.animationDelay = (Math.random() * 2) + 's';
                confetti.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
                container.appendChild(confetti);
            }
            
            // Remove confetti after 5 seconds
            setTimeout(() => {
                container.innerHTML = '';
            }, 5000);
        }
        
        // ============================================================
        // WELCOME TOAST
        // ============================================================
        
        function showWelcomeToast() {
            const toast = document.createElement('div');
            toast.className = 'toast-message toast-success';
            toast.textContent = '🎉 Welcome to SHINEX Learning Circle!';
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(-50%) translateY(-20px)';
                toast.style.transition = 'all 0.4s ease';
                setTimeout(() => toast.remove(), 400);
            }, 4000);
        }
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
        }
        
        // ============================================================
        // INITIALIZE
        // ============================================================
        
        // Trigger confetti
        createConfetti();
        
        // Show welcome toast after 1 second
        setTimeout(showWelcomeToast, 1000);
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('🎉 SHINEX Verification Success');
        console.log('👤 Welcome, <%= user && user.firstName ? user.firstName : "Student" %>!');
        console.log('🆔 Student ID: <%= user && user.studentId ? user.studentId : "N/A" %>');
        console.log('📚 Course: <%= user && user.courseName ? user.courseName : "Not Assigned" %>');
    </script>

    <script src="/js/main.js"></script>
</body>
</html>