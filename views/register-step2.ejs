<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Register – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            background: #f8f7fc;
        }
        .app-wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .main-content {
            flex: 1;
            padding: 12px 0 20px;
        }
        .site-footer {
            margin-top: auto;
        }
        .card {
            padding: 20px 16px !important;
            border-radius: 16px !important;
            margin: 0 8px !important;
        }
        .container {
            padding: 0 4px !important;
            max-width: 100% !important;
        }
        .form-control {
            font-size: 16px !important;
            padding: 14px 16px !important;
            border-radius: 12px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }
        .btn {
            padding: 16px !important;
            font-size: 1rem !important;
            width: 100% !important;
            border-radius: 30px !important;
        }
        .checkbox-grid {
            grid-template-columns: 1fr 1fr !important;
            gap: 8px !important;
        }
        .checkbox-grid label {
            font-size: 0.85rem !important;
        }
        @media (max-width: 480px) {
            .card {
                padding: 16px 12px !important;
                margin: 0 4px !important;
            }
            h1 {
                font-size: 1.3rem !important;
            }
            .form-group {
                margin-bottom: 12px !important;
            }
            .form-group label {
                font-size: 0.85rem !important;
            }
            .checkbox-grid {
                grid-template-columns: 1fr 1fr !important;
                gap: 4px !important;
            }
            .checkbox-grid label {
                font-size: 0.8rem !important;
            }
            .form-section {
                padding: 12px !important;
            }
        }
    </style>
</head>
<body>
    <div class="app-wrapper">
        <%- include('partials/header', { user: null, showBack: true }) %>

        <main class="main-content">
            <div class="container" style="max-width:720px; margin:0 auto;">
                <div class="card">
                    <div style="text-align:center; margin-bottom:16px;">
                        <div style="background:linear-gradient(135deg,#8B5CF6,#6a3dcf); width:48px; height:48px; border-radius:14px; display:inline-flex; align-items:center; justify-content:center; margin-bottom:8px;">
                            <i class="fas fa-id-card" style="font-size:1.5rem; color:#fff;"></i>
                        </div>
                        <h1 style="font-size:1.4rem; font-weight:800; color:#1A0A2E; margin:0;">Complete Your Profile</h1>
                        <p style="color:#7a6a8f; font-size:0.85rem; margin:2px 0 0;">Step 2 of 2 – Tell us about yourself</p>
                    </div>

                    <!-- ===== MESSAGES AT TOP ===== -->
                    <% if (messages && messages.error) { %>
                        <div class="alert alert-danger" style="margin-bottom:12px;"><%= messages.error %></div>
                    <% } %>
                    <% if (messages && messages.success) { %>
                        <div class="alert alert-success" style="margin-bottom:12px;"><%= messages.success %></div>
                    <% } %>

                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:16px;">
                        <span style="background:#8B5CF6; color:#fff; padding:2px 10px; border-radius:20px; font-size:0.65rem; font-weight:600;">Step 2</span>
                        <div class="progress-wrap" style="flex:1; height:8px;"><div class="progress-fill" style="width:100%; height:100%;"></div></div>
                        <span style="color:#8B5CF6; font-size:0.65rem; font-weight:600;">100%</span>
                    </div>

                    <form action="/register/step2" method="POST" autocomplete="off">
                        <!-- ===== PERSONAL INFO ===== -->
                        <div class="form-section" style="background:#fff; border-radius:14px; padding:16px; margin-bottom:14px; border:1px solid #ede8f5;">
                            <h3 style="font-size:1rem; font-weight:700; color:#1A0A2E; margin:0 0 12px 0; padding-bottom:8px; border-bottom:2px solid #f0ebfb;">
                                <i class="fas fa-user" style="color:#8B5CF6; margin-right:8px;"></i> Personal Information
                            </h3>
                            <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                                <div class="form-group">
                                    <label for="firstName">First Name</label>
                                    <input type="text" id="firstName" name="firstName" class="form-control" placeholder="Enter first name" required autocomplete="off">
                                </div>
                                <div class="form-group">
                                    <label for="lastName">Last Name</label>
                                    <input type="text" id="lastName" name="lastName" class="form-control" placeholder="Enter last name" required autocomplete="off">
                                </div>
                            </div>
                            <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:4px;">
                                <div class="form-group">
                                    <label>Gender <span class="label-hint" style="font-size:0.7rem;">(Male / Female only)</span></label>
                                    <div class="radio-group" style="display:flex; gap:16px; padding-top:4px;">
                                        <label><input type="radio" name="gender" value="Male" required> Male</label>
                                        <label><input type="radio" name="gender" value="Female" required> Female</label>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="dob">Date of Birth</label>
                                    <input type="date" id="dob" name="dob" class="form-control" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="country">Country</label>
                                <select id="country" name="country" class="form-control" required>
                                    <option value="">Select your country</option>
                                    <option value="Nigeria">🇳🇬 Nigeria</option>
                                    <option value="USA">🇺🇸 United States</option>
                                    <option value="UK">🇬🇧 United Kingdom</option>
                                    <option value="Ghana">🇬🇭 Ghana</option>
                                    <option value="Kenya">🇰🇪 Kenya</option>
                                    <option value="South Africa">🇿🇦 South Africa</option>
                                    <option value="Canada">🇨🇦 Canada</option>
                                    <option value="Australia">🇦🇺 Australia</option>
                                </select>
                            </div>
                            <!-- ===== SCHOOL FIELD ===== -->
                            <div class="form-group">
                                <label for="school">School / Organization <span class="label-hint" style="font-size:0.7rem;">(optional)</span></label>
                                <input type="text" id="school" name="school" class="form-control" placeholder="Enter your school or organization name" autocomplete="off">
                            </div>
                        </div>

                        <!-- ===== LEARNING PROFILE ===== -->
                        <div class="form-section" style="background:#fff; border-radius:14px; padding:16px; margin-bottom:14px; border:1px solid #ede8f5;">
                            <h3 style="font-size:1rem; font-weight:700; color:#1A0A2E; margin:0 0 12px 0; padding-bottom:8px; border-bottom:2px solid #f0ebfb;">
                                <i class="fas fa-graduation-cap" style="color:#8B5CF6; margin-right:8px;"></i> Learning Profile
                            </h3>
                            <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                                <div class="form-group">
                                    <label for="experienceLevel">Experience Level</label>
                                    <select id="experienceLevel" name="experienceLevel" class="form-control" required>
                                        <option value="">Select level</option>
                                        <option value="Beginner">Beginner</option>
                                        <option value="Intermediate">Intermediate</option>
                                        <option value="Advanced">Advanced</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="courseId">Course to Study</label>
                                    <select id="courseId" name="courseId" class="form-control" required>
                                        <option value="">Choose a course</option>
                                        <% courses.forEach(c => { %>
                                            <option value="<%= c.id %>"><%= c.title %> (<%= c.duration %>)</option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Interests <span class="label-hint" style="font-size:0.7rem;">(check all that apply)</span></label>
                                <div class="checkbox-group">
                                    <div class="checkbox-grid" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(130px,1fr)); gap:8px;">
                                        <label><input type="checkbox" name="interests" value="HTML/CSS"> HTML/CSS</label>
                                        <label><input type="checkbox" name="interests" value="JavaScript"> JavaScript</label>
                                        <label><input type="checkbox" name="interests" value="Python"> Python</label>
                                        <label><input type="checkbox" name="interests" value="UI/UX"> UI/UX</label>
                                        <label><input type="checkbox" name="interests" value="WordPress"> WordPress</label>
                                        <label><input type="checkbox" name="interests" value="SEO"> SEO</label>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="bio">Short Bio</label>
                                <textarea id="bio" name="bio" class="form-control" rows="3" placeholder="Tell us a little about yourself..." style="resize:vertical;"></textarea>
                            </div>
                        </div>

                        <!-- ===== TERMS ===== -->
                        <div class="form-section" style="background:#fff; border-radius:14px; padding:16px; margin-bottom:14px; border:2px solid #8B5CF6;">
                            <div class="terms-check" style="display:flex; align-items:flex-start; gap:10px;">
                                <input type="checkbox" id="terms" name="terms" value="yes" required style="width:20px; height:20px; margin-top:2px; accent-color:#8B5CF6;">
                                <label for="terms" style="font-size:0.85rem; color:#3d2a5a;">
                                    I accept the <a href="/terms" target="_blank" style="color:#8B5CF6; font-weight:600; text-decoration:underline;">Terms and Conditions</a> and <a href="/privacy" target="_blank" style="color:#8B5CF6; font-weight:600; text-decoration:underline;">Privacy Policy</a> of SHINEX Learning Circle.
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary" style="width:100%; padding:14px; font-size:1rem; margin-top:4px;">
                            <i class="fas fa-check-circle"></i> Complete Registration
                        </button>
                        <p style="text-align:center; margin-top:12px; font-size:0.8rem; color:#7a6a8f;">
                            <i class="fas fa-lock" style="margin-right:6px;"></i> Your data is secure and private.
                        </p>
                    </form>
                </div>
            </div>
        </main>

        <%- include('partials/footer') %>
    </div>
</body>
</html>