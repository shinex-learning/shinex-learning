<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Register – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .register-wrapper {
            max-width: 720px;
            margin: 0 auto;
            padding: 0 16px;
        }
        .register-card {
            padding: 28px 24px;
            border-radius: 16px;
            background: #fff;
            border: 1px solid #ede8f5;
        }
        .register-card .logo-area {
            text-align: center;
            margin-bottom: 20px;
        }
        .register-card .logo-area .icon {
            background: linear-gradient(135deg, #8B5CF6, #6a3dcf);
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 8px;
        }
        .register-card .logo-area .icon i {
            font-size: 1.5rem;
            color: #fff;
        }
        .register-card .logo-area h1 {
            font-size: 1.4rem;
            font-weight: 800;
            color: #1A0A2E;
            margin: 0;
        }
        .register-card .logo-area p {
            color: #7a6a8f;
            font-size: 0.85rem;
            margin: 2px 0 0;
        }
        .register-card .progress-area {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }
        .register-card .progress-area .step-badge {
            background: #8B5CF6;
            color: #fff;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 0.65rem;
            font-weight: 600;
        }
        .register-card .progress-area .progress-wrap {
            flex: 1;
            height: 8px;
        }
        .register-card .progress-area .progress-percent {
            color: #8B5CF6;
            font-size: 0.65rem;
            font-weight: 600;
        }
        .register-card .form-section {
            background: #fff;
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 14px;
            border: 1px solid #ede8f5;
        }
        .register-card .form-section .section-title {
            font-size: 1rem;
            font-weight: 700;
            color: #1A0A2E;
            margin: 0 0 12px 0;
            padding-bottom: 8px;
            border-bottom: 2px solid #f0ebfb;
        }
        .register-card .form-section .section-title i {
            color: #8B5CF6;
            margin-right: 8px;
        }
        .register-card .btn-primary {
            width: 100%;
            padding: 14px;
            font-size: 1rem;
            margin-top: 4px;
        }
        .register-card .secure-text {
            text-align: center;
            margin-top: 12px;
            font-size: 0.8rem;
            color: #7a6a8f;
        }
        @media (max-width: 480px) {
            .register-card {
                padding: 16px 12px;
                margin: 0 4px;
            }
            .register-card .form-section {
                padding: 12px;
            }
            .register-card .logo-area h1 {
                font-size: 1.2rem;
            }
            .register-card .checkbox-grid {
                grid-template-columns: 1fr 1fr !important;
            }
        }
        /* Dark mode */
        body.dark-mode .register-card {
            background: #111111 !important;
            border-color: #333 !important;
        }
        body.dark-mode .register-card .logo-area h1 {
            color: #ffffff !important;
        }
        body.dark-mode .register-card .logo-area p {
            color: #cccccc !important;
        }
        body.dark-mode .register-card .form-section {
            background: #1a1a1a !important;
            border-color: #333 !important;
        }
        body.dark-mode .register-card .form-section .section-title {
            color: #ffffff !important;
            border-bottom-color: #444 !important;
        }
        body.dark-mode .register-card .secure-text {
            color: #cccccc !important;
        }
        body.dark-mode .register-card .progress-area .progress-percent {
            color: #b088f9 !important;
        }
        body.dark-mode .register-card .terms-check label {
            color: #cccccc !important;
        }
        body.dark-mode .register-card .terms-check a {
            color: #b088f9 !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header', { user: null, showBack: true }) %>

    <main class="main-content">
        <div class="register-wrapper">
            <div class="register-card">
                <div class="logo-area">
                    <div class="icon">
                        <i class="fas fa-id-card"></i>
                    </div>
                    <h1>Complete Your Profile</h1>
                    <p>Step 2 of 2 – Tell us about yourself</p>
                </div>

                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger" style="margin-bottom:12px;"><%= messages.error %></div>
                <% } %>
                <% if (messages && messages.success) { %>
                    <div class="alert alert-success" style="margin-bottom:12px;"><%= messages.success %></div>
                <% } %>

                <div class="progress-area">
                    <span class="step-badge">Step 2</span>
                    <div class="progress-wrap"><div class="progress-fill" style="width:100%; height:100%;"></div></div>
                    <span class="progress-percent">100%</span>
                </div>

                <form action="/register/step2" method="POST" autocomplete="off">
                    <!-- Personal Info -->
                    <div class="form-section">
                        <div class="section-title"><i class="fas fa-user"></i> Personal Information</div>
                        <div class="grid-2">
                            <div class="form-group">
                                <label for="firstName">First Name</label>
                                <input type="text" id="firstName" name="firstName" class="form-control" placeholder="Enter first name" required autocomplete="off">
                            </div>
                            <div class="form-group">
                                <label for="lastName">Last Name</label>
                                <input type="text" id="lastName" name="lastName" class="form-control" placeholder="Enter last name" required autocomplete="off">
                            </div>
                        </div>
                        <div class="grid-2">
                            <div class="form-group">
                                <label>Gender <span class="label-hint">(Male / Female only)</span></label>
                                <div class="radio-group">
                                    <label><input type="radio" name="gender" value="Male" required> Male</label>
                                    <label><input type="radio" name="gender" value="Female" required> Female</label>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="dob">Date of Birth</label>
                                <input type="date" id="dob" name="dob" class="form-control" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="country">Country</label>
                            <select id="country" name="country" class="form-control" required>
                                <option value="">Select your country</option>
                                <option value="Nigeria">🇳🇬 Nigeria</option>
                                <option value="USA">🇺🇸 United States</option>
                                <option value="UK">🇬🇧 United Kingdom</option>
                                <option value="Ghana">🇬🇭 Ghana</option>
                                <option value="Kenya">🇰🇪 Kenya</option>
                                <option value="South Africa">🇿🇦 South Africa</option>
                                <option value="Canada">🇨🇦 Canada</option>
                                <option value="Australia">🇦🇺 Australia</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="school">School / Organization <span class="label-hint">(optional)</span></label>
                            <input type="text" id="school" name="school" class="form-control" placeholder="Enter your school or organization name" autocomplete="off">
                        </div>
                    </div>

                    <!-- Learning Profile -->
                    <div class="form-section">
                        <div class="section-title"><i class="fas fa-graduation-cap"></i> Learning Profile</div>
                        <div class="grid-2">
                            <div class="form-group">
                                <label for="experienceLevel">Experience Level</label>
                                <select id="experienceLevel" name="experienceLevel" class="form-control" required>
                                    <option value="">Select level</option>
                                    <option value="Beginner">Beginner</option>
                                    <option value="Intermediate">Intermediate</option>
                                    <option value="Advanced">Advanced</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="courseId">Course to Study</label>
                                <select id="courseId" name="courseId" class="form-control" required>
                                    <option value="">Choose a course</option>
                                    <% courses.forEach(c => { %>
                                        <option value="<%= c.id %>"><%= c.title %> (<%= c.duration %>)</option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Interests <span class="label-hint">(check all that apply)</span></label>
                            <div class="checkbox-group">
                                <div class="checkbox-grid">
                                    <label><input type="checkbox" name="interests" value="HTML/CSS"> HTML/CSS</label>
                                    <label><input type="checkbox" name="interests" value="JavaScript"> JavaScript</label>
                                    <label><input type="checkbox" name="interests" value="Python"> Python</label>
                                    <label><input type="checkbox" name="interests" value="UI/UX"> UI/UX</label>
                                    <label><input type="checkbox" name="interests" value="WordPress"> WordPress</label>
                                    <label><input type="checkbox" name="interests" value="SEO"> SEO</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="bio">Short Bio</label>
                            <textarea id="bio" name="bio" class="form-control" rows="3" placeholder="Tell us a little about yourself..."></textarea>
                        </div>
                    </div>

                    <!-- Terms -->
                    <div class="form-section" style="border-color:#8B5CF6;">
                        <div class="terms-check">
                            <input type="checkbox" id="terms" name="terms" value="yes" required>
                            <label for="terms">
                                I accept the <a href="/terms" target="_blank">Terms and Conditions</a> and <a href="/privacy" target="_blank">Privacy Policy</a> of SHINEX Learning Circle.
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check-circle"></i> Complete Registration
                    </button>
                    <div class="secure-text">
                        <i class="fas fa-lock"></i> Your data is secure and private.
                    </div>
                </form>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>