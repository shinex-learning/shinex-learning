<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHINEX – My Course</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/header', { user, showBack: true }) %>

    <main class="main-content">
        <div class="container" style="max-width: 820px;">

            <% if (course) { %>

                <!-- Course Header -->
                <div class="card" style="border-left: 5px solid #8B5CF6; margin-bottom: 20px;">
                    <h2 style="font-size: 1.6rem; font-weight: 800; color: #1A0A2E;">
                        <%= course.title %>
                    </h2>
                    <p style="color: #5a4a70;"><%= course.description %></p>
                    <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px;">
                        <span class="badge badge-purple"><%= course.level %></span>
                        <span class="badge badge-dark"><i class="far fa-clock"></i> <%= course.duration %></span>
                        <span class="badge badge-green">
                            <i class="fas fa-check-circle"></i> <%= completedCount %> / <%= totalLessons %> completed
                        </span>
                    </div>
                    <!-- Progress -->
                    <div style="margin-top: 14px;">
                        <div style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: 500; color: #2d1a4a;">
                            <span>Progress</span>
                            <span><%= Math.round((completedCount / (totalLessons || 1)) * 100) %>%</span>
                        </div>
                        <div class="progress-wrap" style="margin-top: 4px; height: 10px;">
                            <div class="progress-fill" style="width: <%= (completedCount / (totalLessons || 1)) * 100 %>%;"></div>
                        </div>
                    </div>
                </div>

                <!-- Lessons -->
                <div class="card">
                    <h3 style="font-weight: 700; color: #1A0A2E; margin-bottom: 16px;">
                        <i class="fas fa-list-ul" style="color: #8B5CF6; margin-right: 8px;"></i>
                        Lessons
                    </h3>

                    <% if (course.lessons && course.lessons.length > 0) { %>
                        <% course.lessons.forEach(function(lesson, idx) { %>
                            <div class="lesson-item" style="padding: 14px 18px;">
                                <div>
                                    <div style="font-weight: 600; color: #1A0A2E;">
                                        <%= idx + 1 %>. <%= lesson.title %>
                                    </div>
                                    <% if (lesson.content) { %>
                                        <div style="font-size: 0.85rem; color: #7a6a8f; margin-top: 2px;">
                                            <%= lesson.content %>
                                        </div>
                                    <% } %>
                                    <% if (lesson.videoUrl) { %>
                                        <div style="margin-top: 4px;">
                                            <a href="<%= lesson.videoUrl %>" target="_blank" class="btn btn-secondary btn-xs" style="gap: 4px;">
                                                <i class="fab fa-youtube"></i> Video
                                            </a>
                                        </div>
                                    <% } %>
                                    <% if (lesson.externalLink) { %>
                                        <div style="margin-top: 4px;">
                                            <a href="<%= lesson.externalLink %>" target="_blank" class="btn btn-secondary btn-xs" style="gap: 4px;">
                                                <i class="fas fa-external-link-alt"></i> Resource
                                            </a>
                                        </div>
                                    <% } %>
                                </div>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <% if (progress && progress[lesson.id]) { %>
                                        <span style="color: #27ae60; font-weight: 600;">
                                            <i class="fas fa-check-circle"></i> Completed
                                        </span>
                                    <% } else { %>
                                        <form action="/course/complete/<%= lesson.id %>" method="POST" style="display: inline;">
                                            <button type="submit" class="btn btn-success btn-sm" style="gap: 4px;">
                                                <i class="fas fa-check"></i> Mark Complete
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p style="color: #7a6a8f;">This course has no lessons yet.</p>
                    <% } %>
                </div>

                <!-- Test if available -->
                <% if (course.test && course.test.questions && course.test.questions.length > 0) { %>
                    <div class="card" style="margin-top: 20px; border: 2px solid #f7d44a; background: #fffbf0;">
                        <h3 style="font-weight: 700; color: #1A0A2E;">
                            <i class="fas fa-pencil-alt" style="color: #f39c12;"></i> Course Test
                        </h3>
                        <p style="color: #7a6a8f; font-size: 0.9rem;"><%= course.test.questions.length %> questions available.</p>
                        <button class="btn btn-primary btn-sm" style="margin-top: 8px;" disabled>
                            <i class="fas fa-lock"></i> Coming Soon
                        </button>
                    </div>
                <% } %>

            <% } else { %>
                <div class="card" style="text-align: center; padding: 48px 24px;">
                    <div style="font-size: 3rem; color: #d4c4f0; margin-bottom: 12px;">
                        <i class="fas fa-exclamation-circle"></i>
                    </div>
                    <h3 style="font-size: 1.3rem; color: #1A0A2E;">No Course Found</h3>
                    <p style="color: #7a6a8f;">You are not enrolled in any course.</p>
                    <a href="/dashboard" class="btn btn-primary" style="margin-top: 12px;">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            <% } %>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>