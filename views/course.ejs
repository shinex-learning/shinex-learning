<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title><%= course.title %> – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .levels-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin-top: 12px;
        }
        .level-card {
            background: #f8f6fc;
            border-radius: 12px;
            padding: 16px 18px;
            border: 1px solid #ede8f5;
            text-align: center;
            transition: all 0.3s ease;
        }
        .level-card:hover {
            border-color: #8B5CF6;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.1);
        }
        .level-card .level-name {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1A0A2E;
        }
        .level-card .level-duration {
            font-size: 0.85rem;
            color: #7a6a8f;
        }
        .level-card .level-lessons {
            font-size: 0.8rem;
            color: #7a6a8f;
            margin: 4px 0 10px;
        }
        @media (max-width: 480px) {
            .levels-grid {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }
            .level-card .level-name {
                font-size: 0.95rem;
            }
        }
        @media (max-width: 380px) {
            .levels-grid {
                grid-template-columns: 1fr;
            }
        }
        /* Dark mode */
        body.dark-mode .level-card {
            background: #1a1a1a !important;
            border-color: #333 !important;
        }
        body.dark-mode .level-card .level-name {
            color: #ffffff !important;
        }
        body.dark-mode .level-card .level-duration {
            color: #cccccc !important;
        }
        body.dark-mode .level-card .level-lessons {
            color: #cccccc !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header', { user, showBack: true }) %>

    <main class="main-content">
        <div class="container" style="max-width:820px;">

            <% if (messages && messages.error) { %>
                <div class="alert alert-danger" style="margin-bottom:12px;"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success" style="margin-bottom:12px;"><%= messages.success %></div>
            <% } %>

            <!-- Course Header -->
            <div class="card" style="border-left:5px solid #8B5CF6;">
                <h1 style="font-size:1.6rem; font-weight:800; color:#1A0A2E; margin:0;"><%= course.title %></h1>
                <p style="color:#5a4a70; font-size:0.95rem; margin:4px 0 8px;"><%= course.description %></p>
                <div style="display:flex; flex-wrap:wrap; gap:8px;">
                    <span class="badge badge-dark"><i class="far fa-clock"></i> Total: <%= course.duration %></span>
                    <span class="badge badge-purple"><%= course.levels ? course.levels.length : 0 %> Levels</span>
                </div>
                <% if (course.review) { %>
                    <div style="margin-top:8px; padding:10px; background:#f0ebfb; border-radius:8px; font-size:0.85rem; color:#4a2d6b;">
                        <i class="fas fa-edit" style="color:#8B5CF6;"></i> <%= course.review %>
                    </div>
                <% } %>
            </div>

            <!-- Ad Box -->
            <%- include('partials/ad-box') %>

            <!-- Levels -->
            <div class="card" style="padding:18px 16px;">
                <h2 style="font-size:1.2rem; font-weight:700; color:#1A0A2E; margin:0 0 4px 0;">
                    <i class="fas fa-layer-group" style="color:#8B5CF6; margin-right:8px;"></i>
                    Choose Your Level
                </h2>
                <p style="color:#7a6a8f; font-size:0.85rem; margin:0 0 12px 0;">Select a level to start learning</p>

                <% if (course.levels && course.levels.length > 0) { %>
                    <div class="levels-grid">
                        <% course.levels.forEach(function(level) { %>
                            <div class="level-card">
                                <div class="level-name"><%= level.name %></div>
                                <div class="level-duration"><i class="far fa-clock"></i> <%= level.duration %></div>
                                <div class="level-lessons">
                                    <i class="fas fa-book"></i> 
                                    <% let lessonCount = 0; let classCount = 0; %>
                                    <% if (level.lessons) { %>
                                        <% level.lessons.forEach(function(l) { %>
                                            <% lessonCount++; %>
                                            <% if (l.classes) { classCount += l.classes.length; } %>
                                        <% }); %>
                                    <% } %>
                                    <%= lessonCount %> lessons • <%= classCount %> classes
                                </div>
                                <a href="/level/<%= course.id %>/<%= level.id %>" class="btn btn-primary btn-sm" style="width:100%; margin-top:4px;">
                                    <i class="fas fa-arrow-right"></i> Start
                                </a>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p style="color:#7a6a8f; text-align:center; padding:16px 0;">
                        <i class="fas fa-info-circle"></i> No levels available yet for this course.
                    </p>
                <% } %>
            </div>

            <!-- Ad Box Bottom -->
            <%- include('partials/ad-box') %>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>