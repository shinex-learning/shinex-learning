<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= course.title %> – SHINEX</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <!-- Course Header -->
            <div class="card card-purple" style="padding:28px 32px; margin-bottom:24px;">
                <h1 style="font-size:2rem; font-weight:800; margin:0 0 4px;"><%= course.title %></h1>
                <p style="font-size:1.05rem; color:#d4c4f0;"><%= course.description || 'No description available.' %></p>
                <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:12px;">
                    <span class="badge" style="background:rgba(255,255,255,0.2); color:#fff;"><%= course.level || 'Beginner' %></span>
                    <span class="badge" style="background:rgba(255,255,255,0.2); color:#fff;"><%= course.duration || 'Self‑paced' %></span>
                    <span class="badge" style="background:rgba(255,255,255,0.2); color:#fff;"><%= course.levels ? course.levels.length : 0 %> Levels</span>
                </div>
            </div>

            <!-- Enrollment Button (if user is logged in) -->
            <% if (user) { %>
                <% if (user.courseId === course.id) { %>
                    <div class="alert alert-success" style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                        <span><i class="fas fa-check-circle"></i> You are enrolled in this course.</span>
                        <a href="/dashboard" class="btn btn-success btn-sm" style="margin-left:auto;">Go to Dashboard</a>
                    </div>
                <% } else { %>
                    <form action="/enroll" method="POST" style="margin-bottom:20px;">
                        <input type="hidden" name="courseId" value="<%= course.id %>">
                        <button type="submit" class="btn btn-primary btn-lg" style="width:100%;">
                            <i class="fas fa-user-plus"></i> Enroll in this Course
                        </button>
                    </form>
                <% } %>
            <% } else { %>
                <div class="alert alert-info" style="text-align:center;">
                    <a href="/login?redirect=/course/<%= course.id %>" class="btn btn-primary btn-sm">Login to Enroll</a>
                    &nbsp; or &nbsp;
                    <a href="/register" class="btn btn-secondary btn-sm">Create Account</a>
                </div>
            <% } %>

            <!-- Levels -->
            <h2 style="font-size:1.5rem; font-weight:700; margin:24px 0 4px;">Course Levels</h2>
            <p style="color:var(--text-muted); margin-bottom:16px;">Complete each level to unlock the next.</p>

            <% if (course.levels && course.levels.length) { %>
                <div class="levels-grid">
                    <% course.levels.forEach((level, index) => { 
                        // Check if user has completed all classes in this level (optional)
                        let levelProgress = 0;
                        let totalLevelClasses = 0;
                        let completedLevelClasses = 0;
                        if (user && user.progress && level.lessons) {
                            level.lessons.forEach(lesson => {
                                if (lesson.classes) {
                                    lesson.classes.forEach(cls => {
                                        totalLevelClasses++;
                                        if (user.progress[cls.id]) completedLevelClasses++;
                                    });
                                }
                            });
                        }
                        levelProgress = totalLevelClasses > 0 ? Math.round((completedLevelClasses / totalLevelClasses) * 100) : 0;
                    %>
                        <div class="level-card">
                            <div class="level-name">Level <%= index+1 %>: <%= level.name %></div>
                            <div class="level-duration"><i class="far fa-clock"></i> <%= level.duration || 'Flexible' %></div>
                            <div class="level-lessons">
                                <%= level.lessons ? level.lessons.reduce((acc, l) => acc + (l.classes ? l.classes.length : 0), 0) : 0 %> classes
                                <% if (totalLevelClasses > 0) { %>
                                    <span style="display:block; font-size:0.7rem; color:var(--primary);"><%= levelProgress %>% complete</span>
                                <% } %>
                            </div>
                            <a href="/level/<%= course.id %>/<%= level.id %>" class="btn btn-primary btn-sm">
                                <i class="fas fa-eye"></i> View Level
                            </a>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <span class="empty-icon">📂</span>
                    <h3>No Levels Yet</h3>
                    <p>This course is being built. Check back soon.</p>
                </div>
            <% } %>

            <!-- Review -->
            <% if (course.review) { %>
                <div style="margin-top:24px; padding:16px 20px; background:var(--primary-bg); border-radius:12px;">
                    <h4 style="font-weight:700; margin:0 0 4px;">📝 Course Review</h4>
                    <p style="margin:0; color:var(--text-muted);"><%= course.review %></p>
                </div>
            <% } %>

            <!-- Back to Courses -->
            <div style="margin-top:24px;">
                <a href="/courses" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to Courses</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>