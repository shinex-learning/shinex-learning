<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= course.title %> – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container" style="max-width:820px;">
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <!-- Course Info -->
            <div class="card" style="border-left:4px solid var(--primary); padding:20px 24px;">
                <h1 style="font-size:1.4rem; font-weight:800; color:var(--text-dark); margin:0;"><%= course.title %></h1>
                <div style="color:var(--text-muted); font-size:0.95rem; margin:4px 0 8px;"><%= course.description %></div>
                <div style="display:flex; flex-wrap:wrap; gap:8px;">
                    <span class="badge badge-purple"><%= course.level || 'Beginner' %></span>
                    <span class="badge badge-dark"><i class="far fa-clock"></i> <%= course.duration %></span>
                    <span class="badge badge-dark"><i class="fas fa-layer-group"></i> <%= course.levels ? course.levels.length : 0 %> Levels</span>
                </div>
                <% if (course.review) { %>
                    <div style="margin-top:8px; padding:10px 14px; background:var(--primary-bg); border-radius:8px; font-size:0.85rem; color:var(--text-dark);">
                        <i class="fas fa-edit" style="color:var(--primary);"></i> <%= course.review %>
                    </div>
                <% } %>
            </div>

            <!-- Levels -->
            <div class="card" style="padding:20px 24px;">
                <h2 style="font-size:1.2rem; font-weight:700; color:var(--text-dark); margin:0 0 2px;">
                    <i class="fas fa-layer-group" style="color:var(--primary);"></i> Choose Your Level
                </h2>
                <p style="color:var(--text-muted); font-size:0.9rem; margin:0 0 12px;">Select a level to start learning</p>

                <% if (course.levels && course.levels.length > 0) { %>
                    <div class="levels-grid">
                        <% course.levels.forEach(function(level) { %>
                            <div class="level-card">
                                <div class="level-name"><%= level.name %></div>
                                <div class="level-duration"><i class="far fa-clock"></i> <%= level.duration %></div>
                                <div class="level-lessons">
                                    <i class="fas fa-book"></i> 
                                    <% let lessonCount = 0, classCount = 0; if (level.lessons) { level.lessons.forEach(function(l) { lessonCount++; if (l.classes) classCount += l.classes.length; }); } %>
                                    <%= lessonCount %> lessons • <%= classCount %> classes
                                </div>
                                <a href="/level/<%= course.id %>/<%= level.id %>" class="btn btn-primary btn-sm">Start</a>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p style="color:var(--text-muted); text-align:center; padding:16px 0;">No levels available yet.</p>
                <% } %>
            </div>

            <%- include(getAdBox()) %>
        </div>
    </main>

    <%- include(getFooter()) %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Ask me about this course!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>