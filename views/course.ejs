<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= course.title %> – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           COURSE PAGE STYLES
           ============================================================ */
        
        .course-container {
            max-width: 900px;
            margin: 0 auto;
        }
        
        /* ----- Course Hero ----- */
        .course-hero {
            background: var(--purple-gradient);
            border-radius: var(--radius-lg);
            padding: var(--spacing-xl) var(--spacing-lg);
            margin-bottom: var(--spacing-lg);
            color: #fff;
        }
        
        .course-hero h1 {
            font-size: 2rem;
            font-weight: 800;
            color: #fff;
            margin: 0 0 4px 0;
        }
        
        .course-hero .course-description {
            font-size: 1.05rem;
            color: rgba(255, 255, 255, 0.85);
            margin: 0;
            line-height: 1.6;
        }
        
        .course-hero .course-meta {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: var(--spacing-md);
        }
        
        .course-hero .course-meta .meta-badge {
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
            padding: 4px 16px;
            border-radius: var(--radius-full);
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        
        .course-hero .course-meta .meta-badge i {
            font-size: 0.7rem;
            opacity: 0.7;
        }
        
        /* ----- Enrollment Section ----- */
        .enroll-section {
            margin-bottom: var(--spacing-lg);
        }
        
        .enroll-section .enrolled-alert {
            display: flex;
            align-items: center;
            gap: var(--spacing-md);
            flex-wrap: wrap;
            padding: var(--spacing-md);
            background: var(--bg-alert-success);
            border-radius: var(--radius-sm);
            border-left: 4px solid var(--text-success);
        }
        
        .enroll-section .enrolled-alert .enrolled-text {
            color: var(--text-success);
            font-weight: 600;
            font-size: 0.95rem;
        }
        
        .enroll-section .enrolled-alert .enrolled-text i {
            margin-right: 8px;
        }
        
        .enroll-section .enrolled-alert .btn-dashboard {
            margin-left: auto;
            background: var(--text-success);
            color: #fff;
            border: none;
            padding: 8px 20px;
            border-radius: var(--radius-full);
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .enroll-section .enrolled-alert .btn-dashboard:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);
        }
        
        .enroll-section .btn-enroll {
            width: 100%;
            padding: 14px;
            font-size: 1rem;
            font-weight: 700;
            border-radius: var(--radius-full);
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .enroll-section .btn-enroll:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .enroll-section .login-prompt {
            text-align: center;
            padding: var(--spacing-md);
            background: var(--bg-alert-info);
            border-radius: var(--radius-sm);
            border-left: 4px solid #3498db;
        }
        
        .enroll-section .login-prompt p {
            color: #1a5276;
            font-size: 0.95rem;
            margin: 0 0 var(--spacing-sm) 0;
        }
        
        .enroll-section .login-prompt .prompt-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .enroll-section .login-prompt .prompt-actions .btn {
            padding: 8px 24px;
            font-size: 0.9rem;
            border-radius: var(--radius-full);
            text-decoration: none;
            font-weight: 600;
        }
        
        /* ----- Section Title ----- */
        .section-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: var(--spacing-lg) 0 4px 0;
        }
        
        .section-subtitle {
            color: var(--text-muted);
            margin: 0 0 var(--spacing-md) 0;
            font-size: 1rem;
        }
        
        /* ----- Levels Grid ----- */
        .levels-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: var(--spacing-md);
            margin-top: var(--spacing-sm);
        }
        
        .level-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-lg);
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
        }
        
        .level-card:hover {
            border-color: var(--purple-primary);
            box-shadow: var(--shadow-md);
            transform: translateY(-4px);
        }
        
        .level-card .level-badge {
            display: inline-block;
            background: var(--purple-bg);
            color: var(--purple-primary);
            padding: 2px 12px;
            border-radius: var(--radius-full);
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
            align-self: center;
        }
        
        .level-card .level-name {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 2px 0;
        }
        
        .level-card .level-duration {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0 0 2px 0;
        }
        
        .level-card .level-duration i {
            margin-right: 4px;
        }
        
        .level-card .level-classes {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0 0 4px 0;
        }
        
        .level-card .level-classes i {
            margin-right: 4px;
        }
        
        .level-card .level-progress-text {
            font-size: 0.75rem;
            color: var(--purple-primary);
            font-weight: 600;
            margin: 0 0 var(--spacing-sm) 0;
        }
        
        .level-card .level-progress-bar {
            width: 100%;
            height: 6px;
            background: var(--bg-card-secondary);
            border-radius: var(--radius-full);
            overflow: hidden;
            margin-bottom: var(--spacing-sm);
        }
        
        .level-card .level-progress-bar .progress-fill {
            height: 100%;
            background: var(--purple-gradient);
            border-radius: var(--radius-full);
            transition: width 0.6s ease;
        }
        
        .level-card .btn-view-level {
            margin-top: auto;
            padding: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            border-radius: var(--radius-full);
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            text-decoration: none;
            display: block;
            text-align: center;
            transition: all 0.3s ease;
        }
        
        .level-card .btn-view-level:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
        }
        
        .level-card .btn-view-level i {
            margin-right: 6px;
        }
        
        /* ----- Review Section ----- */
        .review-box {
            margin-top: var(--spacing-lg);
            padding: var(--spacing-md);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }
        
        .review-box .review-title {
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
            font-size: 1rem;
        }
        
        .review-box .review-title i {
            color: var(--text-warning);
            margin-right: 6px;
        }
        
        .review-box p {
            color: var(--text-secondary);
            margin: 0;
            font-size: 0.95rem;
            line-height: 1.7;
            font-style: italic;
        }
        
        /* ----- Back Link ----- */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.95rem;
            margin-top: var(--spacing-md);
            transition: all 0.3s ease;
        }
        
        .back-link:hover {
            color: var(--purple-primary);
        }
        
        /* ----- Empty State ----- */
        .empty-state {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-md);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
        }
        
        .empty-state .empty-icon {
            font-size: 3rem;
            display: block;
            margin-bottom: var(--spacing-sm);
            opacity: 0.5;
        }
        
        .empty-state h3 {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .empty-state p {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin: 0;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 768px) {
            .course-hero h1 {
                font-size: 1.5rem;
            }
            
            .course-hero .course-description {
                font-size: 0.95rem;
            }
            
            .course-hero {
                padding: var(--spacing-lg) var(--spacing-md);
            }
            
            .enroll-section .enrolled-alert {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .enroll-section .enrolled-alert .btn-dashboard {
                margin-left: 0;
                width: 100%;
                text-align: center;
            }
            
            .levels-grid {
                grid-template-columns: 1fr 1fr;
            }
            
            .section-title {
                font-size: 1.2rem;
            }
            
            .login-prompt .prompt-actions {
                flex-direction: column;
                align-items: center;
            }
            
            .login-prompt .prompt-actions .btn {
                width: 100%;
                text-align: center;
            }
        }
        
        @media (max-width: 480px) {
            .levels-grid {
                grid-template-columns: 1fr;
            }
            
            .course-hero .course-meta .meta-badge {
                font-size: 0.7rem;
                padding: 3px 12px;
            }
        }
    </style>
</head>
<body>

    <!-- ===== HEADER ===== -->
    <%- include('partials/header', { showBack: true }) %>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="container">
            <div class="course-container">

                <!-- ===== FLASH MESSAGES ===== -->
                <% if (messages && messages.success) { %>
                    <div class="alert alert-success flash-message" data-type="success">
                        <i class="fas fa-check-circle"></i> <%= messages.success %>
                    </div>
                <% } %>
                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger flash-message" data-type="error">
                        <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                    </div>
                <% } %>

                <!-- ===== COURSE HERO ===== -->
                <div class="course-hero">
                    <h1><%= course.title %></h1>
                    <p class="course-description">
                        <%= course.description || 'No description available.' %>
                    </p>
                    <div class="course-meta">
                        <span class="meta-badge">
                            <i class="fas fa-signal"></i> <%= course.level || 'Beginner' %>
                        </span>
                        <span class="meta-badge">
                            <i class="fas fa-clock"></i> <%= course.duration || 'Self-paced' %>
                        </span>
                        <span class="meta-badge">
                            <i class="fas fa-layer-group"></i> <%= course.levels ? course.levels.length : 0 %> Levels
                        </span>
                        <span class="meta-badge">
                            <i class="fas fa-book"></i> 
                            <% let totalClasses = 0; %>
                            <% if (course.levels) { %>
                                <% course.levels.forEach(function(l) { if (l.lessons) { l.lessons.forEach(function(ls) { if (ls.classes) totalClasses += ls.classes.length; }); } }); %>
                            <% } %>
                            <%= totalClasses %> Classes
                        </span>
                    </div>
                </div>

                <!-- ===== ENROLLMENT SECTION ===== -->
                <div class="enroll-section">
                    <% if (user) { %>
                        <% if (user.courseId === course.id) { %>
                            <!-- Already Enrolled -->
                            <div class="enrolled-alert">
                                <span class="enrolled-text">
                                    <i class="fas fa-check-circle"></i> You are enrolled in this course.
                                </span>
                                <a href="/dashboard" class="btn-dashboard">
                                    <i class="fas fa-arrow-right"></i> Dashboard
                                </a>
                            </div>
                        <% } else { %>
                            <!-- Enroll Button -->
                            <form action="/enroll" method="POST">
                                <input type="hidden" name="courseId" value="<%= course.id %>">
                                <button type="submit" class="btn-enroll">
                                    <i class="fas fa-user-plus"></i> Enroll in this Course
                                </button>
                            </form>
                        <% } %>
                    <% } else { %>
                        <!-- Not Logged In -->
                        <div class="login-prompt">
                            <p><i class="fas fa-lock"></i> Login or create an account to enroll</p>
                            <div class="prompt-actions">
                                <a href="/login?redirect=/course/<%= course.id %>" class="btn btn-primary" style="background:var(--purple-primary); color:#fff;">
                                    <i class="fas fa-sign-in-alt"></i> Login
                                </a>
                                <a href="/register" class="btn btn-secondary" style="background:var(--bg-card-secondary); color:var(--text-primary);">
                                    <i class="fas fa-user-plus"></i> Register
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- ===== LEVELS ===== -->
                <h2 class="section-title">
                    <i class="fas fa-layer-group" style="color:var(--purple-primary);"></i> Course Levels
                </h2>
                <p class="section-subtitle">Complete each level to unlock the next.</p>

                <% if (course.levels && course.levels.length > 0) { %>
                    <div class="levels-grid">
                        <% course.levels.forEach((level, index) => { 
                            let levelProgress = 0;
                            let totalLevelClasses = 0;
                            let completedLevelClasses = 0;
                            
                            if (user && user.progress && level.lessons) {
                                level.lessons.forEach(lesson => {
                                    if (lesson.classes) {
                                        lesson.classes.forEach(cls => {
                                            totalLevelClasses++;
                                            if (user.progress[cls.id]) completedLevelClasses++;
                                        });
                                    }
                                });
                            }
                            levelProgress = totalLevelClasses > 0 ? Math.round((completedLevelClasses / totalLevelClasses) * 100) : 0;
                        %>
                            <div class="level-card">
                                <span class="level-badge">Level <%= index + 1 %></span>
                                <div class="level-name"><%= level.name %></div>
                                <div class="level-duration">
                                    <i class="far fa-clock"></i> <%= level.duration || 'Flexible' %>
                                </div>
                                <div class="level-classes">
                                    <i class="fas fa-book-open"></i> 
                                    <%= level.lessons ? level.lessons.reduce((acc, l) => acc + (l.classes ? l.classes.length : 0), 0) : 0 %> classes
                                </div>
                                
                                <!-- Progress -->
                                <% if (totalLevelClasses > 0) { %>
                                    <div class="level-progress-text">
                                        <%= levelProgress %>% complete
                                    </div>
                                    <div class="level-progress-bar">
                                        <div class="progress-fill" style="width: <%= levelProgress %>%;"></div>
                                    </div>
                                <% } %>
                                
                                <a href="/level/<%= course.id %>/<%= level.id %>" class="btn-view-level">
                                    <i class="fas fa-eye"></i> View Level
                                </a>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <span class="empty-icon">📂</span>
                        <h3>No Levels Yet</h3>
                        <p>This course is being built. Check back soon for new content.</p>
                    </div>
                <% } %>

                <!-- ===== REVIEW ===== -->
                <% if (course.review) { %>
                    <div class="review-box">
                        <div class="review-title">
                            <i class="fas fa-star"></i> Course Review
                        </div>
                        <p>"<%= course.review %>"</p>
                    </div>
                <% } %>

                <!-- ===== BACK LINK ===== -->
                <a href="/" class="back-link">
                    <i class="fas fa-arrow-left"></i> Back to Courses
                </a>

            </div>
        </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>
</body>
</html>