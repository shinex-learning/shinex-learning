<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Course – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/header', { user, showBack: true }) %>

    <main class="main-content">
        <div class="container" style="max-width:820px;">
            <% if (course) { %>
                <div class="card" style="border-left:5px solid #8B5CF6; margin-bottom:20px;">
                    <h2 style="font-size:1.4rem; font-weight:800; color:#1A0A2E;"><%= course.title %></h2>
                    <p style="color:#5a4a70; font-size:0.95rem;"><%= course.description %></p>
                    <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:10px;">
                        <span class="badge badge-purple"><%= course.level %></span>
                        <span class="badge badge-dark"><i class="far fa-clock"></i> <%= course.duration %></span>
                        <span class="badge badge-gold"><i class="fas fa-star"></i> Score: <%= score %></span>
                    </div>
                </div>

                <%- include('partials/ad-box') %>

                <% if (course.lessons && course.lessons.length > 0) { %>
                    <% course.lessons.forEach(function(lesson, lIdx) { %>
                        <div class="card" style="margin-bottom:16px; border-left:4px solid #8B5CF6;">
                            <h3 style="font-weight:700; color:#1A0A2E; font-size:1.2rem;">
                                <%= (lIdx+1) %>. <%= lesson.title %>
                            </h3>
                            <% if (lesson.description) { %>
                                <p style="color:#7a6a8f; font-size:0.9rem;"><%= lesson.description %></p>
                            <% } %>

                            <% if (lesson.classes && lesson.classes.length > 0) { %>
                                <div style="margin-top:12px;">
                                    <% lesson.classes.forEach(function(cls, cIdx) { %>
                                        <div style="background:#f8f6fc; border-radius:10px; padding:14px; margin-bottom:10px; border-left:3px solid #8B5CF6;">
                                            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px;">
                                                <div style="flex:1; min-width:200px;">
                                                    <strong style="font-size:1rem; color:#1A0A2E;">
                                                        <%= (lIdx+1) %>.<%= (cIdx+1) %> <%= cls.title %>
                                                    </strong>
                                                    <div class="reading-content-board" style="margin-top:8px;">
                                                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                                                            <span style="font-weight:600; color:#1A0A2E; font-size:0.9rem;">📖 Content</span>
                                                            <button onclick="speakContent('<%= cls.content.replace(/"/g, '\\"').replace(/\n/g, ' ') %>')" 
                                                                    style="background:#8B5CF6; color:white; border:none; border-radius:50%; width:34px; height:34px; cursor:pointer; font-size:14px;">
                                                                <i class="fas fa-volume-up"></i>
                                                            </button>
                                                        </div>
                                                        <div style="font-size:1rem; line-height:1.7; padding:6px 0; max-width:100%;">
                                                            <%- cls.content || 'No content yet' %>
                                                        </div>
                                                        <% if (cls.imageUrl) { %>
                                                            <div style="margin-top:8px;">
                                                                <img src="<%= cls.imageUrl %>" alt="<%= cls.title %>" style="max-width:100%; border-radius:8px; border:1px solid #ede8f5;">
                                                            </div>
                                                        <% } %>
                                                        <% if (cls.videoUrl) { %>
                                                            <div style="margin-top:6px;">
                                                                <a href="<%= cls.videoUrl %>" target="_blank" class="btn btn-secondary btn-sm"><i class="fab fa-youtube"></i> Watch Video</a>
                                                            </div>
                                                        <% } %>
                                                        <% if (cls.externalLink) { %>
                                                            <div style="margin-top:6px;">
                                                                <a href="<%= cls.externalLink %>" target="_blank" class="btn btn-secondary btn-sm"><i class="fas fa-external-link-alt"></i> More Resources</a>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                </div>
                                                <div style="margin-top:8px;">
                                                    <% if (progress && progress[cls.id]) { %>
                                                        <span style="color:#27ae60; font-weight:600; font-size:0.85rem;">
                                                            <i class="fas fa-check-circle"></i> Completed
                                                        </span>
                                                    <% } else { %>
                                                        <form action="/course/complete/<%= cls.id %>" method="POST" style="display:inline;">
                                                            <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check"></i> Mark Complete</button>
                                                        </form>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                                <%- include('partials/ad-box') %>
                            <% } else { %>
                                <p style="color:#7a6a8f; font-style:italic; font-size:0.9rem;">No classes yet in this lesson.</p>
                            <% } %>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p style="color:#7a6a8f;">No lessons yet.</p>
                <% } %>

            <% } else { %>
                <div class="card" style="text-align:center; padding:40px 24px;">
                    <h3 style="font-size:1.2rem; color:#1A0A2E;">No Course Enrolled</h3>
                    <p style="color:#7a6a8f; margin:8px 0 16px;">You are not enrolled in any course.</p>
                    <a href="/dashboard" class="btn btn-primary">Back to Dashboard</a>
                </div>
            <% } %>
        </div>
    </main>

    <script>
        function speakContent(text) {
            if (!text || text.trim() === '') {
                alert('No content to read.');
                return;
            }
            const clean = text.replace(/<[^>]*>/g, '').trim();
            if (!clean) return alert('No readable text.');
            if (window.speechSynthesis.speaking) window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(clean);
            utterance.lang = 'en-US';
            utterance.rate = 0.9;
            utterance.pitch = 1;
            utterance.volume = 1;
            window.speechSynthesis.speak(utterance);
        }
    </script>

    <%- include('partials/footer') %>
</body>
</html>