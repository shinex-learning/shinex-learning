<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= course ? course.title : 'Course' %> – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Inline styles for course page to ensure proper formatting */
        .class-content p {
            margin-bottom: 1rem !important;
            line-height: 1.8 !important;
        }
        .class-content h1, .class-content h2, .class-content h3 {
            margin-top: 1.5rem !important;
            margin-bottom: 0.5rem !important;
        }
        .class-content ul, .class-content ol {
            padding-left: 1.5rem !important;
            margin-bottom: 1rem !important;
        }
        .class-content li {
            margin-bottom: 0.3rem !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header', { user, showBack: true }) %>

    <main class="course-main">
        <div class="course-container">

            <% if (course) { %>

                <!-- ===== LEFT SIDEBAR ===== -->
                <aside class="course-sidebar">
                    <div class="sidebar-header">
                        <h3><i class="fas fa-list-ul"></i> Lessons</h3>
                    </div>
                    <nav class="sidebar-nav">
                        <% course.lessons.forEach(function(lesson, lIdx) { 
                            // Check if any class in this lesson is the current one
                            let isActiveLesson = lesson.classes.some(cls => cls.id === currentClassId);
                        %>
                            <div class="sidebar-lesson">
                                <div class="lesson-header <%= isActiveLesson ? 'active' : '' %>">
                                    <span class="lesson-number"><%= lIdx + 1 %></span>
                                    <span class="lesson-title"><%= lesson.title %></span>
                                    <% if (lesson.classes.every(c => progress && progress[c.id])) { %>
                                        <span class="badge badge-green" style="font-size:0.6rem; margin-left:auto;"><i class="fas fa-check-circle"></i></span>
                                    <% } %>
                                </div>
                                <ul class="class-list">
                                    <% lesson.classes.forEach(function(cls, cIdx) { 
                                        const isCompleted = progress && progress[cls.id];
                                        const isLocked = !isCompleted && cIdx > 0 && !(progress && progress[lesson.classes[cIdx - 1].id]);
                                        const isActive = cls.id === currentClassId;
                                    %>
                                        <li class="class-item <%= isActive ? 'active' : '' %> <%= isLocked ? 'locked' : '' %> <%= isCompleted ? 'completed' : '' %>">
                                            <a href="/course?classId=<%= cls.id %>" class="class-link <%= isLocked ? 'disabled' : '' %>">
                                                <span class="class-number"><%= (lIdx+1) %>.<%= (cIdx+1) %></span>
                                                <span class="class-title"><%= cls.title %></span>
                                                <% if (isCompleted) { %>
                                                    <span class="class-status"><i class="fas fa-check-circle" style="color:#27ae60;"></i></span>
                                                <% } else if (isLocked) { %>
                                                    <span class="class-status"><i class="fas fa-lock" style="color:#b0a3c4;"></i></span>
                                                <% } %>
                                            </a>
                                        </li>
                                    <% }); %>
                                </ul>
                            </div>
                        <% }); %>
                    </nav>
                </aside>

                <!-- ===== MAIN CONTENT ===== -->
                <section class="course-content">
                    <% if (currentClass) { %>
                        <!-- Lesson Title at Top -->
                        <div class="content-header">
                            <h1><%= currentLesson.title %></h1>
                            <span class="class-number-badge"><%= currentClass.number %></span>
                        </div>

                        <!-- Class Content -->
                        <div class="content-body">
                            <h2><%= currentClass.title %></h2>
                            <div class="class-content">
                                <%- currentClass.content || 'No content yet' %>
                            </div>

                            <!-- Image -->
                            <% if (currentClass.imageUrl) { %>
                                <div class="class-image">
                                    <img src="<%= currentClass.imageUrl %>" alt="<%= currentClass.title %>">
                                </div>
                            <% } %>

                            <!-- Video -->
                            <% if (currentClass.videoUrl) { %>
                                <div class="class-video">
                                    <a href="<%= currentClass.videoUrl %>" target="_blank" class="btn btn-secondary btn-sm">
                                        <i class="fab fa-youtube"></i> Watch Video
                                    </a>
                                </div>
                            <% } %>

                            <!-- External Link -->
                            <% if (currentClass.externalLink) { %>
                                <div class="class-external">
                                    <a href="<%= currentClass.externalLink %>" target="_blank" class="btn btn-secondary btn-sm">
                                        <i class="fas fa-external-link-alt"></i> More Resources
                                    </a>
                                </div>
                            <% } %>

                            <!-- Completed Status -->
                            <div class="class-status-bar">
                                <% if (progress && progress[currentClass.id]) { %>
                                    <span class="status-completed"><i class="fas fa-check-circle"></i> Completed</span>
                                <% } else { %>
                                    <span class="status-pending"><i class="far fa-circle"></i> Not Completed</span>
                                <% } %>
                            </div>
                        </div>

                        <!-- ===== NEXT BUTTON ===== -->
                        <div class="content-footer">
                            <div class="next-button-wrapper">
                                <% 
                                    // Check if there is a next class after current
                                    let allClassesFlat = [];
                                    course.lessons.forEach(lesson => {
                                        if (lesson.classes) {
                                            lesson.classes.forEach(cls => {
                                                allClassesFlat.push({
                                                    id: cls.id,
                                                    lessonId: lesson.id
                                                });
                                            });
                                        }
                                    });
                                    let currentIdx = allClassesFlat.findIndex(c => c.id === currentClass.id);
                                    let hasNext = currentIdx < allClassesFlat.length - 1;
                                %>
                                <% if (progress && progress[currentClass.id]) { %>
                                    <% if (hasNext) { %>
                                        <form action="/course/next/<%= currentClass.id %>" method="POST">
                                            <button type="submit" class="btn btn-primary next-btn">
                                                <i class="fas fa-arrow-right"></i> Next Class
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <div class="course-complete-msg">
                                            <i class="fas fa-trophy" style="color:#f39c12;"></i> All classes completed! 🎉
                                        </div>
                                    <% } %>
                                <% } else { %>
                                    <form action="/course/complete/<%= currentClass.id %>" method="POST">
                                        <button type="submit" class="btn btn-success next-btn">
                                            <i class="fas fa-check"></i> Mark Complete
                                        </button>
                                    </form>
                                <% } %>
                            </div>

                            <!-- Progress Bar -->
                            <div class="progress-bar-wrapper">
                                <div class="progress-label">
                                    <span>Progress</span>
                                    <span><%= completedClasses %> / <%= totalClasses %> classes</span>
                                </div>
                                <div class="progress-wrap">
                                    <div class="progress-fill" style="width: <%= totalClasses > 0 ? Math.round((completedClasses / totalClasses) * 100) : 0 %>%;"></div>
                                </div>
                                <div class="score-display">
                                    <i class="fas fa-star" style="color:#f39c12;"></i> Score: <strong><%= score %></strong> points
                                </div>
                            </div>
                        </div>

                        <!-- ===== AD BOX ===== -->
                        <%- include('partials/ad-box') %>

                    <% } else { %>
                        <!-- No class selected -->
                        <div class="content-empty">
                            <i class="fas fa-book-open" style="font-size:3rem; color:#d4c4f0;"></i>
                            <h3>Select a class from the sidebar</h3>
                            <p>Click on any unlocked class to start learning.</p>
                            <!-- Show first unlocked class -->
                            <% 
                                let firstUnlocked = null;
                                let found = false;
                                course.lessons.forEach(lesson => {
                                    if (!found && lesson.classes) {
                                        lesson.classes.forEach(cls => {
                                            if (!found && !(progress && progress[cls.id])) {
                                                firstUnlocked = cls;
                                                found = true;
                                            }
                                        });
                                    }
                                });
                                if (firstUnlocked) { 
                            %>
                                <a href="/course?classId=<%= firstUnlocked.id %>" class="btn btn-primary" style="margin-top:16px;">
                                    <i class="fas fa-play"></i> Start First Class
                                </a>
                            <% } %>
                        </div>
                    <% } %>
                </section>

            <% } else { %>
                <!-- No course enrolled -->
                <div class="course-empty">
                    <i class="fas fa-exclamation-circle" style="font-size:3rem; color:#d4c4f0;"></i>
                    <h3>No Course Enrolled</h3>
                    <p>You are not enrolled in any course.</p>
                    <a href="/dashboard" class="btn btn-primary">Back to Dashboard</a>
                </div>
            <% } %>

        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        // Clicking on a locked class shows a message
        document.querySelectorAll('.class-link.disabled').forEach(function(link) {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                alert('🔒 This class is locked. Complete the previous class first.');
            });
        });
    </script>
</body>
</html>