<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }
        .contact-info-card {
            background: var(--primary-bg);
            border-radius: var(--radius);
            padding: 24px;
            border: 1px solid #ede8f5;
            transition: all 0.3s ease;
        }
        body.dark-mode .contact-info-card {
            background: #1a1a1a;
            border-color: var(--dark-border);
        }
        .contact-info-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px 0;
            border-bottom: 1px solid #ede8f5;
        }
        .contact-info-item:last-child {
            border-bottom: none;
        }
        .contact-info-item .icon-box {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        .contact-info-item .info-text {
            flex: 1;
        }
        .contact-info-item .info-text .label {
            font-size: 0.7rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }
        .contact-info-item .info-text .value {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-dark);
        }
        body.dark-mode .contact-info-item .info-text .value {
            color: var(--text-light);
        }
        .contact-info-item .info-text .value a {
            color: var(--primary);
            text-decoration: none;
        }
        .contact-info-item .info-text .value a:hover {
            text-decoration: underline;
        }
        body.dark-mode .contact-info-item {
            border-color: var(--dark-border);
        }
        .contact-form-card {
            background: #fff;
            border-radius: var(--radius);
            padding: 24px;
            border: 1px solid #ede8f5;
        }
        body.dark-mode .contact-form-card {
            background: #1a1a1a;
            border-color: var(--dark-border);
        }
        .contact-form-card h3 {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0 0 4px 0;
        }
        body.dark-mode .contact-form-card h3 {
            color: var(--text-light);
        }
        .contact-form-card .subtitle {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 0 0 16px 0;
        }
        .whatsapp-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #25D366;
            color: #fff;
            padding: 8px 16px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }
        .whatsapp-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
            color: #fff;
        }
        body.dark-mode .contact-form-card input,
        body.dark-mode .contact-form-card textarea,
        body.dark-mode .contact-form-card select {
            background: #2a2a2a;
            color: var(--text-light);
            border-color: var(--dark-border);
        }
        @media (max-width: 768px) {
            .contact-grid {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            .contact-info-item {
                padding: 10px 0;
            }
            .contact-info-item .icon-box {
                width: 40px;
                height: 40px;
                font-size: 1rem;
            }
            .contact-info-item .info-text .value {
                font-size: 0.85rem;
            }
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container" style="max-width:1000px;">
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <div style="text-align:center; margin-bottom:24px;">
                <h1 style="font-size:1.8rem; font-weight:800; color:var(--text-dark); margin:0;">
                    <i class="fas fa-envelope" style="color:var(--primary);"></i> Contact Us
                </h1>
                <p style="color:var(--text-muted); font-size:0.95rem; margin:4px 0 0;">
                    We'd love to hear from you. Reach out to us through any of the channels below.
                </p>
            </div>

            <div class="contact-grid">
                <!-- ===== CONTACT INFO ===== -->
                <div class="contact-info-card">
                    <h3 style="font-weight:700; color:var(--text-dark); margin:0 0 16px 0;">
                        <i class="fas fa-phone" style="color:var(--primary);"></i> Get in Touch
                    </h3>

                    <!-- Email -->
                    <div class="contact-info-item">
                        <div class="icon-box"><i class="fas fa-envelope"></i></div>
                        <div class="info-text">
                            <div class="label">Email</div>
                            <div class="value">
                                <a href="mailto:shinexlearning@gmail.com">shinexlearning@gmail.com</a>
                            </div>
                        </div>
                    </div>

                    <!-- Phone -->
                    <div class="contact-info-item">
                        <div class="icon-box"><i class="fas fa-phone"></i></div>
                        <div class="info-text">
                            <div class="label">Phone</div>
                            <div class="value">
                                <a href="tel:+2347067574479">+234 706 757 4479</a>
                            </div>
                        </div>
                    </div>

                    <!-- WhatsApp -->
                    <div class="contact-info-item">
                        <div class="icon-box"><i class="fab fa-whatsapp"></i></div>
                        <div class="info-text">
                            <div class="label">WhatsApp</div>
                            <div class="value">
                                <a href="https://wa.me/2348025052852" target="_blank" class="whatsapp-link">
                                    <i class="fab fa-whatsapp"></i> +234 802 505 2852
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Website -->
                    <div class="contact-info-item">
                        <div class="icon-box"><i class="fas fa-globe"></i></div>
                        <div class="info-text">
                            <div class="label">Website</div>
                            <div class="value">
                                <a href="https://shinex-learning.onrender.com" target="_blank">
                                    shinex-learning.onrender.com
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Social Links -->
                    <div style="margin-top:16px; padding-top:16px; border-top:1px solid #ede8f5;">
                        <div style="display:flex; gap:12px;">
                            <a href="#" style="width:40px; height:40px; border-radius:50%; background:var(--primary); color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.1rem; transition:all 0.3s ease;">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="#" style="width:40px; height:40px; border-radius:50%; background:var(--primary); color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.1rem; transition:all 0.3s ease;">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a href="#" style="width:40px; height:40px; border-radius:50%; background:var(--primary); color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.1rem; transition:all 0.3s ease;">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                            <a href="#" style="width:40px; height:40px; border-radius:50%; background:var(--primary); color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.1rem; transition:all 0.3s ease;">
                                <i class="fab fa-youtube"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- ===== CONTACT FORM ===== -->
                <div class="contact-form-card">
                    <h3><i class="fas fa-paper-plane" style="color:var(--primary);"></i> Send Us a Message</h3>
                    <p class="subtitle">Fill in the form and we'll get back to you as soon as possible.</p>

                    <form id="contactForm" method="POST" action="/contact/send">
                        <div class="settings-group">
                            <label for="contactName">Full Name <span style="color:#e74c3c;">*</span></label>
                            <input type="text" id="contactName" name="name" placeholder="Your full name" required>
                        </div>
                        <div class="settings-group">
                            <label for="contactEmail">Email Address <span style="color:#e74c3c;">*</span></label>
                            <input type="email" id="contactEmail" name="email" placeholder="your@email.com" required>
                        </div>
                        <div class="settings-group">
                            <label for="contactSubject">Subject <span style="color:#e74c3c;">*</span></label>
                            <select id="contactSubject" name="subject" required>
                                <option value="">Select a subject...</option>
                                <option value="General Inquiry">General Inquiry</option>
                                <option value="Course Question">Course Question</option>
                                <option value="Technical Issue">Technical Issue</option>
                                <option value="Feature Request">Feature Request</option>
                                <option value="Partnership">Partnership</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="settings-group">
                            <label for="contactMessage">Message <span style="color:#e74c3c;">*</span></label>
                            <textarea id="contactMessage" name="message" rows="5" placeholder="Your message..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fas fa-paper-plane"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <%- include(getFooter()) %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hello! I'm your AI tutor. Ask me anything about your courses!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>