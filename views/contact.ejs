<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container" style="max-width:900px;">
            <h2 style="font-size:2rem; font-weight:800; margin:0 0 4px;">📬 Contact Us</h2>
            <p style="color:var(--text-muted); margin-bottom:24px;">
                Have a question, feedback, or need help? Fill out the form below and we'll get back to you within <strong>24-48 hours</strong>.
            </p>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
                <!-- ===== CONTACT FORM ===== -->
                <div class="card" style="padding:28px 24px;">
                    <h3 style="font-size:1.2rem; font-weight:700; margin:0 0 16px;">Send a Message</h3>
                    <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:16px;">
                        Fill in the form below and our team will respond within 24-48 hours.
                    </p>

                    <form action="/contact/send" method="POST">
                        <div class="settings-group">
                            <label for="name">Your Full Name <span style="color:red;">*</span></label>
                            <input type="text" id="name" name="name" placeholder="e.g. John Doe" required>
                        </div>
                        <div class="settings-group">
                            <label for="email">Email Address <span style="color:red;">*</span></label>
                            <input type="email" id="email" name="email" placeholder="you@example.com" required>
                            <p class="help-text">We'll send our reply to this email.</p>
                        </div>
                        <div class="settings-group">
                            <label for="subject">Subject <span style="color:red;">*</span></label>
                            <select id="subject" name="subject" required>
                                <option value="">Select a subject...</option>
                                <option value="Course Inquiry">📚 Course Inquiry</option>
                                <option value="Technical Support">🛠️ Technical Support</option>
                                <option value="Account Issue">👤 Account Issue</option>
                                <option value="Service Request">🛒 Service Request</option>
                                <option value="Feedback/Suggestion">💡 Feedback / Suggestion</option>
                                <option value="Partnership">🤝 Partnership</option>
                                <option value="Other">📌 Other</option>
                            </select>
                        </div>
                        <div class="settings-group">
                            <label for="message">Message <span style="color:red;">*</span></label>
                            <textarea id="message" name="message" rows="5" placeholder="Describe your issue or question in detail..." required></textarea>
                            <p class="help-text">Please be as detailed as possible so we can assist you better.</p>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block btn-lg">
                            <i class="fas fa-paper-plane"></i> Send Message
                        </button>
                    </form>
                </div>

                <!-- ===== CONTACT INFO ===== -->
                <div>
                    <div class="card" style="padding:24px; margin-bottom:16px;">
                        <h3 style="font-size:1.1rem; font-weight:700; margin:0 0 12px;">Contact Information</h3>
                        <div style="display:flex; flex-direction:column; gap:12px;">
                            <div style="display:flex; align-items:center; gap:12px;">
                                <div style="width:40px; height:40px; border-radius:50%; background:var(--primary-bg); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <i class="fas fa-envelope" style="color:var(--primary);"></i>
                                </div>
                                <div>
                                    <p style="font-weight:600; margin:0;">Email</p>
                                    <p style="color:var(--text-muted); margin:0; font-size:0.85rem;">support@shinex.ng</p>
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:12px;">
                                <div style="width:40px; height:40px; border-radius:50%; background:var(--primary-bg); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <i class="fas fa-phone" style="color:var(--primary);"></i>
                                </div>
                                <div>
                                    <p style="font-weight:600; margin:0;">Phone</p>
                                    <p style="color:var(--text-muted); margin:0; font-size:0.85rem;">+234 800 SHINEX (744639)</p>
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:12px;">
                                <div style="width:40px; height:40px; border-radius:50%; background:var(--primary-bg); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <i class="fab fa-whatsapp" style="color:#25D366; font-size:1.3rem;"></i>
                                </div>
                                <div>
                                    <p style="font-weight:600; margin:0;">WhatsApp</p>
                                    <p style="color:var(--text-muted); margin:0; font-size:0.85rem;">+234 812 345 6789</p>
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:12px;">
                                <div style="width:40px; height:40px; border-radius:50%; background:var(--primary-bg); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <i class="fas fa-map-marker-alt" style="color:var(--primary);"></i>
                                </div>
                                <div>
                                    <p style="font-weight:600; margin:0;">Address</p>
                                    <p style="color:var(--text-muted); margin:0; font-size:0.85rem;">Lagos, Nigeria</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Response Time Info -->
                    <div style="background:var(--primary-bg); padding:16px 20px; border-radius:10px; margin-bottom:16px;">
                        <div style="display:flex; align-items:center; gap:12px;">
                            <i class="fas fa-clock" style="color:var(--primary); font-size:1.5rem;"></i>
                            <div>
                                <p style="font-weight:600; margin:0;">Response Time</p>
                                <p style="color:var(--text-muted); margin:0; font-size:0.85rem;">
                                    We respond within <strong>24-48 hours</strong>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Social Media -->
                    <div class="card" style="padding:16px 20px; text-align:center;">
                        <h4 style="font-size:1rem; font-weight:700; margin:0 0 4px;">📱 Connect With Us</h4>
                        <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">Follow us on social media</p>
                        <div style="display:flex; justify-content:center; gap:16px; font-size:1.4rem;">
                            <a href="#" style="color:var(--text-muted); transition:color 0.3s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-muted)'">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="#" style="color:var(--text-muted); transition:color 0.3s;" onmouseover="this.style.color='#1DA1F2'" onmouseout="this.style.color='var(--text-muted)'">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a href="#" style="color:var(--text-muted); transition:color 0.3s;" onmouseover="this.style.color='#E4405F'" onmouseout="this.style.color='var(--text-muted)'">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="#" style="color:var(--text-muted); transition:color 0.3s;" onmouseover="this.style.color='#25D366'" onmouseout="this.style.color='var(--text-muted)'">
                                <i class="fab fa-whatsapp"></i>
                            </a>
                            <a href="#" style="color:var(--text-muted); transition:color 0.3s;" onmouseover="this.style.color='#FF0000'" onmouseout="this.style.color='var(--text-muted)'">
                                <i class="fab fa-youtube"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FAQ Link -->
            <div style="text-align:center; margin-top:24px; padding:16px; border-top:1px solid #ede8f5;">
                <p style="color:var(--text-muted); font-size:0.9rem;">
                    <i class="fas fa-question-circle" style="color:var(--primary);"></i>
                    Check our <a href="/faq" style="color:var(--primary); font-weight:600;">FAQ</a> for quick answers to common questions.
                </p>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>