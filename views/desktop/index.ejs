<%- include('../partials/header', { user: user, title: title }) %>

<section class="desktop-hero">
    <div class="container">
        <div class="desktop-hero-content">
            <div class="desktop-hero-text">
                <span class="desktop-badge">SHINEX Learning Circle</span>
                <h1>Learn Skills.<br><span>Build Knowledge.</span><br>Shape Your Future.</h1>
                <p>SHINEX Learning Circle (SLC) is your trusted online learning platform. Study at your own pace and earn certificates.</p>
                <div class="desktop-hero-buttons">
                    <a href="/courses" class="btn btn-primary btn-lg">Explore Courses</a>
                    <a href="#how-it-works" class="btn btn-secondary btn-lg">How It Works</a>
                </div>
            </div>
            <div class="desktop-hero-image">
                <div class="hero-illustration">
                    <svg width="400" height="400" viewBox="0 0 400 400" fill="none">
                        <circle cx="200" cy="200" r="180" fill="rgba(139,92,246,0.08)"/>
                        <circle cx="200" cy="200" r="140" fill="rgba(139,92,246,0.12)"/>
                        <rect x="150" y="120" width="100" height="160" rx="12" fill="#8B5CF6" opacity="0.2"/>
                        <rect x="170" y="140" width="60" height="20" rx="6" fill="#8B5CF6"/>
                        <rect x="170" y="170" width="40" height="12" rx="4" fill="#8B5CF6" opacity="0.6"/>
                        <rect x="170" y="190" width="50" height="12" rx="4" fill="#8B5CF6" opacity="0.6"/>
                        <rect x="170" y="210" width="30" height="12" rx="4" fill="#8B5CF6" opacity="0.6"/>
                        <circle cx="200" cy="280" r="30" fill="#8B5CF6" opacity="0.15"/>
                        <path d="M200 260v40M185 275h30" stroke="#8B5CF6" stroke-width="3" stroke-linecap="round"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="desktop-stats">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-number"><%= courses ? courses.length : 0 %></div>
                <div class="stat-label">Courses Available</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">500+</div>
                <div class="stat-label">Students Enrolled</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">100+</div>
                <div class="stat-label">Video Lessons</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">24/7</div>
                <div class="stat-label">AI Tutor Support</div>
            </div>
        </div>
    </div>
</section>

<section class="desktop-courses">
    <div class="container">
        <div class="section-header">
            <h2>Popular Courses</h2>
            <a href="/courses" class="view-all-link">View All Courses →</a>
        </div>
        <div class="desktop-courses-grid">
            <% if (courses && courses.length > 0) { %>
                <% courses.slice(0, 6).forEach(course => { 
                    let lessonCount = 0;
                    if (course.levels) {
                        course.levels.forEach(level => {
                            if (level.lessons) {
                                level.lessons.forEach(lesson => {
                                    if (lesson.classes) lessonCount += lesson.classes.length;
                                });
                            }
                        });
                    }
                %>
                    <div class="desktop-course-card">
                        <div class="desktop-course-image" style="background: linear-gradient(135deg, #8B5CF6, #6a3dcf);">
                            <span class="course-badge"><%= course.level || 'Beginner' %></span>
                        </div>
                        <div class="desktop-course-body">
                            <h3><%= course.title %></h3>
                            <p><%= course.description ? course.description.substring(0, 100) + '...' : 'Learn essential skills in this comprehensive course.' %></p>
                            <div class="desktop-course-meta">
                                <span><%= lessonCount %> Lessons</span>
                                <span><%= course.duration || 'Flexible' %></span>
                            </div>
                            <a href="/course/<%= course.id %>" class="btn btn-primary btn-block">Start Learning</a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state">No courses available yet. Check back soon!</div>
            <% } %>
        </div>
    </div>
</section>

<%- include('../partials/footer', { user: user }) %>