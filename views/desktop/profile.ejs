<%- include('../partials/header', { user: user, title: title }) %>

<section class="profile-section">
    <div class="container">
        <div class="profile-container">
            <div class="profile-header">
                <div class="profile-avatar">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#8B5CF6" stroke-width="2"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
                <h1><%= user ? user.firstName + ' ' + user.lastName : 'Student' %></h1>
                <p class="profile-student-id">Student ID: <%= user ? user.studentId : 'N/A' %></p>
                <p class="profile-email"><%= user ? user.email : 'No email' %></p>
                <p class="profile-bio"><%= user && user.bio ? user.bio : 'No bio yet.' %></p>
            </div>

            <div class="profile-details">
                <div class="profile-detail-card">
                    <h3>Personal Information</h3>
                    <div class="detail-row">
                        <span>Full Name</span>
                        <span><%= user ? user.firstName + ' ' + user.lastName : 'N/A' %></span>
                    </div>
                    <div class="detail-row">
                        <span>Email</span>
                        <span><%= user ? user.email : 'N/A' %></span>
                    </div>
                    <div class="detail-row">
                        <span>Phone</span>
                        <span><%= user && user.phone ? user.phone : 'Not provided' %></span>
                    </div>
                    <div class="detail-row">
                        <span>Student ID</span>
                        <span><%= user ? user.studentId : 'N/A' %></span>
                    </div>
                </div>

                <div class="profile-detail-card">
                    <h3>Learning Information</h3>
                    <div class="detail-row">
                        <span>Course</span>
                        <span><%= user && user.courseName ? user.courseName : 'Not enrolled' %></span>
                    </div>
                    <div class="detail-row">
                        <span>Level</span>
                        <span><%= user && user.learningLevel ? user.learningLevel : 'Beginner' %></span>
                    </div>
                    <div class="detail-row">
                        <span>Interests</span>
                        <span><%= user && user.learningInterests ? user.learningInterests : 'Not specified' %></span>
                    </div>
                </div>

                <div class="profile-actions">
                    <a href="/settings" class="btn btn-primary">Edit Profile</a>
                    <a href="/dashboard" class="btn btn-secondary">Go to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</section>

<%- include('../partials/footer', { user: user }) %>