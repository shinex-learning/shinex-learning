<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Services – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .service-card {
            background: #fff;
            border-radius: 14px;
            padding: 24px;
            border: 1px solid #ede8f5;
            transition: all 0.3s ease;
            margin-bottom: 16px;
        }
        body.dark-mode .service-card {
            background: #1a1a1a;
            border-color: #333;
        }
        .service-card:hover {
            border-color: #8B5CF6;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.08);
        }
        .service-card .service-name {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0 0 4px 0;
        }
        body.dark-mode .service-card .service-name {
            color: var(--text-light);
        }
        .service-card .service-desc {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin: 0 0 8px 0;
        }
        .service-card .service-price {
            font-size: 1.3rem;
            font-weight: 800;
            color: #8B5CF6;
        }
        .service-card .service-actions {
            display: flex;
            gap: 10px;
            margin-top: 12px;
            flex-wrap: wrap;
        }
        .service-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        @media (max-width: 768px) {
            .service-grid {
                grid-template-columns: 1fr;
            }
        }
        .service-category-badge {
            display: inline-block;
            padding: 2px 12px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 600;
            background: var(--primary-bg);
            color: #8B5CF6;
        }
        body.dark-mode .service-category-badge {
            background: #2a1a4a;
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container" style="max-width:1000px;">
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <div style="text-align:center; margin-bottom:24px;">
                <h1 style="font-size:1.8rem; font-weight:800; color:var(--text-dark); margin:0;">
                    <i class="fas fa-cogs" style="color:#8B5CF6;"></i> Our Services
                </h1>
                <p style="color:var(--text-muted); font-size:0.95rem; margin:4px 0 0;">
                    Professional services to help you achieve your goals. Click "Order" to contact us.
                </p>
            </div>

            <div class="service-grid">
                <% if (services && services.length > 0) { %>
                    <% services.forEach(function(service) { %>
                        <div class="service-card">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:6px;">
                                <div class="service-name"><%= service.name %></div>
                                <span class="service-category-badge"><%= service.category || 'Service' %></span>
                            </div>
                            <div class="service-desc"><%= service.description || 'Professional service tailored to your needs.' %></div>
                            <div class="service-price">₦<%= service.price %></div>
                            <div class="service-actions">
                                <a href="/contact" class="btn btn-primary">
                                    <i class="fas fa-envelope"></i> Order Now
                                </a>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div style="grid-column:1/-1; text-align:center; padding:40px 20px; color:var(--text-muted);">
                        <i class="fas fa-info-circle" style="font-size:2rem; display:block; margin-bottom:8px;"></i>
                        <p>No services available yet. Check back soon!</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include(getFooter()) %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hello! I'm your AI tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>