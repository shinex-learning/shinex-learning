<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Services – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <h2 style="font-size:2rem; font-weight:800; margin:0 0 4px;">🛠️ Our Services</h2>
            <p style="color:var(--text-muted); margin-bottom:24px;">
                Professional services to support your academic, creative, and career goals.
            </p>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <!-- Services Grid -->
            <% if (services && services.length > 0) { %>
                <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:20px;">
                    <% services.forEach(service => { %>
                        <div class="card" style="padding:20px 18px; transition:all 0.3s ease; border-color: <%= service.isActive ? 'var(--primary)' : '#e74c3c' %>;">
                            <div style="display:flex; justify-content:space-between; align-items:start;">
                                <span class="badge <%= service.category === 'registration' ? 'badge-purple' : 
                                                  service.category === 'design' ? 'badge-gold' : 
                                                  service.category === 'campaign' ? 'badge-green' : 
                                                  service.category === 'website' ? 'badge-dark' : 'badge' %>">
                                    <%= service.category ? service.category.charAt(0).toUpperCase() + service.category.slice(1) : 'Service' %>
                                </span>
                                <span class="badge <%= service.isActive ? 'badge-green' : 'badge-red' %>">
                                    <%= service.isActive ? '✅ Active' : '❌ Inactive' %>
                                </span>
                            </div>
                            <h3 style="font-size:1.2rem; font-weight:700; margin:10px 0 4px;"><%= service.name %></h3>
                            <p style="font-size:0.9rem; color:var(--text-muted); line-height:1.6; min-height:50px;">
                                <%= service.description || 'No description available.' %>
                            </p>
                            <div style="margin-top:8px;">
                                <p style="font-weight:700; font-size:1.3rem; color:var(--primary); margin:0;">
                                    ₦<%= service.price.toLocaleString() %>
                                </p>
                                <p style="font-size:0.7rem; color:var(--text-muted); margin:0;">
                                    <i class="far fa-calendar-alt"></i> Added <%= new Date(service.createdAt).toLocaleDateString() %>
                                </p>
                            </div>
                            <a href="/contact" class="btn btn-primary btn-sm" style="width:100%; margin-top:12px;">
                                <i class="fas fa-paper-plane"></i> Inquire Now
                            </a>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state" style="padding:60px 20px;">
                    <span class="empty-icon">🛠️</span>
                    <h3>No Services Available</h3>
                    <p>Our services are currently being updated. Check back soon.</p>
                </div>
            <% } %>

            <!-- Service Categories Explained -->
            <div style="margin-top:32px; padding:20px 24px; background:var(--primary-bg); border-radius:14px;">
                <h4 style="font-weight:700; margin:0 0 8px;">📋 Service Categories</h4>
                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px,1fr)); gap:12px;">
                    <div>
                        <span class="badge badge-purple" style="font-size:0.8rem;">Registration</span>
                        <p style="font-size:0.8rem; color:var(--text-muted); margin:4px 0 0;">TASUED, JAMB, WAEC/NECO</p>
                    </div>
                    <div>
                        <span class="badge badge-gold" style="font-size:0.8rem;">Design</span>
                        <p style="font-size:0.8rem; color:var(--text-muted); margin:4px 0 0;">Graphic, Motion, UI/UX</p>
                    </div>
                    <div>
                        <span class="badge badge-green" style="font-size:0.8rem;">Campaign</span>
                        <p style="font-size:0.8rem; color:var(--text-muted); margin:4px 0 0;">SUG, Political, Brand</p>
                    </div>
                    <div>
                        <span class="badge badge-dark" style="font-size:0.8rem;">Website</span>
                        <p style="font-size:0.8rem; color:var(--text-muted); margin:4px 0 0;">Custom, E-commerce, CMS</p>
                    </div>
                    <div>
                        <span class="badge" style="font-size:0.8rem; background:#ede8f5; color:var(--text-dark);">Other</span>
                        <p style="font-size:0.8rem; color:var(--text-muted); margin:4px 0 0;">Tailored to your needs</p>
                    </div>
                </div>
            </div>

            <!-- CTA for custom services -->
            <div style="text-align:center; margin-top:24px; padding:24px; border:2px solid var(--primary); border-radius:14px;">
                <h4 style="font-weight:700; margin:0 0 4px;">Need a custom service?</h4>
                <p style="color:var(--text-muted); margin-bottom:12px;">Tell us what you need and we'll create a solution for you.</p>
                <a href="/contact" class="btn btn-primary">
                    <i class="fas fa-comment"></i> Request Custom Service
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>