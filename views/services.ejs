<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Services – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <%- include('partials/loader.ejs') %>

    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container" style="max-width:900px;">
            <div class="card">
                <h1 style="font-size:1.6rem; font-weight:800; color:var(--text-dark);">
                    <i class="fas fa-cogs" style="color:var(--primary);"></i> Our Services
                </h1>
                <p style="color:var(--text-muted);">Professional services to help you achieve your goals.</p>

                <!-- TASUED Registration -->
                <div style="background:var(--primary-bg); border-radius:12px; padding:16px; margin:16px 0; border-left:4px solid var(--primary);">
                    <h3 style="font-weight:700; color:var(--text-dark);">
                        <i class="fas fa-university" style="color:var(--primary);"></i> TASUED Registration
                    </h3>
                    <p style="color:var(--text-muted); font-size:0.85rem;">Full registration including form and O'Level verification on portal</p>
                    <div style="font-size:1.2rem; font-weight:800; color:var(--primary);">₦20,000</div>
                    <a href="/contact" class="btn btn-primary btn-sm" style="margin-top:8px;">
                        <i class="fas fa-envelope"></i> Contact to Order
                    </a>
                </div>

                <!-- SUG Campaign -->
                <div style="background:var(--primary-bg); border-radius:12px; padding:16px; margin:16px 0; border-left:4px solid #f39c12;">
                    <h3 style="font-weight:700; color:var(--text-dark);">
                        <i class="fas fa-flag" style="color:#f39c12;"></i> SUG Campaign Services
                    </h3>
                    <p style="color:var(--text-muted); font-size:0.85rem;">Flyers, posters, social media, manifesto design</p>
                    <div style="font-size:1.2rem; font-weight:800; color:#f39c12;">From ₦5,000</div>
                    <a href="/contact" class="btn btn-primary btn-sm" style="margin-top:8px; background:#f39c12;">
                        <i class="fas fa-envelope"></i> Contact to Order
                    </a>
                </div>

                <!-- Graphic Design -->
                <div style="background:var(--primary-bg); border-radius:12px; padding:16px; margin:16px 0; border-left:4px solid var(--primary);">
                    <h3 style="font-weight:700; color:var(--text-dark);">
                        <i class="fas fa-paint-brush" style="color:var(--primary);"></i> Graphic Design
                    </h3>
                    <p style="color:var(--text-muted); font-size:0.85rem;">Logos, flyers, social media graphics, business cards</p>
                    <div style="font-size:1.2rem; font-weight:800; color:var(--primary);">From ₦2,000</div>
                    <a href="/contact" class="btn btn-primary btn-sm" style="margin-top:8px;">
                        <i class="fas fa-envelope"></i> Contact to Order
                    </a>
                </div>

                <!-- Website Design -->
                <div style="background:var(--primary-bg); border-radius:12px; padding:16px; margin:16px 0; border-left:4px solid #27ae60;">
                    <h3 style="font-weight:700; color:var(--text-dark);">
                        <i class="fas fa-laptop-code" style="color:#27ae60;"></i> Website Design
                    </h3>
                    <p style="color:var(--text-muted); font-size:0.85rem;">Business websites, portfolios, landing pages</p>
                    <div style="font-size:1.2rem; font-weight:800; color:#27ae60;">From ₦30,000</div>
                    <a href="/contact" class="btn btn-primary btn-sm" style="margin-top:8px; background:#27ae60;">
                        <i class="fas fa-envelope"></i> Contact to Order
                    </a>
                </div>

                <div style="text-align:center; margin-top:16px; padding-top:16px; border-top:1px solid #ede8f5;">
                    <p style="color:var(--text-muted);">
                        <i class="fas fa-clock"></i> We respond within 1-24 hours
                    </p>
                </div>
            </div>
        </div>
    </main>

    <%- include(getFooter()) %>
    <script src="/js/script.js"></script>
</body>
</html>