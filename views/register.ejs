<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Registration – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ============================================================
           REGISTER PAGE STYLES
           ============================================================ */
        
        /* ----- Auth Wrapper ----- */
        .auth-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 70vh;
            padding: var(--spacing-lg);
        }
        
        /* ----- Auth Box ----- */
        .auth-box {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: var(--spacing-xl) var(--spacing-lg);
            max-width: 750px;
            width: 100%;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-md);
            transition: all 0.3s ease;
        }
        
        .auth-box:hover {
            box-shadow: var(--shadow-lg);
        }
        
        /* ----- Logo ----- */
        .auth-box .auth-logo {
            text-align: center;
            margin-bottom: var(--spacing-md);
        }
        
        .auth-box .auth-logo .logo-icon {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--purple-gradient);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 18px;
            letter-spacing: 1px;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
            margin-bottom: var(--spacing-sm);
        }
        
        .auth-box .auth-logo h1 {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-primary);
            margin: 0;
        }
        
        .auth-box .auth-logo h1 span {
            color: var(--purple-primary);
        }
        
        .auth-box .auth-logo p {
            color: var(--text-muted);
            font-size: 0.7rem;
            margin: 0;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        
        /* ----- Titles ----- */
        .auth-box .auth-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            text-align: center;
            margin: 0 0 4px 0;
        }
        
        .auth-box .auth-subtitle {
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-align: center;
            margin: 0 0 var(--spacing-lg) 0;
        }
        
        /* ----- Form Sections ----- */
        .auth-box .form-section {
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            padding: var(--spacing-md);
            margin-bottom: var(--spacing-md);
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }
        
        .auth-box .form-section.highlight {
            border: 2px solid var(--purple-primary);
        }
        
        .auth-box .form-section .section-title {
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 2px 0;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .auth-box .form-section .section-title i {
            color: var(--purple-primary);
        }
        
        .auth-box .form-section .section-subtitle {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin: 0 0 var(--spacing-sm) 0;
        }
        
        /* ----- Form Fields ----- */
        .auth-box .form-group {
            margin-bottom: var(--spacing-sm);
        }
        
        .auth-box .form-group label {
            font-weight: 600;
            font-size: 0.8rem;
            color: var(--text-primary);
            display: block;
            margin-bottom: 4px;
        }
        
        .auth-box .form-group label .required {
            color: var(--text-error);
        }
        
        .auth-box .form-group input,
        .auth-box .form-group select {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            font-family: inherit;
            transition: all 0.3s ease;
            background: var(--bg-input);
            color: var(--text-primary);
        }
        
        .auth-box .form-group input:focus,
        .auth-box .form-group select:focus {
            border-color: var(--purple-primary);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
            outline: none;
        }
        
        .auth-box .form-group input::placeholder {
            color: var(--text-muted);
        }
        
        .auth-box .form-group .help-text {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 4px;
        }
        
        .auth-box .form-group .help-text i {
            margin-right: 4px;
        }
        
        /* ----- Form Rows ----- */
        .auth-box .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-sm);
        }
        
        .auth-box .form-row-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: var(--spacing-sm);
        }
        
        /* ----- Password Toggle ----- */
        .auth-box .password-wrapper {
            position: relative;
            width: 100%;
        }
        
        .auth-box .password-wrapper input {
            width: 100%;
            padding-right: 44px !important;
        }
        
        .auth-box .password-wrapper .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 1.1rem;
            padding: 4px 6px;
            transition: all 0.3s ease;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .auth-box .password-wrapper .toggle-password:hover {
            color: var(--purple-primary);
        }
        
        /* ----- Register Button ----- */
        .auth-box .btn-auth {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: var(--radius-full);
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            background: var(--purple-gradient);
            color: #fff;
            margin-top: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .auth-box .btn-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .auth-box .btn-auth i {
            font-size: 1rem;
        }
        
        /* ----- Alerts ----- */
        .auth-box .alert {
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            margin-bottom: var(--spacing-sm);
            text-align: center;
            border-left: 4px solid;
        }
        
        .auth-box .alert-danger {
            background: var(--bg-alert-error);
            color: var(--text-error);
            border-left-color: var(--text-error);
        }
        
        .auth-box .alert-success {
            background: var(--bg-alert-success);
            color: var(--text-success);
            border-left-color: var(--text-success);
        }
        
        /* ----- Footer ----- */
        .auth-box .auth-footer {
            text-align: center;
            margin-top: var(--spacing-md);
            padding-top: var(--spacing-md);
            border-top: 1px solid var(--border-color);
        }
        
        .auth-box .auth-footer p {
            color: var(--text-secondary);
            font-size: 0.85rem;
            margin: 0;
        }
        
        .auth-box .auth-footer a {
            color: var(--purple-primary);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .auth-box .auth-footer a:hover {
            text-decoration: underline;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 768px) {
            .auth-box {
                padding: var(--spacing-lg) var(--spacing-md);
            }
            
            .auth-box .form-row,
            .auth-box .form-row-3 {
                grid-template-columns: 1fr;
            }
            
            .auth-box .auth-logo h1 {
                font-size: 1.3rem;
            }
            
            .auth-box .auth-title {
                font-size: 1rem;
            }
        }
        
        @media (max-width: 480px) {
            .auth-box {
                padding: var(--spacing-md);
            }
            
            .auth-box .form-section {
                padding: var(--spacing-sm);
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    PAGE LOADER
    ============================================================ -->
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <!-- ===== HEADER ===== -->
    <%- include(getHeader()) %>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="container">
            <div class="auth-wrapper">

                <!-- ===== AUTH BOX ===== -->
                <div class="auth-box">

                    <!-- Logo -->
                    <div class="auth-logo">
                        <div class="logo-icon">SLC</div>
                        <h1>SHINEX<span>.</span></h1>
                        <p>Learning Circle</p>
                    </div>

                    <!-- Titles -->
                    <div class="auth-title">Student Registration</div>
                    <div class="auth-subtitle">Join SHINEX Learning Circle (SLC)</div>

                    <!-- Flash Messages -->
                    <% if (messages && messages.error) { %>
                        <div class="alert alert-danger flash-message" data-type="error">
                            <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                        </div>
                    <% } %>
                    <% if (messages && messages.success) { %>
                        <div class="alert alert-success flash-message" data-type="success">
                            <i class="fas fa-check-circle"></i> <%= messages.success %>
                        </div>
                    <% } %>

                    <!-- Registration Form -->
                    <form action="/register" method="POST" id="registerForm">

                        <!-- ===== 1. PERSONAL INFORMATION ===== -->
                        <div class="form-section">
                            <div class="section-title">
                                <i class="fas fa-user"></i> Personal Information
                            </div>
                            <p class="section-subtitle">Tell us about yourself</p>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>First Name <span class="required">*</span></label>
                                    <input type="text" name="firstName" placeholder="John" required>
                                </div>
                                <div class="form-group">
                                    <label>Middle Name</label>
                                    <input type="text" name="middleName" placeholder="(Optional)">
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Last Name <span class="required">*</span></label>
                                <input type="text" name="lastName" placeholder="Doe" required>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Date of Birth</label>
                                    <input type="date" name="dateOfBirth">
                                </div>
                                <div class="form-group">
                                    <label>Gender <span class="required">*</span></label>
                                    <select name="gender" required>
                                        <option value="">Select...</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-row-3">
                                <div class="form-group">
                                    <label>Country <span class="required">*</span></label>
                                    <select name="country" required>
                                        <option value="">Select...</option>
                                        <option value="Nigeria">Nigeria</option>
                                        <option value="USA">USA</option>
                                        <option value="UK">UK</option>
                                        <option value="Canada">Canada</option>
                                        <option value="Australia">Australia</option>
                                        <option value="Ghana">Ghana</option>
                                        <option value="Kenya">Kenya</option>
                                        <option value="South Africa">South Africa</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>State <span class="required">*</span></label>
                                    <input type="text" name="state" placeholder="e.g., Ogun State" required>
                                </div>
                                <div class="form-group">
                                    <label>City/Town <span class="required">*</span></label>
                                    <input type="text" name="city" placeholder="e.g., Abeokuta" required>
                                </div>
                            </div>
                        </div>

                        <!-- ===== 2. CONTACT INFORMATION ===== -->
                        <div class="form-section">
                            <div class="section-title">
                                <i class="fas fa-phone"></i> Contact Information
                            </div>
                            <p class="section-subtitle">How can we reach you?</p>

                            <div class="form-group">
                                <label>Email Address <span class="required">*</span></label>
                                <input type="email" name="email" placeholder="you@email.com" required>
                                <div class="help-text">
                                    <i class="fas fa-info-circle"></i> We'll send verification to this email
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Phone Number <span class="required">*</span></label>
                                    <input type="tel" name="phone" placeholder="080 1234 5678" required>
                                </div>
                                <div class="form-group">
                                    <label>WhatsApp Number</label>
                                    <input type="tel" name="whatsapp" placeholder="080 1234 5678">
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Home Address</label>
                                <input type="text" name="homeAddress" placeholder="Your home address">
                            </div>
                        </div>

                        <!-- ===== 3. ACADEMIC INFORMATION ===== -->
                        <div class="form-section">
                            <div class="section-title">
                                <i class="fas fa-graduation-cap"></i> Academic Information
                            </div>
                            <p class="section-subtitle">Tell us about your education</p>

                            <div class="form-group">
                                <label>School/Institution <span class="required">*</span></label>
                                <input type="text" name="school" placeholder="e.g., TASUED" required>
                            </div>

                            <div class="form-group">
                                <label>Department / Field of Study <span class="required">*</span></label>
                                <input type="text" name="department" placeholder="e.g., Computer Science" required>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Current Level <span class="required">*</span></label>
                                    <input type="text" name="currentLevel" placeholder="e.g., Year 1, Year 2" required>
                                </div>
                                <div class="form-group">
                                    <label>Student Status</label>
                                    <select name="studentStatus">
                                        <option value="">Select...</option>
                                        <option value="Full-time">Full-time</option>
                                        <option value="Part-time">Part-time</option>
                                        <option value="Graduate">Graduate</option>
                                        <option value="Working Professional">Working Professional</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- ===== 4. CHOOSE YOUR COURSE ===== -->
                        <div class="form-section">
                            <div class="section-title">
                                <i class="fas fa-book-open"></i> Choose Your Course
                            </div>
                            <p class="section-subtitle">Select the course you want to study</p>

                            <div class="form-group">
                                <label>Course <span class="required">*</span></label>
                                <select name="courseName" required>
                                    <option value="">Select a course...</option>
                                    <% if (courses && courses.length > 0) { %>
                                        <% courses.forEach(function(c) { %>
                                            <option value="<%= c %>"><%= c %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                        </div>

                        <!-- ===== 5. LEARNING LEVEL ===== -->
                        <div class="form-section">
                            <div class="section-title">
                                <i class="fas fa-chart-line"></i> Learning Level
                            </div>
                            <p class="section-subtitle">Choose your experience level</p>

                            <div class="form-group">
                                <label>Learning Level <span class="required">*</span></label>
                                <select name="learningLevel" required>
                                    <option value="Beginner">Beginner</option>
                                    <option value="Intermediate">Intermediate</option>
                                    <option value="Advanced">Advanced</option>
                                </select>
                            </div>
                        </div>

                        <!-- ===== 6. ACCOUNT DETAILS ===== -->
                        <div class="form-section highlight">
                            <div class="section-title">
                                <i class="fas fa-lock"></i> Account Details
                            </div>
                            <p class="section-subtitle">Create your login credentials</p>

                            <div class="form-group">
                                <label>Email Address <span class="required">*</span></label>
                                <input type="email" name="email" placeholder="you@email.com" required>
                                <div class="help-text">
                                    <i class="fas fa-info-circle"></i> You will use this to login or receive updates
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Password <span class="required">*</span></label>
                                    <div class="password-wrapper">
                                        <input type="password" name="password" id="registerPassword" placeholder="Min 6 characters" required>
                                        <button type="button" class="toggle-password" onclick="togglePassword('registerPassword', this)" aria-label="Toggle password visibility">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Confirm Password <span class="required">*</span></label>
                                    <div class="password-wrapper">
                                        <input type="password" name="confirmPassword" id="registerConfirmPassword" placeholder="Confirm password" required>
                                        <button type="button" class="toggle-password" onclick="togglePassword('registerConfirmPassword', this)" aria-label="Toggle password visibility">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="help-text" style="margin-top:8px; font-size:0.75rem; color:var(--text-muted);">
                                <i class="fas fa-info-circle"></i> Your <strong>Student ID</strong> will be generated automatically after registration.
                                <br>Format: <strong>SLC-2026-XX-XXX</strong>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn-auth" id="registerBtn">
                            <i class="fas fa-user-plus"></i> Register
                        </button>
                    </form>

                    <!-- Footer -->
                    <div class="auth-footer">
                        <p>Already have an account? <a href="/login">Login</a></p>
                    </div>

                </div>

            </div>
        </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <%- include(getFooter()) %>

    <script>
        // ============================================================
        // PASSWORD VISIBILITY TOGGLE
        // ============================================================
        
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            if (!input) return;
            
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
        }
        
        // ============================================================
        // AUTO DISMISS FLASH MESSAGES
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.flash-message').forEach(msg => {
                setTimeout(() => {
                    msg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                    msg.style.opacity = '0';
                    msg.style.transform = 'translateY(-10px)';
                    setTimeout(() => {
                        if (msg.parentNode) msg.remove();
                    }, 500);
                }, 5000);
            });
        });
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('📝 SHINEX Registration Page');
        console.log('📚 Join SHINEX Learning Circle');
        console.log('📧 Verify your email after registration');
    </script>

    <script src="/js/main.js"></script>
</body>
</html>