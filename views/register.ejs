<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Registration – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .auth-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 70vh;
            padding: 20px;
        }
        .auth-box {
            background: #fff;
            border-radius: 16px;
            padding: 36px 32px;
            max-width: 700px;
            width: 100%;
            border: 1px solid #ede8f5;
            box-shadow: 0 4px 20px rgba(26, 10, 46, 0.08);
        }
        body.dark-mode .auth-box {
            background: #1a1a1a;
            border-color: #333;
        }
        .auth-box .auth-logo {
            text-align: center;
            margin-bottom: 20px;
        }
        .auth-box .auth-logo h1 {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-dark);
            margin: 0;
        }
        body.dark-mode .auth-box .auth-logo h1 {
            color: var(--text-light);
        }
        .auth-box .auth-logo h1 span {
            color: #8B5CF6;
        }
        .auth-box .auth-logo p {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin: 0;
            letter-spacing: 2px;
        }
        .auth-box .auth-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-dark);
            text-align: center;
            margin: 0 0 4px 0;
        }
        body.dark-mode .auth-box .auth-title {
            color: var(--text-light);
        }
        .auth-box .auth-subtitle {
            font-size: 0.85rem;
            color: var(--text-muted);
            text-align: center;
            margin: 0 0 20px 0;
        }
        .auth-box .form-section {
            background: var(--primary-bg);
            border-radius: 10px;
            padding: 16px;
            margin-bottom: 16px;
        }
        body.dark-mode .auth-box .form-section {
            background: #1a1a1a;
            border-color: #333;
        }
        .auth-box .form-section h4 {
            font-weight: 700;
            color: var(--text-dark);
            margin: 0 0 4px 0;
            font-size: 0.95rem;
        }
        body.dark-mode .auth-box .form-section h4 {
            color: var(--text-light);
        }
        .auth-box .form-section .sub {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin: 0 0 12px 0;
        }
        .auth-box .form-group {
            margin-bottom: 14px;
        }
        .auth-box .form-group label {
            font-weight: 600;
            font-size: 0.8rem;
            color: var(--text-dark);
            display: block;
            margin-bottom: 4px;
        }
        body.dark-mode .auth-box .form-group label {
            color: var(--text-light);
        }
        .auth-box .form-group input,
        .auth-box .form-group select {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid #ede8f5;
            border-radius: 10px;
            font-size: 0.95rem;
            font-family: inherit;
            transition: all 0.3s ease;
            background: #fff;
            color: var(--text-dark);
        }
        body.dark-mode .auth-box .form-group input,
        body.dark-mode .auth-box .form-group select {
            background: #2a2a2a;
            color: var(--text-light);
            border-color: #333;
        }
        .auth-box .form-group input:focus,
        .auth-box .form-group select:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
            outline: none;
        }
        .auth-box .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .auth-box .form-row-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
        }
        .auth-box .required {
            color: #e74c3c;
        }
        .auth-box .help-text {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 3px;
        }
        .auth-box .btn-auth {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #8B5CF6;
            color: #fff;
            margin-top: 8px;
        }
        .auth-box .btn-auth:hover {
            background: #6a3dcf;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        .auth-box .alert {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.85rem;
            margin-bottom: 12px;
            text-align: center;
        }
        .auth-box .alert-danger {
            background: #fadbd8;
            color: #922b21;
            border-left: 4px solid #e74c3c;
        }
        .auth-box .alert-success {
            background: #d5f5e3;
            color: #1a7a4a;
            border-left: 4px solid #27ae60;
        }
        body.dark-mode .auth-box .alert-danger {
            background: #3a1a1a;
            color: #f1948a;
        }
        body.dark-mode .auth-box .alert-success {
            background: #1a3a2a;
            color: #7dcea0;
        }
        .auth-box .auth-footer {
            text-align: center;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid #ede8f5;
        }
        body.dark-mode .auth-box .auth-footer {
            border-color: #333;
        }
        .auth-box .auth-footer a {
            color: #8B5CF6;
            text-decoration: none;
            font-weight: 600;
        }
        .auth-box .auth-footer a:hover {
            text-decoration: underline;
        }
        .auth-box .auth-footer p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 0;
        }

        /* ===== PASSWORD VISIBILITY TOGGLE ===== */
        .password-wrapper {
            position: relative;
            width: 100%;
        }
        .password-wrapper input {
            width: 100%;
            padding-right: 44px !important;
        }
        .toggle-password {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 1.1rem;
            padding: 4px 6px;
            transition: color 0.3s ease;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .toggle-password:hover {
            color: #8B5CF6;
        }
        body.dark-mode .toggle-password {
            color: #888;
        }
        body.dark-mode .toggle-password:hover {
            color: #a78bfa;
        }

        @media (max-width: 600px) {
            .auth-box {
                padding: 20px 16px;
            }
            .auth-box .form-row,
            .auth-box .form-row-3 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container">
            <div class="auth-wrapper">
                <div class="auth-box">
                    <!-- Logo -->
                    <div class="auth-logo">
                        <h1>SHINEX<span>.</span></h1>
                        <p>LEARNING CIRCLE</p>
                    </div>

                    <div class="auth-title">Student Registration</div>
                    <div class="auth-subtitle">Join SHINEX Learning Circle (SLC)</div>

                    <% if (messages && messages.error) { %>
                        <div class="alert alert-danger"><%= messages.error %></div>
                    <% } %>
                    <% if (messages && messages.success) { %>
                        <div class="alert alert-success"><%= messages.success %></div>
                    <% } %>

                    <form action="/register" method="POST" id="registerForm">

                        <!-- ===== 1. PERSONAL INFORMATION ===== -->
                        <div class="form-section">
                            <h4><i class="fas fa-user" style="color:#8B5CF6;"></i> Personal Information</h4>
                            <p class="sub">Tell us about yourself</p>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>First Name <span class="required">*</span></label>
                                    <input type="text" name="firstName" placeholder="John" required>
                                </div>
                                <div class="form-group">
                                    <label>Middle Name</label>
                                    <input type="text" name="middleName" placeholder="(Optional)">
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Last Name <span class="required">*</span></label>
                                <input type="text" name="lastName" placeholder="Doe" required>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Date of Birth</label>
                                    <input type="date" name="dateOfBirth">
                                </div>
                                <div class="form-group">
                                    <label>Gender <span class="required">*</span></label>
                                    <select name="gender" required>
                                        <option value="">Select...</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-row-3">
                                <div class="form-group">
                                    <label>Country <span class="required">*</span></label>
                                    <select name="country" required>
                                        <option value="">Select...</option>
                                        <option value="Nigeria">Nigeria</option>
                                        <option value="USA">USA</option>
                                        <option value="UK">UK</option>
                                        <option value="Canada">Canada</option>
                                        <option value="Australia">Australia</option>
                                        <option value="Ghana">Ghana</option>
                                        <option value="Kenya">Kenya</option>
                                        <option value="South Africa">South Africa</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>State <span class="required">*</span></label>
                                    <input type="text" name="state" placeholder="e.g., Ogun State" required>
                                </div>
                                <div class="form-group">
                                    <label>City/Town <span class="required">*</span></label>
                                    <input type="text" name="city" placeholder="e.g., Abeokuta" required>
                                </div>
                            </div>
                        </div>

                        <!-- ===== 2. CONTACT INFORMATION ===== -->
                        <div class="form-section">
                            <h4><i class="fas fa-phone" style="color:#8B5CF6;"></i> Contact Information</h4>
                            <p class="sub">How can we reach you?</p>

                            <div class="form-group">
                                <label>Email Address <span class="required">*</span></label>
                                <input type="email" name="email" placeholder="you@email.com" required>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Phone Number <span class="required">*</span></label>
                                    <input type="tel" name="phone" placeholder="080 1234 5678" required>
                                </div>
                                <div class="form-group">
                                    <label>WhatsApp Number</label>
                                    <input type="tel" name="whatsapp" placeholder="080 1234 5678">
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Home Address</label>
                                <input type="text" name="homeAddress" placeholder="Your home address">
                            </div>
                        </div>

                        <!-- ===== 3. ACADEMIC INFORMATION ===== -->
                        <div class="form-section">
                            <h4><i class="fas fa-graduation-cap" style="color:#8B5CF6;"></i> Academic Information</h4>
                            <p class="sub">Tell us about your education</p>

                            <div class="form-group">
                                <label>School/Institution <span class="required">*</span></label>
                                <input type="text" name="school" placeholder="e.g., TASUED" required>
                            </div>

                            <div class="form-group">
                                <label>Department / Field of Study <span class="required">*</span></label>
                                <input type="text" name="department" placeholder="e.g., Computer Science" required>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Current Level <span class="required">*</span></label>
                                    <input type="text" name="currentLevel" placeholder="e.g., Year 1, Year 2" required>
                                </div>
                                <div class="form-group">
                                    <label>Student Status</label>
                                    <select name="studentStatus">
                                        <option value="">Select...</option>
                                        <option value="Full-time">Full-time</option>
                                        <option value="Part-time">Part-time</option>
                                        <option value="Graduate">Graduate</option>
                                        <option value="Working Professional">Working Professional</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- ===== 4. CHOOSE YOUR COURSE ===== -->
                        <div class="form-section">
                            <h4><i class="fas fa-book-open" style="color:#8B5CF6;"></i> Choose Your Course</h4>
                            <p class="sub">Select the course you want to study</p>

                            <div class="form-group">
                                <label>Course <span class="required">*</span></label>
                                <select name="courseName" required>
                                    <option value="">Select a course...</option>
                                    <% if (courses && courses.length > 0) { %>
                                        <% courses.forEach(function(c) { %>
                                            <option value="<%= c %>"><%= c %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                            </div>
                        </div>

                        <!-- ===== 5. LEARNING LEVEL ===== -->
                        <div class="form-section">
                            <h4><i class="fas fa-chart-line" style="color:#8B5CF6;"></i> Learning Level</h4>
                            <p class="sub">Choose your experience level</p>

                            <div class="form-group">
                                <label>Learning Level <span class="required">*</span></label>
                                <select name="learningLevel" required>
                                    <option value="Beginner">Beginner</option>
                                    <option value="Intermediate">Intermediate</option>
                                    <option value="Advanced">Advanced</option>
                                </select>
                            </div>
                        </div>

                        <!-- ===== 6. ACCOUNT DETAILS ===== -->
                        <div class="form-section" style="border:2px solid #8B5CF6;">
                            <h4><i class="fas fa-lock" style="color:#8B5CF6;"></i> Account Details</h4>
                            <p class="sub">Create your login credentials</p>

                            <div class="form-group">
                                <label>Email Address <span class="required">*</span></label>
                                <input type="email" name="email" placeholder="you@email.com" required>
                                <div class="help-text">You will use this to login or receive updates</div>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Password <span class="required">*</span></label>
                                    <div class="password-wrapper">
                                        <input type="password" name="password" id="registerPassword" placeholder="Min 6 characters" required>
                                        <button type="button" class="toggle-password" onclick="togglePassword('registerPassword', this)" aria-label="Toggle password visibility">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Confirm Password <span class="required">*</span></label>
                                    <div class="password-wrapper">
                                        <input type="password" name="confirmPassword" id="registerConfirmPassword" placeholder="Confirm password" required>
                                        <button type="button" class="toggle-password" onclick="togglePassword('registerConfirmPassword', this)" aria-label="Toggle password visibility">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="help-text" style="margin-top:8px; font-size:0.75rem; color:var(--text-muted);">
                                <i class="fas fa-info-circle"></i> Your <strong>Student ID</strong> will be generated automatically after registration.
                                <br>Format: <strong>SLC-2026-XX-XXX</strong>
                            </div>
                        </div>

                        <button type="submit" class="btn-auth">
                            <i class="fas fa-user-plus"></i> Register
                        </button>
                    </form>

                    <div class="auth-footer">
                        <p>Already have an account? <a href="/login">Login</a></p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include(getFooter()) %>
    
    <script>
        // ===== PASSWORD VISIBILITY TOGGLE =====
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            if (!input) return;
            
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
            
            // Prevent form submission
            event.preventDefault();
        }
    </script>
    <script src="/js/script.js"></script>
</body>
</html>