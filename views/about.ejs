<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .about-mission {
            background: var(--primary-bg);
            border-radius: var(--radius);
            padding: 24px;
            margin: 16px 0;
            border-left: 4px solid var(--primary);
        }
        body.dark-mode .about-mission {
            background: #1a1a1a;
            border-color: var(--primary);
        }
        .about-values {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin: 16px 0;
        }
        .about-value-item {
            background: var(--primary-bg);
            border-radius: 10px;
            padding: 16px;
            text-align: center;
            border: 1px solid #ede8f5;
        }
        body.dark-mode .about-value-item {
            background: #1a1a1a;
            border-color: var(--dark-border);
        }
        .about-value-item .icon {
            font-size: 2rem;
            color: var(--primary);
            display: block;
            margin-bottom: 6px;
        }
        .about-value-item h4 {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text-dark);
            margin: 0 0 2px 0;
        }
        body.dark-mode .about-value-item h4 {
            color: var(--text-light);
        }
        .about-value-item p {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 0;
        }
        .about-tagline {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary);
            text-align: center;
            padding: 16px 0;
            border-top: 2px solid #ede8f5;
            border-bottom: 2px solid #ede8f5;
            margin: 20px 0;
        }
        body.dark-mode .about-tagline {
            border-color: var(--dark-border);
        }
        .course-list-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin: 12px 0;
        }
        .course-list-item {
            background: var(--primary-bg);
            border-radius: 8px;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            color: var(--text-dark);
        }
        body.dark-mode .course-list-item {
            background: #1a1a1a;
        }
        .course-list-item i {
            color: var(--primary);
            font-size: 1rem;
        }
        @media (max-width: 600px) {
            .about-values {
                grid-template-columns: 1fr;
            }
            .course-list-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container" style="max-width:800px;">
            <div class="card">
                <h1 style="font-size:1.8rem; font-weight:800; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-info-circle" style="color:var(--primary);"></i> About SHINEX Learning Circle
                </h1>

                <div class="about-tagline">
                    Learn. Understand. Protect.
                </div>

                <p style="font-size:1.05rem; color:var(--text-dark); margin:16px 0;">
                    <strong>SHINEX Learning Circle (SLC)</strong> is an online learning platform created to make quality digital education more accessible, practical, and engaging.
                </p>

                <p style="color:var(--text-muted); font-size:0.95rem; margin:0 0 16px 0;">
                    Our goal is simple: <strong style="color:var(--text-dark);">help people learn useful skills, understand technology, and build the confidence to apply what they learn.</strong>
                </p>

                <!-- Mission -->
                <div class="about-mission">
                    <h3 style="font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                        <i class="fas fa-bullseye" style="color:var(--primary);"></i> Our Mission
                    </h3>
                    <p style="color:var(--text-muted); margin:0; font-size:0.95rem;">
                        To provide accessible, structured, and practical learning experiences that help students and aspiring professionals develop valuable digital and technology skills.
                    </p>
                </div>

                <!-- What We Offer -->
                <h3 style="font-weight:700; color:var(--text-dark); margin:20px 0 8px 0;">
                    <i class="fas fa-gem" style="color:var(--primary);"></i> What We Offer
                </h3>
                <p style="color:var(--text-muted); font-size:0.95rem; margin:0 0 8px 0;">
                    SLC provides:
                </p>
                <ul style="color:var(--text-dark); font-size:0.95rem; line-height:1.8; padding-left:20px;">
                    <li>📚 Structured online courses</li>
                    <li>🧠 Interactive lessons and learning materials</li>
                    <li>📝 Quizzes and assessments</li>
                    <li>📊 Learning progress tracking</li>
                    <li>🎓 Course completion and certification opportunities</li>
                    <li>💻 Practical technology education</li>
                    <li>👥 A learning community for students and technology enthusiasts</li>
                </ul>

                <!-- Our Courses -->
                <h3 style="font-weight:700; color:var(--text-dark); margin:20px 0 8px 0;">
                    <i class="fas fa-book-open" style="color:var(--primary);"></i> Our Courses
                </h3>
                <p style="color:var(--text-muted); font-size:0.95rem; margin:0 0 10px 0;">
                    We offer a wide range of courses across multiple fields to help you build the skills you need:
                </p>

                <div class="course-list-grid">
                    <div class="course-list-item">
                        <i class="fas fa-shield-alt"></i> Cybersecurity
                    </div>
                    <div class="course-list-item">
                        <i class="fas fa-chart-bar"></i> Data Analysis
                    </div>
                    <div class="course-list-item">
                        <i class="fas fa-bullhorn"></i> Digital Marketing
                    </div>
                    <div class="course-list-item">
                        <i class="fas fa-paint-brush"></i> Graphic Design
                    </div>
                    <div class="course-list-item">
                        <i class="fas fa-film"></i> Motion Design
                    </div>
                    <div class="course-list-item">
                        <i class="fas fa-network-wired"></i> Networking
                    </div>
                    <div class="course-list-item">
                        <i class="fas fa-code"></i> Programming
                    </div>
                    <div class="course-list-item">
                        <i class="fas fa-pencil-ruler"></i> UI/UX Design
                    </div>
                    <div class="course-list-item">
                        <i class="fas fa-laptop-code"></i> Web Development
                    </div>
                    <div class="course-list-item">
                        <i class="fab fa-wordpress"></i> WordPress Development
                    </div>
                </div>

                <!-- Our Focus -->
                <h3 style="font-weight:700; color:var(--text-dark); margin:20px 0 8px 0;">
                    <i class="fas fa-lock" style="color:var(--primary);"></i> Our Focus
                </h3>
                <p style="color:var(--text-muted); font-size:0.95rem; margin:0 0 8px 0;">
                    We place strong emphasis on <strong style="color:var(--text-dark);">practical knowledge</strong> rather than simply memorizing information.
                </p>
                <p style="color:var(--text-muted); font-size:0.95rem; margin:0 0 8px 0;">
                    Our learning areas include:
                </p>
                <ul style="color:var(--text-dark); font-size:0.95rem; line-height:1.8; padding-left:20px;">
                    <li>🔐 Cybersecurity</li>
                    <li>💻 Web Development</li>
                    <li>⚙️ Programming</li>
                    <li>🎨 UI/UX Design</li>
                    <li>📊 Data Analysis</li>
                    <li>📱 Digital Marketing</li>
                    <li>🎬 Motion Design</li>
                    <li>🌐 Networking</li>
                    <li>📝 WordPress Development</li>
                </ul>

                <!-- Vision -->
                <h3 style="font-weight:700; color:var(--text-dark); margin:20px 0 8px 0;">
                    <i class="fas fa-globe" style="color:var(--primary);"></i> Our Vision
                </h3>
                <p style="color:var(--text-muted); font-size:0.95rem; margin:0;">
                    To build a learning community where anyone with the desire to learn can develop relevant skills, grow professionally, and become more confident in the digital world.
                </p>

                <!-- Community -->
                <h3 style="font-weight:700; color:var(--text-dark); margin:20px 0 8px 0;">
                    <i class="fas fa-users" style="color:var(--primary);"></i> Our Community
                </h3>
                <p style="color:var(--text-muted); font-size:0.95rem; margin:0;">
                    SHINEX Learning Circle is more than just a collection of courses. We aim to create a community where learners can <strong style="color:var(--text-dark);">learn together, ask questions, share knowledge, and grow together.</strong>
                </p>

                <!-- Values -->
                <div class="about-values">
                    <div class="about-value-item">
                        <span class="icon"><i class="fas fa-star"></i></span>
                        <h4>Excellence</h4>
                        <p>Striving for the highest quality</p>
                    </div>
                    <div class="about-value-item">
                        <span class="icon"><i class="fas fa-hand-holding-heart"></i></span>
                        <h4>Accessibility</h4>
                        <p>Education for everyone</p>
                    </div>
                    <div class="about-value-item">
                        <span class="icon"><i class="fas fa-lightbulb"></i></span>
                        <h4>Innovation</h4>
                        <p>Embracing new technologies</p>
                    </div>
                    <div class="about-value-item">
                        <span class="icon"><i class="fas fa-handshake"></i></span>
                        <h4>Community</h4>
                        <p>Collaborative learning</p>
                    </div>
                </div>

                <!-- Start Learning -->
                <div style="text-align:center; margin-top:24px; padding:24px; background:var(--primary-bg); border-radius:var(--radius);">
                    <h3 style="font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                        <i class="fas fa-rocket" style="color:var(--primary);"></i> Start Learning
                    </h3>
                    <p style="color:var(--text-muted); font-size:0.95rem; margin:0 0 12px 0;">
                        Whether you're completely new to technology or looking to improve your existing skills, <strong style="color:var(--text-dark);">SHINEX Learning Circle is built to help you take the next step.</strong>
                    </p>
                    <a href="/" class="btn btn-primary"><i class="fas fa-graduation-cap"></i> Explore Courses</a>
                </div>

                <div style="text-align:center; margin-top:16px; padding-top:16px; border-top:2px solid #ede8f5;">
                    <p style="font-weight:700; color:var(--text-dark); font-size:1.1rem; margin:0;">
                        SHINEX Learning Circle
                    </p>
                    <p style="color:var(--primary); font-weight:600; font-size:0.95rem; margin:0;">
                        Learn. Understand. Protect.
                    </p>
                </div>
            </div>
        </div>
    </main>

    <%- include(getFooter()) %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hello! I'm your AI tutor. Ask me anything about your courses!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>