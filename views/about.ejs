<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header', { showBack: true }) %>

    <main class="main-content">
        <div class="container">
            <h2 style="font-size:2rem; font-weight:800; margin:0 0 4px;">About SHINEX Learning Circle</h2>
            <p style="color:var(--text-muted); margin-bottom:20px;">Learn. Understand. Protect.</p>

            <!-- Mission -->
            <div class="card card-purple" style="padding:32px; margin-bottom:24px; text-align:center;">
                <h3 style="font-size:1.6rem; font-weight:700; color:#fff; margin:0 0 8px;">Our Mission</h3>
                <p style="font-size:1.05rem; color:#d4c4f0; max-width:700px; margin:0 auto;">
                    To empower individuals with practical, industry-relevant skills through accessible, 
                    high-quality online education.
                </p>
            </div>

            <!-- Who We Are -->
            <div class="card" style="padding:24px 28px; margin-bottom:20px;">
                <h3 style="font-size:1.3rem; font-weight:700; margin:0 0 8px;">Who We Are</h3>
                <p style="font-size:1rem; color:var(--text-muted); line-height:1.8;">
                    SHINEX Learning Circle (SLC) is a Nigerian-based online learning platform dedicated to 
                    bridging the skills gap in technology, design, and business. We believe that everyone 
                    deserves access to quality education, regardless of their background or location.
                </p>
                <p style="font-size:1rem; color:var(--text-muted); line-height:1.8; margin-top:8px;">
                    Founded in 2026, SLC offers 10+ practical courses taught by industry professionals. 
                    Our curriculum is designed to be hands-on, project-based, and tailored to the needs of 
                    African learners.
                </p>
            </div>

            <!-- What We Offer -->
            <div class="card" style="padding:24px 28px; margin-bottom:20px;">
                <h3 style="font-size:1.3rem; font-weight:700; margin:0 0 8px;">What We Offer</h3>
                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px,1fr)); gap:16px; margin-top:8px;">
                    <div style="text-align:center; padding:12px;">
                        <i class="fas fa-graduation-cap" style="font-size:2rem; color:var(--primary);"></i>
                        <h4 style="margin:6px 0 2px;">10+ Courses</h4>
                        <p style="font-size:0.85rem; color:var(--text-muted);">From Cybersecurity to Web Development</p>
                    </div>
                    <div style="text-align:center; padding:12px;">
                        <i class="fas fa-chalkboard-teacher" style="font-size:2rem; color:var(--primary);"></i>
                        <h4 style="margin:6px 0 2px;">Expert Instructors</h4>
                        <p style="font-size:0.85rem; color:var(--text-muted);">Industry professionals with real-world experience</p>
                    </div>
                    <div style="text-align:center; padding:12px;">
                        <i class="fas fa-laptop-code" style="font-size:2rem; color:var(--primary);"></i>
                        <h4 style="margin:6px 0 2px;">Hands-on Learning</h4>
                        <p style="font-size:0.85rem; color:var(--text-muted);">Projects, labs, and real-world scenarios</p>
                    </div>
                    <div style="text-align:center; padding:12px;">
                        <i class="fas fa-users" style="font-size:2rem; color:var(--primary);"></i>
                        <h4 style="margin:6px 0 2px;">Community</h4>
                        <p style="font-size:0.85rem; color:var(--text-muted);">Connect with fellow learners and mentors</p>
                    </div>
                </div>
            </div>

            <!-- Why SLC -->
            <div class="card" style="padding:24px 28px; margin-bottom:20px;">
                <h3 style="font-size:1.3rem; font-weight:700; margin:0 0 8px;">Why SHINEX Learning Circle?</h3>
                <ul style="list-style:none; padding:0; margin:0;">
                    <li style="padding:6px 0; display:flex; gap:10px; align-items:center;">
                        <i class="fas fa-check-circle" style="color:#27ae60;"></i>
                        <span><strong>Affordable</strong> – Quality education at no cost for now.</span>
                    </li>
                    <li style="padding:6px 0; display:flex; gap:10px; align-items:center;">
                        <i class="fas fa-check-circle" style="color:#27ae60;"></i>
                        <span><strong>Flexible</strong> – Learn at your own pace, anytime, anywhere.</span>
                    </li>
                    <li style="padding:6px 0; display:flex; gap:10px; align-items:center;">
                        <i class="fas fa-check-circle" style="color:#27ae60;"></i>
                        <span><strong>Practical</strong> – Focus on skills you can apply immediately.</span>
                    </li>
                    <li style="padding:6px 0; display:flex; gap:10px; align-items:center;">
                        <i class="fas fa-check-circle" style="color:#27ae60;"></i>
                        <span><strong>Community-driven</strong> – Learn with peers and get support.</span>
                    </li>
                </ul>
            </div>

            <!-- Our Team -->
            <div class="card" style="padding:24px 28px; margin-bottom:20px;">
                <h3 style="font-size:1.3rem; font-weight:700; margin:0 0 8px;">Our Team</h3>
                <p style="font-size:1rem; color:var(--text-muted); line-height:1.8;">
                    We are a passionate group of educators, developers, designers, and business professionals 
                    who believe in the transformative power of education. Our team is dedicated to creating 
                    the best learning experience for our students.
                </p>
            </div>

            <!-- Contact CTA -->
            <div style="text-align:center; padding:24px; background:var(--primary-bg); border-radius:14px;">
                <h4 style="font-size:1.1rem; font-weight:700; margin:0 0 4px;">Have Questions?</h4>
                <p style="color:var(--text-muted); margin-bottom:12px;">We'd love to hear from you.</p>
                <a href="/contact" class="btn btn-primary">
                    <i class="fas fa-envelope"></i> Contact Us
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html><!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           ABOUT PAGE STYLES
           ============================================================ */
        
        .about-container {
            max-width: 900px;
            margin: 0 auto;
        }
        
        /* ----- Page Header ----- */
        .about-header {
            margin-bottom: var(--spacing-lg);
        }
        
        .about-header h1 {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .about-header h1 i {
            color: var(--purple-primary);
        }
        
        .about-header .tagline {
            color: var(--text-muted);
            font-size: 1.05rem;
            margin: 0;
        }
        
        /* ----- Mission Card ----- */
        .mission-card {
            background: var(--purple-gradient);
            border-radius: var(--radius-lg);
            padding: var(--spacing-xl);
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: #fff;
            border: none;
        }
        
        .mission-card .mission-icon {
            font-size: 2.5rem;
            margin-bottom: var(--spacing-sm);
            display: block;
        }
        
        .mission-card h2 {
            font-size: 1.8rem;
            font-weight: 700;
            color: #fff;
            margin: 0 0 8px 0;
        }
        
        .mission-card p {
            font-size: 1.05rem;
            color: rgba(255, 255, 255, 0.85);
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.7;
        }
        
        /* ----- Cards ----- */
        .about-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-lg);
            margin-bottom: var(--spacing-md);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .about-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        .about-card .card-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 var(--spacing-sm) 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .about-card .card-title i {
            color: var(--purple-primary);
        }
        
        .about-card p {
            font-size: 1rem;
            color: var(--text-secondary);
            line-height: 1.8;
            margin: 0;
        }
        
        .about-card p + p {
            margin-top: var(--spacing-sm);
        }
        
        /* ----- Features Grid ----- */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: var(--spacing-md);
            margin-top: var(--spacing-sm);
        }
        
        .feature-item {
            text-align: center;
            padding: var(--spacing-md);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }
        
        .feature-item:hover {
            transform: translateY(-4px);
            border-color: var(--purple-primary);
            box-shadow: var(--shadow-sm);
        }
        
        .feature-item .feature-icon {
            font-size: 2.2rem;
            color: var(--purple-primary);
            display: block;
            margin-bottom: var(--spacing-sm);
        }
        
        .feature-item h4 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 2px 0;
        }
        
        .feature-item p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.5;
        }
        
        /* ----- Why SLC List ----- */
        .why-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        
        .why-list li {
            padding: var(--spacing-sm) 0;
            display: flex;
            gap: 12px;
            align-items: center;
            font-size: 1rem;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-color);
        }
        
        .why-list li:last-child {
            border-bottom: none;
        }
        
        .why-list li i {
            color: var(--text-success);
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        
        .why-list li strong {
            color: var(--text-primary);
        }
        
        /* ----- Team Section ----- */
        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: var(--spacing-md);
            margin-top: var(--spacing-sm);
        }
        
        .team-member {
            text-align: center;
            padding: var(--spacing-md);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }
        
        .team-member:hover {
            transform: translateY(-4px);
            border-color: var(--purple-primary);
        }
        
        .team-member .member-avatar {
            font-size: 3rem;
            color: var(--purple-primary);
            display: block;
            margin-bottom: var(--spacing-sm);
        }
        
        .team-member .member-name {
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 2px 0;
        }
        
        .team-member .member-role {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 0;
        }
        
        /* ----- CTA Section ----- */
        .cta-section {
            text-align: center;
            padding: var(--spacing-xl);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
        }
        
        .cta-section h4 {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .cta-section p {
            color: var(--text-secondary);
            margin: 0 0 var(--spacing-md) 0;
            font-size: 1rem;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 768px) {
            .about-header h1 {
                font-size: 1.6rem;
            }
            
            .mission-card {
                padding: var(--spacing-lg);
            }
            
            .mission-card h2 {
                font-size: 1.4rem;
            }
            
            .mission-card p {
                font-size: 0.95rem;
            }
            
            .about-card {
                padding: var(--spacing-md);
            }
            
            .about-card .card-title {
                font-size: 1.1rem;
            }
            
            .features-grid {
                grid-template-columns: 1fr 1fr;
            }
            
            .team-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        
        @media (max-width: 480px) {
            .features-grid {
                grid-template-columns: 1fr;
            }
            
            .team-grid {
                grid-template-columns: 1fr;
            }
            
            .cta-section {
                padding: var(--spacing-lg);
            }
        }
    </style>
</head>
