<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHINEX Learning Circle – Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <!-- ===== HERO ===== -->
            <div class="card card-purple hero-section">
                <h1>SHINEX Learning Circle</h1>
                <p>Empowering minds with cutting-edge courses in tech, design, and data.</p>
                <div class="hero-buttons">
                    <a href="#courses" class="btn btn-secondary" style="background:rgba(255,255,255,0.2); color:#fff;">
                        <i class="fas fa-arrow-down"></i> Explore Courses
                    </a>
                    <a href="/services" class="btn btn-secondary" style="background:rgba(255,255,255,0.2); color:#fff;">
                        <i class="fas fa-cogs"></i> View Services
                    </a>
                </div>
            </div>

            <!-- ===== COURSES (SHOWCASE ONLY - UNCLICKABLE) ===== -->
            <div id="courses">
                <h3 style="font-size:1.2rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-graduation-cap" style="color:#8B5CF6;"></i> Our Courses
                </h3>
                <p style="color:var(--text-muted); font-size:0.85rem; margin:0 0 12px 0;">
                    Explore our wide range of courses designed to help you build valuable skills.
                </p>

                <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:20px; margin-bottom:30px;">
                    <% if (courses && courses.length > 0) { %>
                        <% courses.forEach(function(c) { %>
                            <div style="background:#fff; border-radius:10px; padding:18px 20px; border:1px solid #ede8f5; transition:all 0.3s ease; cursor:default;">
                                <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                                    <span class="badge badge-purple"><%= c.level || 'Beginner' %></span>
                                    <span style="font-size:0.75rem; color:var(--text-muted);">
                                        <i class="far fa-clock"></i> <%= c.duration || 'N/A' %>
                                    </span>
                                </div>
                                <div style="font-size:1.1rem; font-weight:700; color:var(--text-dark); margin:6px 0 2px;"><%= c.title %></div>
                                <div style="font-size:0.85rem; color:var(--text-muted); margin:0 0 8px;"><%= c.description || 'Learn more about this course.' %></div>
                                <div style="display:flex; flex-wrap:wrap; gap:6px;">
                                    <span class="badge badge-dark">
                                        <i class="fas fa-layer-group"></i> <%= c.levels ? c.levels.length : 0 %> Levels
                                    </span>
                                    <span class="badge badge-dark">
                                        <i class="fas fa-book"></i> 
                                        <% let totalClasses = 0; %>
                                        <% if (c.levels) { %>
                                            <% c.levels.forEach(function(l) { if (l.lessons) { l.lessons.forEach(function(ls) { if (ls.classes) totalClasses += ls.classes.length; }); } }); %>
                                        <% } %>
                                        <%= totalClasses %> Classes
                                    </span>
                                </div>
                                <div style="margin-top:10px; padding-top:10px; border-top:1px solid #ede8f5; text-align:center; color:var(--text-muted); font-size:0.75rem;">
                                    <i class="fas fa-lock" style="color:#8B5CF6;"></i> Available to registered students
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div style="text-align:center; padding:30px 20px; color:var(--text-muted); grid-column:1/-1;">
                            <p>No courses available yet. Check back soon!</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- ===== SERVICES PREVIEW WITH BUTTON ===== -->
            <div style="text-align:center; background:var(--primary-bg); border-radius:14px; padding:30px 20px; margin-top:10px;">
                <h3 style="font-size:1.2rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-cogs" style="color:#8B5CF6;"></i> Need Professional Services?
                </h3>
                <p style="color:var(--text-muted); font-size:0.95rem; margin:0 0 16px 0;">
                    From school registration to graphic design, we've got you covered.
                </p>
                <a href="/services" class="btn btn-primary btn-lg">
                    <i class="fas fa-arrow-right"></i> View All Services
                </a>
            </div>

        </div>
    </main>

    <%- include(getFooter()) %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hello! I'm your AI tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>