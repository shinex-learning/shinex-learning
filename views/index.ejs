<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHINEX Learning Circle – Learn. Grow. Succeed.</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ============================================================
           HOMEPAGE STYLES
           ============================================================ */
        
        /* ----- Hero Section ----- */
        .hero-section {
            background: var(--purple-gradient);
            border-radius: var(--radius-lg);
            padding: var(--spacing-xl) var(--spacing-lg);
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: #fff;
            border: none;
        }
        
        .hero-section .hero-icon {
            font-size: 3rem;
            margin-bottom: var(--spacing-sm);
            display: block;
        }
        
        .hero-section h1 {
            font-size: 2.5rem;
            font-weight: 900;
            color: #fff;
            margin: 0;
            letter-spacing: -1px;
        }
        
        .hero-section p {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.85);
            max-width: 600px;
            margin: 8px auto 0;
            line-height: 1.6;
        }
        
        .hero-section .hero-buttons {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: var(--spacing-md);
        }
        
        .hero-section .hero-buttons .btn-hero {
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
            padding: 10px 28px;
            border-radius: var(--radius-full);
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        
        .hero-section .hero-buttons .btn-hero:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
        }
        
        .hero-section .hero-buttons .btn-hero i {
            font-size: 0.85rem;
        }
        
        /* ----- Section Headers ----- */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: var(--spacing-sm);
            margin-bottom: 4px;
        }
        
        .section-header h2 {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        
        .section-header h2 i {
            color: var(--purple-primary);
            margin-right: 8px;
        }
        
        .section-header .view-all {
            font-size: 0.85rem;
            color: var(--purple-primary);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .section-header .view-all:hover {
            color: var(--purple-dark);
            transform: translateX(4px);
        }
        
        .section-subtitle {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin: 0 0 var(--spacing-md) 0;
        }
        
        /* ----- Course Cards ----- */
        .course-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: var(--spacing-md);
            margin-bottom: var(--spacing-lg);
        }
        
        .course-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-lg);
            transition: all 0.3s ease;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
        }
        
        .course-card:hover {
            border-color: var(--purple-primary);
            box-shadow: var(--shadow-md);
            transform: translateY(-4px);
        }
        
        .course-card .card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }
        
        .course-card .card-top .level-badge {
            background: var(--purple-bg);
            color: var(--purple-primary);
            padding: 2px 14px;
            border-radius: var(--radius-full);
            font-size: 0.65rem;
            font-weight: 600;
        }
        
        .course-card .card-top .duration-badge {
            font-size: 0.7rem;
            color: var(--text-muted);
        }
        
        .course-card .card-top .duration-badge i {
            margin-right: 4px;
        }
        
        .course-card .course-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 2px 0 4px 0;
        }
        
        .course-card .course-desc {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin: 0 0 var(--spacing-sm) 0;
            line-height: 1.6;
            flex: 1;
        }
        
        .course-card .course-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: var(--spacing-sm);
        }
        
        .course-card .course-meta .meta-tag {
            background: var(--bg-card-secondary);
            color: var(--text-secondary);
            padding: 2px 12px;
            border-radius: var(--radius-full);
            font-size: 0.6rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        
        .course-card .course-meta .meta-tag i {
            font-size: 0.55rem;
        }
        
        .course-card .course-lock {
            margin-top: auto;
            padding-top: var(--spacing-sm);
            border-top: 1px solid var(--border-color);
            text-align: center;
            color: var(--text-muted);
            font-size: 0.75rem;
        }
        
        .course-card .course-lock i {
            color: var(--purple-primary);
            margin-right: 4px;
        }
        
        /* ----- Service Cards ----- */
        .services-section {
            margin-top: var(--spacing-lg);
        }
        
        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }
        
        .service-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-md);
            transition: all 0.3s ease;
            box-shadow: var(--shadow-sm);
            display: flex;
            flex-direction: column;
        }
        
        .service-card:hover {
            border-color: var(--purple-primary);
            box-shadow: var(--shadow-md);
            transform: translateY(-4px);
        }
        
        .service-card .service-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 6px;
            margin-bottom: 4px;
        }
        
        .service-card .service-top .service-name {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
        }
        
        .service-card .service-top .category-badge {
            background: var(--purple-bg);
            color: var(--purple-primary);
            padding: 2px 10px;
            border-radius: var(--radius-full);
            font-size: 0.55rem;
            font-weight: 600;
            white-space: nowrap;
        }
        
        .service-card .service-desc {
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin: 0 0 var(--spacing-sm) 0;
            line-height: 1.6;
            flex: 1;
        }
        
        .service-card .service-price {
            font-weight: 700;
            color: var(--purple-primary);
            font-size: 1.1rem;
            margin-bottom: var(--spacing-sm);
        }
        
        .service-card .service-price .price-label {
            font-weight: 400;
            font-size: 0.75rem;
            color: var(--text-muted);
        }
        
        .service-card .btn-order {
            width: 100%;
            padding: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            border-radius: var(--radius-full);
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            text-decoration: none;
            display: block;
            text-align: center;
            transition: all 0.3s ease;
        }
        
        .service-card .btn-order:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
        }
        
        .service-card .btn-order i {
            margin-right: 6px;
        }
        
        /* ----- View All Services ----- */
        .view-all-services {
            text-align: center;
            padding: var(--spacing-lg);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            margin-top: var(--spacing-sm);
        }
        
        .view-all-services p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            margin: 0 0 var(--spacing-sm) 0;
        }
        
        .view-all-services .btn-view-all {
            padding: 10px 32px;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: var(--radius-full);
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
        }
        
        .view-all-services .btn-view-all:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .view-all-services .btn-view-all i {
            margin-right: 6px;
        }
        
        /* ----- Empty State ----- */
        .empty-state {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-md);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            grid-column: 1 / -1;
        }
        
        .empty-state .empty-icon {
            font-size: 3rem;
            display: block;
            margin-bottom: var(--spacing-sm);
            opacity: 0.5;
        }
        
        .empty-state h4 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .empty-state p {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin: 0;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 768px) {
            .hero-section h1 {
                font-size: 1.8rem;
            }
            
            .hero-section p {
                font-size: 0.95rem;
            }
            
            .hero-section {
                padding: var(--spacing-lg) var(--spacing-md);
            }
            
            .course-grid {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }
            
            .course-card {
                padding: var(--spacing-md);
            }
            
            .course-card .course-title {
                font-size: 0.95rem;
            }
            
            .course-card .course-desc {
                font-size: 0.75rem;
            }
            
            .service-grid {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }
            
            .service-card {
                padding: var(--spacing-sm);
            }
            
            .section-header h2 {
                font-size: 1.1rem;
            }
            
            .view-all-services {
                padding: var(--spacing-md);
            }
        }
        
        @media (max-width: 480px) {
            .course-grid {
                grid-template-columns: 1fr;
            }
            
            .service-grid {
                grid-template-columns: 1fr;
            }
            
            .hero-section h1 {
                font-size: 1.4rem;
            }
            
            .hero-section .hero-buttons .btn-hero {
                width: 100%;
                justify-content: center;
            }
            
            .section-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    PAGE LOADER
    ============================================================ -->
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <!-- ===== HEADER ===== -->
    <%- include(getHeader()) %>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="container">

            <!-- ===== FLASH MESSAGES ===== -->
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error">
                    <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                </div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success">
                    <i class="fas fa-check-circle"></i> <%= messages.success %>
                </div>
            <% } %>

            <!-- ===== HERO SECTION ===== -->
            <div class="hero-section">
                <span class="hero-icon">📚</span>
                <h1>SHINEX Learning Circle</h1>
                <p>Empowering minds with cutting-edge courses in tech, design, and data.</p>
                <div class="hero-buttons">
                    <a href="#courses" class="btn-hero">
                        <i class="fas fa-arrow-down"></i> Explore Courses
                    </a>
                    <a href="/services" class="btn-hero">
                        <i class="fas fa-cogs"></i> View Services
                    </a>
                    <% if (!user) { %>
                        <a href="/register" class="btn-hero" style="background:rgba(255,255,255,0.25);">
                            <i class="fas fa-user-plus"></i> Get Started
                        </a>
                    <% } %>
                </div>
            </div>

            <!-- ===== COURSES SECTION ===== -->
            <div id="courses">
                <div class="section-header">
                    <h2><i class="fas fa-graduation-cap"></i> Our Courses</h2>
                    <a href="/courses" class="view-all">View All →</a>
                </div>
                <p class="section-subtitle">Explore our wide range of courses designed to help you build valuable skills.</p>

                <div class="course-grid">
                    <% if (courses && courses.length > 0) { %>
                        <% courses.forEach(function(c) { 
                            let totalClasses = 0;
                            if (c.levels) {
                                c.levels.forEach(function(l) { 
                                    if (l.lessons) { 
                                        l.lessons.forEach(function(ls) { 
                                            if (ls.classes) totalClasses += ls.classes.length; 
                                        }); 
                                    } 
                                });
                            }
                        %>
                            <div class="course-card">
                                <div class="card-top">
                                    <span class="level-badge">
                                        <i class="fas fa-signal"></i> <%= c.level || 'Beginner' %>
                                    </span>
                                    <span class="duration-badge">
                                        <i class="far fa-clock"></i> <%= c.duration || 'Self-paced' %>
                                    </span>
                                </div>
                                <div class="course-title"><%= c.title %></div>
                                <div class="course-desc">
                                    <%= c.description ? c.description.substring(0, 100) + (c.description.length > 100 ? '...' : '') : 'Learn more about this course.' %>
                                </div>
                                <div class="course-meta">
                                    <span class="meta-tag">
                                        <i class="fas fa-layer-group"></i> <%= c.levels ? c.levels.length : 0 %> Level<%= c.levels && c.levels.length > 1 ? 's' : '' %>
                                    </span>
                                    <span class="meta-tag">
                                        <i class="fas fa-book"></i> <%= totalClasses %> Class<%= totalClasses > 1 ? 'es' : '' %>
                                    </span>
                                </div>
                                <div class="course-lock">
                                    <i class="fas fa-lock"></i> Available to registered students
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-state">
                            <span class="empty-icon">📖</span>
                            <h4>No Courses Available</h4>
                            <p>Check back soon for new courses!</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- ===== SERVICES SECTION ===== -->
            <div class="services-section">
                <div class="section-header">
                    <h2><i class="fas fa-cogs"></i> Our Services</h2>
                    <a href="/services" class="view-all">View All →</a>
                </div>
                <p class="section-subtitle">Professional services to help you achieve your goals.</p>

                <div class="service-grid">
                    <% if (services && services.length > 0) { %>
                        <% services.slice(0, 4).forEach(function(service) { %>
                            <div class="service-card">
                                <div class="service-top">
                                    <span class="service-name"><%= service.name %></span>
                                    <span class="category-badge">
                                        <%= service.category ? service.category.charAt(0).toUpperCase() + service.category.slice(1) : 'Service' %>
                                    </span>
                                </div>
                                <div class="service-desc">
                                    <%= service.description ? service.description.substring(0, 60) + (service.description.length > 60 ? '...' : '') : 'Professional service tailored to your needs.' %>
                                </div>
                                <div class="service-price">
                                    <span class="price-label">₦</span> <%= service.price.toLocaleString() %>
                                </div>
                                <a href="/contact" class="btn-order">
                                    <i class="fas fa-arrow-right"></i> Order
                                </a>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-state">
                            <span class="empty-icon">🔧</span>
                            <h4>No Services Available</h4>
                            <p>Check back soon for our professional services.</p>
                        </div>
                    <% } %>
                </div>

                <!-- View All Services -->
                <div class="view-all-services">
                    <p>Need more services? Check out our full list.</p>
                    <a href="/services" class="btn-view-all">
                        <i class="fas fa-arrow-right"></i> View All Services
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <%- include(getFooter()) %>

    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:60px; height:60px; border-radius:50%; background:var(--purple-gradient); color:#fff; border:none; font-size:26px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:60px; height:60px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    👋 Hello! I'm your SHINEX AI Tutor. Ask me anything about our courses, services, or any topic!
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>