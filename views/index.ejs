<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHINEX Learning Circle – Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Course Cards */
        .course-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px 22px;
            border: 1px solid #ede8f5;
            transition: all 0.3s ease;
            cursor: default;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        body.dark-mode .course-card {
            background: #1a1a1a;
            border-color: #333;
        }
        .course-card:hover {
            border-color: #8B5CF6;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.08);
        }
        body.dark-mode .course-card .course-title {
            color: #ffffff;
        }
        body.dark-mode .course-card .course-desc {
            color: #b0a0c0;
        }
        body.dark-mode .course-card .course-meta {
            color: #b0a0c0;
        }
        body.dark-mode .course-card .course-lock {
            color: #888;
            border-top-color: #333;
        }
        .course-card .course-badge {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }
        .course-card .course-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-dark);
            margin: 4px 0 4px;
        }
        .course-card .course-desc {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0 0 10px;
            line-height: 1.5;
            flex: 1;
        }
        .course-card .course-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 10px;
        }
        .course-card .course-lock {
            margin-top: auto;
            padding-top: 10px;
            border-top: 1px solid #ede8f5;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.75rem;
        }
        .course-card .course-lock i {
            color: #8B5CF6;
            margin-right: 4px;
        }
        .courses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
            margin-bottom: 30px;
        }
        @media (max-width: 768px) {
            .courses-grid {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }
            .course-card {
                padding: 14px 16px;
            }
            .course-card .course-title {
                font-size: 0.95rem;
            }
            .course-card .course-desc {
                font-size: 0.75rem;
            }
        }
        @media (max-width: 480px) {
            .courses-grid {
                grid-template-columns: 1fr;
            }
        }
        .badge-course-level {
            background: var(--primary-bg);
            color: #8B5CF6;
            padding: 2px 12px;
            border-radius: 12px;
            font-size: 0.65rem;
            font-weight: 600;
        }
        body.dark-mode .badge-course-level {
            background: #2a1a4a;
            color: #a78bfa;
        }
        .badge-course-duration {
            font-size: 0.7rem;
            color: var(--text-muted);
        }
        body.dark-mode .badge-course-duration {
            color: #888;
        }
        .badge-meta {
            background: #ede8f5;
            color: var(--text-dark);
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.6rem;
            font-weight: 600;
        }
        body.dark-mode .badge-meta {
            background: #333;
            color: #d0d0d0;
        }

        /* ===== SERVICE CARDS ===== */
        .service-card-home {
            background: #fff;
            border-radius: 10px;
            padding: 16px 18px;
            border: 1px solid #ede8f5;
            transition: all 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        body.dark-mode .service-card-home {
            background: #1a1a1a;
            border-color: #333;
        }
        .service-card-home:hover {
            border-color: #8B5CF6;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.08);
        }
        body.dark-mode .service-card-home .service-name {
            color: #ffffff;
        }
        body.dark-mode .service-card-home .service-desc {
            color: #b0a0c0;
        }
        body.dark-mode .service-card-home .service-price {
            color: #a78bfa;
        }
        .service-card-home .service-name {
            font-weight: 700;
            font-size: 1rem;
            color: var(--text-dark);
        }
        .service-card-home .service-desc {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 4px 0 8px;
            flex: 1;
        }
        .service-card-home .service-price {
            font-weight: 700;
            color: #8B5CF6;
            font-size: 1.1rem;
        }
        .service-card-home .service-category {
            background: var(--primary-bg);
            color: #8B5CF6;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.55rem;
            font-weight: 600;
        }
        body.dark-mode .service-card-home .service-category {
            background: #2a1a4a;
            color: #a78bfa;
        }
        .service-card-home .service-order-btn {
            margin-top: 10px;
            width: 100%;
            text-align: center;
            font-size: 0.8rem;
            padding: 8px;
            border-radius: 30px;
            background: #8B5CF6;
            color: #fff;
            border: none;
            font-weight: 600;
            text-decoration: none;
            display: block;
            transition: all 0.3s ease;
        }
        .service-card-home .service-order-btn:hover {
            background: #6a3dcf;
            transform: translateY(-2px);
        }
        .services-grid-home {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }
        @media (max-width: 768px) {
            .services-grid-home {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }
        }
        @media (max-width: 480px) {
            .services-grid-home {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container">
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <!-- ===== HERO ===== -->
            <div class="card card-purple hero-section">
                <h1>SHINEX Learning Circle</h1>
                <p>Empowering minds with cutting-edge courses in tech, design, and data.</p>
                <div class="hero-buttons">
                    <a href="#courses" class="btn btn-secondary" style="background:rgba(255,255,255,0.2); color:#fff;">
                        <i class="fas fa-arrow-down"></i> Explore Courses
                    </a>
                    <a href="/services" class="btn btn-secondary" style="background:rgba(255,255,255,0.2); color:#fff;">
                        <i class="fas fa-cogs"></i> View Services
                    </a>
                </div>
            </div>

            <!-- ===== COURSES ===== -->
            <div id="courses">
                <h3 style="font-size:1.2rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-graduation-cap" style="color:#8B5CF6;"></i> Our Courses
                </h3>
                <p style="color:var(--text-muted); font-size:0.85rem; margin:0 0 16px 0;">
                    Explore our wide range of courses designed to help you build valuable skills.
                </p>

                <div class="courses-grid">
                    <% if (courses && courses.length > 0) { %>
                        <% courses.forEach(function(c) { %>
                            <div class="course-card">
                                <div class="course-badge">
                                    <span class="badge-course-level"><%= c.level || 'Beginner' %></span>
                                    <span class="badge-course-duration"><i class="far fa-clock"></i> <%= c.duration || 'N/A' %></span>
                                </div>
                                <div class="course-title"><%= c.title %></div>
                                <div class="course-desc"><%= c.description ? c.description.substring(0, 80) + (c.description.length > 80 ? '...' : '') : 'Learn more about this course.' %></div>
                                <div class="course-meta">
                                    <span class="badge-meta">
                                        <i class="fas fa-layer-group"></i> <%= c.levels ? c.levels.length : 0 %> Levels
                                    </span>
                                    <span class="badge-meta">
                                        <i class="fas fa-book"></i> 
                                        <% let totalClasses = 0; %>
                                        <% if (c.levels) { %>
                                            <% c.levels.forEach(function(l) { if (l.lessons) { l.lessons.forEach(function(ls) { if (ls.classes) totalClasses += ls.classes.length; }); } }); %>
                                        <% } %>
                                        <%= totalClasses %> Classes
                                    </span>
                                </div>
                                <div class="course-lock">
                                    <i class="fas fa-lock"></i> Available to registered students
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div style="text-align:center; padding:40px 20px; color:var(--text-muted); grid-column:1/-1;">
                            <i class="fas fa-info-circle" style="font-size:2rem; display:block; margin-bottom:8px;"></i>
                            <p>No courses available yet. Check back soon!</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- ===== SERVICES PREVIEW ===== -->
            <h3 style="font-size:1.2rem; font-weight:700; color:var(--text-dark); margin:30px 0 4px 0;">
                <i class="fas fa-cogs" style="color:#8B5CF6;"></i> Our Services
            </h3>
            <p style="color:var(--text-muted); font-size:0.85rem; margin:0 0 16px 0;">
                Professional services to help you achieve your goals.
            </p>

            <div class="services-grid-home">
                <% if (services && services.length > 0) { %>
                    <% services.forEach(function(service) { %>
                        <div class="service-card-home">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:6px;">
                                <div class="service-name"><%= service.name %></div>
                                <span class="service-category"><%= service.category || 'Service' %></span>
                            </div>
                            <div class="service-desc"><%= service.description ? service.description.substring(0, 60) + (service.description.length > 60 ? '...' : '') : 'Professional service tailored to your needs.' %></div>
                            <div class="service-price">₦<%= service.price %></div>
                            <a href="/contact" class="service-order-btn">
                                <i class="fas fa-arrow-right"></i> Order
                            </a>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div style="text-align:center; padding:20px; color:var(--text-muted); grid-column:1/-1;">
                        <p>No services available yet.</p>
                    </div>
                <% } %>
            </div>

            <!-- ===== SERVICES BUTTON ===== -->
            <div style="text-align:center; background:var(--primary-bg); border-radius:14px; padding:24px 20px; margin-top:10px;">
                <p style="color:var(--text-muted); font-size:0.95rem; margin:0 0 12px 0;">
                    Need more services? Check out our full list.
                </p>
                <a href="/services" class="btn btn-primary">
                    <i class="fas fa-arrow-right"></i> View All Services
                </a>
            </div>

        </div>
    </main>

    <%- include(getFooter()) %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hello! I'm your AI tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>