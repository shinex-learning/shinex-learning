<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHINEX Learning Circle – Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/header', { user, showBack: false }) %>

    <main class="main-content">
        <div class="container">

            <!-- Hero -->
            <div class="card card-purple" style="padding: 40px 36px; margin-bottom: 32px; text-align: center;">
                <h1 style="font-size: 2.4rem; font-weight: 800; color: #fff; letter-spacing: -1px;">
                    SHINEX Learning Circle
                </h1>
                <p style="color: #d4c4f0; font-size: 1.1rem; max-width: 600px; margin: 8px auto 0;">
                    Empowering minds with cutting-edge courses in tech, design, and data.
                </p>
                <div style="margin-top: 20px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
                    <% if (user) { %>
                        <a href="/dashboard" class="btn btn-primary" style="background: #fff; color: #8B5CF6;">
                            <i class="fas fa-tachometer-alt"></i> My Dashboard
                        </a>
                    <% } else { %>
                        <a href="/register/step1" class="btn btn-primary" style="background: #fff; color: #8B5CF6;">
                            <i class="fas fa-user-plus"></i> Get Started
                        </a>
                        <a href="/login" class="btn btn-outline" style="border-color: #fff; color: #fff;">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    <% } %>
                </div>
            </div>

            <!-- Courses -->
            <h3 style="font-size: 1.4rem; font-weight: 700; color: #1A0A2E; margin-bottom: 16px;">
                <i class="fas fa-graduation-cap" style="color: #8B5CF6;"></i> Our Courses
            </h3>

            <div class="grid-3">
                <% courses.forEach(c => { %>
                    <div class="course-card">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <span class="badge badge-purple"><%= c.level %></span>
                            <span style="font-size: 0.8rem; color: #7a6a8f;"><i class="far fa-clock"></i> <%= c.duration %></span>
                        </div>
                        <h4 class="course-title" style="margin-top: 8px;"><%= c.title %></h4>
                        <p style="font-size: 0.9rem; color: #5a4a70; margin: 6px 0 10px;"><%= c.description %></p>
                        <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                            <span class="badge badge-dark"><i class="fas fa-book"></i> <%= c.lessons ? c.lessons.length : 0 %> lessons</span>
                            <% if (user && user.courseId === c.id) { %>
                                <span class="badge badge-green"><i class="fas fa-check-circle"></i> Enrolled</span>
                            <% } %>
                        </div>
                        <% if (user && user.courseId === c.id) { %>
                            <a href="/course" class="btn btn-primary btn-sm" style="margin-top: 10px; width:100%;">
                                <i class="fas fa-arrow-right"></i> Continue Learning
                            </a>
                        <% } else if (user) { %>
                            <button class="btn btn-secondary btn-sm" style="margin-top: 10px; width:100%;" disabled>
                                <i class="fas fa-lock"></i> Enroll via Admin
                            </button>
                        <% } else { %>
                            <a href="/login" class="btn btn-secondary btn-sm" style="margin-top: 10px; width:100%;">
                                <i class="fas fa-sign-in-alt"></i> Login to Enroll
                            </a>
                        <% } %>
                    </div>
                <% }) %>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>