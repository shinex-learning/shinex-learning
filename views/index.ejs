<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHINEX Learning Circle – Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <!-- PAGE LOADER -->
    <div id="page-loader">
        <div class="loader-logo">
            <span>SLC</span>
            <div class="loader-water"></div>
        </div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content">
        <div class="container">
            <!-- Flash Messages -->
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <!-- ===== HERO SECTION ===== -->
            <div class="card card-purple hero-section">
                <h1>SHINEX Learning Circle</h1>
                <p>Empowering minds with cutting-edge courses in tech, design, and data.</p>
                <div class="hero-buttons">
                    <span style="color:#d4c4f0; font-size:1rem; padding:8px 16px;">
                        <i class="fas fa-arrow-down"></i> Browse courses below
                    </span>
                </div>
            </div>

            <!-- ===== COURSES SECTION ===== -->
            <h3 style="font-size:1.2rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                <i class="fas fa-graduation-cap" style="color:var(--primary);"></i> Our Courses
            </h3>
            <p style="color:var(--text-muted); font-size:0.85rem; margin:0 0 12px 0;">
                Choose a course and start your learning journey today.
            </p>

            <div class="course-grid">
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(function(c) { %>
                        <div class="course-card">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                                <span class="badge badge-purple"><%= c.level || 'Beginner' %></span>
                                <span style="font-size:0.75rem; color:var(--text-muted);">
                                    <i class="far fa-clock"></i> <%= c.duration || 'N/A' %>
                                </span>
                            </div>
                            <div class="course-title"><%= c.title %></div>
                            <div class="course-desc"><%= c.description || 'Learn more about this course.' %></div>
                            <div class="course-meta">
                                <span class="badge badge-dark">
                                    <i class="fas fa-layer-group"></i> <%= c.levels ? c.levels.length : 0 %> Levels
                                </span>
                                <span class="badge badge-dark">
                                    <i class="fas fa-book"></i> 
                                    <% let totalClasses = 0; %>
                                    <% if (c.levels) { %>
                                        <% c.levels.forEach(function(l) { if (l.lessons) { l.lessons.forEach(function(ls) { if (ls.classes) totalClasses += ls.classes.length; }); } }); %>
                                    <% } %>
                                    <%= totalClasses %> Classes
                                </span>
                            </div>
                            <div class="course-action">
                                <a href="/course/<%= c.id %>" class="btn btn-primary btn-sm">
                                    <i class="fas fa-eye"></i> View Course
                                </a>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-state">
                        <span class="empty-icon"><i class="fas fa-info-circle"></i></span>
                        <h3>No courses available yet.</h3>
                        <p>Check back soon for new courses!</p>
                    </div>
                <% } %>
            </div>

            <!-- ===== AD BOX ===== -->
            <%- include(getAdBox()) %>

        </div>
    </main>

    <%- include(getFooter()) %>

    <!-- ===== FLOATING AI BOT ===== -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn" aria-label="AI Tutor">
            <i class="fas fa-robot"></i>
        </button>
    </div>

    <!-- ===== AI CHAT MODAL ===== -->
    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header">
            <h4><i class="fas fa-robot"></i> AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hello! I'm your AI tutor. Ask me anything about your courses!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>