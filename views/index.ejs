<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>SHINEX Learning Circle – Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ===== HOMEPAGE SPECIFIC STYLES ===== */
        .hero-section {
            padding: 40px 36px;
            text-align: center;
            margin-bottom: 32px;
        }
        .hero-section h1 {
            font-size: 2.4rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: -1px;
        }
        .hero-section p {
            color: #d4c4f0;
            font-size: 1.1rem;
            max-width: 600px;
            margin: 8px auto 0;
        }
        .hero-buttons {
            margin-top: 20px;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
            align-items: center;
        }
        .hero-buttons .btn {
            min-height: 48px;
            padding: 12px 28px;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 30px;
            min-width: 140px;
        }
        @media (max-width: 480px) {
            .hero-buttons .btn {
                min-width: 100%;
                width: 100%;
                justify-content: center;
            }
        }

        .course-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
            margin-top: 12px;
        }
        @media (min-width: 768px) {
            .course-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }
        }
        @media (min-width: 1024px) {
            .course-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 24px;
            }
        }

        .course-card {
            background: #fff;
            border-radius: 14px;
            padding: 18px 16px;
            border: 1px solid #ede8f5;
            transition: all 0.3s ease;
        }
        .course-card:hover {
            border-color: #8B5CF6;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.08);
        }
        .course-card .course-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1A0A2E;
            margin: 6px 0 2px;
        }
        .course-card .course-desc {
            font-size: 0.85rem;
            color: #5a4a70;
            margin: 4px 0 8px;
        }
        .course-card .course-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 6px 0 10px;
        }
        .course-card .course-action {
            margin-top: 8px;
        }
        .course-card .course-action .btn {
            width: 100%;
            text-align: center;
        }

        /* Dark Mode Overrides for Homepage */
        body.dark-mode .course-card {
            background: #1e1e1e;
            border-color: #333;
        }
        body.dark-mode .course-card .course-title {
            color: #f0f0f0;
        }
        body.dark-mode .course-card .course-desc {
            color: #a090b0;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            margin: 20px 0 30px;
            background: #f8f6fc;
            border-radius: 14px;
            border: 1px solid #ede8f5;
            grid-column: 1 / -1;
        }
        .empty-state .empty-icon {
            font-size: 2.5rem;
            color: #d4c4f0;
            display: block;
            margin-bottom: 12px;
        }
        .empty-state h3 {
            font-size: 1.2rem;
            color: #1A0A2E;
            margin: 0 0 6px 0;
        }
        .empty-state p {
            color: #7a6a8f;
            font-size: 0.95rem;
            margin: 0 0 12px 0;
        }

        body.dark-mode .empty-state {
            background: #1e1e1e;
            border-color: #333;
        }
        body.dark-mode .empty-state h3 {
            color: #f0f0f0;
        }
        body.dark-mode .empty-state p {
            color: #a090b0;
        }
    </style>
</head>
<body>
    <%- include('partials/header', { user, showBack: false }) %>

    <main class="main-content">
        <div class="container">

            <!-- ===== MESSAGES ===== -->
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger" style="margin-bottom:12px;"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success" style="margin-bottom:12px;"><%= messages.success %></div>
            <% } %>

            <!-- ===== HERO SECTION ===== -->
            <div class="card card-purple hero-section">
                <h1>SHINEX Learning Circle</h1>
                <p>Empowering minds with cutting-edge courses in tech, design, and data.</p>
                <div class="hero-buttons">
                    <% if (user) { %>
                        <a href="/dashboard" class="btn btn-primary" style="background:#fff; color:#8B5CF6;">
                            <i class="fas fa-tachometer-alt"></i> My Dashboard
                        </a>
                    <% } else { %>
                        <a href="/register/step1" class="btn btn-primary" style="background:#fff; color:#8B5CF6;">
                            <i class="fas fa-user-plus"></i> Get Started
                        </a>
                        <a href="/login" class="btn btn-outline" style="border-color:#fff; color:#fff;">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    <% } %>
                </div>
            </div>

            <!-- ===== COURSES SECTION ===== -->
            <h3 style="font-size:1.2rem; font-weight:700; color:#1A0A2E; margin:0 0 4px 0;">
                <i class="fas fa-graduation-cap" style="color:#8B5CF6;"></i> Our Courses
            </h3>
            <p style="color:#7a6a8f; font-size:0.85rem; margin:0 0 12px 0;">
                Choose a course and start your learning journey today.
            </p>

            <div class="course-grid">
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(function(c) { %>
                        <div class="course-card">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                                <span class="badge badge-purple"><%= c.level || 'N/A' %></span>
                                <span style="font-size:0.75rem; color:#7a6a8f;">
                                    <i class="far fa-clock"></i> <%= c.duration || 'N/A' %>
                                </span>
                            </div>
                            <div class="course-title"><%= c.title %></div>
                            <div class="course-desc"><%= c.description %></div>
                            <div class="course-meta">
                                <span class="badge badge-dark">
                                    <i class="fas fa-layer-group"></i> <%= c.levels ? c.levels.length : 0 %> Levels
                                </span>
                                <span class="badge badge-dark">
                                    <i class="fas fa-book"></i> 
                                    <% let totalClasses = 0; %>
                                    <% if (c.levels) { %>
                                        <% c.levels.forEach(function(l) { %>
                                            <% if (l.lessons) { %>
                                                <% l.lessons.forEach(function(ls) { %>
                                                    <% if (ls.classes) { totalClasses += ls.classes.length; } %>
                                                <% }); %>
                                            <% } %>
                                        <% }); %>
                                    <% } %>
                                    <%= totalClasses %> Classes
                                </span>
                                <% if (user && user.courseId === c.id) { %>
                                    <span class="badge badge-green"><i class="fas fa-check-circle"></i> Enrolled</span>
                                <% } %>
                            </div>
                            <div class="course-action">
                                <% if (user && user.courseId === c.id) { %>
                                    <a href="/course/<%= c.id %>" class="btn btn-primary btn-sm">
                                        <i class="fas fa-arrow-right"></i> Continue Learning
                                    </a>
                                <% } else if (user) { %>
                                    <button class="btn btn-secondary btn-sm" style="width:100%;" disabled>
                                        <i class="fas fa-lock"></i> Enroll via Admin
                                    </button>
                                <% } else { %>
                                    <a href="/login" class="btn btn-secondary btn-sm">
                                        <i class="fas fa-sign-in-alt"></i> Login to Enroll
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <!-- ===== EMPTY STATE ===== -->
                    <div class="empty-state">
                        <span class="empty-icon"><i class="fas fa-info-circle"></i></span>
                        <h3>No courses available yet.</h3>
                        <p>Check back soon for new courses!</p>
                    </div>
                <% } %>
            </div>

            <!-- ===== AD BOX ===== -->
            <%- include('partials/ad-box') %>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>