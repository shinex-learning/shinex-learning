<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHINEX Learning Circle – Learn. Understand. Protect.</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main class="main-content">
        <div class="container">
            <!-- Flash Messages -->
            <% if (messages && messages.success) { %>
                <div class="alert alert-success"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger"><%= messages.error %></div>
            <% } %>

            <!-- Hero Section -->
            <div class="hero-section card-purple" style="padding:60px 40px; text-align:center; border-radius:20px; margin-bottom:40px;">
                <h1 style="font-size:2.8rem; margin-bottom:8px;">Welcome to SHINEX</h1>
                <p style="font-size:1.2rem; max-width:600px; margin:0 auto;">Learn. Understand. Protect.<br> Explore 10+ cutting‑edge courses taught by industry experts.</p>
                <div class="hero-buttons" style="margin-top:24px;">
                    <a href="/courses" class="btn btn-secondary btn-lg" style="background:#fff; color:#6a3dcf; font-weight:700;">Explore Courses</a>
                    <% if (!user) { %>
                        <a href="/register" class="btn btn-primary btn-lg" style="background:rgba(255,255,255,0.2); color:#fff; border:2px solid #fff;">Get Started Free</a>
                    <% } else { %>
                        <a href="/dashboard" class="btn btn-primary btn-lg" style="background:rgba(255,255,255,0.2); color:#fff; border:2px solid #fff;">Go to Dashboard</a>
                    <% } %>
                </div>
            </div>

            <!-- Courses Preview -->
            <h2 style="font-size:1.8rem; font-weight:700; margin-bottom:8px;">Our Courses</h2>
            <p style="color:var(--text-muted); margin-bottom:16px;">Choose your path and start learning today.</p>
            <div class="course-grid">
                <% if (courses && courses.length) { %>
                    <% courses.forEach(course => { %>
                        <div class="course-card">
                            <div style="display:flex; justify-content:space-between; align-items:start;">
                                <span class="badge badge-purple"><%= course.level || 'Beginner' %></span>
                                <span class="badge badge-dark"><%= course.duration || 'Self‑paced' %></span>
                            </div>
                            <h3 class="course-title"><%= course.title %></h3>
                            <p class="course-desc"><%= course.description ? course.description.substring(0,120)+'...' : 'Learn the fundamentals and advance your skills.' %></p>
                            <div class="course-action" style="margin-top:12px;">
                                <a href="/course/<%= course.id %>" class="btn btn-primary btn-sm" style="width:100%;">View Course</a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state">
                        <span class="empty-icon">📚</span>
                        <h3>No Courses Available Yet</h3>
                        <p>Check back soon for exciting new courses.</p>
                    </div>
                <% } %>
            </div>

            <!-- Services Preview -->
            <h2 style="font-size:1.8rem; font-weight:700; margin-top:40px; margin-bottom:8px;">Our Services</h2>
            <p style="color:var(--text-muted); margin-bottom:16px;">Professional services to accelerate your journey.</p>
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px,1fr)); gap:16px;">
                <% if (services && services.length) { %>
                    <% services.slice(0,4).forEach(service => { %>
                        <div class="card" style="text-align:center; padding:16px;">
                            <h4 style="font-size:1rem; font-weight:700; margin:0 0 4px;"><%= service.name %></h4>
                            <p style="font-size:0.85rem; color:var(--text-muted);"><%= service.description || '' %></p>
                            <p style="font-weight:700; color:var(--primary); font-size:1.1rem;">₦<%= service.price.toLocaleString() %></p>
                            <a href="/services" class="btn btn-secondary btn-sm" style="margin-top:6px;">Learn More</a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state" style="grid-column:1/-1;">
                        <p>Services coming soon.</p>
                    </div>
                <% } %>
            </div>
            <div style="text-align:center; margin-top:16px;">
                <a href="/services" class="btn btn-outline">View All Services</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>