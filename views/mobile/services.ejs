<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Our Services – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-services-container {
            padding: 12px 12px 24px;
            max-width: 500px;
            margin: 0 auto;
        }
        .mobile-service-card {
            padding: 16px 14px !important;
            border-radius: 12px !important;
            margin-bottom: 10px !important;
        }
        .mobile-service-card .service-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            flex-wrap: wrap;
            gap: 4px;
        }
        .mobile-service-card h3 {
            font-size: 0.95rem !important;
            font-weight: 700 !important;
            margin: 6px 0 2px !important;
        }
        .mobile-service-card p {
            font-size: 0.82rem !important;
            color: var(--text-muted);
            margin: 4px 0 8px !important;
            line-height: 1.6;
        }
        .mobile-service-card .price {
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--primary);
            margin: 4px 0;
        }
        .mobile-service-card .btn {
            width: 100%;
            font-size: 0.82rem !important;
            padding: 8px !important;
            min-height: 38px !important;
        }
        .mobile-service-card .badge {
            font-size: 0.6rem !important;
            padding: 2px 8px !important;
        }
        .mobile-category-section {
            margin-bottom: 12px;
        }
        .mobile-categories-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 6px;
            margin: 8px 0 12px;
        }
        .mobile-categories-grid .cat-item {
            text-align: center;
            padding: 8px 4px;
            background: var(--primary-bg);
            border-radius: 8px;
            font-size: 0.65rem;
            font-weight: 600;
            color: var(--text-muted);
        }
        body.dark-mode .mobile-categories-grid .cat-item {
            background: #1a1a1a;
        }
        .mobile-categories-grid .cat-item i {
            display: block;
            font-size: 1.1rem;
            color: var(--primary);
            margin-bottom: 2px;
        }
        .mobile-cta-box {
            padding: 16px;
            border: 2px solid var(--primary);
            border-radius: 12px;
            text-align: center;
            margin-top: 4px;
        }
        .mobile-cta-box h4 {
            font-size: 0.95rem !important;
            margin: 0 0 4px !important;
        }
        .mobile-cta-box p {
            font-size: 0.82rem !important;
            color: var(--text-muted);
            margin: 0 0 10px !important;
        }
        .mobile-cta-box .btn {
            width: 100%;
            font-size: 0.85rem !important;
            padding: 10px !important;
            min-height: 44px !important;
        }
        .mobile-alert {
            font-size: 0.82rem !important;
            padding: 10px 14px !important;
            border-radius: 8px !important;
            margin-bottom: 10px !important;
        }
        .mobile-empty-state {
            padding: 24px !important;
            border-radius: 12px !important;
            text-align: center !important;
        }
        .mobile-empty-state .empty-icon {
            font-size: 2rem;
            display: block;
            margin-bottom: 8px;
            opacity: 0.3;
        }
        .mobile-empty-state h3 {
            font-size: 1rem !important;
            margin: 0 0 4px !important;
        }
        .mobile-empty-state p {
            font-size: 0.85rem !important;
            margin: 0 !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: true }) %>

    <main class="main-content">
        <div class="mobile-services-container">
            <h2 style="font-size:1.3rem; font-weight:800; margin:0 0 2px;">🛠️ Our Services</h2>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">
                Professional services to support your academic, creative, and career goals.
            </p>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success mobile-alert"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger mobile-alert"><%= messages.error %></div>
            <% } %>

            <!-- Services List -->
            <% if (services && services.length > 0) { %>
                <% services.forEach(service => { %>
                    <div class="card mobile-service-card" style="border-color: <%= service.isActive ? 'var(--primary)' : '#e74c3c' %>;">
                        <div class="service-header">
                            <div>
                                <span class="badge <%= service.category === 'registration' ? 'badge-purple' : 
                                                  service.category === 'design' ? 'badge-gold' : 
                                                  service.category === 'campaign' ? 'badge-green' : 
                                                  service.category === 'website' ? 'badge-dark' : 'badge' %>">
                                    <%= service.category ? service.category.charAt(0).toUpperCase() + service.category.slice(1) : 'Service' %>
                                </span>
                                <span class="badge <%= service.isActive ? 'badge-green' : 'badge-red' %>">
                                    <%= service.isActive ? '✅ Active' : '❌ Inactive' %>
                                </span>
                            </div>
                            <span style="font-size:0.65rem; color:var(--text-muted);">
                                <%= new Date(service.createdAt).toLocaleDateString() %>
                            </span>
                        </div>
                        <h3><%= service.name %></h3>
                        <p><%= service.description || 'No description available.' %></p>
                        <div class="price">₦<%= service.price.toLocaleString() %></div>
                        <a href="/contact" class="btn btn-primary">
                            <i class="fas fa-paper-plane"></i> Inquire Now
                        </a>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state mobile-empty-state" style="background:#f8f6fc; border:1px solid #ede8f5;">
                    <span class="empty-icon">🛠️</span>
                    <h3>No Services Available</h3>
                    <p>Our services are currently being updated. Check back soon.</p>
                </div>
            <% } %>

            <!-- Categories -->
            <div class="card" style="padding:14px 12px !important; border-radius:12px !important;">
                <h4 style="font-size:0.9rem; font-weight:700; margin:0 0 6px;">📋 Service Categories</h4>
                <div class="mobile-categories-grid">
                    <div class="cat-item">
                        <i class="fas fa-file-signature"></i>
                        Registration
                    </div>
                    <div class="cat-item">
                        <i class="fas fa-paint-brush"></i>
                        Design
                    </div>
                    <div class="cat-item">
                        <i class="fas fa-bullhorn"></i>
                        Campaign
                    </div>
                    <div class="cat-item">
                        <i class="fas fa-globe"></i>
                        Website
                    </div>
                    <div class="cat-item">
                        <i class="fas fa-ellipsis-h"></i>
                        Other
                    </div>
                </div>
            </div>

            <!-- CTA -->
            <div class="mobile-cta-box">
                <h4>Need a custom service?</h4>
                <p>Tell us what you need and we'll create a solution for you.</p>
                <a href="/contact" class="btn btn-primary">
                    <i class="fas fa-comment"></i> Request Custom Service
                </a>
            </div>

            <!-- Back Link -->
            <div style="text-align:center; margin-top:12px;">
                <a href="/" style="color:var(--text-muted); font-size:0.82rem; text-decoration:none;">
                    <i class="fas fa-arrow-left"></i> Back to Home
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer-mobile') %>
    <script src="/js/main.js"></script>
</body>
</html>