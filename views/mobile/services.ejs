<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Our Services – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-services-container { padding: 12px 12px 24px; max-width: 500px; margin: 0 auto; }
        .mobile-service-card { padding: 16px 14px !important; border-radius: 12px !important; margin-bottom: 10px !important; background: var(--bg-light) !important; border: 1px solid #ede8f5 !important; }
        .mobile-service-card .service-header { display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 4px; }
        .mobile-service-card h3 { font-size: 0.95rem !important; font-weight: 700 !important; margin: 6px 0 2px !important; color: var(--text-dark); }
        .mobile-service-card p { font-size: 0.82rem !important; color: var(--text-muted); margin: 4px 0 8px !important; line-height: 1.6; }
        .mobile-service-card .price { font-weight: 700; font-size: 1.1rem; color: #8B5CF6; margin: 4px 0; }
        .mobile-service-card .btn { width: 100%; font-size: 0.82rem !important; padding: 8px !important; min-height: 38px !important; border-radius: 30px !important; background: #8B5CF6 !important; color: #fff !important; border: none !important; text-decoration: none; display: block; text-align: center; }
        .mobile-service-card .badge { font-size: 0.6rem !important; padding: 2px 8px !important; border-radius: 20px !important; }
        .mobile-categories-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; margin: 8px 0 12px; }
        .mobile-categories-grid .cat-item { text-align: center; padding: 8px 4px; background: #f0ebfb; border-radius: 8px; font-size: 0.65rem; font-weight: 600; color: var(--text-muted); }
        .mobile-categories-grid .cat-item i { display: block; font-size: 1.1rem; color: #8B5CF6; margin-bottom: 2px; }
        .mobile-cta-box { padding: 16px; border: 2px solid #8B5CF6; border-radius: 12px; text-align: center; margin-top: 4px; background: var(--bg-light); }
        .mobile-cta-box h4 { font-size: 0.95rem !important; margin: 0 0 4px !important; color: var(--text-dark); }
        .mobile-cta-box p { font-size: 0.82rem !important; color: var(--text-muted); margin: 0 0 10px !important; }
        .mobile-cta-box .btn { width: 100%; font-size: 0.85rem !important; padding: 10px !important; min-height: 44px !important; border-radius: 30px !important; background: #8B5CF6 !important; color: #fff !important; border: none !important; text-decoration: none; display: block; text-align: center; }
        .mobile-alert { font-size: 0.82rem !important; padding: 10px 14px !important; border-radius: 8px !important; margin-bottom: 10px !important; }
        .mobile-empty-state { padding: 24px !important; border-radius: 12px !important; text-align: center !important; background: #f8f6fc !important; border: 1px solid #ede8f5 !important; }
        .mobile-empty-state .empty-icon { font-size: 2rem; display: block; margin-bottom: 8px; opacity: 0.3; }
        .mobile-empty-state h3 { font-size: 1rem !important; margin: 0 0 4px !important; color: var(--text-dark); }
        .mobile-empty-state p { font-size: 0.85rem !important; margin: 0 !important; color: var(--text-muted); }
        .mobile-back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); text-decoration: none; font-size: 0.82rem; margin-top: 12px; padding: 6px 0; }
        body.dark-mode .mobile-service-card { background: var(--dark-card) !important; border-color: var(--dark-border) !important; }
        body.dark-mode .mobile-categories-grid .cat-item { background: #1a1a1a !important; }
        body.dark-mode .mobile-cta-box { background: var(--dark-card) !important; }
        body.dark-mode .mobile-empty-state { background: #1a1a1a !important; border-color: var(--dark-border) !important; }
    </style>
</head>
<body>
    <!-- ===== MOBILE HEADER ===== -->
    <header class="header" style="padding:8px 12px; flex-wrap:nowrap;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="javascript:history.back()" class="back-btn" style="font-size:0.75rem; padding:4px 8px; color:rgba(255,255,255,0.9); text-decoration:none; display:flex; align-items:center; gap:4px;"><i class="fas fa-arrow-left"></i></a>
            <a href="/" class="logo-container" style="gap:8px; text-decoration:none;">
                <div class="logo" style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:10px;">SLC</div>
                <div style="line-height:1.1;"><div class="logo-text" style="font-size:13px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div><div class="logo-sub" style="font-size:6px; color:rgba(255,255,255,0.7);">LEARNING</div></div>
            </a>
        </div>
        <div class="header-actions" style="gap:4px; flex-wrap:nowrap;">
            <button class="dark-toggle" id="darkToggleMobile" onclick="toggleDarkModeMobile()" style="padding:4px 8px; font-size:1rem; background:rgba(255,255,255,0.15); border:none; border-radius:30px; color:#fff; cursor:pointer;">🌙</button>
        </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="mobile-services-container">
            <h2 style="font-size:1.3rem; font-weight:800; margin:0 0 2px; color:var(--text-dark);">🛠️ Our Services</h2>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">Professional services to support your academic, creative, and career goals.</p>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success mobile-alert"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger mobile-alert"><%= messages.error %></div>
            <% } %>

            <!-- Services List -->
            <% if (services && services.length > 0) { %>
                <% services.forEach(service => { %>
                    <div class="card mobile-service-card" style="border-color: <%= service.isActive ? '#8B5CF6' : '#e74c3c' %>;">
                        <div class="service-header">
                            <div>
                                <span class="badge <%= service.category === 'registration' ? 'badge-purple' : 
                                                  service.category === 'design' ? 'badge-gold' : 
                                                  service.category === 'campaign' ? 'badge-green' : 
                                                  service.category === 'website' ? 'badge-dark' : 'badge' %>">
                                    <%= service.category ? service.category.charAt(0).toUpperCase() + service.category.slice(1) : 'Service' %>
                                </span>
                                <span class="badge <%= service.isActive ? 'badge-green' : 'badge-red' %>">
                                    <%= service.isActive ? '✅ Active' : '❌ Inactive' %>
                                </span>
                            </div>
                            <span style="font-size:0.65rem; color:var(--text-muted);"><%= new Date(service.createdAt).toLocaleDateString() %></span>
                        </div>
                        <h3><%= service.name %></h3>
                        <p><%= service.description || 'No description available.' %></p>
                        <div class="price">₦<%= service.price.toLocaleString() %></div>
                        <a href="/contact" class="btn"><i class="fas fa-paper-plane"></i> Inquire Now</a>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="mobile-empty-state">
                    <span class="empty-icon">🛠️</span>
                    <h3>No Services Available</h3>
                    <p>Our services are currently being updated. Check back soon.</p>
                </div>
            <% } %>

            <!-- Categories -->
            <div class="card" style="padding:14px 12px !important; border-radius:12px !important; background:var(--bg-light) !important; border:1px solid #ede8f5 !important;">
                <h4 style="font-size:0.9rem; font-weight:700; margin:0 0 6px; color:var(--text-dark);">📋 Service Categories</h4>
                <div class="mobile-categories-grid">
                    <div class="cat-item"><i class="fas fa-file-signature"></i>Registration</div>
                    <div class="cat-item"><i class="fas fa-paint-brush"></i>Design</div>
                    <div class="cat-item"><i class="fas fa-bullhorn"></i>Campaign</div>
                    <div class="cat-item"><i class="fas fa-globe"></i>Website</div>
                    <div class="cat-item"><i class="fas fa-ellipsis-h"></i>Other</div>
                </div>
            </div>

            <!-- CTA -->
            <div class="mobile-cta-box">
                <h4>Need a custom service?</h4>
                <p>Tell us what you need and we'll create a solution for you.</p>
                <a href="/contact" class="btn"><i class="fas fa-comment"></i> Request Custom Service</a>
            </div>

            <!-- Back Link -->
            <div style="text-align:center; margin-top:12px;">
                <a href="/" style="color:var(--text-muted); font-size:0.82rem; text-decoration:none;"><i class="fas fa-arrow-left"></i> Back to Home</a>
            </div>
        </div>
    </main>

    <!-- ===== MOBILE FOOTER ===== -->
    <footer class="footer" style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div class="container">
            <div style="text-align:center;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:6px;">
                    <div class="logo" style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div><div class="logo-text" style="font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div></div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:4px 0 8px;">Learn. Understand. Protect.</p>
                <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px 16px; margin:12px 0;">
                    <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Home</a>
                    <a href="/courses" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Courses</a>
                    <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Services</a>
                    <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">About</a>
                    <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Contact</a>
                    <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">FAQ</a>
                </div>
                <div style="display:flex; justify-content:center; gap:12px; margin:8px 0 12px;">
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-twitter"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-instagram"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-whatsapp"></i></a>
                </div>
                <div class="footer-bottom" style="border-top:1px solid rgba(255,255,255,0.1); padding-top:10px; font-size:0.7rem; color:rgba(255,255,255,0.6);">&copy; <%= new Date().getFullYear() %> SHINEX Learning Circle</div>
            </div>
        </div>
    </footer>

    <!-- ===== AI BOT ===== -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:26px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">🤖<span class="ai-bot-pulse" style="position:absolute; width:60px; height:60px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span></button>
    </div>
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:#fff; border-radius:14px; border:1px solid #ede8f5; box-shadow:0 20px 60px rgba(0,0,0,0.15); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:#8B5CF6; color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px;">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:10px; font-size:0.9rem; max-width:85%; line-height:1.5; background:#f0ebfb; color:#1A0A2E; align-self:flex-start; border-bottom-left-radius:4px;">👋 Hi! I'm your SHINEX AI Tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid #ede8f5; display:flex; gap:8px;">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:8px; border:1px solid #ede8f5; font-size:0.85rem;">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:30px; background:#8B5CF6; color:#fff; font-weight:600; cursor:pointer;">Send</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js"></script>
    <script src="/js/main.js"></script>
    <script>
        function toggleDarkModeMobile() {
            const body = document.body;
            body.classList.toggle('dark-mode');
            const isDark = body.classList.contains('dark-mode');
            localStorage.setItem('shinex-dark-mode', isDark);
            const btn = document.getElementById('darkToggleMobile');
            if (btn) btn.textContent = isDark ? '☀️' : '🌙';
        }
        document.addEventListener('DOMContentLoaded', function() {
            const savedDark = localStorage.getItem('shinex-dark-mode');
            if (savedDark === 'true') {
                document.body.classList.add('dark-mode');
                const btn = document.getElementById('darkToggleMobile');
                if (btn) btn.textContent = '☀️';
            }
        });
    </script>
</body>
</html>