<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Services – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .mobile-service-card {
            background: #fff;
            border-radius: 12px;
            padding: 14px 16px;
            border: 1px solid #ede8f5;
            margin-bottom: 10px;
        }
        body.dark-mode .mobile-service-card {
            background: #1a1a1a;
            border-color: #333;
        }
        body.dark-mode .mobile-service-card .service-name {
            color: #fff;
        }
        body.dark-mode .mobile-service-card .service-desc {
            color: #b0a0c0;
        }
        body.dark-mode .mobile-service-card .service-price {
            color: #a78bfa;
        }
        .mobile-service-card .service-name {
            font-weight: 700;
            font-size: 1rem;
            color: var(--text-dark);
        }
        .mobile-service-card .service-desc {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 4px 0 6px;
        }
        .mobile-service-card .service-price {
            font-weight: 700;
            color: #8B5CF6;
            font-size: 1.1rem;
        }
        .mobile-service-badge {
            background: var(--primary-bg);
            color: #8B5CF6;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.55rem;
            font-weight: 600;
        }
        body.dark-mode .mobile-service-badge {
            background: #2a1a4a;
            color: #a78bfa;
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <div style="text-align:center; margin-bottom:12px;">
                <h1 style="font-size:1.3rem; font-weight:800; color:var(--text-dark); margin:0;">
                    <i class="fas fa-cogs" style="color:#8B5CF6;"></i> Services
                </h1>
                <p style="color:var(--text-muted); font-size:0.75rem; margin:2px 0 0;">Click "Order" to contact us</p>
            </div>

            <% if (typeof services !== 'undefined' && services && services.length > 0) { %>
                <% services.forEach(function(service) { %>
                    <div class="mobile-service-card">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:6px;">
                            <div class="service-name"><%= service.name %></div>
                            <span class="mobile-service-badge">
                                <%= service.category || 'Service' %>
                            </span>
                        </div>
                        <div class="service-desc"><%= service.description || 'Professional service tailored to your needs.' %></div>
                        <div class="service-price">₦<%= service.price %></div>
                        <a href="/contact" style="width:100%; text-align:center; font-size:0.85rem; padding:10px; border-radius:30px; background:#8B5CF6; color:#fff; border:none; font-weight:600; text-decoration:none; display:block; margin-top:8px;">
                            <i class="fas fa-envelope"></i> Order Now
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <div style="text-align:center; padding:30px 16px; color:var(--text-muted);">
                    <i class="fas fa-info-circle" style="font-size:2rem; display:block; margin-bottom:8px;"></i>
                    <p>No services available yet.</p>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer-mobile') %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; font-size:20px;"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hello! I'm your AI tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>