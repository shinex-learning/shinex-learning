<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title><%= title %> | SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           MOBILE VERIFICATION SENT PAGE STYLES
           ============================================================ */
        
        .verify-container {
            max-width: 400px;
            margin: 0 auto;
            padding: var(--spacing-lg) var(--spacing-sm);
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 70vh;
        }
        
        /* ----- Verify Card ----- */
        .verify-card {
            background: var(--bg-card);
            border-radius: var(--radius-xl);
            padding: var(--spacing-xl) var(--spacing-lg);
            box-shadow: var(--shadow-lg);
            text-align: center;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }
        
        .verify-card:hover {
            box-shadow: var(--shadow-xl);
        }
        
        /* ----- Verify Icon ----- */
        .verify-card .verify-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--purple-gradient);
            color: #fff;
            font-size: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto var(--spacing-md);
            animation: floatIcon 2s ease-in-out infinite;
            box-shadow: 0 8px 30px rgba(139, 92, 246, 0.3);
        }
        
        @keyframes floatIcon {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        
        /* ----- Title ----- */
        .verify-card .verify-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }
        
        .verify-card .verify-subtitle {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-bottom: var(--spacing-md);
        }
        
        /* ----- Email Display ----- */
        .verify-card .email-display {
            background: var(--purple-bg);
            border-radius: var(--radius-sm);
            padding: var(--spacing-sm) var(--spacing-md);
            margin: 0 0 var(--spacing-md) 0;
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-primary);
            word-break: break-all;
            border: 1px solid var(--border-color);
        }
        
        .verify-card .email-display i {
            color: var(--purple-primary);
            margin-right: 8px;
        }
        
        /* ----- User Info Box ----- */
        .verify-card .user-info-box {
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            padding: var(--spacing-md);
            margin: 0 0 var(--spacing-md) 0;
            text-align: left;
            border-left: 4px solid var(--purple-primary);
        }
        
        .verify-card .user-info-box .info-row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 0.85rem;
        }
        
        .verify-card .user-info-box .info-label {
            color: var(--text-muted);
            font-weight: 500;
        }
        
        .verify-card .user-info-box .info-label i {
            margin-right: 6px;
            color: var(--purple-primary);
        }
        
        .verify-card .user-info-box .info-value {
            color: var(--text-primary);
            font-weight: 600;
        }
        
        .verify-card .user-info-box .info-value.student-id {
            color: var(--purple-primary);
        }
        
        /* ----- Resend Section ----- */
        .verify-card .resend-section {
            margin: var(--spacing-md) 0;
        }
        
        .verify-card .resend-section .resend-timer {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: var(--spacing-sm);
        }
        
        .verify-card .resend-section .resend-timer strong {
            color: var(--purple-primary);
            font-size: 1.1rem;
        }
        
        .verify-card .resend-section .btn-resend {
            width: 100%;
            padding: 12px;
            border-radius: var(--radius-full);
            font-size: 1rem;
            font-weight: 600;
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .verify-card .resend-section .btn-resend:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .verify-card .resend-section .btn-resend:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .verify-card .resend-section .btn-resend.loading {
            background: var(--purple-dark);
            cursor: wait;
        }
        
        .verify-card .resend-section .btn-resend .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 0.8s linear infinite;
            vertical-align: middle;
            margin-right: 8px;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* ----- Edit Email Button ----- */
        .verify-card .btn-edit-email {
            width: 100%;
            padding: 12px;
            border-radius: var(--radius-full);
            font-size: 1rem;
            font-weight: 600;
            background: transparent;
            color: var(--purple-primary);
            border: 2px solid var(--purple-primary);
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: block;
            text-align: center;
            margin-top: var(--spacing-sm);
        }
        
        .verify-card .btn-edit-email:hover {
            background: var(--purple-primary);
            color: #fff;
            transform: translateY(-2px);
        }
        
        .verify-card .btn-edit-email i {
            margin-right: 6px;
        }
        
        /* ----- Back Button ----- */
        .verify-card .btn-back {
            background: transparent;
            color: var(--text-muted);
            border: none;
            padding: var(--spacing-sm);
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: var(--spacing-sm);
            text-decoration: none;
            display: inline-block;
        }
        
        .verify-card .btn-back:hover {
            color: var(--text-primary);
        }
        
        .verify-card .btn-back i {
            margin-right: 6px;
        }
        
        /* ----- Warning Text ----- */
        .verify-card .warning-text {
            font-size: 0.75rem;
            color: var(--text-warning);
            margin-top: var(--spacing-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        
        .verify-card .warning-text i {
            font-size: 0.9rem;
        }
        
        /* ----- Toast ----- */
        .toast-message {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            padding: 12px 24px;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 0.9rem;
            z-index: 99999;
            max-width: 90%;
            text-align: center;
            box-shadow: var(--shadow-lg);
            animation: slideDown 0.4s ease;
        }
        
        @keyframes slideDown {
            0% { opacity: 0; transform: translateX(-50%) translateY(-20px); }
            100% { opacity: 1; transform: translateX(-50%) translateY(0); }
        }
        
        .toast-success {
            background: var(--text-success);
            color: #fff;
        }
        
        .toast-error {
            background: var(--text-error);
            color: #fff;
        }
        
        .toast-info {
            background: #3498db;
            color: #fff;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 400px) {
            .verify-card {
                padding: var(--spacing-lg) var(--spacing-md);
            }
            
            .verify-card .verify-title {
                font-size: 1.2rem;
            }
            
            .verify-card .verify-icon {
                width: 64px;
                height: 64px;
                font-size: 28px;
            }
            
            .verify-card .user-info-box .info-row {
                font-size: 0.78rem;
                flex-direction: column;
                align-items: flex-start;
                gap: 2px;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    MOBILE HEADER (Built-in)
    ============================================================ -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:10px 14px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; flex-wrap:wrap; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
                <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                <div>
                    <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); updateThemeToggle();" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 8px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon" id="themeIconMobile"></i>
            </button>
            <a href="/login" style="background:rgba(255,255,255,0.2); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
        </div>
    </header>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <main class="main-content" style="padding:0; min-height:auto;">
        <div class="verify-container">

            <!-- ===== VERIFY CARD ===== -->
            <div class="verify-card">
                
                <!-- Icon -->
                <div class="verify-icon">
                    <i class="fas fa-envelope"></i>
                </div>
                
                <!-- Title -->
                <h1 class="verify-title">📧 Verify Your Email</h1>
                <p class="verify-subtitle">We've sent a verification link to your email</p>
                
                <!-- Email Display -->
                <div class="email-display">
                    <i class="fas fa-envelope"></i>
                    <%= user && user.email ? user.email : 'Loading...' %>
                </div>
                
                <!-- User Info -->
                <div class="user-info-box">
                    <div class="info-row">
                        <span class="info-label"><i class="fas fa-user"></i> Name</span>
                        <span class="info-value"><%= user && user.firstName ? user.firstName + ' ' + (user.lastName || '') : 'Loading...' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="fas fa-id-card"></i> Student ID</span>
                        <span class="info-value student-id">
                            <%= user && user.studentId ? user.studentId : 'Not assigned yet' %>
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="fas fa-graduation-cap"></i> Course</span>
                        <span class="info-value"><%= user && user.courseName ? user.courseName : 'Not assigned' %></span>
                    </div>
                </div>
                
                <!-- Resend Section -->
                <div class="resend-section">
                    <div class="resend-timer">
                        <i class="fas fa-clock"></i> 
                        Resend available in <strong id="timerDisplay">30</strong> seconds
                    </div>
                    
                    <button id="resendBtn" class="btn-resend" disabled>
                        <i class="fas fa-paper-plane"></i> Send Verification Link
                    </button>
                </div>
                
                <!-- Edit Email -->
                <a href="/register" class="btn-edit-email">
                    <i class="fas fa-edit"></i> Edit Email Address
                </a>
                
                <!-- Back to Login -->
                <a href="/login" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Back to Login
                </a>
                
                <!-- Warning -->
                <div class="warning-text">
                    <i class="fas fa-exclamation-circle"></i>
                    Check your spam folder if you don't see the email
                </div>
                
            </div>

        </div>
    </main>

    <!-- ============================================================
    MOBILE FOOTER (Built-in)
    ============================================================ -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:16px 0; margin-top:16px;">
        <div style="max-width:480px; margin:0 auto; padding:0 16px;">
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:6px 12px; margin-bottom:10px;">
                <a href="/" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">Home</a>
                <a href="/about" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">About</a>
                <a href="/faq" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">FAQ</a>
                <a href="/services" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">Services</a>
                <a href="/contact" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">Contact</a>
                <a href="/terms" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">Terms</a>
                <a href="/privacy" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">Privacy</a>
            </div>
            <div style="text-align:center; font-size:0.6rem; color:rgba(255,255,255,0.5); border-top:1px solid rgba(255,255,255,0.1); padding-top:8px;">
                &copy; <%= new Date().getFullYear() %> SHINEX Learning Circle
            </div>
        </div>
    </footer>

    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:20px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:50px; height:50px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    👋 Hi! I'm your SHINEX AI Tutor. Need help with verification?
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script>
        // ============================================================
        // THEME TOGGLE
        // ============================================================
        
        function updateThemeToggle() {
            const isDark = document.body.classList.contains('dark-mode');
            const icon = document.getElementById('themeIconMobile');
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }
        
        // ============================================================
        // RESEND VERIFICATION
        // ============================================================
        
        let timer = 30;
        let timerInterval;
        let isResending = false;
        
        const resendBtn = document.getElementById('resendBtn');
        const timerDisplay = document.getElementById('timerDisplay');
        
        function startTimer() {
            timer = 30;
            resendBtn.disabled = true;
            timerDisplay.textContent = timer;
            
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                timer--;
                timerDisplay.textContent = timer;
                
                if (timer <= 0) {
                    clearInterval(timerInterval);
                    resendBtn.disabled = false;
                    timerDisplay.textContent = 'Now';
                }
            }, 1000);
        }
        
        function showToast(message, type) {
            const existing = document.querySelector('.toast-message');
            if (existing) existing.remove();
            
            const toast = document.createElement('div');
            toast.className = 'toast-message toast-' + type;
            toast.textContent = message;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(-50%) translateY(-20px)';
                toast.style.transition = 'all 0.4s ease';
                setTimeout(() => toast.remove(), 400);
            }, 4000);
        }
        
        resendBtn.addEventListener('click', async function() {
            if (this.disabled || isResending) return;
            
            const email = '<%= user && user.email ? user.email : "" %>';
            if (!email) {
                showToast('❌ Email not found. Please try again.', 'error');
                return;
            }
            
            isResending = true;
            this.disabled = true;
            this.innerHTML = '<span class="spinner"></span> Sending...';
            this.classList.add('loading');
            
            try {
                const response = await fetch('/resend-verification', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: email })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showToast('✅ Verification email resent! Check your inbox.', 'success');
                    startTimer();
                } else {
                    showToast('❌ ' + (data.error || 'Failed to resend. Please try again.'), 'error');
                }
            } catch (error) {
                showToast('❌ Network error. Please check your connection.', 'error');
            } finally {
                isResending = false;
                this.classList.remove('loading');
                if (timer > 0) {
                    this.innerHTML = '<i class="fas fa-paper-plane"></i> Send Verification Link';
                }
            }
        });
        
        // ============================================================
        // AI BOT
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const botBtn = document.getElementById('aiBotBtn');
            const chatModal = document.getElementById('aiChatModal');
            const chatClose = document.getElementById('aiChatClose');
            const chatInput = document.getElementById('aiChatInput');
            const chatSend = document.getElementById('aiChatSend');
            const chatMessages = document.getElementById('aiChatMessages');
            
            if (!botBtn || !chatModal) return;
            
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
            
            if (chatClose) {
                chatClose.addEventListener('click', function() {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                });
            }
            
            document.addEventListener('click', function(e) {
                if (chatModal.classList.contains('open')) {
                    if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                        chatModal.classList.remove('open');
                        chatModal.style.display = 'none';
                    }
                }
            });
            
            function addChatMessage(text, type) {
                const div = document.createElement('div');
                div.className = 'ai-chat-msg ' + type;
                let formatted = text;
                formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\n/g, '<br>');
                div.innerHTML = formatted;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            
            function sendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;
                
                addChatMessage(message, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                chatSend.disabled = true;
                
                const loadingMsg = document.createElement('div');
                loadingMsg.className = 'ai-chat-msg bot';
                loadingMsg.innerHTML = '⏳ Thinking...';
                loadingMsg.id = 'aiChatLoading';
                chatMessages.appendChild(loadingMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                fetch('/api/ai-tutor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userPrompt: message })
                })
                .then(response => response.json())
                .then(data => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    
                    if (data.error) {
                        addChatMessage('❌ ' + data.error, 'bot');
                    } else {
                        addChatMessage(data.answer, 'bot');
                    }
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                    chatInput.focus();
                })
                .catch(error => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                });
            }
            
            if (chatSend) {
                chatSend.addEventListener('click', sendMessage);
            }
            
            if (chatInput) {
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            }
        });
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
            updateThemeToggle();
        }
        
        // ============================================================
        // START TIMER
        // ============================================================
        
        startTimer();
        
        // ============================================================
