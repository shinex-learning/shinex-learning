<!-- ===== MOBILE HEADER – NO LOGIN/REGISTER ===== -->
<header class="mobile-header">
    <div class="mobile-header-flex">
        <div class="mobile-logo-container">
            <a href="/" class="mobile-logo-link">
                <div class="mobile-logo-circle">SLC</div>
                <span class="mobile-title-text">(SLC) SHINEX</span>
            </a>
        </div>

        <div class="mobile-header-actions">
            <button class="mobile-dark-toggle" id="mobileDarkToggle">
                <i class="fas fa-moon"></i>
            </button>
            <button class="mobile-hamburger" id="mobileHamburger">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <!-- ===== MOBILE NAV – NO LOGIN/REGISTER ===== -->
        <nav class="mobile-nav" id="mobileNav">
            <ul>
                <% if (user) { %>
                    <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                    <li><a href="/course/<%= user.courseId || '#' %>"><i class="fas fa-book"></i> My Course</a></li>
                    <li><a href="/settings"><i class="fas fa-cog"></i> Settings</a></li>
                    <li><a href="/logout" class="mobile-btn-logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                <% } else { %>
                    <!-- ===== PUBLIC MOBILE MENU (No Login/Register) ===== -->
                    <li><a href="/"><i class="fas fa-home"></i> Home</a></li>
                    <li><a href="/privacy"><i class="fas fa-shield-alt"></i> Privacy</a></li>
                    <li><a href="/terms"><i class="fas fa-file-contract"></i> Terms</a></li>
                    <li><a href="/contact"><i class="fas fa-envelope"></i> Contact</a></li>
                <% } %>
            </ul>
        </nav>
    </div>
</header>

<style>
    /* ===== MOBILE HEADER STYLES ===== */
    .mobile-header {
        background: #ffffff;
        padding: 10px 12px;
        border-bottom: 2px solid #8B5CF6;
        position: sticky;
        top: 0;
        z-index: 100;
        transition: background 0.3s, border-color 0.3s;
        display: none;
    }

    body.dark-mode .mobile-header {
        background: #000000;
        border-bottom: 2px solid #8B5CF6;
    }

    @media (max-width: 768px) {
        .mobile-header {
            display: block !important;
        }
        .site-header {
            display: none !important;
        }
    }

    @media (min-width: 769px) {
        .mobile-header {
            display: none !important;
        }
        .site-header {
            display: block !important;
        }
    }

    .mobile-header-flex {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .mobile-logo-container {
        display: flex;
        align-items: center;
    }

    .mobile-logo-link {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .mobile-logo-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #8B5CF6, #6a3dcf);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 14px;
        letter-spacing: 1px;
        box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
        flex-shrink: 0;
    }

    .mobile-title-text {
        font-size: 14px;
        font-weight: 700;
        color: #1A0A2E;
    }

    body.dark-mode .mobile-title-text {
        color: #ffffff;
    }

    .mobile-header-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .mobile-dark-toggle {
        background: transparent;
        border: none;
        color: #1A0A2E;
        font-size: 1.1rem;
        cursor: pointer;
        padding: 4px 8px;
    }

    body.dark-mode .mobile-dark-toggle {
        color: #ffffff;
    }

    .mobile-hamburger {
        background: transparent;
        border: none;
        color: #1A0A2E;
        font-size: 1.3rem;
        cursor: pointer;
        padding: 4px 6px;
    }

    body.dark-mode .mobile-hamburger {
        color: #ffffff;
    }

    .mobile-nav {
        display: none;
        width: 100%;
        padding: 10px 0;
        border-top: 1px solid rgba(139, 92, 246, 0.15);
        margin-top: 8px;
    }

    .mobile-nav-active {
        display: block !important;
    }

    .mobile-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .mobile-nav a {
        color: #4a2d6b;
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 500;
        display: block;
        text-align: center;
        transition: all 0.2s;
        text-decoration: none;
    }

    body.dark-mode .mobile-nav a {
        color: #d0c0e0;
    }

    .mobile-nav a:hover {
        background: rgba(139, 92, 246, 0.1);
        color: #8B5CF6;
    }

    .mobile-btn-logout {
        color: #e74c3c !important;
    }

    @media (max-width: 480px) {
        .mobile-logo-circle {
            width: 32px;
            height: 32px;
            font-size: 12px;
        }
        .mobile-title-text {
            font-size: 12px;
        }
    }
</style>

<script>
    document.getElementById('mobileHamburger').addEventListener('click', function() {
        document.getElementById('mobileNav').classList.toggle('mobile-nav-active');
    });

    document.getElementById('mobileDarkToggle').addEventListener('click', function() {
        document.body.classList.toggle('dark-mode');
        localStorage.setItem('darkMode', document.body.classList.contains('dark-mode'));
        const icon = this.querySelector('i');
        if (icon) {
            icon.classList.toggle('fa-moon');
            icon.classList.toggle('fa-sun');
        }
    });

    if (localStorage.getItem('darkMode') === 'true') {
        document.body.classList.add('dark-mode');
        const icon = document.querySelector('#mobileDarkToggle i');
        if (icon) {
            icon.classList.remove('fa-moon');
            icon.classList.add('fa-sun');
        }
    }

    document.querySelectorAll('.mobile-nav a').forEach(function(link) {
        link.addEventListener('click', function() {
            document.getElementById('mobileNav').classList.remove('mobile-nav-active');
        });
    });
</script>