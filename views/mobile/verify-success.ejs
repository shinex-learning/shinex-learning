<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Verified – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <div style="background:#fff; border-radius:12px; padding:30px 20px; border:3px solid #27ae60; text-align:center;">
                <div style="font-size:3.5rem; color:#27ae60; margin-bottom:12px;">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h1 style="font-size:1.4rem; font-weight:800; color:#27ae60; margin:0 0 6px 0;">
                    Verified! ✅
                </h1>
                <p style="color:var(--text-muted); font-size:0.9rem; margin:0 0 12px 0;">
                    Your email has been verified successfully.
                </p>
                <% if (user) { %>
                    <div style="background:var(--primary-bg); border-radius:8px; padding:12px; margin:12px 0;">
                        <p style="margin:2px 0; font-size:0.85rem; color:var(--text-dark);">
                            <strong><%= user.firstName %></strong>
                        </p>
                        <p style="margin:2px 0; font-size:0.75rem; color:var(--text-muted);">
                            ID: <strong style="color:#8B5CF6;"><%= user.studentId %></strong>
                        </p>
                    </div>
                <% } %>
                <div style="display:flex; flex-direction:column; gap:8px; margin-top:12px;">
                    <a href="/dashboard" style="width:100%; text-align:center; font-size:0.9rem; padding:10px; border-radius:30px; background:#8B5CF6; color:#fff; border:none; font-weight:600; text-decoration:none; display:block;">
                        <i class="fas fa-tachometer-alt"></i> Dashboard
                    </a>
                    <a href="/" style="width:100%; text-align:center; font-size:0.9rem; padding:10px; border-radius:30px; background:#ede8f5; color:var(--text-dark); border:none; font-weight:600; text-decoration:none; display:block;">
                        <i class="fas fa-home"></i> Home
                    </a>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer-mobile') %>
    <script src="/js/script.js"></script>
</body>
</html>