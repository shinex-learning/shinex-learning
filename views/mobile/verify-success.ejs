<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title><%= title %> | SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           MOBILE VERIFICATION SUCCESS PAGE STYLES
           ============================================================ */
        
        .success-container {
            max-width: 400px;
            margin: 0 auto;
            padding: var(--spacing-lg) var(--spacing-sm);
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 70vh;
        }
        
        /* ----- Success Card ----- */
        .success-card {
            background: var(--bg-card);
            border-radius: var(--radius-xl);
            padding: var(--spacing-xl) var(--spacing-lg);
            box-shadow: var(--shadow-lg);
            text-align: center;
            border: 1px solid var(--border-color);
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        
        .success-card:hover {
            box-shadow: var(--shadow-xl);
        }
        
        /* ----- Top Gradient Bar ----- */
        .success-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--purple-primary), var(--purple-dark), var(--purple-light));
            background-size: 200% 100%;
            animation: gradientMove 2s ease infinite;
        }
        
        @keyframes gradientMove {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        
        /* ----- Success Icon ----- */
        .success-card .success-icon {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--text-success), #2ecc71);
            color: #fff;
            font-size: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto var(--spacing-md);
            animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 8px 30px rgba(39, 174, 96, 0.3);
        }
        
        @keyframes popIn {
            0% { transform: scale(0) rotate(-10deg); opacity: 0; }
            70% { transform: scale(1.1) rotate(2deg); }
            100% { transform: scale(1) rotate(0deg); opacity: 1; }
        }
        
        /* ----- Title ----- */
        .success-card .success-title {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-primary);
            margin-bottom: 4px;
            animation: fadeUp 0.8s ease 0.2s both;
        }
        
        .success-card .success-subtitle {
            font-size: 1rem;
            color: var(--text-secondary);
            margin-bottom: var(--spacing-md);
            animation: fadeUp 0.8s ease 0.3s both;
        }
        
        @keyframes fadeUp {
            0% { opacity: 0; transform: translateY(20px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        
        /* ----- Student ID Display ----- */
        .success-card .student-id-display {
            background: var(--purple-gradient);
            border-radius: var(--radius-md);
            padding: var(--spacing-md);
            margin: var(--spacing-md) 0;
            color: #fff;
            animation: fadeUp 0.8s ease 0.4s both;
        }
        
        .success-card .student-id-display .label {
            font-size: 0.7rem;
            opacity: 0.8;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        
        .success-card .student-id-display .id-number {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: 2px;
            margin-top: 4px;
        }
        
        .success-card .student-id-display .id-sub {
            font-size: 0.8rem;
            opacity: 0.9;
            margin-top: 4px;
        }
        
        /* ----- User Details Grid ----- */
        .success-card .user-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin: var(--spacing-md) 0;
            animation: fadeUp 0.8s ease 0.5s both;
        }
        
        .success-card .user-details .detail-item {
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            padding: var(--spacing-sm);
            text-align: center;
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }
        
        .success-card .user-details .detail-item:hover {
            border-color: var(--purple-primary);
        }
        
        .success-card .user-details .detail-item .detail-icon {
            font-size: 1.2rem;
            color: var(--purple-primary);
        }
        
        .success-card .user-details .detail-item .detail-label {
            font-size: 0.6rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 2px;
        }
        
        .success-card .user-details .detail-item .detail-value {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-top: 2px;
        }
        
        .success-card .user-details .detail-item .detail-value.verified {
            color: var(--text-success);
        }
        
        .success-card .user-details .detail-item .detail-value.email-value {
            font-size: 0.7rem;
            word-break: break-all;
        }
        
        /* ----- Dashboard Button ----- */
        .success-card .btn-dashboard {
            width: 100%;
            padding: 14px;
            border-radius: var(--radius-full);
            font-size: 1rem;
            font-weight: 700;
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            animation: fadeUp 0.8s ease 0.6s both;
        }
        
        .success-card .btn-dashboard:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(139, 92, 246, 0.4);
        }
        
        .success-card .btn-dashboard i {
            margin-right: 8px;
        }
        
        /* ----- Confetti Container ----- */
        .confetti-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9999;
            overflow: hidden;
        }
        
        .confetti-container .confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            animation: confettiFall linear forwards;
        }
        
        @keyframes confettiFall {
            0% { transform: translateY(-10px) rotate(0deg); opacity: 1; }
            100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
        }
        
        /* ----- Toast Message ----- */
        .toast-message {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            padding: 12px 24px;
            border-radius: var(--radius-md);
            font-weight: 600;
            font-size: 0.9rem;
            z-index: 99999;
            max-width: 90%;
            text-align: center;
            box-shadow: var(--shadow-lg);
            animation: slideDown 0.4s ease;
        }
        
        @keyframes slideDown {
            0% { opacity: 0; transform: translateX(-50%) translateY(-20px); }
            100% { opacity: 1; transform: translateX(-50%) translateY(0); }
        }
        
        .toast-success {
            background: var(--text-success);
            color: #fff;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 400px) {
            .success-card {
                padding: var(--spacing-lg) var(--spacing-md);
            }
            
            .success-card .success-title {
                font-size: 1.2rem;
            }
            
            .success-card .success-icon {
                width: 72px;
                height: 72px;
                font-size: 36px;
            }
            
            .success-card .student-id-display .id-number {
                font-size: 1.2rem;
            }
            
            .success-card .user-details {
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }
            
            .success-card .user-details .detail-item .detail-value {
                font-size: 0.75rem;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    MOBILE HEADER (Built-in)
    ============================================================ -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:10px 14px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; flex-wrap:wrap; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
                <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                <div>
                    <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); updateThemeToggle();" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 8px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon" id="themeIconMobile"></i>
            </button>
        </div>
    </header>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <main class="main-content" style="padding:0; min-height:auto;">
        <div class="success-container">

            <!-- ===== SUCCESS CARD ===== -->
            <div class="success-card">
                
                <!-- Success Icon -->
                <div class="success-icon">
                    <i class="fas fa-check"></i>
                </div>
                
                <!-- Title -->
                <h1 class="success-title">🎉 Welcome, <%= user && user.firstName ? user.firstName : 'Student' %>!</h1>
                <p class="success-subtitle">Your email has been verified successfully!</p>
                
                <!-- Student ID Display -->
                <div class="student-id-display">
                    <div class="label"><i class="fas fa-id-card"></i> Your Student ID</div>
                    <div class="id-number"><%= user && user.studentId ? user.studentId : 'SLC-2026-***-***' %></div>
                    <div class="id-sub">Use this ID to login to your dashboard</div>
                </div>
                
                <!-- User Details -->
                <div class="user-details">
                    <div class="detail-item">
                        <div class="detail-icon"><i class="fas fa-user"></i></div>
                        <div class="detail-label">Name</div>
                        <div class="detail-value"><%= user && user.firstName ? user.firstName + ' ' + (user.lastName || '') : 'Student' %></div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-icon"><i class="fas fa-graduation-cap"></i></div>
                        <div class="detail-label">Course</div>
                        <div class="detail-value"><%= user && user.courseName ? user.courseName : 'Not Assigned' %></div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-icon"><i class="fas fa-envelope"></i></div>
                        <div class="detail-label">Email</div>
                        <div class="detail-value email-value"><%= user && user.email ? user.email : 'Loading...' %></div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-icon"><i class="fas fa-check-circle"></i></div>
                        <div class="detail-label">Status</div>
                        <div class="detail-value verified">✅ Verified</div>
                    </div>
                </div>
                
                <!-- Dashboard Button -->
                <a href="/dashboard" class="btn-dashboard">
                    <i class="fas fa-arrow-right"></i> Go to Dashboard
                </a>
                
            </div>

        </div>
    </main>

    <!-- ============================================================
    CONFETTI ANIMATION
    ============================================================ -->
    <div class="confetti-container" id="confettiContainer"></div>

    <!-- ============================================================
    MOBILE FOOTER (Built-in)
    ============================================================ -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:16px 0; margin-top:16px;">
        <div style="max-width:480px; margin:0 auto; padding:0 16px;">
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:6px 12px; margin-bottom:10px;">
                <a href="/" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">Home</a>
                <a href="/about" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">About</a>
                <a href="/faq" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">FAQ</a>
                <a href="/services" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">Services</a>
                <a href="/contact" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">Contact</a>
                <a href="/terms" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">Terms</a>
                <a href="/privacy" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.7rem;">Privacy</a>
            </div>
            <div style="text-align:center; font-size:0.6rem; color:rgba(255,255,255,0.5); border-top:1px solid rgba(255,255,255,0.1); padding-top:8px;">
                &copy; <%= new Date().getFullYear() %> SHINEX Learning Circle
            </div>
        </div>
    </footer>

    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:20px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:50px; height:50px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    🎉 Congratulations on verifying your email! I'm your SHINEX AI Tutor. Ask me anything about your courses!
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script>
        // ============================================================
        // THEME TOGGLE
        // ============================================================
        
        function updateThemeToggle() {
            const isDark = document.body.classList.contains('dark-mode');
            const icon = document.getElementById('themeIconMobile');
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }
        
        // ============================================================
        // CONFETTI ANIMATION
        // ============================================================
        
        function createConfetti() {
            const container = document.getElementById('confettiContainer');
            const colors = ['#8B5CF6', '#6a3dcf', '#a78bfa', '#27ae60', '#f39c12', '#e74c3c', '#3498db', '#1abc9c', '#9b59b6', '#2ecc71'];
            
            for (let i = 0; i < 60; i++) {
                const confetti = document.createElement('div');
                confetti.className = 'confetti';
                confetti.style.left = Math.random() * 100 + '%';
                confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
                confetti.style.width = (Math.random() * 8 + 4) + 'px';
                confetti.style.height = (Math.random() * 8 + 4) + 'px';
                confetti.style.animationDuration = (Math.random() * 2 + 2) + 's';
                confetti.style.animationDelay = (Math.random() * 2) + 's';
                confetti.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
                container.appendChild(confetti);
            }
            
            // Remove confetti after 5 seconds
            setTimeout(() => {
                container.innerHTML = '';
            }, 5000);
        }
        
        // ============================================================
        // WELCOME TOAST
        // ============================================================
        
        function showWelcomeToast() {
            const toast = document.createElement('div');
            toast.className = 'toast-message toast-success';
            toast.textContent = '🎉 Welcome to SHINEX Learning Circle!';
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(-50%) translateY(-20px)';
                toast.style.transition = 'all 0.4s ease';
                setTimeout(() => toast.remove(), 400);
            }, 4000);
        }
        
        // ============================================================
        // AI BOT
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const botBtn = document.getElementById('aiBotBtn');
            const chatModal = document.getElementById('aiChatModal');
            const chatClose = document.getElementById('aiChatClose');
            const chatInput = document.getElementById('aiChatInput');
            const chatSend = document.getElementById('aiChatSend');
            const chatMessages = document.getElementById('aiChatMessages');
            
            if (!botBtn || !chatModal) return;
            
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
            
            if (chatClose) {
                chatClose.addEventListener('click', function() {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                });
            }
            
            document.addEventListener('click', function(e) {
                if (chatModal.classList.contains('open')) {
                    if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                        chatModal.classList.remove('open');
                        chatModal.style.display = 'none';
                    }
                }
            });
            
            function addChatMessage(text, type) {
                const div = document.createElement('div');
                div.className = 'ai-chat-msg ' + type;
                let formatted = text;
                formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\n/g, '<br>');
                div.innerHTML = formatted;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            
            function sendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;
                
                addChatMessage(message, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                chatSend.disabled = true;
                
                const loadingMsg = document.createElement('div');
                loadingMsg.className = 'ai-chat-msg bot';
                loadingMsg.innerHTML = '⏳ Thinking...';
                loadingMsg.id = 'aiChatLoading';
                chatMessages.appendChild(loadingMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                fetch('/api/ai-tutor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userPrompt: message })
                })
                .then(response => response.json())
                .then(data => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    
                    if (data.error) {
                        addChatMessage('❌ ' + data.error, 'bot');
                    } else {
                        addChatMessage(data.answer, 'bot');
                    }
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                    chatInput.focus();
                })
                .catch(error => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                });
            }
            
            if (chatSend) {
                chatSend.addEventListener('click', sendMessage);
            }
            
            if (chatInput) {
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            }
        });
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
            updateThemeToggle();
        }
        
        // ============================================================
        // INITIALIZE
        // ============================================================
        
        // Trigger confetti
        createConfetti();
        
        // Show welcome toast after 1 second
        setTimeout(showWelcomeToast, 1000);
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('🎉 SHINEX Verification Success');
        console.log('👤 Welcome, <%= user && user.firstName ? user.firstName : "Student" %>!');
        console.log('🆔 Student ID: <%= user && user.studentId ? user.studentId : "N/A" %>');
        console.log('📚 Course: <%= user && user.courseName ? user.courseName : "Not Assigned" %>');
        console.log('🤖 AI Tutor ready to help!');
    </script>

</body>
</html>