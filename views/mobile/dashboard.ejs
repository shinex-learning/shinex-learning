<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Dashboard – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .mobile-dash-card {
            background: #fff;
            border-radius: 12px;
            padding: 14px 16px;
            border: 1px solid #ede8f5;
            margin-bottom: 10px;
        }
        body.dark-mode .mobile-dash-card {
            background: #1a1a1a;
            border-color: #333;
        }
        .mobile-dash-card .label {
            font-size: 0.6rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }
        .mobile-dash-card .value {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-dark);
        }
        body.dark-mode .mobile-dash-card .value {
            color: var(--text-light);
        }
        .mobile-dash-card .value-primary {
            color: #8B5CF6;
            font-weight: 700;
        }
        .mobile-stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
            margin-bottom: 10px;
        }
        .mobile-stat-item {
            background: var(--primary-bg);
            border-radius: 8px;
            padding: 10px;
            text-align: center;
        }
        body.dark-mode .mobile-stat-item {
            background: #2a1a4a;
        }
        .mobile-stat-item .stat-number {
            font-size: 1.2rem;
            font-weight: 800;
            color: #8B5CF6;
        }
        .mobile-stat-item .stat-label {
            font-size: 0.6rem;
            color: var(--text-muted);
        }
        body.dark-mode .mobile-stat-item .stat-label {
            color: var(--text-muted-light);
        }
        .mobile-info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        .mobile-info-grid .info-item {
            padding: 6px 0;
        }
        .mobile-info-grid .info-item .label {
            font-size: 0.55rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .mobile-info-grid .info-item .value {
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-dark);
        }
        body.dark-mode .mobile-info-grid .info-item .value {
            color: var(--text-light);
        }
        .mobile-info-grid .info-item .value-primary {
            color: #8B5CF6;
        }
        .badge-mobile {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.6rem;
            font-weight: 600;
        }
        .badge-mobile-purple {
            background: var(--primary-bg);
            color: #8B5CF6;
        }
        .badge-mobile-gold {
            background: #fef9e7;
            color: #f39c12;
        }
        body.dark-mode .badge-mobile-gold {
            background: #2a1a0a;
            color: #f39c12;
        }
        .badge-mobile-green {
            background: #d5f5e3;
            color: #27ae60;
        }
        body.dark-mode .badge-mobile-green {
            background: #1a3a2a;
            color: #7dcea0;
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <!-- ===== WELCOME CARD ===== -->
            <div style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); border-radius:12px; padding:16px 18px; color:#fff; margin-bottom:12px;">
                <div style="font-size:1.1rem; font-weight:700;">👋 Welcome, <%= user ? user.firstName : 'Student' %>!</div>
                <div style="font-size:0.75rem; color:#d4c4f0; margin-top:2px;">
                    <i class="fas fa-id-card"></i> <strong><%= user ? user.studentId : '—' %></strong>
                </div>
                <div style="font-size:0.7rem; color:#d4c4f0; margin-top:2px;">
                    <i class="fas fa-book-open"></i> <%= user ? user.courseName || 'Not enrolled' : 'Not enrolled' %>
                </div>
                <div style="margin-top:4px;">
                    <span class="badge-mobile badge-mobile-gold" style="background:rgba(255,255,255,0.2); color:#fff;">
                        <i class="fas fa-user-graduate"></i> <%= user ? user.learningLevel || 'Beginner' : 'Beginner' %>
                    </span>
                </div>
            </div>

            <!-- ===== STUDENT ID & INFO CARD ===== -->
            <div class="mobile-dash-card">
                <div style="margin-bottom:8px;">
                    <div style="font-size:0.6rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px;">Student ID</div>
                    <div style="font-size:1.1rem; font-weight:700; color:#8B5CF6;"><%= user ? user.studentId : '—' %></div>
                </div>
                <div class="mobile-info-grid">
                    <div class="info-item">
                        <div class="label">Full Name</div>
                        <div class="value"><%= user ? user.firstName + ' ' + user.lastName : '—' %></div>
                    </div>
                    <div class="info-item">
                        <div class="label">Course</div>
                        <div class="value"><%= user ? user.courseName || '—' : '—' %></div>
                    </div>
                    <div class="info-item">
                        <div class="label">Level</div>
                        <div class="value"><%= user ? user.learningLevel || '—' : '—' %></div>
                    </div>
                    <div class="info-item">
                        <div class="label">Email</div>
                        <div class="value"><%= user ? user.email : '—' %></div>
                    </div>
                </div>
            </div>

            <!-- ===== STATS ===== -->
            <div class="mobile-stats-grid">
                <div class="mobile-stat-item">
                    <div class="stat-number"><%= courses ? courses.length : 0 %></div>
                    <div class="stat-label">Courses</div>
                </div>
                <div class="mobile-stat-item">
                    <div class="stat-number">
                        <% let tc = 0; if (courses) { courses.forEach(c => { if (c.levels) { c.levels.forEach(l => { if (l.lessons) { l.lessons.forEach(ls => { if (ls.classes) tc += ls.classes.length; }); } }); } }); } %><%= tc %>
                    </div>
                    <div class="stat-label">Classes</div>
                </div>
                <div class="mobile-stat-item">
                    <div class="stat-number"><%= user && user.progress ? Object.keys(user.progress).length : 0 %></div>
                    <div class="stat-label">Completed</div>
                </div>
            </div>

            <!-- ===== ENROLLED COURSE ===== -->
            <% if (enrolledCourse) { %>
                <div class="mobile-dash-card" style="border-left:4px solid #8B5CF6;">
                    <div style="font-weight:700; font-size:0.95rem; color:var(--text-dark);">
                        <i class="fas fa-book-open" style="color:#8B5CF6;"></i> <%= enrolledCourse.title %>
                    </div>
                    <div style="font-size:0.7rem; color:var(--text-muted); margin-top:2px;">
                        <span class="badge-mobile badge-mobile-purple"><%= enrolledCourse.level %></span>
                        <span style="margin-left:6px;"><i class="far fa-clock"></i> <%= enrolledCourse.duration %></span>
                    </div>
                    <div style="margin-top:8px;">
                        <div style="display:flex; justify-content:space-between; font-size:0.7rem; font-weight:500; color:var(--text-dark);">
                            <span>Progress</span>
                            <span><%= progress %>%</span>
                        </div>
                        <div class="progress-wrap" style="height:6px; margin-top:2px;">
                            <div class="progress-fill" style="width:<%= progress %>%; height:100%;"></div>
                        </div>
                        <div style="font-size:0.7rem; color:var(--text-muted); margin-top:3px;">
                            <i class="fas fa-star" style="color:#f39c12;"></i> Score: <strong><%= score %></strong>
                            <span style="float:right;"><%= completedClasses %>/<%= totalClasses %> done</span>
                        </div>
                    </div>
                    <a href="/course/<%= enrolledCourse.id %>" class="btn btn-primary btn-sm" style="width:100%; text-align:center; margin-top:8px; font-size:0.8rem; padding:8px;">
                        <i class="fas fa-arrow-right"></i> Continue Learning
                    </a>
                </div>
            <% } else { %>
                <div class="mobile-dash-card" style="text-align:center; padding:20px 16px;">
                    <div style="font-size:2rem; color:var(--text-muted);"><i class="fas fa-book-open"></i></div>
                    <p style="font-weight:600; color:var(--text-dark); margin:4px 0;">No Course Enrolled</p>
                    <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 8px;">Browse our courses and start learning.</p>
                    <a href="/" class="btn btn-primary btn-sm" style="width:100%; text-align:center;">Browse Courses</a>
                </div>
            <% } %>

            <!-- ===== ALL COURSES ===== -->
            <div style="margin-top:4px;">
                <div style="font-weight:600; font-size:0.85rem; color:var(--text-dark); margin-bottom:6px;">
                    <i class="fas fa-list-ul" style="color:#8B5CF6;"></i> All Courses
                </div>
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(function(c) { %>
                        <a href="/course/<%= c.id %>" style="text-decoration:none; color:inherit;">
                            <div style="background:#f8f6fc; border-radius:8px; padding:10px 14px; margin-bottom:4px; border:1px solid #ede8f5;">
                                <div style="font-weight:600; font-size:0.85rem; color:var(--text-dark);"><%= c.title %></div>
                                <div style="font-size:0.7rem; color:var(--text-muted);"><i class="far fa-clock"></i> <%= c.duration %></div>
                            </div>
                        </a>
                    <% }); %>
                <% } else { %>
                    <p style="color:var(--text-muted); font-size:0.8rem;">No courses available.</p>
                <% } %>
            </div>

        </div>
    </main>

    <%- include('../partials/footer-mobile') %>

    <script src="/js/script.js"></script>
</body>
</html>