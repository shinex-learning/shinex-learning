<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Dashboard – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <!-- Welcome -->
            <div style="background:linear-gradient(135deg, var(--primary), var(--primary-dark)); border-radius:12px; padding:16px 18px; color:#fff; margin-bottom:12px;">
                <div style="font-size:1.1rem; font-weight:700;">👋 Welcome!</div>
                <div style="font-size:0.8rem; color:#d4c4f0;">Explore our courses and start learning.</div>
            </div>

            <!-- Stats -->
            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:12px;">
                <div style="background:#f8f6fc; border-radius:8px; padding:10px; text-align:center;">
                    <div style="font-size:1.2rem; font-weight:800; color:var(--primary);"><%= courses ? courses.length : 0 %></div>
                    <div style="font-size:0.6rem; color:var(--text-muted);">Courses</div>
                </div>
                <div style="background:#f8f6fc; border-radius:8px; padding:10px; text-align:center;">
                    <div style="font-size:1.2rem; font-weight:800; color:var(--primary);">
                        <% let tc = 0; if (courses) { courses.forEach(c => { if (c.levels) { c.levels.forEach(l => { if (l.lessons) { l.lessons.forEach(ls => { if (ls.classes) tc += ls.classes.length; }); } }); } }); } %><%= tc %>
                    </div>
                    <div style="font-size:0.6rem; color:var(--text-muted);">Classes</div>
                </div>
                <div style="background:#f8f6fc; border-radius:8px; padding:10px; text-align:center;">
                    <div style="font-size:1.2rem; font-weight:800; color:var(--primary);">6</div>
                    <div style="font-size:0.6rem; color:var(--text-muted);">Topics</div>
                </div>
            </div>

            <!-- Featured Course -->
            <div style="background:#fff; border-radius:12px; padding:14px 16px; border:1px solid #ede8f5; margin-bottom:12px;">
                <div style="font-weight:700; font-size:0.95rem; color:var(--text-dark);">
                    <i class="fas fa-book-open" style="color:var(--primary);"></i> Cybersecurity
                </div>
                <div style="font-size:0.75rem; color:var(--text-muted);">Beginner • 4 hours</div>
                <a href="/course/course1" class="btn btn-primary btn-sm" style="width:100%; text-align:center; margin-top:6px; font-size:0.8rem; padding:8px;">Continue Learning</a>
            </div>

            <!-- Course List -->
            <div style="font-weight:600; font-size:0.9rem; color:var(--text-dark); margin-bottom:6px;">All Courses</div>
            <% if (courses && courses.length > 0) { %>
                <% courses.forEach(function(c) { %>
                    <a href="/course/<%= c.id %>" style="text-decoration:none; color:inherit;">
                        <div style="background:#f8f6fc; border-radius:8px; padding:10px 14px; margin-bottom:4px; border:1px solid #ede8f5;">
                            <div style="font-weight:600; font-size:0.85rem; color:var(--text-dark);"><%= c.title %></div>
                            <div style="font-size:0.7rem; color:var(--text-muted);"><i class="far fa-clock"></i> <%= c.duration %></div>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <p style="color:var(--text-muted); font-size:0.8rem;">No courses available.</p>
            <% } %>

            <%- include(getAdBox()) %>
        </div>
    </main>

    <%- include(getFooter()) %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; font-size:20px;"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hi! Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>