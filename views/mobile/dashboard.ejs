<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Dashboard – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-dash-container {
            padding: 12px 12px 24px;
            max-width: 500px;
            margin: 0 auto;
        }
        .mobile-welcome {
            padding: 18px 16px !important;
            border-radius: 14px !important;
            margin-bottom: 16px !important;
        }
        .mobile-welcome h1 {
            font-size: 1.2rem !important;
            margin: 0 !important;
        }
        .mobile-welcome p {
            font-size: 0.8rem !important;
            margin: 4px 0 0 !important;
        }
        .mobile-welcome .student-id {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            padding: 2px 10px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.75rem;
        }
        .mobile-stats {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            gap: 8px;
            margin-bottom: 16px;
        }
        .mobile-stats .stat-box {
            padding: 10px 6px !important;
            border-radius: 10px !important;
        }
        .mobile-stats .stat-box .stat-number {
            font-size: 1.2rem !important;
        }
        .mobile-stats .stat-box .stat-label {
            font-size: 0.6rem !important;
        }
        .mobile-progress {
            margin-bottom: 16px;
        }
        .mobile-progress .progress-label {
            font-size: 0.8rem !important;
        }
        .mobile-course-card {
            padding: 14px 14px !important;
            border-radius: 12px !important;
            margin-bottom: 12px !important;
        }
        .mobile-course-card h3 {
            font-size: 1rem !important;
            margin: 0 0 4px !important;
        }
        .mobile-course-card p {
            font-size: 0.82rem !important;
            margin: 0 0 8px !important;
        }
        .mobile-course-card .btn {
            font-size: 0.82rem !important;
            padding: 8px 16px !important;
            min-height: 38px !important;
        }
        .mobile-section-title {
            font-size: 1.1rem !important;
            font-weight: 700 !important;
            margin: 16px 0 6px !important;
        }
        .mobile-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .mobile-grid-2 .course-card {
            padding: 12px !important;
            border-radius: 10px !important;
        }
        .mobile-grid-2 .course-card h4 {
            font-size: 0.82rem !important;
            margin: 0 0 2px !important;
        }
        .mobile-grid-2 .course-card .btn {
            font-size: 0.7rem !important;
            padding: 6px !important;
            min-height: 32px !important;
            width: 100%;
        }
        .mobile-quick-links {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid #ede8f5;
        }
        .mobile-quick-links .btn {
            font-size: 0.75rem !important;
            padding: 6px 12px !important;
            min-height: 32px !important;
        }
        body.dark-mode .mobile-quick-links {
            border-color: var(--dark-border);
        }
        .btn-change-course {
            background: rgba(255,255,255,0.2);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.3);
            font-size: 0.75rem !important;
            padding: 4px 12px !important;
            min-height: 30px !important;
            border-radius: 20px !important;
        }
        .btn-change-course:hover {
            background: rgba(255,255,255,0.3);
        }
        @media (max-width: 400px) {
            .mobile-stats {
                grid-template-columns: 1fr 1fr;
            }
            .mobile-grid-2 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: false }) %>

    <main class="main-content">
        <div class="mobile-dash-container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success" style="font-size:0.82rem; padding:10px 14px; border-radius:8px; margin-bottom:12px;"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger" style="font-size:0.82rem; padding:10px 14px; border-radius:8px; margin-bottom:12px;"><%= messages.error %></div>
            <% } %>

            <!-- Welcome Card -->
            <div class="welcome-card card-purple mobile-welcome">
                <div style="display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center;">
                    <div>
                        <h1>👋 Hi, <%= user.firstName %>!</h1>
                        <p>
                            <span class="student-id"><%= user.studentId %></span>
                            <span style="margin-left:6px;"><%= user.courseName || 'Not enrolled' %></span>
                        </p>
                    </div>
                    <div style="margin-top:6px;">
                        <a href="/enroll" class="btn-change-course">
                            <i class="fas fa-exchange-alt"></i> Change
                        </a>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="mobile-stats">
                <div class="stat-box">
                    <div class="stat-number"><%= totalClasses || 0 %></div>
                    <div class="stat-label">Classes</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number"><%= completedClasses || 0 %></div>
                    <div class="stat-label">Done</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number"><%= progress || 0 %>%</div>
                    <div class="stat-label">Progress</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number"><%= score || 0 %></div>
                    <div class="stat-label">Points</div>
                </div>
            </div>

            <!-- Progress -->
            <div class="mobile-progress">
                <div class="progress-label" style="display:flex; justify-content:space-between; font-weight:600; font-size:0.8rem;">
                    <span>Course Progress</span>
                    <span><%= progress || 0 %>%</span>
                </div>
                <div class="progress-wrap" style="height:8px; border-radius:10px;">
                    <div class="progress-fill" style="width:<%= progress || 0 %>%; border-radius:10px;"></div>
                </div>
            </div>

            <!-- Enrolled Course -->
            <% if (enrolledCourse) { %>
                <h3 class="mobile-section-title">Your Course</h3>
                <div class="course-card mobile-course-card" style="border-color:var(--primary);">
                    <div style="display:flex; justify-content:space-between; align-items:start; flex-wrap:wrap;">
                        <h3><%= enrolledCourse.title %></h3>
                        <span class="badge badge-purple" style="font-size:0.6rem;"><%= enrolledCourse.level || 'Beginner' %></span>
                    </div>
                    <p><%= enrolledCourse.description ? enrolledCourse.description.substring(0,80) : '' %></p>
                    <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:8px;">
                        <span class="badge badge-dark" style="font-size:0.6rem;"><i class="far fa-clock"></i> <%= enrolledCourse.duration || 'Self-paced' %></span>
                        <span class="badge badge-green" style="font-size:0.6rem;"><i class="fas fa-check-circle"></i> <%= progress || 0 %>%</span>
                    </div>
                    <a href="/course/<%= enrolledCourse.id %>" class="btn btn-primary" style="width:100%;">
                        <i class="fas fa-arrow-right"></i> Continue Learning
                    </a>
                </div>
            <% } else { %>
                <div class="empty-state" style="padding:24px; border-radius:12px;">
                    <span class="empty-icon">📖</span>
                    <h3 style="font-size:1rem;">No course enrolled</h3>
                    <p style="font-size:0.85rem;">Browse our courses and start learning!</p>
                    <a href="/courses" class="btn btn-primary" style="margin-top:8px; width:100%;">
                        <i class="fas fa-search"></i> Explore Courses
                    </a>
                </div>
            <% } %>

            <!-- Other Courses -->
            <% if (enrolledCourse) { %>
                <h3 class="mobile-section-title">More Courses</h3>
                <div class="mobile-grid-2">
                    <% courses.slice(0,4).forEach(c => { %>
                        <% if (!enrolledCourse || c.id !== enrolledCourse.id) { %>
                            <div class="course-card" style="padding:12px;">
                                <h4><%= c.title %></h4>
                                <p style="font-size:0.7rem; color:var(--text-muted); margin:0 0 6px;"><%= c.description ? c.description.substring(0,40)+'...' : '' %></p>
                                <a href="/course/<%= c.id %>" class="btn btn-secondary btn-sm">View</a>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
            <% } %>

            <!-- Quick Links -->
            <div class="mobile-quick-links">
                <a href="/settings" class="btn btn-secondary btn-sm"><i class="fas fa-cog"></i> Settings</a>
                <a href="/faq" class="btn btn-secondary btn-sm"><i class="fas fa-question-circle"></i> FAQ</a>
                <a href="/contact" class="btn btn-secondary btn-sm"><i class="fas fa-headset"></i> Help</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer-mobile') %>
    <script src="/js/main.js"></script>
</body>
</html>