<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>FAQ – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-faq-container { padding: 12px 12px 24px; max-width: 500px; margin: 0 auto; }
        .mobile-faq-card { padding: 16px 14px !important; border-radius: 12px !important; margin-bottom: 8px !important; background: var(--bg-light) !important; border: 1px solid #ede8f5 !important; }
        .mobile-faq-item { border-bottom: 1px solid #ede8f5; padding: 12px 0; }
        .mobile-faq-item:last-child { border-bottom: none; }
        .mobile-faq-question { font-weight: 700; font-size: 0.9rem; color: var(--text-dark); cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 4px 0; gap: 8px; }
        .mobile-faq-question:hover { color: #8B5CF6; }
        .mobile-faq-question i { transition: transform 0.3s ease; flex-shrink: 0; font-size: 0.85rem; color: var(--text-muted); }
        .mobile-faq-question i.rotated { transform: rotate(180deg); }
        .mobile-faq-answer { color: var(--text-muted); font-size: 0.85rem; line-height: 1.7; margin-top: 6px; display: none; padding-right: 4px; }
        .mobile-faq-answer.open { display: block; }
        .mobile-faq-answer a { color: #8B5CF6; font-weight: 600; text-decoration: none; }
        .mobile-faq-cta { text-align: center; padding: 16px; background: #f0ebfb; border-radius: 12px; margin-top: 8px; }
        .mobile-faq-cta h4 { font-size: 0.95rem !important; margin: 0 0 4px !important; color: var(--text-dark); }
        .mobile-faq-cta p { font-size: 0.82rem !important; color: var(--text-muted); margin: 0 0 10px !important; }
        .mobile-faq-cta .btn { width: 100%; font-size: 0.85rem !important; padding: 10px !important; min-height: 44px !important; border-radius: 30px !important; background: #8B5CF6 !important; color: #fff !important; border: none !important; text-decoration: none; display: block; text-align: center; }
        body.dark-mode .mobile-faq-card { background: var(--dark-card) !important; border-color: var(--dark-border) !important; }
        body.dark-mode .mobile-faq-item { border-color: var(--dark-border) !important; }
        body.dark-mode .mobile-faq-question { color: var(--text-light) !important; }
        body.dark-mode .mobile-faq-cta { background: #1a1a1a !important; }
    </style>
</head>
<body>
    <!-- ===== MOBILE HEADER ===== -->
    <header class="header" style="padding:8px 12px; flex-wrap:nowrap;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="javascript:history.back()" class="back-btn" style="font-size:0.75rem; padding:4px 8px; color:rgba(255,255,255,0.9); text-decoration:none; display:flex; align-items:center; gap:4px;"><i class="fas fa-arrow-left"></i></a>
            <a href="/" class="logo-container" style="gap:8px; text-decoration:none;">
                <div class="logo" style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:10px;">SLC</div>
                <div style="line-height:1.1;">
                    <div class="logo-text" style="font-size:13px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div class="logo-sub" style="font-size:6px; color:rgba(255,255,255,0.7);">LEARNING</div>
                </div>
            </a>
        </div>
        <div class="header-actions" style="gap:4px; flex-wrap:nowrap;">
            <button class="dark-toggle" id="darkToggleMobile" onclick="toggleDarkModeMobile()" style="padding:4px 8px; font-size:1rem; background:rgba(255,255,255,0.15); border:none; border-radius:30px; color:#fff; cursor:pointer;">🌙</button>
        </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="mobile-faq-container">
            <h2 style="font-size:1.3rem; font-weight:800; margin:0 0 2px; color:var(--text-dark);">❓ FAQ</h2>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">Find quick answers to common questions.</p>

            <div class="card mobile-faq-card">

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>What is SHINEX Learning Circle?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">SHINEX Learning Circle (SLC) is a Nigerian-based online learning platform offering practical courses in technology, design, and business.</div>
                </div>

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>How do I register?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">Click the <strong>Register</strong> button, fill in your details, choose your course, and set a password. You'll receive a verification email with your Student ID.</div>
                </div>

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>What is my Student ID?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">Your Student ID is a unique identifier in the format <strong>SLC-2026-XX-XXX</strong>. It is automatically generated during registration.</div>
                </div>

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>What courses do you offer?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">We offer 10 courses: Cybersecurity, Data Analysis, Digital Marketing, Graphic Design, Motion Design, Networking, Programming, UI/UX Design, Web Development, and WordPress Development.</div>
                </div>

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>Is it free?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">Yes! Currently all courses are completely free. We believe in making quality education accessible to everyone.</div>
                </div>

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>How do I track my progress?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">Your <strong>Dashboard</strong> shows your overall progress, completed classes, and points earned. Complete a class to earn +10 points.</div>
                </div>

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>Forgot my password?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">You can log in using your <strong>email address</strong>. If you've forgotten your password, contact us at <a href="/contact">support@shinex.ng</a>.</div>
                </div>

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>Can I change my course?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">Yes! Go to your <strong>Dashboard</strong> and click the <strong>Change Course</strong> button. Your progress will reset for the new course.</div>
                </div>

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>How do I contact support?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">Visit the <a href="/contact">Contact page</a> to send us a message. You can also email us at <strong>support@shinex.ng</strong> or call <strong>+234 800 SHINEX</strong>.</div>
                </div>

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>What is the AI Tutor?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">The AI Tutor is a floating chat button on every page. You can ask it questions about your courses, technology, or careers.</div>
                </div>

                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)"><span>Is my data safe?</span><i class="fas fa-chevron-down"></i></div>
                    <div class="mobile-faq-answer">Yes! All passwords are hashed using bcrypt. Read our <a href="/privacy">Privacy Policy</a> for more details.</div>
                </div>

            </div>

            <div class="mobile-faq-cta">
                <h4>📧 Still have questions?</h4>
                <p>We're here to help. Reach out to us anytime.</p>
                <a href="/contact" class="btn"><i class="fas fa-envelope"></i> Contact Support</a>
            </div>
        </div>
    </main>

    <!-- ===== MOBILE FOOTER ===== -->
    <footer class="footer" style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div class="container">
            <div style="text-align:center;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:6px;">
                    <div class="logo" style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div><div class="logo-text" style="font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div></div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:4px 0 8px;">Learn. Understand. Protect.</p>
                <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px 16px; margin:12px 0;">
                    <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Home</a>
                    <a href="/courses" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Courses</a>
                    <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Services</a>
                    <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">About</a>
                    <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Contact</a>
                    <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">FAQ</a>
                </div>
                <div style="display:flex; justify-content:center; gap:12px; margin:8px 0 12px;">
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-twitter"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-instagram"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-whatsapp"></i></a>
                </div>
                <div class="footer-bottom" style="border-top:1px solid rgba(255,255,255,0.1); padding-top:10px; font-size:0.7rem; color:rgba(255,255,255,0.6);">&copy; <%= new Date().getFullYear() %> SHINEX Learning Circle</div>
            </div>
        </div>
    </footer>

    <!-- ===== AI BOT ===== -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:26px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">🤖<span class="ai-bot-pulse" style="position:absolute; width:60px; height:60px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span></button>
    </div>
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:#fff; border-radius:14px; border:1px solid #ede8f5; box-shadow:0 20px 60px rgba(0,0,0,0.15); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:#8B5CF6; color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px;">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:10px; font-size:0.9rem; max-width:85%; line-height:1.5; background:#f0ebfb; color:#1A0A2E; align-self:flex-start; border-bottom-left-radius:4px;">👋 Hi! I'm your SHINEX AI Tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid #ede8f5; display:flex; gap:8px;">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:8px; border:1px solid #ede8f5; font-size:0.85rem;">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:30px; background:#8B5CF6; color:#fff; font-weight:600; cursor:pointer;">Send</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js"></script>
    <script src="/js/main.js"></script>
    <script>
        function toggleFaq(element) {
            const answer = element.nextElementSibling;
            const icon = element.querySelector('i');
            answer.classList.toggle('open');
            icon.classList.toggle('rotated');
        }
        function toggleDarkModeMobile() {
            const body = document.body;
            body.classList.toggle('dark-mode');
            const isDark = body.classList.contains('dark-mode');
            localStorage.setItem('shinex-dark-mode', isDark);
            const btn = document.getElementById('darkToggleMobile');
            if (btn) btn.textContent = isDark ? '☀️' : '🌙';
        }
        document.addEventListener('DOMContentLoaded', function() {
            const savedDark = localStorage.getItem('shinex-dark-mode');
            if (savedDark === 'true') {
                document.body.classList.add('dark-mode');
                const btn = document.getElementById('darkToggleMobile');
                if (btn) btn.textContent = '☀️';
            }
        });
    </script>
</body>
</html>