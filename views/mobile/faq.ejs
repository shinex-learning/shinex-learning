<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>FAQ – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-faq-container {
            padding: 12px 12px 24px;
            max-width: 500px;
            margin: 0 auto;
        }
        .mobile-faq-card {
            padding: 16px 14px !important;
            border-radius: 12px !important;
            margin-bottom: 8px !important;
        }
        .mobile-faq-item {
            border-bottom: 1px solid #ede8f5;
            padding: 12px 0;
        }
        body.dark-mode .mobile-faq-item {
            border-color: var(--dark-border);
        }
        .mobile-faq-item:last-child {
            border-bottom: none;
        }
        .mobile-faq-question {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-dark);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 0;
            gap: 8px;
        }
        body.dark-mode .mobile-faq-question {
            color: var(--text-light);
        }
        .mobile-faq-question:hover {
            color: var(--primary);
        }
        .mobile-faq-question i {
            transition: transform 0.3s ease;
            flex-shrink: 0;
            font-size: 0.85rem;
            color: var(--text-muted);
        }
        .mobile-faq-question i.rotated {
            transform: rotate(180deg);
        }
        .mobile-faq-answer {
            color: var(--text-muted);
            font-size: 0.85rem;
            line-height: 1.7;
            margin-top: 6px;
            display: none;
            padding-right: 4px;
        }
        .mobile-faq-answer.open {
            display: block;
        }
        .mobile-faq-answer a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }
        .mobile-faq-cta {
            text-align: center;
            padding: 16px;
            background: var(--primary-bg);
            border-radius: 12px;
            margin-top: 8px;
        }
        body.dark-mode .mobile-faq-cta {
            background: #1a1a1a;
        }
        .mobile-faq-cta h4 {
            font-size: 0.95rem !important;
            margin: 0 0 4px !important;
        }
        .mobile-faq-cta p {
            font-size: 0.82rem !important;
            color: var(--text-muted);
            margin: 0 0 10px !important;
        }
        .mobile-faq-cta .btn {
            width: 100%;
            font-size: 0.85rem !important;
            padding: 10px !important;
            min-height: 44px !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: true }) %>

    <main class="main-content">
        <div class="mobile-faq-container">
            <h2 style="font-size:1.3rem; font-weight:800; margin:0 0 2px;">❓ FAQ</h2>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">Find quick answers to common questions.</p>

            <div class="card mobile-faq-card">

                <!-- FAQ 1 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>What is SHINEX Learning Circle?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        SHINEX Learning Circle (SLC) is a Nigerian-based online learning platform offering practical courses in technology, design, and business. We provide hands-on training to help you build real-world skills.
                    </div>
                </div>

                <!-- FAQ 2 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>How do I register?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        Click the <strong>Register</strong> button, fill in your personal, contact, academic information, choose your course, and set a password. You'll receive a verification email with your unique Student ID.
                    </div>
                </div>

                <!-- FAQ 3 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>What is my Student ID?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        Your Student ID is a unique identifier in the format <strong>SLC-2026-XX-XXX</strong>. It is automatically generated during registration. You can use it to log in instead of your email.
                    </div>
                </div>

                <!-- FAQ 4 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>What courses do you offer?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        We offer 10 courses: Cybersecurity, Data Analysis, Digital Marketing, Graphic Design, Motion Design, Networking, Programming, UI/UX Design, Web Development, and WordPress Development.
                    </div>
                </div>

                <!-- FAQ 5 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>Is it free?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        Yes! Currently all courses are completely free. We believe in making quality education accessible to everyone.
                    </div>
                </div>

                <!-- FAQ 6 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>How do I track my progress?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        Your <strong>Dashboard</strong> shows your overall progress, completed classes, and points earned. Inside each level, you'll see a progress bar and class completion status. Complete a class to earn +10 points.
                    </div>
                </div>

                <!-- FAQ 7 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>Forgot my password?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        You can log in using your <strong>email address</strong> instead. If you've forgotten your password, contact us at <a href="/contact">support@shinex.ng</a> for assistance.
                    </div>
                </div>

                <!-- FAQ 8 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>Can I change my course?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        Yes! Go to your <strong>Dashboard</strong> and click the <strong>Change Course</strong> button. Your progress will reset for the new course.
                    </div>
                </div>

                <!-- FAQ 9 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>How do I contact support?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        Visit the <a href="/contact">Contact page</a> to send us a message. You can also email us at <strong>support@shinex.ng</strong> or call <strong>+234 800 SHINEX</strong>.
                    </div>
                </div>

                <!-- FAQ 10 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>Do I get a certificate?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        Not yet, but we are working on introducing certificates of completion. Stay tuned for updates!
                    </div>
                </div>

                <!-- FAQ 11 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>What is the AI Tutor?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        The AI Tutor is a floating chat button on every page. You can ask it questions about your courses, technology, or careers. It provides educational responses in real time.
                    </div>
                </div>

                <!-- FAQ 12 -->
                <div class="mobile-faq-item">
                    <div class="mobile-faq-question" onclick="toggleFaq(this)">
                        <span>Is my data safe?</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="mobile-faq-answer">
                        Yes! All passwords are hashed using bcrypt, and we follow best practices to protect your personal information. Read our <a href="/privacy">Privacy Policy</a> for more details.
                    </div>
                </div>

            </div>

            <!-- CTA -->
            <div class="mobile-faq-cta">
                <h4>📧 Still have questions?</h4>
                <p>We're here to help. Reach out to us anytime.</p>
                <a href="/contact" class="btn btn-primary">
                    <i class="fas fa-envelope"></i> Contact Support
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer-mobile') %>

    <script>
        function toggleFaq(element) {
            const answer = element.nextElementSibling;
            const icon = element.querySelector('i');
            answer.classList.toggle('open');
            icon.classList.toggle('rotated');
        }
    </script>

    <script src="/js/main.js"></script>
</body>
</html>