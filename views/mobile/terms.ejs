<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Terms & Conditions – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           MOBILE TERMS PAGE STYLES
           ============================================================ */
        
        .mobile-terms-container {
            padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-xl);
            max-width: 500px;
            margin: 0 auto;
        }
        
        /* ----- Page Header ----- */
        .page-header {
            margin-bottom: var(--spacing-md);
        }
        
        .page-header h1 {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--text-primary);
            margin: 0;
        }
        
        .page-header h1 i {
            color: var(--purple-primary);
        }
        
        .page-header .last-updated {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin: 2px 0 0 0;
        }
        
        .page-header .last-updated strong {
            color: var(--text-secondary);
        }
        
        /* ----- Terms Cards ----- */
        .terms-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-md);
            margin-bottom: var(--spacing-sm);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .terms-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        .terms-card .section-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--purple-primary);
            margin: 0 0 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .terms-card .section-title .section-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: var(--purple-bg);
            color: var(--purple-primary);
            font-size: 0.65rem;
            font-weight: 700;
            flex-shrink: 0;
        }
        
        .terms-card p {
            font-size: 0.82rem;
            line-height: 1.8;
            color: var(--text-secondary);
            margin: 0 0 6px 0;
        }
        
        .terms-card p:last-child {
            margin-bottom: 0;
        }
        
        .terms-card ul {
            padding-left: var(--spacing-md);
            margin: 4px 0 0 0;
        }
        
        .terms-card ul li {
            font-size: 0.82rem;
            line-height: 1.8;
            color: var(--text-secondary);
            margin-bottom: 2px;
        }
        
        .terms-card ul li strong {
            color: var(--text-primary);
        }
        
        .terms-card .contact-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-top: 4px;
        }
        
        .terms-card .contact-info .contact-row {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.82rem;
            color: var(--text-secondary);
        }
        
        .terms-card .contact-info .contact-row i {
            color: var(--purple-primary);
            width: 20px;
            text-align: center;
        }
        
        .terms-card .contact-info .contact-row a {
            color: var(--purple-primary);
            text-decoration: none;
            font-weight: 500;
        }
        
        .terms-card .contact-info .contact-row a:hover {
            text-decoration: underline;
        }
        
        .terms-card a {
            color: var(--purple-primary);
            text-decoration: none;
            font-weight: 500;
        }
        
        .terms-card a:hover {
            text-decoration: underline;
        }
        
        /* ----- Divider ----- */
        .terms-divider {
            height: 1px;
            background: var(--border-color);
            margin: var(--spacing-sm) 0;
        }
        
        /* ----- Back Link ----- */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.82rem;
            margin-top: var(--spacing-sm);
            padding: 6px 0;
            transition: all 0.3s ease;
        }
        
        .back-link:hover {
            color: var(--purple-primary);
        }
        
        .back-link i {
            font-size: 0.7rem;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 400px) {
            .page-header h1 {
                font-size: 1.1rem;
            }
            
            .terms-card .section-title {
                font-size: 0.88rem;
            }
            
            .terms-card p,
            .terms-card ul li {
                font-size: 0.78rem;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    MOBILE HEADER (Built-in)
    ============================================================ -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:10px 14px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; flex-wrap:wrap; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="javascript:history.back()" style="color:rgba(255,255,255,0.9); font-size:0.75rem; padding:4px 8px; text-decoration:none; display:flex; align-items:center; gap:4px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
                <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                <div>
                    <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); updateThemeToggle();" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 8px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon" id="themeIconMobile"></i>
            </button>
            <a href="/login" style="background:rgba(255,255,255,0.2); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
            <a href="/register" style="background:rgba(255,255,255,0.25); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-user-plus"></i> Register
            </a>
        </div>
    </header>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <main class="main-content">
        <div class="mobile-terms-container">

            <!-- ===== PAGE HEADER ===== -->
            <div class="page-header">
                <h1><i class="fas fa-file-contract"></i> Terms & Conditions</h1>
                <p class="last-updated">
                    <i class="far fa-calendar-alt"></i> 
                    <strong>Last Updated:</strong> August 2026
                </p>
            </div>

            <!-- ===== SECTION 1: ACCEPTANCE OF TERMS ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">1</span> Acceptance of Terms
                </div>
                <p>
                    By accessing or using SHINEX Learning Circle ("SLC", "we", "our", "us"), you agree to comply with and be bound by these Terms & Conditions. If you do not agree, you must not use our platform.
                </p>
                <p>
                    Your continued use of the platform constitutes your acceptance of these terms as they may be updated from time to time.
                </p>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 2: ACCOUNT REGISTRATION ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">2</span> Account Registration
                </div>
                <p>
                    To access certain features of SHINEX Learning Circle, you must create an account. You agree to:
                </p>
                <ul>
                    <li>Provide accurate and complete information during registration</li>
                    <li>Maintain the security and confidentiality of your password</li>
                    <li>Notify us immediately of any unauthorized use of your account</li>
                    <li>Be responsible for all activities that occur under your account</li>
                </ul>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 3: STUDENT ID ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">3</span> Student ID
                </div>
                <p>
                    Upon successful registration and email verification, you will be assigned a unique <strong>Student ID</strong> in the format:
                </p>
                <ul>
                    <li><strong>SLC-YYYY-XX-XXX</strong> (Year-CourseCode-StudentNumber)</li>
                </ul>
                <p>
                    This ID serves as your primary identifier on our platform. It is permanent and cannot be changed. Use it for login, tracking your progress, and all official communications.
                </p>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 4: COURSES AND LEARNING ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">4</span> Courses and Learning
                </div>
                <p>
                    All courses and learning materials provided on SHINEX Learning Circle are for educational purposes only.
                </p>
                <ul>
                    <li>Courses are designed to provide knowledge and practical skills</li>
                    <li>We do not guarantee employment, career advancement, or specific outcomes</li>
                    <li>You are responsible for your own learning journey and progress</li>
                    <li>Course content may be updated or modified at any time</li>
                </ul>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 5: USER CONDUCT ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">5</span> User Conduct
                </div>
                <p>You agree not to engage in any of the following prohibited activities:</p>
                <ul>
                    <li>Posting offensive, discriminatory, or inappropriate content</li>
                    <li>Attempting to cheat on tests, quizzes, or assessments</li>
                    <li>Impersonating other users or creating fake accounts</li>
                    <li>Using the platform for illegal or unauthorized purposes</li>
                    <li>Interfering with or disrupting platform functionality</li>
                    <li>Attempting to gain unauthorized access to other users' accounts</li>
                    <li>Distributing malware, viruses, or other harmful code</li>
                </ul>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 6: INTELLECTUAL PROPERTY ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">6</span> Intellectual Property
                </div>
                <p>
                    All content on SHINEX Learning Circle, including but not limited to:
                </p>
                <ul>
                    <li>Course materials, lessons, and classes</li>
                    <li>Text, graphics, logos, and images</li>
                    <li>Software, code, and platform design</li>
                    <li>Videos, audio, and other multimedia content</li>
                </ul>
                <p>
                    is the property of SHINEX Learning Circle or its licensors. You may not reproduce, distribute, modify, or create derivative works without explicit permission.
                </p>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 7: SERVICES ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">7</span> Services
                </div>
                <p>
                    In addition to our free courses, we offer various services including but not limited to:
                </p>
                <ul>
                    <li><strong>Registration Services</strong> – Assistance with academic registration</li>
                    <li><strong>Design Services</strong> – Graphic design, UI/UX, and creative work</li>
                    <li><strong>Campaign Services</strong> – Marketing and awareness campaigns</li>
                    <li><strong>Website Services</strong> – Web development and hosting</li>
                </ul>
                <p>
                    These services are subject to separate pricing and terms. We reserve the right to modify, suspend, or discontinue any service at any time.
                </p>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 8: PRIVACY ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">8</span> Privacy
                </div>
                <p>
                    Your privacy is important to us. Please review our <a href="/privacy">Privacy Policy</a> to understand how we collect, use, and protect your personal information.
                </p>
                <p>
                    By using SHINEX Learning Circle, you consent to the collection and use of your information as described in our Privacy Policy.
                </p>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 9: DISCLAIMER OF WARRANTIES ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">9</span> Disclaimer of Warranties
                </div>
                <p>
                    Our platform is provided <strong>"as is"</strong> and <strong>"as available"</strong>. We make no warranties of any kind, express or implied, including but not limited to:
                </p>
                <ul>
                    <li>The platform will be uninterrupted or error-free</li>
                    <li>All content is accurate, complete, or up-to-date</li>
                    <li>Particular outcomes or results from using the platform</li>
                </ul>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 10: LIMITATION OF LIABILITY ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">10</span> Limitation of Liability
                </div>
                <p>
                    To the fullest extent permitted by law, SHINEX Learning Circle shall not be liable for any:
                </p>
                <ul>
                    <li>Indirect, incidental, or consequential damages</li>
                    <li>Loss of data, revenue, or business opportunities</li>
                    <li>Damages arising from your use or inability to use the platform</li>
                    <li>Third-party content or services accessed through our platform</li>
                </ul>
                <p>
                    Our total liability to you shall not exceed the amount you have paid to us (if any) in the past 12 months.
                </p>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 11: TERMINATION ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">11</span> Termination
                </div>
                <p>
                    We reserve the right to suspend or terminate your account at any time, with or without notice, for:
                </p>
                <ul>
                    <li>Violation of these Terms & Conditions</li>
                    <li>Fraudulent or illegal activity</li>
                    <li>Non-compliance with our policies</li>
                </ul>
                <p>
                    You may also delete your account at any time via the <a href="/settings">Settings</a> page. Upon termination, your access to the platform will be revoked.
                </p>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 12: CHANGES TO TERMS ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">12</span> Changes to Terms
                </div>
                <p>
                    We may update these Terms & Conditions from time to time. We will notify you of any changes by:
                </p>
                <ul>
                    <li>Posting the updated terms on this page</li>
                    <li>Updating the "Last Updated" date</li>
                    <li>Sending an email notification (for significant changes)</li>
                </ul>
                <p>
                    Your continued use of the platform after changes are posted constitutes your acceptance of the updated terms.
                </p>
            </div>

            <div class="terms-divider"></div>

            <!-- ===== SECTION 13: CONTACT INFORMATION ===== -->
            <div class="terms-card">
                <div class="section-title">
                    <span class="section-number">13</span> Contact Information
                </div>
                <p>If you have any questions about these Terms & Conditions, please contact us:</p>
                <div class="contact-info">
                    <div class="contact-row">
                        <i class="fas fa-envelope"></i>
                        <a href="mailto:support@shinex.ng">support@shinex.ng</a>
                    </div>
                    <div class="contact-row">
                        <i class="fas fa-phone"></i>
                        <span>+234 802 505 2852</span>
                    </div>
                    <div class="contact-row">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Lagos, Nigeria</span>
                    </div>
                    <div class="contact-row">
                        <i class="fas fa-globe"></i>
                        <a href="https://shinex-learning.onrender.com" target="_blank">shinex-learning.onrender.com</a>
                    </div>
                </div>
            </div>

            <!-- ===== BACK LINK ===== -->
            <a href="/" class="back-link">
                <i class="fas fa-arrow-left"></i> Back to Home
            </a>

        </div>
    </main>

    <!-- ============================================================
    MOBILE FOOTER (Built-in)
    ============================================================ -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div style="max-width:500px; margin:0 auto; padding:0 16px;">
            <!-- Logo -->
            <div style="text-align:center; margin-bottom:12px;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:4px;">
                    <div style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div>
                        <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                        <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                    </div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:0;">Learn. Understand. Protect. 🛡️</p>
            </div>

            <!-- Footer Links -->
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:6px 12px; margin:12px 0;">
                <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Home</a>
                <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">About</a>
                <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Services</a>
                <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">FAQ</a>
                <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Contact</a>
                <a href="/terms" style="color:rgba(255,255,255,0.9); font-size:0.7rem; text-decoration:none; font-weight:600;">Terms</a>
                <a href="/privacy" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Privacy</a>
            </div>

            <!-- Social Icons -->
            <div style="display:flex; justify-content:center; gap:12px; margin:12px 0 16px;">
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-whatsapp"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-youtube"></i>
                </a>
            </div>

            <!-- Copyright -->
            <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:12px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.5);">
                &copy; <%= new Date().getFullYear() %> SHINEX Learning Circle. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:20px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:50px; height:50px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    👋 Hi! I'm your SHINEX AI Tutor. Ask me anything about our terms and conditions!
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script>
        // ============================================================
        // THEME TOGGLE
        // ============================================================
        
        function updateThemeToggle() {
            const isDark = document.body.classList.contains('dark-mode');
            const icon = document.getElementById('themeIconMobile');
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }
        
        // ============================================================
        // AI BOT
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const botBtn = document.getElementById('aiBotBtn');
            const chatModal = document.getElementById('aiChatModal');
            const chatClose = document.getElementById('aiChatClose');
            const chatInput = document.getElementById('aiChatInput');
            const chatSend = document.getElementById('aiChatSend');
            const chatMessages = document.getElementById('aiChatMessages');
            
            if (!botBtn || !chatModal) return;
            
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
            
            if (chatClose) {
                chatClose.addEventListener('click', function() {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                });
            }
            
            document.addEventListener('click', function(e) {
                if (chatModal.classList.contains('open')) {
                    if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                        chatModal.classList.remove('open');
                        chatModal.style.display = 'none';
                    }
                }
            });
            
            function addChatMessage(text, type) {
                const div = document.createElement('div');
                div.className = 'ai-chat-msg ' + type;
                let formatted = text;
                formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\n/g, '<br>');
                div.innerHTML = formatted;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            
            function sendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;
                
                addChatMessage(message, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                chatSend.disabled = true;
                
                const loadingMsg = document.createElement('div');
                loadingMsg.className = 'ai-chat-msg bot';
                loadingMsg.innerHTML = '⏳ Thinking...';
                loadingMsg.id = 'aiChatLoading';
                chatMessages.appendChild(loadingMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                fetch('/api/ai-tutor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userPrompt: message })
                })
                .then(response => response.json())
                .then(data => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    
                    if (data.error) {
                        addChatMessage('❌ ' + data.error, 'bot');
                    } else {
                        addChatMessage(data.answer, 'bot');
                    }
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                    chatInput.focus();
                })
                .catch(error => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                });
            }
            
            if (chatSend) {
                chatSend.addEventListener('click', sendMessage);
            }
            
            if (chatInput) {
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            }
        });
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
            updateThemeToggle();
        }
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('📜 SHINEX Terms & Conditions');
        console.log('📋 Please read our terms carefully');
        console.log('📧 Contact: support@shinex.ng');
        console.log('🤖 AI Tutor ready to help!');
    </script>

</body>
</html>