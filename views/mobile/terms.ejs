<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Terms & Conditions – SHINEX</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-terms-container {
            padding: 12px 12px 24px;
            max-width: 500px;
            margin: 0 auto;
        }
        .mobile-terms-card {
            padding: 16px 14px !important;
            border-radius: 12px !important;
            margin-bottom: 10px !important;
        }
        .mobile-terms-card h3 {
            font-size: 0.95rem !important;
            font-weight: 700 !important;
            margin: 0 0 4px !important;
            color: var(--primary);
        }
        .mobile-terms-card p {
            font-size: 0.82rem !important;
            line-height: 1.7 !important;
            margin: 0 !important;
            color: var(--text-muted);
        }
        .mobile-terms-card ul {
            padding-left: 18px;
            margin: 4px 0 0;
        }
        .mobile-terms-card ul li {
            font-size: 0.82rem !important;
            line-height: 1.7 !important;
            color: var(--text-muted);
            margin-bottom: 2px;
        }
        .mobile-terms-card a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: none;
        }
        .mobile-terms-divider {
            height: 1px;
            background: #ede8f5;
            margin: 12px 0;
        }
        body.dark-mode .mobile-terms-divider {
            background: var(--dark-border);
        }
        .mobile-back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.82rem;
            margin-top: 8px;
            padding: 6px 0;
        }
        .mobile-back-link:hover {
            color: var(--primary);
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: true }) %>

    <main class="main-content">
        <div class="mobile-terms-container">
            <h2 style="font-size:1.3rem; font-weight:800; margin:0 0 2px;">📜 Terms & Conditions</h2>
            <p style="color:var(--text-muted); font-size:0.8rem; margin-bottom:10px;">
                <strong>Last Updated:</strong> August 2026
            </p>

            <div class="card mobile-terms-card">
                <h3>1. Acceptance of Terms</h3>
                <p>By accessing or using SHINEX Learning Circle ("SLC", "we", "our", "us"), you agree to comply with and be bound by these Terms & Conditions. If you do not agree, you must not use our platform.</p>

                <div class="mobile-terms-divider"></div>

