<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>About Us – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-about-container {
            padding: 12px 12px 24px;
            max-width: 500px;
            margin: 0 auto;
        }
        .mobile-about-card {
            padding: 18px 16px !important;
            border-radius: 12px !important;
            margin-bottom: 12px !important;
        }
        .mobile-about-card h3 {
            font-size: 1rem !important;
            font-weight: 700 !important;
            margin: 0 0 6px !important;
        }
        .mobile-about-card p {
            font-size: 0.85rem !important;
            line-height: 1.7 !important;
            margin: 0 !important;
            color: var(--text-muted);
        }
        .mobile-mission {
            padding: 20px 16px !important;
            border-radius: 12px !important;
            text-align: center !important;
            margin-bottom: 12px !important;
        }
        .mobile-mission h3 {
            font-size: 1.2rem !important;
            font-weight: 700 !important;
            color: #fff !important;
            margin: 0 0 6px !important;
        }
        .mobile-mission p {
            font-size: 0.9rem !important;
            color: #d4c4f0 !important;
            margin: 0 !important;
        }
        .mobile-features-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 4px;
        }
        .mobile-features-grid .feature-item {
            text-align: center;
            padding: 12px 8px;
            background: var(--primary-bg);
            border-radius: 10px;
        }
        body.dark-mode .mobile-features-grid .feature-item {
            background: #1a1a1a;
        }
        .mobile-features-grid .feature-item i {
            font-size: 1.5rem;
            color: var(--primary);
        }
        .mobile-features-grid .feature-item h4 {
            font-size: 0.82rem !important;
            margin: 4px 0 2px !important;
        }
        .mobile-features-grid .feature-item p {
            font-size: 0.7rem !important;
            margin: 0 !important;
            color: var(--text-muted);
        }
        .mobile-about-list {
            list-style: none;
            padding: 0;
            margin: 6px 0 0;
        }
        .mobile-about-list li {
            padding: 6px 0;
            display: flex;
            gap: 10px;
            align-items: center;
            font-size: 0.82rem;
            color: var(--text-muted);
        }
        .mobile-about-list li i {
            color: #27ae60;
            font-size: 0.9rem;
            width: 18px;
        }
        .mobile-cta-box {
            padding: 16px;
            background: var(--primary-bg);
            border-radius: 12px;
            text-align: center;
            margin-top: 4px;
        }
        body.dark-mode .mobile-cta-box {
            background: #1a1a1a;
        }
        .mobile-cta-box h4 {
            font-size: 0.95rem !important;
            margin: 0 0 4px !important;
        }
        .mobile-cta-box p {
            font-size: 0.82rem !important;
            color: var(--text-muted);
            margin: 0 0 10px !important;
        }
        .mobile-cta-box .btn {
            width: 100%;
            font-size: 0.85rem !important;
            padding: 10px !important;
            min-height: 44px !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: true }) %>

    <main class="main-content">
        <div class="mobile-about-container">
            <h2 style="font-size:1.3rem; font-weight:800; margin:0 0 2px;">About SHINEX</h2>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">Learn. Understand. Protect.</p>

            <!-- Mission -->
            <div class="card card-purple mobile-mission">
                <h3>Our Mission</h3>
                <p>To empower individuals with practical, industry-relevant skills through accessible, high-quality online education.</p>
            </div>

            <!-- Who We Are -->
            <div class="card mobile-about-card">
                <h3>Who We Are</h3>
                <p>
                    SHINEX Learning Circle (SLC) is a Nigerian-based online learning platform dedicated to 
                    bridging the skills gap in technology, design, and business. We believe that everyone 
                    deserves access to quality education, regardless of their background or location.
                </p>
                <p style="margin-top:8px !important;">
                    Founded in 2026, SLC offers 10+ practical courses taught by industry professionals. 
                    Our curriculum is designed to be hands-on, project-based, and tailored to the needs of 
                    African learners.
                </p>
            </div>

            <!-- What We Offer -->
            <div class="card mobile-about-card">
                <h3>What We Offer</h3>
                <div class="mobile-features-grid">
                    <div class="feature-item">
                        <i class="fas fa-graduation-cap"></i>
                        <h4>10+ Courses</h4>
                        <p>Cybersecurity to Web Dev</p>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-chalkboard-teacher"></i>
                        <h4>Expert Instructors</h4>
                        <p>Industry professionals</p>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-laptop-code"></i>
                        <h4>Hands-on Learning</h4>
                        <p>Projects & real-world</p>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-users"></i>
                        <h4>Community</h4>
                        <p>Connect & grow together</p>
                    </div>
                </div>
            </div>

            <!-- Why SLC -->
            <div class="card mobile-about-card">
                <h3>Why SHINEX?</h3>
                <ul class="mobile-about-list">
                    <li><i class="fas fa-check-circle"></i> <strong>Affordable</strong> – Quality education at no cost</li>
                    <li><i class="fas fa-check-circle"></i> <strong>Flexible</strong> – Learn at your own pace</li>
                    <li><i class="fas fa-check-circle"></i> <strong>Practical</strong> – Skills you can apply immediately</li>
                    <li><i class="fas fa-check-circle"></i> <strong>Community-driven</strong> – Learn with peers</li>
                </ul>
            </div>

            <!-- Team -->
            <div class="card mobile-about-card">
                <h3>Our Team</h3>
                <p>
                    We are a passionate group of educators, developers, designers, and business professionals 
                    who believe in the transformative power of education. Our team is dedicated to creating 
                    the best learning experience for our students.
                </p>
            </div>

            <!-- CTA -->
            <div class="mobile-cta-box">
                <h4>Have Questions?</h4>
                <p>We'd love to hear from you.</p>
                <a href="/contact" class="btn btn-primary">
                    <i class="fas fa-envelope"></i> Contact Us
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer-mobile') %>
    <script src="/js/main.js"></script>
</body>
</html>