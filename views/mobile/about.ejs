<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>About Us – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           MOBILE ABOUT PAGE STYLES
           ============================================================ */
        
        .mobile-about-container {
            padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-xl);
            max-width: 500px;
            margin: 0 auto;
        }
        
        /* ----- Hero Section ----- */
        .about-hero {
            background: var(--purple-gradient);
            border-radius: var(--radius-lg);
            padding: var(--spacing-xl) var(--spacing-md);
            text-align: center;
            margin-bottom: var(--spacing-md);
            color: #fff;
        }
        
        .about-hero .hero-icon {
            font-size: 3rem;
            margin-bottom: var(--spacing-sm);
            display: block;
        }
        
        .about-hero h1 {
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff;
            margin: 0;
        }
        
        .about-hero p {
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.95rem;
            margin: 4px 0 0 0;
        }
        
        .about-hero .hero-tagline {
            display: inline-block;
            background: rgba(255, 255, 255, 0.15);
            padding: 4px 16px;
            border-radius: var(--radius-full);
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 1px;
            margin-top: var(--spacing-sm);
            color: #fff;
        }
        
        /* ----- Cards ----- */
        .about-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-md);
            margin-bottom: var(--spacing-md);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .about-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        .about-card .card-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 var(--spacing-sm) 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .about-card .card-title i {
            color: var(--purple-primary);
        }
        
        .about-card p {
            font-size: 0.85rem;
            line-height: 1.8;
            color: var(--text-secondary);
            margin: 0 0 var(--spacing-sm) 0;
        }
        
        .about-card p:last-child {
            margin-bottom: 0;
        }
        
        /* ----- Mission Card ----- */
        .mission-card {
            background: var(--purple-gradient);
            border-radius: var(--radius-lg);
            padding: var(--spacing-lg) var(--spacing-md);
            text-align: center;
            margin-bottom: var(--spacing-md);
            border: none;
        }
        
        .mission-card .mission-icon {
            font-size: 2.5rem;
            margin-bottom: var(--spacing-sm);
            display: block;
        }
        
        .mission-card h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #fff;
            margin: 0 0 4px 0;
        }
        
        .mission-card p {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.85);
            margin: 0;
            line-height: 1.7;
        }
        
        /* ----- Features Grid ----- */
        .features-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 4px;
        }
        
        .feature-item {
            text-align: center;
            padding: var(--spacing-md) var(--spacing-sm);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }
        
        .feature-item:hover {
            transform: translateY(-2px);
            border-color: var(--purple-primary);
            box-shadow: var(--shadow-sm);
        }
        
        .feature-item i {
            font-size: 1.8rem;
            color: var(--purple-primary);
            display: block;
            margin-bottom: 4px;
        }
        
        .feature-item h4 {
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-primary);
            margin: 4px 0 2px 0;
        }
        
        .feature-item p {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.4;
        }
        
        /* ----- List Styles ----- */
        .about-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        
        .about-list li {
            padding: var(--spacing-sm) 0;
            display: flex;
            gap: 10px;
            align-items: flex-start;
            font-size: 0.82rem;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-color);
            line-height: 1.5;
        }
        
        .about-list li:last-child {
            border-bottom: none;
        }
        
        .about-list li i {
            color: var(--text-success);
            font-size: 0.9rem;
            width: 20px;
            margin-top: 2px;
            flex-shrink: 0;
        }
        
        .about-list li strong {
            color: var(--text-primary);
        }
        
        /* ----- Stats ----- */
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
            margin-top: 4px;
        }
        
        .stat-item {
            text-align: center;
            padding: var(--spacing-sm);
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }
        
        .stat-item .stat-number {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--purple-primary);
            display: block;
        }
        
        .stat-item .stat-label {
            font-size: 0.65rem;
            color: var(--text-muted);
            display: block;
            margin-top: 2px;
        }
        
        /* ----- CTA Box ----- */
        .cta-box {
            background: var(--bg-card-secondary);
            border-radius: var(--radius-lg);
            padding: var(--spacing-lg) var(--spacing-md);
            text-align: center;
            border: 1px solid var(--border-color);
            margin-top: 4px;
        }
        
        .cta-box h4 {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .cta-box p {
            font-size: 0.82rem;
            color: var(--text-secondary);
            margin: 0 0 var(--spacing-md) 0;
        }
        
        .cta-box .btn-cta {
            width: 100%;
            font-size: 0.85rem;
            padding: 12px;
            min-height: 44px;
            border-radius: var(--radius-full);
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            text-decoration: none;
            display: block;
            text-align: center;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .cta-box .btn-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .cta-box .btn-cta i {
            margin-right: 6px;
        }
        
        /* ----- Values Section ----- */
        .values-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        
        .value-item {
            padding: var(--spacing-sm);
            text-align: center;
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }
        
        .value-item i {
            font-size: 1.2rem;
            color: var(--purple-primary);
            display: block;
            margin-bottom: 2px;
        }
        
        .value-item .value-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text-primary);
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 400px) {
            .features-grid {
                grid-template-columns: 1fr 1fr;
            }
            
            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }
            
            .values-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
        
        @media (max-width: 350px) {
            .features-grid {
                grid-template-columns: 1fr;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
            }
            
            .values-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    MOBILE HEADER (Built-in)
    ============================================================ -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:10px 14px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; flex-wrap:wrap; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="javascript:history.back()" style="color:rgba(255,255,255,0.9); font-size:0.75rem; padding:4px 8px; text-decoration:none; display:flex; align-items:center; gap:4px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
                <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                <div>
                    <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); updateThemeToggle();" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 8px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon" id="themeIconMobile"></i>
            </button>
            <a href="/login" style="background:rgba(255,255,255,0.2); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
            <a href="/register" style="background:rgba(255,255,255,0.25); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-user-plus"></i> Register
            </a>
        </div>
    </header>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <main class="main-content">
        <div class="mobile-about-container">

            <!-- ===== HERO SECTION ===== -->
            <div class="about-hero">
                <span class="hero-icon">📚</span>
                <h1>About SHINEX</h1>
                <p>Empowering minds with cutting-edge education</p>
                <span class="hero-tagline">Learn. Understand. Protect. 🛡️</span>
            </div>

            <!-- ===== MISSION ===== -->
            <div class="mission-card">
                <span class="mission-icon">🎯</span>
                <h3>Our Mission</h3>
                <p>To empower individuals with practical, industry-relevant skills through accessible, high-quality online education that transforms lives and builds careers.</p>
            </div>

            <!-- ===== WHO WE ARE ===== -->
            <div class="about-card">
                <div class="card-title">
                    <i class="fas fa-users"></i> Who We Are
                </div>
                <p>
                    SHINEX Learning Circle (SLC) is a Nigerian-based online learning platform dedicated to bridging the skills gap in technology, design, and business. We believe that everyone deserves access to quality education, regardless of their background or location.
                </p>
                <p>
                    Founded in 2026, SLC offers <strong>10+ practical courses</strong> taught by industry professionals. Our curriculum is designed to be hands-on, project-based, and tailored to the needs of African learners.
                </p>
                <p>
                    We are more than just a learning platform — we are a community of lifelong learners committed to growth, innovation, and excellence.
                </p>
            </div>

            <!-- ===== STATS ===== -->
            <div class="about-card">
                <div class="card-title">
                    <i class="fas fa-chart-bar"></i> SHINEX at a Glance
                </div>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-number">10+</span>
                        <span class="stat-label">Courses</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">50+</span>
                        <span class="stat-label">Lessons</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">100+</span>
                        <span class="stat-label">Classes</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">2026</span>
                        <span class="stat-label">Founded</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">10</span>
                        <span class="stat-label">Instructors</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">100%</span>
                        <span class="stat-label">Free Access</span>
                    </div>
                </div>
            </div>

            <!-- ===== WHAT WE OFFER ===== -->
            <div class="about-card">
                <div class="card-title">
                    <i class="fas fa-graduation-cap"></i> What We Offer
                </div>
                <div class="features-grid">
                    <div class="feature-item">
                        <i class="fas fa-laptop-code"></i>
                        <h4>10+ Courses</h4>
                        <p>Cybersecurity to Web Dev</p>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-chalkboard-teacher"></i>
                        <h4>Expert Instructors</h4>
                        <p>Industry professionals</p>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-project-diagram"></i>
                        <h4>Hands-on Learning</h4>
                        <p>Projects & real-world</p>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-users"></i>
                        <h4>Community</h4>
                        <p>Connect & grow together</p>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-mobile-alt"></i>
                        <h4>Mobile Friendly</h4>
                        <p>Learn anywhere, anytime</p>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-robot"></i>
                        <h4>AI Tutor</h4>
                        <p>24/7 learning support</p>
                    </div>
                </div>
            </div>

            <!-- ===== WHY SHINEX ===== -->
            <div class="about-card">
                <div class="card-title">
                    <i class="fas fa-star"></i> Why SHINEX?
                </div>
                <ul class="about-list">
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>Affordable</strong> – Quality education at zero cost</div>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>Flexible</strong> – Learn at your own pace, anytime</div>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>Practical</strong> – Skills you can apply immediately</div>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>Community-driven</strong> – Learn with like-minded peers</div>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>Mobile-first</strong> – Access courses on any device</div>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>AI-Powered</strong> – Get help from our AI Tutor anytime</div>
                    </li>
                </ul>
            </div>

            <!-- ===== OUR VALUES ===== -->
            <div class="about-card">
                <div class="card-title">
                    <i class="fas fa-heart" style="color:var(--text-error);"></i> Our Core Values
                </div>
                <div class="values-grid">
                    <div class="value-item">
                        <i class="fas fa-lightbulb"></i>
                        <span class="value-label">Innovation</span>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-handshake"></i>
                        <span class="value-label">Integrity</span>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-users"></i>
                        <span class="value-label">Community</span>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-rocket"></i>
                        <span class="value-label">Excellence</span>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-globe-africa"></i>
                        <span class="value-label">Inclusivity</span>
                    </div>
                    <div class="value-item">
                        <i class="fas fa-seedling"></i>
                        <span class="value-label">Growth</span>
                    </div>
                </div>
            </div>

            <!-- ===== OUR TEAM ===== -->
            <div class="about-card">
                <div class="card-title">
                    <i class="fas fa-user-tie"></i> Our Team
                </div>
                <p>
                    We are a passionate group of educators, developers, designers, and business professionals who believe in the transformative power of education. Our team is dedicated to creating the best learning experience for our students.
                </p>
                <p>
                    Every member of our team brings unique expertise and a shared commitment to making quality education accessible to everyone across Africa and beyond.
                </p>
                <p style="font-style:italic; color:var(--purple-primary);">
                    "Education is the most powerful weapon which you can use to change the world."
                </p>
            </div>

            <!-- ===== WHAT MAKES US DIFFERENT ===== -->
            <div class="about-card">
                <div class="card-title">
                    <i class="fas fa-gem" style="color:var(--text-warning);"></i> What Makes Us Different
                </div>
                <ul class="about-list">
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>African Focus</strong> – Curriculum tailored for African learners</div>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>Practical Approach</strong> – Learn by doing, not just watching</div>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>Community First</strong> – Built-in networking and collaboration</div>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>AI Integration</strong> – Smart learning assistance available 24/7</div>
                    </li>
                    <li>
                        <i class="fas fa-check-circle"></i>
                        <div><strong>Mobile-first Design</strong> – Learn on any device seamlessly</div>
                    </li>
                </ul>
            </div>

            <!-- ===== CALL TO ACTION ===== -->
            <div class="cta-box">
                <h4>Ready to Start Learning?</h4>
                <p>Join thousands of students already learning on SHINEX.</p>
                <a href="/register" class="btn-cta">
                    <i class="fas fa-rocket"></i> Get Started Today
                </a>
                <div style="margin-top:10px;">
                    <a href="/contact" style="color:var(--purple-primary); font-size:0.8rem; text-decoration:none;">
                        <i class="fas fa-envelope"></i> Have Questions? Contact Us
                    </a>
                </div>
            </div>

        </div>
    </main>

    <!-- ============================================================
    MOBILE FOOTER (Built-in)
    ============================================================ -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div style="max-width:500px; margin:0 auto; padding:0 16px;">
            <!-- Logo -->
            <div style="text-align:center; margin-bottom:12px;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:4px;">
                    <div style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div>
                        <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                        <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                    </div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:0;">Learn. Understand. Protect. 🛡️</p>
            </div>

            <!-- Footer Links -->
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:6px 12px; margin:12px 0;">
                <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Home</a>
                <a href="/about" style="color:rgba(255,255,255,0.9); font-size:0.75rem; text-decoration:none; font-weight:600;">About</a>
                <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Services</a>
                <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">FAQ</a>
                <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Contact</a>
                <a href="/terms" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Terms</a>
                <a href="/privacy" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Privacy</a>
            </div>

            <!-- Social Icons -->
            <div style="display:flex; justify-content:center; gap:12px; margin:12px 0 16px;">
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-whatsapp"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-youtube"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-linkedin-in"></i>
                </a>
            </div>

            <!-- Copyright -->
            <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:12px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.5);">
                &copy; <%= new Date().getFullYear() %> SHINEX Learning Circle. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:26px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:60px; height:60px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    👋 Hi! I'm your SHINEX AI Tutor. Ask me anything about our courses, learning paths, or any topic you'd like to explore!
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script>
        // ============================================================
        // THEME TOGGLE
        // ============================================================
        
        function updateThemeToggle() {
            const isDark = document.body.classList.contains('dark-mode');
            const icon = document.getElementById('themeIconMobile');
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }
        
        // ============================================================
        // AI BOT
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const botBtn = document.getElementById('aiBotBtn');
            const chatModal = document.getElementById('aiChatModal');
            const chatClose = document.getElementById('aiChatClose');
            const chatInput = document.getElementById('aiChatInput');
            const chatSend = document.getElementById('aiChatSend');
            const chatMessages = document.getElementById('aiChatMessages');
            
            if (!botBtn || !chatModal) return;
            
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
            
            if (chatClose) {
                chatClose.addEventListener('click', function() {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                });
            }
            
            document.addEventListener('click', function(e) {
                if (chatModal.classList.contains('open')) {
                    if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                        chatModal.classList.remove('open');
                        chatModal.style.display = 'none';
                    }
                }
            });
            
            function addChatMessage(text, type) {
                const div = document.createElement('div');
                div.className = 'ai-chat-msg ' + type;
                let formatted = text;
                formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\n/g, '<br>');
                div.innerHTML = formatted;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            
            function sendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;
                
                addChatMessage(message, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                chatSend.disabled = true;
                
                const loadingMsg = document.createElement('div');
                loadingMsg.className = 'ai-chat-msg bot';
                loadingMsg.innerHTML = '⏳ Thinking...';
                loadingMsg.id = 'aiChatLoading';
                chatMessages.appendChild(loadingMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                fetch('/api/ai-tutor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userPrompt: message })
                })
                .then(response => response.json())
                .then(data => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    
                    if (data.error) {
                        addChatMessage('❌ ' + data.error, 'bot');
                    } else {
                        addChatMessage(data.answer, 'bot');
                    }
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                    chatInput.focus();
                })
                .catch(error => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                });
            }
            
            if (chatSend) {
                chatSend.addEventListener('click', sendMessage);
            }
            
            if (chatInput) {
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            }
        });
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
            updateThemeToggle();
        }
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('📚 SHINEX Learning Circle');
        console.log('💡 About Page - Learn about our mission and values');
        console.log('🤖 AI Tutor ready to help!');
    </script>

</body>
</html>