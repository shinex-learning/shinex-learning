<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Contact – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .contact-info-item-mobile {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid #ede8f5;
        }
        .contact-info-item-mobile:last-child { border-bottom: none; }
        .contact-info-item-mobile .icon-box {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            flex-shrink: 0;
        }
        .contact-info-item-mobile .info-text .label {
            font-size: 0.6rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }
        .contact-info-item-mobile .info-text .value {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-dark);
        }
        .contact-info-item-mobile .info-text .value a { color: var(--primary); text-decoration: none; }
        body.dark-mode .contact-info-item-mobile { border-color: var(--dark-border); }
        body.dark-mode .contact-info-item-mobile .info-text .value { color: var(--text-light); }
        .whatsapp-link-mobile {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #25D366;
            color: #fff;
            padding: 6px 14px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.8rem;
        }
        .whatsapp-link-mobile:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(37,211,102,0.3); color: #fff; }
        .settings-group { margin-bottom: 12px; }
        .settings-group label { font-weight: 600; font-size: 0.8rem; color: var(--text-dark); display: block; margin-bottom: 4px; }
        body.dark-mode .settings-group label { color: var(--text-light); }
        .settings-group input, .settings-group textarea, .settings-group select {
            width: 100%;
            padding: 8px 12px;
            border: 2px solid #ede8f5;
            border-radius: 8px;
            font-size: 0.85rem;
            font-family: inherit;
            background: #fff;
            color: var(--text-dark);
        }
        body.dark-mode .settings-group input, body.dark-mode .settings-group textarea, body.dark-mode .settings-group select {
            background: #2a2a2a;
            color: var(--text-light);
            border-color: var(--dark-border);
        }
        .settings-group input:focus, .settings-group textarea:focus, .settings-group select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(139,92,246,0.12);
            outline: none;
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <!-- HEADER -->
    <header class="header" style="padding:10px 12px; flex-wrap:wrap; gap:6px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1;">
            <% if (showBack) { %>
                <a href="javascript:history.back()" class="back-btn" style="font-size:0.75rem; padding:4px 8px; color:rgba(255,255,255,0.9);"><i class="fas fa-arrow-left"></i></a>
            <% } %>
            <a href="/" class="logo-container" style="gap:8px;">
                <div class="logo" style="width:36px; height:36px; font-size:11px; background:rgba(255,255,255,0.2);">SLC</div>
                <div>
                    <div class="logo-text" style="font-size:15px; color:#fff;">SHINEX<span>.</span></div>
                    <div class="logo-sub" style="font-size:7px; color:rgba(255,255,255,0.7);">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div class="header-actions" style="gap:4px; flex-wrap:wrap;">
            <div class="text-size-control" style="padding:2px 8px; background:rgba(255,255,255,0.15);">
                <label style="font-size:0.6rem; color:rgba(255,255,255,0.8);"><i class="fas fa-font"></i></label>
                <input type="range" id="textSizeSliderMobile" min="12" max="24" value="16" step="1" style="width:50px;">
                <span class="text-size-value" id="textSizeValueMobile" style="font-size:0.6rem; min-width:24px; color:#fff;">16px</span>
            </div>
            <button class="dark-toggle" id="darkToggleMobile" style="font-size:1rem; padding:4px 6px; color:#fff; background:rgba(255,255,255,0.15); border-radius:30px;">🌙</button>
            <a href="/settings" class="btn btn-secondary btn-sm" style="min-height:32px; padding:4px 10px; border-radius:30px; font-size:0.75rem; background:rgba(255,255,255,0.2); color:#fff;"><i class="fas fa-cog"></i></a>
        </div>
    </header>

    <!-- CONTENT -->
    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <div style="text-align:center; margin-bottom:12px;">
                <h1 style="font-size:1.3rem; font-weight:800; color:var(--text-dark); margin:0;">
                    <i class="fas fa-envelope" style="color:var(--primary);"></i> Contact
                </h1>
                <p style="color:var(--text-muted); font-size:0.8rem; margin:4px 0 0;">We'd love to hear from you</p>
            </div>

            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5; margin-bottom:12px;">
                <h3 style="font-size:0.95rem; font-weight:700; color:var(--text-dark); margin:0 0 8px 0;">
                    <i class="fas fa-phone" style="color:var(--primary);"></i> Get in Touch
                </h3>

                <div class="contact-info-item-mobile">
                    <div class="icon-box"><i class="fas fa-envelope"></i></div>
                    <div class="info-text">
                        <div class="label">Email</div>
                        <div class="value"><a href="mailto:shinexlearning@gmail.com">shinexlearning@gmail.com</a></div>
                    </div>
                </div>

                <div class="contact-info-item-mobile">
                    <div class="icon-box"><i class="fas fa-phone"></i></div>
                    <div class="info-text">
                        <div class="label">Phone</div>
                        <div class="value"><a href="tel:+2347067574479">+234 706 757 4479</a></div>
                    </div>
                </div>

                <div class="contact-info-item-mobile">
                    <div class="icon-box"><i class="fab fa-whatsapp"></i></div>
                    <div class="info-text">
                        <div class="label">WhatsApp</div>
                        <div class="value">
                            <a href="https://wa.me/2348025052852" target="_blank" class="whatsapp-link-mobile">
                                <i class="fab fa-whatsapp"></i> +234 802 505 2852
                            </a>
                        </div>
                    </div>
                </div>

                <div class="contact-info-item-mobile">
                    <div class="icon-box"><i class="fas fa-globe"></i></div>
                    <div class="info-text">
                        <div class="label">Website</div>
                        <div class="value"><a href="https://shinex-learning.onrender.com" target="_blank">shinex-learning.onrender.com</a></div>
                    </div>
                </div>
            </div>

            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5;">
                <h3 style="font-size:0.95rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-paper-plane" style="color:var(--primary);"></i> Send Message
                </h3>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 12px 0;">We'll get back to you within 24 hours</p>
                <form>
                    <div class="settings-group">
                        <label>Full Name <span style="color:#e74c3c;">*</span></label>
                        <input type="text" placeholder="Your full name">
                    </div>
                    <div class="settings-group">
                        <label>Email Address <span style="color:#e74c3c;">*</span></label>
                        <input type="email" placeholder="your@email.com">
                    </div>
                    <div class="settings-group">
                        <label>Subject <span style="color:#e74c3c;">*</span></label>
                        <select>
                            <option value="">Select a subject...</option>
                            <option value="General Inquiry">General Inquiry</option>
                            <option value="Course Question">Course Question</option>
                            <option value="Technical Issue">Technical Issue</option>
                            <option value="Service Request">Service Request</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="settings-group">
                        <label>Message <span style="color:#e74c3c;">*</span></label>
                        <textarea rows="4" placeholder="Your message..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" style="width:100%; font-size:0.9rem; padding:10px; border-radius:30px; background:#8B5CF6; color:#fff; border:none; font-weight:600;">
                        <i class="fas fa-paper-plane"></i> Send Message
                    </button>
                </form>
            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="footer" style="padding:20px 0 16px; margin-top:20px;">
        <div class="container">
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:10px 16px; margin-bottom:12px;">
                <a href="/" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.8rem;"><i class="fas fa-home"></i> Home</a>
                <a href="/about" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.8rem;"><i class="fas fa-info-circle"></i> About</a>
                <a href="/faq" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.8rem;"><i class="fas fa-question-circle"></i> FAQ</a>
                <a href="/services" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.8rem;"><i class="fas fa-cogs"></i> Services</a>
                <a href="/contact" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.8rem;"><i class="fas fa-envelope"></i> Contact</a>
                <a href="/terms" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.8rem;"><i class="fas fa-file-contract"></i> Terms</a>
                <a href="/privacy" style="color:rgba(255,255,255,0.8); text-decoration:none; font-size:0.8rem;"><i class="fas fa-shield-alt"></i> Privacy</a>
            </div>
            <div style="display:flex; justify-content:center; gap:14px; margin-bottom:12px;">
                <a href="#" style="color:rgba(255,255,255,0.6); font-size:1rem;"><i class="fab fa-facebook"></i></a>
                <a href="#" style="color:rgba(255,255,255,0.6); font-size:1rem;"><i class="fab fa-twitter"></i></a>
                <a href="#" style="color:rgba(255,255,255,0.6); font-size:1rem;"><i class="fab fa-linkedin"></i></a>
                <a href="#" style="color:rgba(255,255,255,0.6); font-size:1rem;"><i class="fab fa-youtube"></i></a>
            </div>
            <div style="text-align:center; margin-bottom:8px;">
                <span style="color:#fff; font-weight:700; font-size:1rem;">SHINEX</span>
                <span style="color:rgba(255,255,255,0.5); font-size:0.65rem; display:block;">Learning Circle</span>
            </div>
            <div style="text-align:center; font-size:0.65rem; color:rgba(255,255,255,0.5); border-top:1px solid rgba(255,255,255,0.1); padding-top:10px;">
                <p style="margin:0;">&copy; 2026 SHINEX Learning Circle</p>
            </div>
        </div>
    </footer>

    <script src="/js/script.js"></script>
</body>
</html>