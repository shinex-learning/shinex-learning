<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Contact Us – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           MOBILE CONTACT PAGE STYLES
           ============================================================ */
        
        .mobile-contact-container {
            padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-xl);
            max-width: 500px;
            margin: 0 auto;
        }
        
        /* ----- Page Header ----- */
        .page-header {
            margin-bottom: var(--spacing-md);
        }
        
        .page-header h1 {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--text-primary);
            margin: 0;
        }
        
        .page-header h1 i {
            color: var(--purple-primary);
        }
        
        .page-header p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 2px 0 0 0;
        }
        
        .page-header p strong {
            color: var(--purple-primary);
        }
        
        /* ----- Cards ----- */
        .contact-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-md);
            margin-bottom: var(--spacing-md);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .contact-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        .contact-card .card-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .contact-card .card-title i {
            color: var(--purple-primary);
        }
        
        .contact-card .card-subtitle {
            font-size: 0.82rem;
            color: var(--text-muted);
            margin: 0 0 var(--spacing-md) 0;
        }
        
        /* ----- Form ----- */
        .form-group {
            margin-bottom: var(--spacing-md);
        }
        
        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.82rem;
            color: var(--text-primary);
            margin-bottom: 4px;
        }
        
        .form-group label .required {
            color: var(--text-error);
        }
        
        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.9rem;
            font-family: inherit;
            transition: all 0.3s ease;
            background: var(--bg-input);
            color: var(--text-primary);
            min-height: 40px;
        }
        
        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: var(--purple-primary);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
            outline: none;
        }
        
        .form-group textarea {
            resize: vertical;
            min-height: 100px;
        }
        
        .form-group .help-text {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 4px;
        }
        
        .form-group .help-text i {
            margin-right: 4px;
        }
        
        /* ----- Submit Button ----- */
        .btn-submit {
            width: 100%;
            font-size: 0.85rem;
            padding: 12px;
            min-height: 48px;
            border-radius: var(--radius-full);
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .btn-submit:active {
            transform: translateY(0);
        }
        
        .btn-submit i {
            font-size: 1rem;
        }
        
        /* ----- Contact Info Items ----- */
        .contact-info-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: var(--spacing-sm) 0;
            border-bottom: 1px solid var(--border-color);
        }
        
        .contact-info-item:last-child {
            border-bottom: none;
        }
        
        .contact-info-item .icon-box {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--purple-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }
        
        .contact-info-item .icon-box i {
            color: var(--purple-primary);
            font-size: 1rem;
        }
        
        .contact-info-item .icon-box.whatsapp i {
            color: #25D366;
        }
        
        .contact-info-item .icon-box.web i {
            color: #00BCD4;
        }
        
        .contact-info-item .info-text {
            flex: 1;
            min-width: 0;
        }
        
        .contact-info-item .info-text .label {
            font-weight: 600;
            font-size: 0.7rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .contact-info-item .info-text .value {
            font-size: 0.85rem;
            color: var(--text-primary);
            word-break: break-all;
        }
        
        .contact-info-item .info-text .value a {
            color: var(--purple-primary);
            text-decoration: none;
        }
        
        .contact-info-item .info-text .value a:hover {
            text-decoration: underline;
        }
        
        /* ----- WhatsApp Button ----- */
        .whatsapp-btn {
            display: block;
            width: 100%;
            padding: 12px;
            background: #25D366;
            color: #fff;
            border: none;
            border-radius: var(--radius-sm);
            font-size: 0.9rem;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            transition: all 0.3s ease;
            margin-top: var(--spacing-sm);
        }
        
        .whatsapp-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(37, 211, 102, 0.3);
        }
        
        .whatsapp-btn i {
            margin-right: 8px;
            font-size: 1.1rem;
        }
        
        /* ----- Response Time Box ----- */
        .response-box {
            background: var(--purple-bg);
            border-radius: var(--radius-sm);
            padding: var(--spacing-sm) var(--spacing-md);
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 4px;
            border: 1px solid var(--border-color);
        }
        
        .response-box i {
            color: var(--purple-primary);
            font-size: 1.3rem;
        }
        
        .response-box .response-text {
            font-size: 0.82rem;
            color: var(--text-primary);
        }
        
        .response-box .response-text strong {
            color: var(--purple-primary);
        }
        
        /* ----- Social Links ----- */
        .social-links {
            display: flex;
            justify-content: center;
            gap: 16px;
            padding: var(--spacing-sm) 0;
            font-size: 1.3rem;
        }
        
        .social-links a {
            color: var(--text-muted);
            transition: all 0.3s ease;
        }
        
        .social-links a:hover {
            color: var(--purple-primary);
            transform: translateY(-2px);
        }
        
        /* ----- FAQ Link ----- */
        .faq-link {
            text-align: center;
            padding: var(--spacing-md) 0 0 0;
            border-top: 1px solid var(--border-color);
            margin-top: 4px;
        }
        
        .faq-link a {
            color: var(--purple-primary);
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
        }
        
        .faq-link a:hover {
            text-decoration: underline;
        }
        
        .faq-link i {
            color: var(--purple-primary);
            margin-right: 4px;
        }
        
        /* ----- Alert ----- */
        .mobile-alert {
            font-size: 0.82rem;
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            margin-bottom: var(--spacing-sm);
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 400px) {
            .contact-info-item {
                flex-direction: column;
                align-items: flex-start;
                gap: 4px;
            }
            
            .contact-info-item .icon-box {
                width: 32px;
                height: 32px;
            }
            
            .contact-info-item .icon-box i {
                font-size: 0.8rem;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    MOBILE HEADER (Built-in)
    ============================================================ -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:10px 14px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; flex-wrap:wrap; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="javascript:history.back()" style="color:rgba(255,255,255,0.9); font-size:0.75rem; padding:4px 8px; text-decoration:none; display:flex; align-items:center; gap:4px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
                <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                <div>
                    <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); updateThemeToggle();" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 8px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon" id="themeIconMobile"></i>
            </button>
            <a href="/login" style="background:rgba(255,255,255,0.2); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
            <a href="/register" style="background:rgba(255,255,255,0.25); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-user-plus"></i> Register
            </a>
        </div>
    </header>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <main class="main-content">
        <div class="mobile-contact-container">

            <!-- ===== PAGE HEADER ===== -->
            <div class="page-header">
                <h1><i class="fas fa-envelope"></i> Contact Us</h1>
                <p>Send us a message and we'll respond within <strong>24-48 hours</strong>.</p>
            </div>

            <!-- ===== ALERT MESSAGES ===== -->
            <% if (messages && messages.success) { %>
                <div class="alert alert-success mobile-alert flash-message" data-type="success">
                    <i class="fas fa-check-circle"></i> <%= messages.success %>
                </div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger mobile-alert flash-message" data-type="error">
                    <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                </div>
            <% } %>

            <!-- ===== CONTACT FORM ===== -->
            <div class="contact-card">
                <div class="card-title">
                    <i class="fas fa-paper-plane"></i> Send a Message
                </div>
                <p class="card-subtitle">Fill in the form below and our team will respond.</p>

                <form action="/contact/send" method="POST" id="contactForm">
                    <!-- Name -->
                    <div class="form-group">
                        <label for="name">Your Full Name <span class="required">*</span></label>
                        <input type="text" id="name" name="name" placeholder="e.g. John Doe" required>
                    </div>

                    <!-- Email -->
                    <div class="form-group">
                        <label for="email">Email Address <span class="required">*</span></label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required>
                        <div class="help-text">
                            <i class="fas fa-info-circle"></i> We'll send our reply to this email.
                        </div>
                    </div>

                    <!-- Subject -->
                    <div class="form-group">
                        <label for="subject">Subject <span class="required">*</span></label>
                        <select id="subject" name="subject" required>
                            <option value="">Select a subject...</option>
                            <option value="Course Inquiry">📚 Course Inquiry</option>
                            <option value="Technical Support">🛠️ Technical Support</option>
                            <option value="Account Issue">👤 Account Issue</option>
                            <option value="Service Request">🛒 Service Request</option>
                            <option value="Feedback/Suggestion">💡 Feedback / Suggestion</option>
                            <option value="Partnership">🤝 Partnership</option>
                            <option value="Other">📌 Other</option>
                        </select>
                    </div>

                    <!-- Message -->
                    <div class="form-group">
                        <label for="message">Message <span class="required">*</span></label>
                        <textarea id="message" name="message" rows="4" placeholder="Describe your issue or question in detail..." required></textarea>
                        <div class="help-text">
                            <i class="fas fa-info-circle"></i> Be as detailed as possible so we can assist you better.
                        </div>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-paper-plane"></i> Send Message
                    </button>
                </form>
            </div>

            <!-- ===== CONTACT INFORMATION ===== -->
            <div class="contact-card">
                <div class="card-title">
                    <i class="fas fa-address-card"></i> Contact Information
                </div>
                <p class="card-subtitle">Reach us through any of these channels.</p>

                <!-- Email -->
                <div class="contact-info-item">
                    <div class="icon-box">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div class="info-text">
                        <div class="label">Email</div>
                        <div class="value">
                            <a href="mailto:shinexlearning@gmail.com">shinexlearning@gmail.com</a>
                        </div>
                    </div>
                </div>

                <!-- Phone -->
                <div class="contact-info-item">
                    <div class="icon-box">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div class="info-text">
                        <div class="label">Phone</div>
                        <div class="value">
                            <a href="tel:+2348025052852">+234 802 505 2852</a>
                        </div>
                    </div>
                </div>

                <!-- WhatsApp -->
                <div class="contact-info-item">
                    <div class="icon-box whatsapp">
                        <i class="fab fa-whatsapp"></i>
                    </div>
                    <div class="info-text">
                        <div class="label">WhatsApp</div>
                        <div class="value">
                            <a href="https://wa.me/2348025052852?text=Hello%20from%20SHINEX%20Learning%20Circle%20(SLC%20lmt.%C2%AE)" target="_blank">
                                +234 802 505 2852
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Website -->
                <div class="contact-info-item">
                    <div class="icon-box web">
                        <i class="fas fa-globe"></i>
                    </div>
                    <div class="info-text">
                        <div class="label">Website</div>
                        <div class="value">
                            <a href="https://shinex-learning.onrender.com" target="_blank">
                                shinex-learning.onrender.com
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== WHATSAPP BUTTON ===== -->
            <a href="https://wa.me/2348025052852?text=Hello%20from%20SHINEX%20Learning%20Circle%20(SLC%20lmt.%C2%AE)" 
               target="_blank" 
               class="whatsapp-btn">
                <i class="fab fa-whatsapp"></i> Chat with us on WhatsApp
            </a>

            <!-- ===== RESPONSE TIME ===== -->
            <div class="response-box">
                <i class="fas fa-clock"></i>
                <div class="response-text">
                    <strong>Response Time:</strong> We respond within <strong>24-48 hours</strong>
                </div>
            </div>

            <!-- ===== SOCIAL MEDIA ===== -->
            <div class="contact-card" style="text-align:center;">
                <div class="card-title" style="justify-content:center;">
                    <i class="fas fa-share-alt"></i> Connect With Us
                </div>
                <p class="card-subtitle">Follow us on social media</p>
                <div class="social-links">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                    <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                </div>
            </div>

            <!-- ===== FAQ LINK ===== -->
            <div class="faq-link">
                <i class="fas fa-question-circle"></i>
                Check our <a href="/faq">FAQ</a> for quick answers to common questions.
            </div>

        </div>
    </main>

    <!-- ============================================================
    MOBILE FOOTER (Built-in)
    ============================================================ -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div style="max-width:500px; margin:0 auto; padding:0 16px;">
            <!-- Logo -->
            <div style="text-align:center; margin-bottom:12px;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:4px;">
                    <div style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div>
                        <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                        <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                    </div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:0;">Learn. Understand. Protect. 🛡️</p>
            </div>

            <!-- Footer Links -->
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:6px 12px; margin:12px 0;">
                <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Home</a>
                <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">About</a>
                <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Services</a>
                <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">FAQ</a>
                <a href="/contact" style="color:rgba(255,255,255,0.9); font-size:0.75rem; text-decoration:none; font-weight:600;">Contact</a>
                <a href="/terms" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Terms</a>
                <a href="/privacy" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Privacy</a>
            </div>

            <!-- Social Icons -->
            <div style="display:flex; justify-content:center; gap:12px; margin:12px 0 16px;">
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-whatsapp"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-youtube"></i>
                </a>
            </div>

            <!-- Copyright -->
            <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:12px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.5);">
                &copy; <%= new Date().getFullYear() %> SHINEX Learning Circle. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:26px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:60px; height:60px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    👋 Hi! I'm your SHINEX AI Tutor. Ask me anything about our courses, learning paths, or any topic you'd like to explore!
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script>
        // ============================================================
        // THEME TOGGLE
        // ============================================================
        
        function updateThemeToggle() {
            const isDark = document.body.classList.contains('dark-mode');
            const icon = document.getElementById('themeIconMobile');
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }
        
        // ============================================================
        // AI BOT
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const botBtn = document.getElementById('aiBotBtn');
            const chatModal = document.getElementById('aiChatModal');
            const chatClose = document.getElementById('aiChatClose');
            const chatInput = document.getElementById('aiChatInput');
            const chatSend = document.getElementById('aiChatSend');
            const chatMessages = document.getElementById('aiChatMessages');
            
            if (!botBtn || !chatModal) return;
            
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
            
            if (chatClose) {
                chatClose.addEventListener('click', function() {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                });
            }
            
            document.addEventListener('click', function(e) {
                if (chatModal.classList.contains('open')) {
                    if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                        chatModal.classList.remove('open');
                        chatModal.style.display = 'none';
                    }
                }
            });
            
            function addChatMessage(text, type) {
                const div = document.createElement('div');
                div.className = 'ai-chat-msg ' + type;
                let formatted = text;
                formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\n/g, '<br>');
                div.innerHTML = formatted;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            
            function sendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;
                
                addChatMessage(message, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                chatSend.disabled = true;
                
                const loadingMsg = document.createElement('div');
                loadingMsg.className = 'ai-chat-msg bot';
                loadingMsg.innerHTML = '⏳ Thinking...';
                loadingMsg.id = 'aiChatLoading';
                chatMessages.appendChild(loadingMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                fetch('/api/ai-tutor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userPrompt: message })
                })
                .then(response => response.json())
                .then(data => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    
                    if (data.error) {
                        addChatMessage('❌ ' + data.error, 'bot');
                    } else {
                        addChatMessage(data.answer, 'bot');
                    }
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                    chatInput.focus();
                })
                .catch(error => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                });
            }
            
            if (chatSend) {
                chatSend.addEventListener('click', sendMessage);
            }
            
            if (chatInput) {
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            }
        });
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
            updateThemeToggle();
        }
        
        // ============================================================
        // AUTO DISMISS FLASH MESSAGES
        // ============================================================
        
        document.querySelectorAll('.flash-message').forEach(msg => {
            setTimeout(() => {
                msg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                msg.style.opacity = '0';
                msg.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    if (msg.parentNode) msg.remove();
                }, 500);
            }, 5000);
        });
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('📬 SHINEX Contact Page');
        console.log('📧 Email: shinexlearning@gmail.com');
        console.log('📞 Phone: +234 802 505 2852');
        console.log('💬 WhatsApp: Click to chat');
        console.log('🌐 Website: shinex-learning.onrender.com');
    </script>

</body>
</html>