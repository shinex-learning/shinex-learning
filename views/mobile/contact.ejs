<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Contact Us – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-contact-container {
            padding: 12px 12px 24px;
            max-width: 500px;
            margin: 0 auto;
        }
        .mobile-contact-card {
            padding: 18px 16px !important;
            border-radius: 12px !important;
            margin-bottom: 12px !important;
        }
        .mobile-contact-card h3 {
            font-size: 1rem !important;
            font-weight: 700 !important;
            margin: 0 0 4px !important;
        }
        .mobile-contact-card p {
            font-size: 0.82rem !important;
            margin: 0 0 12px !important;
            color: var(--text-muted);
        }
        .mobile-contact-card label {
            font-size: 0.82rem !important;
        }
        .mobile-contact-card input,
        .mobile-contact-card select,
        .mobile-contact-card textarea {
            font-size: 0.9rem !important;
            padding: 10px 12px !important;
            min-height: 40px !important;
            border-radius: 8px !important;
        }
        .mobile-contact-card .btn {
            font-size: 0.85rem !important;
            padding: 12px !important;
            min-height: 48px !important;
            width: 100%;
            justify-content: center;
        }
        .mobile-contact-card .help-text {
            font-size: 0.7rem !important;
        }
        .mobile-contact-info {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid #ede8f5;
        }
        body.dark-mode .mobile-contact-info {
            border-color: var(--dark-border);
        }
        .mobile-contact-info:last-child {
            border-bottom: none;
        }
        .mobile-contact-info .icon-box {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        body.dark-mode .mobile-contact-info .icon-box {
            background: #1a1a1a;
        }
        .mobile-contact-info .icon-box i {
            color: var(--primary);
            font-size: 1rem;
        }
        .mobile-contact-info .info-text {
            flex: 1;
        }
        .mobile-contact-info .info-text .label {
            font-weight: 600;
            font-size: 0.78rem;
            color: var(--text-muted);
        }
        .mobile-contact-info .info-text .value {
            font-size: 0.85rem;
        }
        .mobile-response-time {
            background: var(--primary-bg);
            border-radius: 10px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 8px;
        }
        body.dark-mode .mobile-response-time {
            background: #1a1a1a;
        }
        .mobile-response-time i {
            color: var(--primary);
            font-size: 1.3rem;
        }
        .mobile-response-time .response-text {
            font-size: 0.82rem;
        }
        .mobile-response-time .response-text strong {
            color: var(--primary);
        }
        .mobile-social-links {
            display: flex;
            justify-content: center;
            gap: 16px;
            padding: 8px 0;
            font-size: 1.3rem;
        }
        .mobile-social-links a {
            color: var(--text-muted);
            transition: color 0.3s;
        }
        .mobile-social-links a:hover {
            color: var(--primary);
        }
        .mobile-faq-link {
            text-align: center;
            padding: 12px;
            border-top: 1px solid #ede8f5;
            margin-top: 4px;
        }
        body.dark-mode .mobile-faq-link {
            border-color: var(--dark-border);
        }
        .mobile-faq-link a {
            color: var(--primary);
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
        }
        .mobile-alert {
            font-size: 0.82rem !important;
            padding: 10px 14px !important;
            border-radius: 8px !important;
            margin-bottom: 10px !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: true }) %>

    <main class="main-content">
        <div class="mobile-contact-container">
            <h2 style="font-size:1.3rem; font-weight:800; margin:0 0 2px;">📬 Contact Us</h2>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">
                Send us a message and we'll respond within <strong>24-48 hours</strong>.
            </p>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success mobile-alert"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger mobile-alert"><%= messages.error %></div>
            <% } %>

            <!-- ===== CONTACT FORM ===== -->
            <div class="card mobile-contact-card">
                <h3>Send a Message</h3>
                <p>Fill in the form below and our team will respond.</p>

                <form action="/contact/send" method="POST">
                    <div class="settings-group">
                        <label for="name">Your Full Name <span style="color:red;">*</span></label>
                        <input type="text" id="name" name="name" placeholder="e.g. John Doe" required>
                    </div>
                    <div class="settings-group">
                        <label for="email">Email Address <span style="color:red;">*</span></label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required>
                        <p class="help-text">We'll send our reply to this email.</p>
                    </div>
                    <div class="settings-group">
                        <label for="subject">Subject <span style="color:red;">*</span></label>
                        <select id="subject" name="subject" required>
                            <option value="">Select a subject...</option>
                            <option value="Course Inquiry">📚 Course Inquiry</option>
                            <option value="Technical Support">🛠️ Technical Support</option>
                            <option value="Account Issue">👤 Account Issue</option>
                            <option value="Service Request">🛒 Service Request</option>
                            <option value="Feedback/Suggestion">💡 Feedback / Suggestion</option>
                            <option value="Partnership">🤝 Partnership</option>
                            <option value="Other">📌 Other</option>
                        </select>
                    </div>
                    <div class="settings-group">
                        <label for="message">Message <span style="color:red;">*</span></label>
                        <textarea id="message" name="message" rows="4" placeholder="Describe your issue or question in detail..." required></textarea>
                        <p class="help-text">Be as detailed as possible so we can assist you better.</p>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i> Send Message
                    </button>
                </form>
            </div>

            <!-- ===== CONTACT INFORMATION ===== -->
            <div class="card mobile-contact-card">
                <h3>Contact Information</h3>
                <p>Reach us through any of these channels.</p>

                <div class="mobile-contact-info">
                    <div class="icon-box"><i class="fas fa-envelope"></i></div>
                    <div class="info-text">
                        <div class="label">Email</div>
                        <div class="value">support@shinex.ng</div>
                    </div>
                </div>

                <div class="mobile-contact-info">
                    <div class="icon-box"><i class="fas fa-phone"></i></div>
                    <div class="info-text">
                        <div class="label">Phone</div>
                        <div class="value">+234 800 SHINEX</div>
                    </div>
                </div>

                <div class="mobile-contact-info">
                    <div class="icon-box"><i class="fab fa-whatsapp" style="color:#25D366;"></i></div>
                    <div class="info-text">
                        <div class="label">WhatsApp</div>
                        <div class="value">+234 812 345 6789</div>
                    </div>
                </div>

                <div class="mobile-contact-info">
                    <div class="icon-box"><i class="fas fa-map-marker-alt"></i></div>
                    <div class="info-text">
                        <div class="label">Address</div>
                        <div class="value">Lagos, Nigeria</div>
                    </div>
                </div>
            </div>

            <!-- ===== RESPONSE TIME ===== -->
            <div class="mobile-response-time">
                <i class="fas fa-clock"></i>
                <div class="response-text">
                    <strong>Response Time:</strong> We respond within <strong>24-48 hours</strong>
                </div>
            </div>

            <!-- ===== SOCIAL MEDIA ===== -->
            <div class="card mobile-contact-card" style="text-align:center;">
                <h3>Connect With Us</h3>
                <p>Follow us on social media</p>
                <div class="mobile-social-links">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                    <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                </div>
            </div>

            <!-- ===== FAQ LINK ===== -->
            <div class="mobile-faq-link">
                <i class="fas fa-question-circle" style="color:var(--primary);"></i>
                Check our <a href="/faq">FAQ</a> for quick answers to common questions.
            </div>
        </div>
    </main>

    <%- include('partials/footer-mobile') %>
    <script src="/js/main.js"></script>
</body>
</html>