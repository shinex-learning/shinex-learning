<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Contact – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div id="page-loader"><div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div><div class="loader-text">SHINEX</div><div class="loader-sub">LEARNING CIRCLE</div></div>
    <%- include(getHeader()) %>
    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5;">
                <h1 style="font-size:1.2rem; font-weight:800; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-envelope" style="color:var(--primary);"></i> Contact
                </h1>
                <form>
                    <div class="settings-group">
                        <label for="contactNameM">Name</label>
                        <input type="text" id="contactNameM" placeholder="Your name" style="font-size:0.9rem; padding:8px 12px;">
                    </div>
                    <div class="settings-group">
                        <label for="contactEmailM">Email</label>
                        <input type="email" id="contactEmailM" placeholder="your@email.com" style="font-size:0.9rem; padding:8px 12px;">
                    </div>
                    <div class="settings-group">
                        <label for="contactMessageM">Message</label>
                        <textarea id="contactMessageM" rows="4" placeholder="Your message..." style="font-size:0.9rem; padding:8px 12px;"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" style="font-size:0.9rem; padding:10px;"><i class="fas fa-paper-plane"></i> Send</button>
                </form>
            </div>
        </div>
    </main>
    <%- include(getFooter()) %>
    <script src="/js/script.js"></script>
</body>
</html>