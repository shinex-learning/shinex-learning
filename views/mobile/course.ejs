<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title><%= course.title %> – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           MOBILE COURSE PAGE STYLES
           ============================================================ */
        
        .mobile-course-container {
            padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-xl);
            max-width: 500px;
            margin: 0 auto;
        }
        
        /* ----- Course Header ----- */
        .course-hero {
            background: var(--purple-gradient);
            border-radius: var(--radius-lg);
            padding: var(--spacing-lg) var(--spacing-md);
            margin-bottom: var(--spacing-md);
            color: #fff;
        }
        
        .course-hero .course-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.15);
            padding: 2px 12px;
            border-radius: var(--radius-full);
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: #fff;
            margin-bottom: var(--spacing-sm);
        }
        
        .course-hero h1 {
            font-size: 1.3rem;
            font-weight: 800;
            color: #fff;
            margin: 0 0 4px 0;
        }
        
        .course-hero p {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.85);
            margin: 0;
            line-height: 1.6;
        }
        
        .course-hero .course-meta {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: var(--spacing-sm);
        }
        
        .course-hero .course-meta .meta-tag {
            background: rgba(255, 255, 255, 0.15);
            padding: 3px 12px;
            border-radius: var(--radius-full);
            font-size: 0.65rem;
            color: #fff;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        
        .course-hero .course-meta .meta-tag i {
            font-size: 0.6rem;
            opacity: 0.7;
        }
        
        /* ----- Enrollment Buttons ----- */
        .enroll-section {
            margin-bottom: var(--spacing-md);
        }
        
        .enroll-btn {
            width: 100%;
            padding: 12px;
            font-size: 0.9rem;
            min-height: 48px;
            border-radius: var(--radius-full);
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .enroll-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .enroll-btn:active {
            transform: translateY(0);
        }
        
        .enroll-btn i {
            font-size: 1rem;
        }
        
        .enrolled-badge {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
            padding: var(--spacing-sm) var(--spacing-md);
            background: var(--bg-alert-success);
            border-radius: var(--radius-sm);
            border-left: 4px solid var(--text-success);
            flex-wrap: wrap;
        }
        
        .enrolled-badge .enrolled-text {
            color: var(--text-success);
            font-weight: 600;
            font-size: 0.85rem;
        }
        
        .enrolled-badge .enrolled-text i {
            margin-right: 6px;
        }
        
        .enrolled-badge .dashboard-link {
            margin-left: auto;
            background: var(--text-success);
            color: #fff;
            border: none;
            border-radius: var(--radius-full);
            padding: 4px 16px;
            text-decoration: none;
            font-size: 0.75rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .enrolled-badge .dashboard-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);
        }
        
        .login-prompt {
            text-align: center;
            padding: var(--spacing-md);
            background: var(--bg-alert-info);
            border-radius: var(--radius-sm);
            border-left: 4px solid #3498db;
        }
        
        .login-prompt p {
            color: #1a5276;
            font-size: 0.85rem;
            margin: 0 0 var(--spacing-sm) 0;
        }
        
        .login-prompt .prompt-actions {
            display: flex;
            gap: 8px;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .login-prompt .prompt-actions .btn {
            padding: 6px 20px;
            font-size: 0.8rem;
            min-height: 36px;
            border-radius: var(--radius-full);
            text-decoration: none;
            font-weight: 600;
        }
        
        /* ----- Section Title ----- */
        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: var(--spacing-md) 0 4px 0;
        }
        
        .section-subtitle {
            color: var(--text-muted);
            font-size: 0.82rem;
            margin: 0 0 var(--spacing-sm) 0;
        }
        
        /* ----- Level Cards ----- */
        .level-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-md);
            margin-bottom: var(--spacing-sm);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .level-card:hover {
            border-color: var(--purple-primary);
            box-shadow: var(--shadow-md);
            transform: translateX(4px);
        }
        
        .level-card .level-number {
            display: inline-block;
            background: var(--purple-bg);
            color: var(--purple-primary);
            padding: 1px 10px;
            border-radius: var(--radius-full);
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }
        
        .level-card .level-name {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        
        .level-card .level-duration {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 2px 0;
        }
        
        .level-card .level-duration i {
            margin-right: 4px;
        }
        
        .level-card .level-classes {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 0 0 4px 0;
        }
        
        .level-card .level-classes i {
            margin-right: 4px;
        }
        
        .level-card .level-progress {
            font-size: 0.7rem;
            color: var(--purple-primary);
            font-weight: 600;
            display: block;
            margin-top: 2px;
        }
        
        .level-card .level-actions {
            margin-top: var(--spacing-sm);
        }
        
        .level-card .level-actions .btn-view {
            width: 100%;
            font-size: 0.8rem;
            padding: 8px;
            min-height: 36px;
            border-radius: var(--radius-full);
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            text-decoration: none;
            display: block;
            text-align: center;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .level-card .level-actions .btn-view:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
        }
        
        .level-card .level-actions .btn-view i {
            margin-right: 6px;
        }
        
        /* ----- Progress Bar in Level Card ----- */
        .level-progress-bar {
            width: 100%;
            height: 4px;
            background: var(--bg-card-secondary);
            border-radius: var(--radius-full);
            margin-top: 6px;
            overflow: hidden;
        }
        
        .level-progress-bar .progress-fill {
            height: 100%;
            background: var(--purple-gradient);
            border-radius: var(--radius-full);
            transition: width 0.6s ease;
        }
        
        /* ----- Review Section ----- */
        .review-box {
            padding: var(--spacing-md);
            border-radius: var(--radius-sm);
            margin-top: var(--spacing-md);
            background: var(--bg-card-secondary);
            border: 1px solid var(--border-color);
        }
        
        .review-box .review-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .review-box .review-title i {
            color: var(--text-warning);
            margin-right: 6px;
        }
        
        .review-box p {
            font-size: 0.82rem;
            color: var(--text-secondary);
            margin: 0;
            line-height: 1.7;
            font-style: italic;
        }
        
        /* ----- Back Link ----- */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.82rem;
            margin-top: var(--spacing-md);
            padding: 6px 0;
            transition: all 0.3s ease;
        }
        
        .back-link:hover {
            color: var(--purple-primary);
        }
        
        .back-link i {
            font-size: 0.7rem;
        }
        
        /* ----- Empty State ----- */
        .empty-state {
            padding: var(--spacing-xl) var(--spacing-md);
            border-radius: var(--radius-lg);
            text-align: center;
            background: var(--bg-card-secondary);
            border: 1px solid var(--border-color);
        }
        
        .empty-state .empty-icon {
            font-size: 3rem;
            display: block;
            margin-bottom: var(--spacing-sm);
            opacity: 0.5;
        }
        
        .empty-state h3 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .empty-state p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0;
        }
        
        /* ----- Alert Override ----- */
        .mobile-alert {
            font-size: 0.82rem;
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            margin-bottom: var(--spacing-sm);
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 400px) {
            .course-hero h1 {
                font-size: 1.1rem;
            }
            
            .course-hero p {
                font-size: 0.8rem;
            }
            
            .enrolled-badge {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .enrolled-badge .dashboard-link {
                margin-left: 0;
                width: 100%;
                text-align: center;
            }
            
            .login-prompt .prompt-actions {
                flex-direction: column;
            }
            
            .login-prompt .prompt-actions .btn {
                width: 100%;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    MOBILE HEADER (Built-in)
    ============================================================ -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:10px 14px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; flex-wrap:wrap; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="javascript:history.back()" style="color:rgba(255,255,255,0.9); font-size:0.75rem; padding:4px 8px; text-decoration:none; display:flex; align-items:center; gap:4px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
                <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                <div>
                    <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); updateThemeToggle();" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 8px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon" id="themeIconMobile"></i>
            </button>
            <% if (user) { %>
                <a href="/dashboard" style="background:rgba(255,255,255,0.2); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                    <i class="fas fa-user"></i> <%= user.firstName %>
                </a>
                <a href="/logout" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            <% } else { %>
                <a href="/login" style="background:rgba(255,255,255,0.2); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                    <i class="fas fa-sign-in-alt"></i> Login
                </a>
                <a href="/register" style="background:rgba(255,255,255,0.25); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                    <i class="fas fa-user-plus"></i> Register
                </a>
            <% } %>
        </div>
    </header>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <main class="main-content">
        <div class="mobile-course-container">

            <!-- Flash Messages -->
            <% if (messages && messages.success) { %>
                <div class="alert alert-success mobile-alert flash-message" data-type="success">
                    <i class="fas fa-check-circle"></i> <%= messages.success %>
                </div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger mobile-alert flash-message" data-type="error">
                    <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                </div>
            <% } %>

            <!-- ===== COURSE HERO ===== -->
            <div class="course-hero">
                <span class="course-badge">
                    <i class="fas fa-graduation-cap"></i> Course
                </span>
                <h1><%= course.title %></h1>
                <p><%= course.description || 'No description available.' %></p>
                <div class="course-meta">
                    <span class="meta-tag">
                        <i class="fas fa-signal"></i> <%= course.level || 'Beginner' %>
                    </span>
                    <span class="meta-tag">
                        <i class="fas fa-clock"></i> <%= course.duration || 'Self-paced' %>
                    </span>
                    <span class="meta-tag">
                        <i class="fas fa-layer-group"></i> <%= course.levels ? course.levels.length : 0 %> Levels
                    </span>
                </div>
            </div>

            <!-- ===== ENROLLMENT SECTION ===== -->
            <div class="enroll-section">
                <% if (user) { %>
                    <% if (user.courseId === course.id) { %>
                        <!-- Already Enrolled -->
                        <div class="enrolled-badge">
                            <span class="enrolled-text">
                                <i class="fas fa-check-circle"></i> You're enrolled in this course
                            </span>
                            <a href="/dashboard" class="dashboard-link">
                                <i class="fas fa-arrow-right"></i> Dashboard
                            </a>
                        </div>
                    <% } else { %>
                        <!-- Enroll Button -->
                        <form action="/enroll" method="POST">
                            <input type="hidden" name="courseId" value="<%= course.id %>">
                            <button type="submit" class="enroll-btn">
                                <i class="fas fa-user-plus"></i> Enroll in this Course
                            </button>
                        </form>
                    <% } %>
                <% } else { %>
                    <!-- Not Logged In -->
                    <div class="login-prompt">
                        <p><i class="fas fa-lock"></i> Login or create an account to enroll</p>
                        <div class="prompt-actions">
                            <a href="/login?redirect=/course/<%= course.id %>" class="btn btn-primary" style="background:var(--purple-primary); color:#fff;">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </a>
                            <a href="/register" class="btn btn-secondary" style="background:var(--bg-card-secondary); color:var(--text-primary);">
                                <i class="fas fa-user-plus"></i> Register
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- ===== LEVELS ===== -->
            <h3 class="section-title">
                <i class="fas fa-layer-group" style="color:var(--purple-primary);"></i> Course Levels
            </h3>
            <p class="section-subtitle">Complete each level to unlock the next.</p>

            <% if (course.levels && course.levels.length > 0) { %>
                <% course.levels.forEach((level, index) => { 
                    let levelProgress = 0;
                    let totalLevelClasses = 0;
                    let completedLevelClasses = 0;
                    
                    if (user && user.progress && level.lessons) {
                        level.lessons.forEach(lesson => {
                            if (lesson.classes) {
                                lesson.classes.forEach(cls => {
                                    totalLevelClasses++;
                                    if (user.progress[cls.id]) completedLevelClasses++;
                                });
                            }
                        });
                    }
                    levelProgress = totalLevelClasses > 0 ? Math.round((completedLevelClasses / totalLevelClasses) * 100) : 0;
                %>
                    <div class="level-card">
                        <span class="level-number">Level <%= index + 1 %></span>
                        <div class="level-name"><%= level.name %></div>
                        <div class="level-duration">
                            <i class="far fa-clock"></i> <%= level.duration || 'Flexible' %>
                        </div>
                        <div class="level-classes">
                            <i class="fas fa-book-open"></i> 
                            <%= level.lessons ? level.lessons.reduce((acc, l) => acc + (l.classes ? l.classes.length : 0), 0) : 0 %> classes
                            <% if (totalLevelClasses > 0) { %>
                                <span class="level-progress">
                                    • <%= levelProgress %>% complete
                                </span>
                            <% } %>
                        </div>
                        
                        <!-- Progress Bar -->
                        <% if (totalLevelClasses > 0) { %>
                            <div class="level-progress-bar">
                                <div class="progress-fill" style="width: <%= levelProgress %>%;"></div>
                            </div>
                        <% } %>
                        
                        <div class="level-actions">
                            <a href="/level/<%= course.id %>/<%= level.id %>" class="btn-view">
                                <i class="fas fa-eye"></i> View Level
                            </a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state">
                    <span class="empty-icon">📂</span>
                    <h3>No Levels Yet</h3>
                    <p>This course is being built. Check back soon for new content.</p>
                </div>
            <% } %>

            <!-- ===== REVIEW ===== -->
            <% if (course.review) { %>
                <div class="review-box">
                    <div class="review-title">
                        <i class="fas fa-star"></i> Course Review
                    </div>
                    <p>"<%= course.review %>"</p>
                </div>
            <% } %>

            <!-- ===== BACK LINK ===== -->
            <a href="/" class="back-link">
                <i class="fas fa-arrow-left"></i> Back to Courses
            </a>

        </div>
    </main>

    <!-- ============================================================
    MOBILE FOOTER (Built-in)
    ============================================================ -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div style="max-width:500px; margin:0 auto; padding:0 16px;">
            <!-- Logo -->
            <div style="text-align:center; margin-bottom:12px;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:4px;">
                    <div style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div>
                        <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                        <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                    </div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:0;">Learn. Understand. Protect. 🛡️</p>
            </div>

            <!-- Footer Links -->
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:6px 12px; margin:12px 0;">
                <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Home</a>
                <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">About</a>
                <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Services</a>
                <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">FAQ</a>
                <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Contact</a>
                <a href="/terms" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Terms</a>
                <a href="/privacy" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Privacy</a>
            </div>

            <!-- Social Icons -->
            <div style="display:flex; justify-content:center; gap:12px; margin:12px 0 16px;">
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-whatsapp"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-youtube"></i>
                </a>
            </div>

            <!-- Copyright -->
            <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:12px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.5);">
                &copy; <%= new Date().getFullYear() %> SHINEX Learning Circle. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:26px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:60px; height:60px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    👋 Hi! I'm your SHINEX AI Tutor. Ask me anything about this course or any topic!
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script>
        // ============================================================
        // THEME TOGGLE
        // ============================================================
        
        function updateThemeToggle() {
            const isDark = document.body.classList.contains('dark-mode');
            const icon = document.getElementById('themeIconMobile');
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }
        
        // ============================================================
        // AI BOT
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const botBtn = document.getElementById('aiBotBtn');
            const chatModal = document.getElementById('aiChatModal');
            const chatClose = document.getElementById('aiChatClose');
            const chatInput = document.getElementById('aiChatInput');
            const chatSend = document.getElementById('aiChatSend');
            const chatMessages = document.getElementById('aiChatMessages');
            
            if (!botBtn || !chatModal) return;
            
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
            
            if (chatClose) {
                chatClose.addEventListener('click', function() {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                });
            }
            
            document.addEventListener('click', function(e) {
                if (chatModal.classList.contains('open')) {
                    if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                        chatModal.classList.remove('open');
                        chatModal.style.display = 'none';
                    }
                }
            });
            
            function addChatMessage(text, type) {
                const div = document.createElement('div');
                div.className = 'ai-chat-msg ' + type;
                let formatted = text;
                formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\n/g, '<br>');
                div.innerHTML = formatted;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            
            function sendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;
                
                addChatMessage(message, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                chatSend.disabled = true;
                
                const loadingMsg = document.createElement('div');
                loadingMsg.className = 'ai-chat-msg bot';
                loadingMsg.innerHTML = '⏳ Thinking...';
                loadingMsg.id = 'aiChatLoading';
                chatMessages.appendChild(loadingMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                fetch('/api/ai-tutor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userPrompt: message })
                })
                .then(response => response.json())
                .then(data => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    
                    if (data.error) {
                        addChatMessage('❌ ' + data.error, 'bot');
                    } else {
                        addChatMessage(data.answer, 'bot');
                    }
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                    chatInput.focus();
                })
                .catch(error => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                });
            }
            
            if (chatSend) {
                chatSend.addEventListener('click', sendMessage);
            }
            
            if (chatInput) {
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            }
        });
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
            updateThemeToggle();
        }
        
        // ============================================================
        // AUTO DISMISS FLASH MESSAGES
        // ============================================================
        
        document.querySelectorAll('.flash-message').forEach(msg => {
            setTimeout(() => {
                msg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                msg.style.opacity = '0';
                msg.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    if (msg.parentNode) msg.remove();
                }, 500);
            }, 5000);
        });
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('📚 SHINEX Course Page');
        console.log('📖 Course: <%= course.title %>');
        console.log('📊 Levels: <%= course.levels ? course.levels.length : 0 %>');
        console.log('👤 User: <%= user ? user.firstName : "Not logged in" %>');
    </script>

</body>
</html>