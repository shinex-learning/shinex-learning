<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title><%= course.title %> – SHINEX</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-course-container {
            padding: 12px 12px 24px;
            max-width: 500px;
            margin: 0 auto;
        }
        .mobile-course-header {
            padding: 20px 16px !important;
            border-radius: 14px !important;
            margin-bottom: 16px !important;
        }
        .mobile-course-header h1 {
            font-size: 1.3rem !important;
            margin: 0 0 4px !important;
        }
        .mobile-course-header p {
            font-size: 0.85rem !important;
            margin: 0 !important;
        }
        .mobile-course-header .badge {
            font-size: 0.6rem !important;
            padding: 2px 10px !important;
        }
        .mobile-enroll-btn {
            width: 100%;
            padding: 12px !important;
            font-size: 0.9rem !important;
            min-height: 48px !important;
            border-radius: 12px !important;
            margin-bottom: 12px !important;
        }
        .mobile-level-card {
            padding: 14px 14px !important;
            border-radius: 12px !important;
            margin-bottom: 10px !important;
            text-align: center !important;
        }
        .mobile-level-card .level-name {
            font-size: 0.95rem !important;
            font-weight: 700 !important;
            margin: 0 !important;
        }
        .mobile-level-card .level-duration {
            font-size: 0.8rem !important;
            margin: 2px 0 !important;
        }
        .mobile-level-card .level-lessons {
            font-size: 0.8rem !important;
            margin: 0 0 8px !important;
        }
        .mobile-level-card .btn {
            width: 100%;
            font-size: 0.8rem !important;
            padding: 8px !important;
            min-height: 36px !important;
        }
        .mobile-level-progress {
            font-size: 0.7rem !important;
            color: var(--primary);
            display: block;
            margin-top: 2px;
        }
        .mobile-review {
            padding: 12px 16px !important;
            border-radius: 10px !important;
            margin-top: 12px !important;
        }
        .mobile-review h4 {
            font-size: 0.9rem !important;
            margin: 0 0 4px !important;
        }
        .mobile-review p {
            font-size: 0.82rem !important;
            margin: 0 !important;
        }
        .mobile-back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.82rem;
            margin-top: 12px;
            padding: 6px 0;
        }
        .mobile-back-link:hover {
            color: var(--primary);
        }
        .mobile-alert {
            font-size: 0.82rem !important;
            padding: 10px 14px !important;
            border-radius: 10px !important;
            margin-bottom: 12px !important;
        }
        .mobile-alert .btn {
            font-size: 0.78rem !important;
            padding: 6px 14px !important;
            min-height: 32px !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: true }) %>

    <main class="main-content">
        <div class="mobile-course-container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success mobile-alert"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger mobile-alert"><%= messages.error %></div>
            <% } %>

            <!-- Course Header -->
            <div class="card card-purple mobile-course-header">
                <h1><%= course.title %></h1>
                <p><%= course.description || 'No description available.' %></p>
                <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:10px;">
                    <span class="badge" style="background:rgba(255,255,255,0.2); color:#fff;"><%= course.level || 'Beginner' %></span>
                    <span class="badge" style="background:rgba(255,255,255,0.2); color:#fff;"><%= course.duration || 'Self‑paced' %></span>
                    <span class="badge" style="background:rgba(255,255,255,0.2); color:#fff;"><%= course.levels ? course.levels.length : 0 %> Levels</span>
                </div>
            </div>

            <!-- Enrollment -->
            <% if (user) { %>
                <% if (user.courseId === course.id) { %>
                    <div class="alert alert-success mobile-alert" style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        <span><i class="fas fa-check-circle"></i> You're enrolled</span>
                        <a href="/dashboard" class="btn btn-success btn-sm" style="margin-left:auto;">Dashboard</a>
                    </div>
                <% } else { %>
                    <form action="/enroll" method="POST">
                        <input type="hidden" name="courseId" value="<%= course.id %>">
                        <button type="submit" class="btn btn-primary mobile-enroll-btn">
                            <i class="fas fa-user-plus"></i> Enroll in this Course
                        </button>
                    </form>
                <% } %>
            <% } else { %>
                <div class="alert alert-info mobile-alert" style="text-align:center;">
                    <a href="/login?redirect=/course/<%= course.id %>" class="btn btn-primary btn-sm">Login to Enroll</a>
                    <span style="margin:0 6px;">or</span>
                    <a href="/register" class="btn btn-secondary btn-sm">Create Account</a>
                </div>
            <% } %>

            <!-- Levels -->
            <h3 style="font-size:1.1rem; font-weight:700; margin:16px 0 4px;">Course Levels</h3>
            <p style="color:var(--text-muted); font-size:0.82rem; margin-bottom:12px;">Complete each level to unlock the next.</p>

            <% if (course.levels && course.levels.length) { %>
                <% course.levels.forEach((level, index) => { 
                    let levelProgress = 0;
                    let totalLevelClasses = 0;
                    let completedLevelClasses = 0;
                    if (user && user.progress && level.lessons) {
                        level.lessons.forEach(lesson => {
                            if (lesson.classes) {
                                lesson.classes.forEach(cls => {
                                    totalLevelClasses++;
                                    if (user.progress[cls.id]) completedLevelClasses++;
                                });
                            }
                        });
                    }
                    levelProgress = totalLevelClasses > 0 ? Math.round((completedLevelClasses / totalLevelClasses) * 100) : 0;
                %>
                    <div class="level-card mobile-level-card">
                        <div class="level-name">Level <%= index+1 %>: <%= level.name %></div>
                        <div class="level-duration"><i class="far fa-clock"></i> <%= level.duration || 'Flexible' %></div>
                        <div class="level-lessons">
                            <%= level.lessons ? level.lessons.reduce((acc, l) => acc + (l.classes ? l.classes.length : 0), 0) : 0 %> classes
                            <% if (totalLevelClasses > 0) { %>
                                <span class="mobile-level-progress"><%= levelProgress %>% complete</span>
                            <% } %>
                        </div>
                        <a href="/level/<%= course.id %>/<%= level.id %>" class="btn btn-primary btn-sm">
                            <i class="fas fa-eye"></i> View Level
                        </a>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="empty-state" style="padding:24px; border-radius:12px;">
                    <span class="empty-icon">📂</span>
                    <h3 style="font-size:1rem;">No Levels Yet</h3>
                    <p style="font-size:0.85rem;">This course is being built. Check back soon.</p>
                </div>
            <% } %>

            <!-- Review -->
            <% if (course.review) { %>
                <div class="mobile-review" style="background:var(--primary-bg);">
                    <h4>📝 Course Review</h4>
                    <p><%= course.review %></p>
                </div>
            <% } %>

            <!-- Back Link -->
            <a href="/courses" class="mobile-back-link">
                <i class="fas fa-arrow-left"></i> Back to Courses
            </a>
        </div>
    </main>

    <%- include('partials/footer-mobile') %>
    <script src="/js/main.js"></script>
</body>
</html>