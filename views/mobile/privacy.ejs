<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Privacy – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5;">
                <h1 style="font-size:1.1rem; font-weight:800; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-shield-alt" style="color:var(--primary);"></i> Privacy Policy
                </h1>
                <p style="color:var(--text-muted); font-size:0.7rem; margin:0 0 12px 0;">Last updated: August 2026</p>
                <div style="font-size:0.85rem; line-height:1.8; color:var(--text-dark);">
                    <p style="margin-bottom:12px;">
                        <strong>Information We Collect</strong><br>
                        We collect minimal data to improve your learning experience.
                    </p>
                    <p style="margin-bottom:12px;">
                        <strong>How We Use Your Data</strong><br>
                        Data is used to personalize your learning journey.
                    </p>
                    <p style="margin-bottom:12px;">
                        <strong>Data Security</strong><br>
                        We implement industry-standard security measures.
                    </p>
                    <p style="margin-bottom:12px;">
                        <strong>Your Rights</strong><br>
                        You can request data deletion at any time.
                    </p>
                    <p style="margin-bottom:0;">
                        <strong>Contact</strong><br>
                        For privacy concerns, <a href="/contact" style="color:var(--primary);">contact us</a>.
                    </p>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer-mobile') %>

    <script src="/js/script.js"></script>
</body>
</html>