<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Privacy Policy – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           MOBILE PRIVACY PAGE STYLES
           ============================================================ */
        
        .mobile-privacy-container {
            padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-xl);
            max-width: 500px;
            margin: 0 auto;
        }
        
        /* ----- Page Header ----- */
        .page-header {
            margin-bottom: var(--spacing-md);
        }
        
        .page-header h1 {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--text-primary);
            margin: 0;
        }
        
        .page-header h1 i {
            color: var(--purple-primary);
        }
        
        .page-header .last-updated {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin: 2px 0 0 0;
        }
        
        .page-header .last-updated strong {
            color: var(--text-secondary);
        }
        
        /* ----- Privacy Cards ----- */
        .privacy-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-md);
            margin-bottom: var(--spacing-sm);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .privacy-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        .privacy-card .section-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--purple-primary);
            margin: 0 0 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .privacy-card .section-title .section-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: var(--purple-bg);
            color: var(--purple-primary);
            font-size: 0.65rem;
            font-weight: 700;
            flex-shrink: 0;
        }
        
        .privacy-card p {
            font-size: 0.82rem;
            line-height: 1.8;
            color: var(--text-secondary);
            margin: 0 0 6px 0;
        }
        
        .privacy-card p:last-child {
            margin-bottom: 0;
        }
        
        .privacy-card ul {
            padding-left: var(--spacing-md);
            margin: 4px 0 0 0;
        }
        
        .privacy-card ul li {
            font-size: 0.82rem;
            line-height: 1.8;
            color: var(--text-secondary);
            margin-bottom: 2px;
        }
        
        .privacy-card ul li strong {
            color: var(--text-primary);
        }
        
        .privacy-card .contact-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
            margin-top: 4px;
        }
        
        .privacy-card .contact-info .contact-row {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.82rem;
            color: var(--text-secondary);
        }
        
        .privacy-card .contact-info .contact-row i {
            color: var(--purple-primary);
            width: 20px;
            text-align: center;
        }
        
        .privacy-card .contact-info .contact-row a {
            color: var(--purple-primary);
            text-decoration: none;
            font-weight: 500;
        }
        
        .privacy-card .contact-info .contact-row a:hover {
            text-decoration: underline;
        }
        
        /* ----- Divider ----- */
        .privacy-divider {
            height: 1px;
            background: var(--border-color);
            margin: var(--spacing-sm) 0;
        }
        
        /* ----- Back Link ----- */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.82rem;
            margin-top: var(--spacing-sm);
            padding: 6px 0;
            transition: all 0.3s ease;
        }
        
        .back-link:hover {
            color: var(--purple-primary);
        }
        
        .back-link i {
            font-size: 0.7rem;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 400px) {
            .page-header h1 {
                font-size: 1.1rem;
            }
            
            .privacy-card .section-title {
                font-size: 0.88rem;
            }
            
            .privacy-card p,
            .privacy-card ul li {
                font-size: 0.78rem;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    MOBILE HEADER (Built-in)
    ============================================================ -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:10px 14px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; flex-wrap:wrap; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="javascript:history.back()" style="color:rgba(255,255,255,0.9); font-size:0.75rem; padding:4px 8px; text-decoration:none; display:flex; align-items:center; gap:4px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
                <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                <div>
                    <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); updateThemeToggle();" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 8px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon" id="themeIconMobile"></i>
            </button>
            <a href="/login" style="background:rgba(255,255,255,0.2); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
            <a href="/register" style="background:rgba(255,255,255,0.25); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-user-plus"></i> Register
            </a>
        </div>
    </header>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <main class="main-content">
        <div class="mobile-privacy-container">

            <!-- ===== PAGE HEADER ===== -->
            <div class="page-header">
                <h1><i class="fas fa-shield-alt"></i> Privacy Policy</h1>
                <p class="last-updated">
                    <i class="far fa-calendar-alt"></i> 
                    <strong>Last Updated:</strong> August 2026
                </p>
            </div>

            <!-- ===== SECTION 1: INTRODUCTION ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">1</span> Introduction
                </div>
                <p>
                    SHINEX Learning Circle ("SLC", "we", "our", "us") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website and use our services.
                </p>
                <p>
                    By using SHINEX Learning Circle, you agree to the collection and use of information in accordance with this policy.
                </p>
            </div>

            <div class="privacy-divider"></div>

            <!-- ===== SECTION 2: INFORMATION WE COLLECT ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">2</span> Information We Collect
                </div>
                <p>We collect the following types of information:</p>
                <ul>
                    <li><strong>Personal Information:</strong> Name, email address, phone number, date of birth, gender, address, and Student ID.</li>
                    <li><strong>Academic Information:</strong> School, department, current level, and student status.</li>
                    <li><strong>Learning Data:</strong> Course enrollment, progress, completed classes, test scores, and points.</li>
                    <li><strong>Usage Data:</strong> Pages visited, time spent, interactions with content, and AI chat messages.</li>
                    <li><strong>Device Information:</strong> IP address, browser type, device type, and operating system.</li>
                </ul>
            </div>

            <div class="privacy-divider"></div>

            <!-- ===== SECTION 3: HOW WE USE YOUR INFORMATION ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">3</span> How We Use Your Information
                </div>
                <p>We use your information to:</p>
                <ul>
                    <li>Create and manage your account</li>
                    <li>Provide, maintain, and improve our services</li>
                    <li>Track your learning progress and achievements</li>
                    <li>Send you email notifications about your account and courses</li>
                    <li>Respond to your inquiries and support requests</li>
                    <li>Personalize your learning experience</li>
                    <li>Analyze usage patterns to improve our platform</li>
                </ul>
            </div>

            <div class="privacy-divider"></div>

            <!-- ===== SECTION 4: INFORMATION SHARING ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">4</span> Information Sharing
                </div>
                <p>We do not sell, trade, or rent your personal information to third parties. We may share your information in the following cases:</p>
                <ul>
                    <li><strong>With your consent:</strong> We may share information with your explicit permission.</li>
                    <li><strong>Service Providers:</strong> We use third-party services (e.g., email, hosting, AI) that process data on our behalf.</li>
                    <li><strong>Legal Requirements:</strong> We may disclose information if required by law or to protect our rights.</li>
                </ul>
            </div>

            <div class="privacy-divider"></div>

            <!-- ===== SECTION 5: DATA SECURITY ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">5</span> Data Security
                </div>
                <p>We take data security seriously. We implement industry-standard security measures including:</p>
                <ul>
                    <li><strong>Password Hashing:</strong> All passwords are hashed using bcrypt</li>
                    <li><strong>Encryption:</strong> HTTPS encryption for all data transmission</li>
                    <li><strong>Access Control:</strong> Session management and authentication controls</li>
                    <li><strong>Monitoring:</strong> Regular security updates and monitoring</li>
                </ul>
            </div>

            <div class="privacy-divider"></div>

            <!-- ===== SECTION 6: YOUR RIGHTS ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">6</span> Your Rights
                </div>
                <p>You have the right to:</p>
                <ul>
                    <li><strong>Access:</strong> Request a copy of your personal information</li>
                    <li><strong>Correct:</strong> Update or correct inaccurate information</li>
                    <li><strong>Delete:</strong> Delete your account and associated data</li>
                    <li><strong>Opt-out:</strong> Unsubscribe from marketing communications</li>
                    <li><strong>Portability:</strong> Request a copy of your data in a portable format</li>
                </ul>
                <p style="margin-top:6px;">
                    To exercise these rights, contact us at <strong>support@shinex.ng</strong>.
                </p>
            </div>

            <div class="privacy-divider"></div>

            <!-- ===== SECTION 7: COOKIES AND TRACKING ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">7</span> Cookies and Tracking
                </div>
                <p>We use cookies to enhance your experience. Cookies help us:</p>
                <ul>
                    <li><strong>Session Management:</strong> Remember your login session and preferences</li>
                    <li><strong>Progress Tracking:</strong> Track your learning progress</li>
                    <li><strong>Analytics:</strong> Analyze site traffic and usage patterns</li>
                </ul>
                <p style="margin-top:6px;">
                    You can manage cookie preferences in your browser settings at any time.
                </p>
            </div>

            <div class="privacy-divider"></div>

            <!-- ===== SECTION 8: DATA RETENTION ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">8</span> Data Retention
                </div>
                <p>
                    We retain your personal information for as long as your account is active. If you delete your account, we will delete or anonymize your data within <strong>30 days</strong>, except where we are required to retain it for legal or regulatory purposes.
                </p>
            </div>

            <div class="privacy-divider"></div>

            <!-- ===== SECTION 9: CHILDREN'S PRIVACY ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">9</span> Children's Privacy
                </div>
                <p>
                    Our services are not directed at individuals under the age of <strong>13</strong>. We do not knowingly collect personal information from children. If you are a parent or guardian and believe your child has provided us with information, please contact us immediately.
                </p>
            </div>

            <div class="privacy-divider"></div>

            <!-- ===== SECTION 10: CHANGES TO THIS POLICY ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">10</span> Changes to This Policy
                </div>
                <p>
                    We may update this Privacy Policy from time to time. We will notify you of any changes by posting the new policy on this page and updating the "Last Updated" date. We encourage you to review this policy periodically.
                </p>
            </div>

            <div class="privacy-divider"></div>

            <!-- ===== SECTION 11: CONTACT US ===== -->
            <div class="privacy-card">
                <div class="section-title">
                    <span class="section-number">11</span> Contact Us
                </div>
                <p>If you have any questions about this Privacy Policy, please contact us:</p>
                <div class="contact-info">
                    <div class="contact-row">
                        <i class="fas fa-envelope"></i>
                        <a href="mailto:support@shinex.ng">support@shinex.ng</a>
                    </div>
                    <div class="contact-row">
                        <i class="fas fa-phone"></i>
                        <span>+234 802 505 2852</span>
                    </div>
                    <div class="contact-row">
                        <i class="fas fa-map-marker-alt"></i>
                        <span>Lagos, Nigeria</span>
                    </div>
                    <div class="contact-row">
                        <i class="fas fa-globe"></i>
                        <a href="https://shinex-learning.onrender.com" target="_blank">shinex-learning.onrender.com</a>
                    </div>
                </div>
            </div>

            <!-- ===== BACK LINK ===== -->
            <a href="/" class="back-link">
                <i class="fas fa-arrow-left"></i> Back to Home
            </a>

        </div>
    </main>

    <!-- ============================================================
    MOBILE FOOTER (Built-in)
    ============================================================ -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div style="max-width:500px; margin:0 auto; padding:0 16px;">
            <!-- Logo -->
            <div style="text-align:center; margin-bottom:12px;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:4px;">
                    <div style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div>
                        <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                        <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                    </div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:0;">Learn. Understand. Protect. 🛡️</p>
            </div>

            <!-- Footer Links -->
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:6px 12px; margin:12px 0;">
                <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Home</a>
                <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">About</a>
                <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Services</a>
                <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">FAQ</a>
                <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Contact</a>
                <a href="/terms" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Terms</a>
                <a href="/privacy" style="color:rgba(255,255,255,0.9); font-size:0.7rem; text-decoration:none; font-weight:600;">Privacy</a>
            </div>

            <!-- Social Icons -->
            <div style="display:flex; justify-content:center; gap:12px; margin:12px 0 16px;">
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-whatsapp"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-youtube"></i>
                </a>
            </div>

            <!-- Copyright -->
            <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:12px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.5);">
                &copy; <%= new Date().getFullYear() %> SHINEX Learning Circle. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:20px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:50px; height:50px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    👋 Hi! I'm your SHINEX AI Tutor. Ask me anything about our privacy policy or any topic!
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script>
        // ============================================================
        // THEME TOGGLE
        // ============================================================
        
        function updateThemeToggle() {
            const isDark = document.body.classList.contains('dark-mode');
            const icon = document.getElementById('themeIconMobile');
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }
        
        // ============================================================
        // AI BOT
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const botBtn = document.getElementById('aiBotBtn');
            const chatModal = document.getElementById('aiChatModal');
            const chatClose = document.getElementById('aiChatClose');
            const chatInput = document.getElementById('aiChatInput');
            const chatSend = document.getElementById('aiChatSend');
            const chatMessages = document.getElementById('aiChatMessages');
            
            if (!botBtn || !chatModal) return;
            
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
            
            if (chatClose) {
                chatClose.addEventListener('click', function() {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                });
            }
            
            document.addEventListener('click', function(e) {
                if (chatModal.classList.contains('open')) {
                    if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                        chatModal.classList.remove('open');
                        chatModal.style.display = 'none';
                    }
                }
            });
            
            function addChatMessage(text, type) {
                const div = document.createElement('div');
                div.className = 'ai-chat-msg ' + type;
                let formatted = text;
                formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\n/g, '<br>');
                div.innerHTML = formatted;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            
            function sendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;
                
                addChatMessage(message, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                chatSend.disabled = true;
                
                const loadingMsg = document.createElement('div');
                loadingMsg.className = 'ai-chat-msg bot';
                loadingMsg.innerHTML = '⏳ Thinking...';
                loadingMsg.id = 'aiChatLoading';
                chatMessages.appendChild(loadingMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                fetch('/api/ai-tutor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userPrompt: message })
                })
                .then(response => response.json())
                .then(data => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    
                    if (data.error) {
                        addChatMessage('❌ ' + data.error, 'bot');
                    } else {
                        addChatMessage(data.answer, 'bot');
                    }
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                    chatInput.focus();
                })
                .catch(error => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                });
            }
            
            if (chatSend) {
                chatSend.addEventListener('click', sendMessage);
            }
            
            if (chatInput) {
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            }
        });
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
            updateThemeToggle();
        }
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('🔒 SHINEX Privacy Policy');
        console.log('📋 Protecting your privacy is our priority');
        console.log('📧 Contact: support@shinex.ng');
        console.log('🤖 AI Tutor ready to help!');
    </script>

</body>
</html>