<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Privacy – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div id="page-loader"><div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div><div class="loader-text">SHINEX</div><div class="loader-sub">LEARNING CIRCLE</div></div>
    <%- include(getHeader()) %>
    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5;">
                <h1 style="font-size:1.1rem; font-weight:800; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-shield-alt" style="color:var(--primary);"></i> Privacy
                </h1>
                <div style="font-size:0.85rem; line-height:1.7; color:var(--text-dark);">
                    <p><strong>Data Collection:</strong> We collect minimal data.</p>
                    <p><strong>Usage:</strong> Data personalizes your learning.</p>
                    <p><strong>Security:</strong> Industry-standard protection.</p>
                    <p><strong>Your Rights:</strong> Request data deletion anytime.</p>
                </div>
            </div>
        </div>
    </main>
    <%- include(getFooter()) %>
    <script src="/js/script.js"></script>
</body>
</html>