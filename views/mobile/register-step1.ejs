<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Register – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .mobile-register-card { padding: 20px 16px; background: #fff; border-radius: 16px; border: 1px solid #ede8f5; margin: 8px 0; }
        body.dark-mode .mobile-register-card { background: #1a1a1a; border-color: #333; }
        .mobile-register-card .logo { text-align: center; margin-bottom: 14px; }
        .mobile-register-card .logo .icon { background: #8B5CF6; width: 48px; height: 48px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 6px; }
        .mobile-register-card .logo .icon i { font-size: 1.5rem; color: #fff; }
        .mobile-register-card .logo h1 { font-size: 1.3rem; font-weight: 800; color: #1A0A2E; margin: 0; }
        body.dark-mode .mobile-register-card .logo h1 { color: #fff; }
        .mobile-register-card .logo p { color: #7a6a8f; font-size: 0.8rem; margin: 2px 0 0; }
        body.dark-mode .mobile-register-card .logo p { color: #b0a0c0; }
    </style>
</head>
<body>
    <%- include('partials/header', { user: null, showBack: false }) %>

    <main class="main-content" style="padding: 8px 12px 20px;">
        <div class="mobile-register-card">
            <div class="logo">
                <div class="icon"><i class="fas fa-user-plus"></i></div>
                <h1>Create Account</h1>
                <p>Step 1 of 2</p>
            </div>

            <% if (messages && messages.error) { %>
                <div class="alert alert-danger" style="margin-bottom:10px;"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success" style="margin-bottom:10px;"><%= messages.success %></div>
            <% } %>

            <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px;">
                <span style="background:#8B5CF6; color:#fff; padding:2px 10px; border-radius:20px; font-size:0.6rem; font-weight:600;">Step 1</span>
                <div class="progress-wrap" style="flex:1; height:6px;"><div class="progress-fill" style="width:50%; height:100%;"></div></div>
                <span style="color:#7a6a8f; font-size:0.6rem; font-weight:500;">50%</span>
            </div>

            <form action="/register/step1" method="POST" autocomplete="off">
                <div class="form-group">
                    <label for="fullName">Full Name</label>
                    <input type="text" id="fullName" name="fullName" class="form-control" placeholder="Enter your full name" required autocomplete="off">
                </div>
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email" required autocomplete="off">
                </div>
                <div class="form-group">
                    <label for="password">Password <span class="label-hint" style="font-size:0.65rem;">(min 6 chars)</span></label>
                    <div class="password-wrapper">
                        <input type="password" id="password" name="password" class="form-control" placeholder="Create a password" required minlength="6" autocomplete="new-password">
                        <i class="fas fa-eye password-toggle" onclick="togglePassword('password', this)"></i>
                    </div>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Confirm your password" required minlength="6" autocomplete="new-password">
                        <i class="fas fa-eye password-toggle" onclick="togglePassword('confirmPassword', this)"></i>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%; padding:14px; font-size:1rem;">
                    <i class="fas fa-arrow-right"></i> Continue to Profile
                </button>
                <p style="text-align:center; margin-top:12px; font-size:0.8rem; color:#7a6a8f;">
                    Already have an account? <a href="/login" style="color:#8B5CF6; font-weight:600;">Login</a>
                </p>
            </form>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        function togglePassword(id, icon) {
            const input = document.getElementById(id);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>