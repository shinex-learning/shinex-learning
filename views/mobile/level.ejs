    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:20px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:50px; height:50px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    👋 Hi! I'm your SHINEX AI Tutor. Ask me anything about this topic!
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script>
        // ============================================================
        // SIDEBAR TOGGLE
        // ============================================================
        
        function toggleSidebar() {
            const sidebar = document.getElementById('mobileSidebar');
            const arrow = document.getElementById('sidebarArrow');
            
            sidebar.classList.toggle('open');
            
            if (sidebar.classList.contains('open')) {
                arrow.className = 'fas fa-chevron-up';
            } else {
                arrow.className = 'fas fa-chevron-down';
            }
        }
        
        // ============================================================
        // THEME TOGGLE
        // ============================================================
        
        function updateThemeToggle() {
            const isDark = document.body.classList.contains('dark-mode');
            const icon = document.getElementById('themeIconMobile');
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }
        
        // ============================================================
        // AI BOT
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const botBtn = document.getElementById('aiBotBtn');
            const chatModal = document.getElementById('aiChatModal');
            const chatClose = document.getElementById('aiChatClose');
            const chatInput = document.getElementById('aiChatInput');
            const chatSend = document.getElementById('aiChatSend');
            const chatMessages = document.getElementById('aiChatMessages');
            
            if (!botBtn || !chatModal) return;
            
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
            
            if (chatClose) {
                chatClose.addEventListener('click', function() {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                });
            }
            
            document.addEventListener('click', function(e) {
                if (chatModal.classList.contains('open')) {
                    if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                        chatModal.classList.remove('open');
                        chatModal.style.display = 'none';
                    }
                }
            });
            
            function addChatMessage(text, type) {
                const div = document.createElement('div');
                div.className = 'ai-chat-msg ' + type;
                let formatted = text;
                formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\n/g, '<br>');
                div.innerHTML = formatted;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            
            function sendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;
                
                addChatMessage(message, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                chatSend.disabled = true;
                
                const loadingMsg = document.createElement('div');
                loadingMsg.className = 'ai-chat-msg bot';
                loadingMsg.innerHTML = '⏳ Thinking...';
                loadingMsg.id = 'aiChatLoading';
                chatMessages.appendChild(loadingMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                fetch('/api/ai-tutor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userPrompt: message })
                })
                .then(response => response.json())
                .then(data => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    
                    if (data.error) {
                        addChatMessage('❌ ' + data.error, 'bot');
                    } else {
                        addChatMessage(data.answer, 'bot');
                    }
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                    chatInput.focus();
                })
                .catch(error => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                });
            }
            
            if (chatSend) {
                chatSend.addEventListener('click', sendMessage);
            }
            
            if (chatInput) {
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            }
        });
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
            updateThemeToggle();
        }
        
        // ============================================================
        // AUTO DISMISS FLASH MESSAGES
        // ============================================================
        
        document.querySelectorAll('.flash-message').forEach(msg => {
            setTimeout(() => {
                msg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                msg.style.opacity = '0';
                msg.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    if (msg.parentNode) msg.remove();
                }, 500);
            }, 5000);
        });
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('📚 SHINEX Level Page');
        console.log('📖 Level: <%= level.name %>');
        console.log('📊 Progress: <%= progress || 0 %>%');
        console.log('⭐ Points: <%= score || 0 %>');
        console.log('📝 Test: <%= level.test && level.test.questions ? level.test.questions.length : 0 %> questions');
    </script>

</body>
</html>