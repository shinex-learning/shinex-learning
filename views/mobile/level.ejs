<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title><%= level.name %> – <%= course.title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           MOBILE LEVEL PAGE STYLES
           ============================================================ */
        
        .mobile-level-container {
            padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-xl);
            max-width: 500px;
            margin: 0 auto;
        }
        
        /* ----- Level Header ----- */
        .level-header {
            background: var(--purple-gradient);
            border-radius: var(--radius-lg);
            padding: var(--spacing-md);
            margin-bottom: var(--spacing-md);
            color: #fff;
        }
        
        .level-header .level-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 4px;
        }
        
        .level-header .level-top h1 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #fff;
            margin: 0;
        }
        
        .level-header .level-top .level-badge {
            font-size: 0.65rem;
            padding: 2px 12px;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            border-radius: var(--radius-full);
        }
        
        .level-header .level-progress {
            margin-top: var(--spacing-sm);
        }
        
        .level-header .level-progress .progress-label {
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.8);
            display: flex;
            justify-content: space-between;
        }
        
        .level-header .level-progress .progress-bar {
            height: 6px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: var(--radius-full);
            overflow: hidden;
            margin-top: 2px;
        }
        
        .level-header .level-progress .progress-bar .progress-fill {
            height: 100%;
            background: #fff;
            border-radius: var(--radius-full);
            transition: width 0.6s ease;
        }
        
        .level-header .level-score {
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.8);
            margin-top: 2px;
        }
        
        .level-header .level-score i {
            margin-right: 4px;
        }
        
        /* ----- Sidebar Toggle ----- */
        .sidebar-toggle {
            width: 100%;
            padding: 10px 14px;
            background: var(--bg-card-secondary);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-primary);
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-sm);
            transition: all 0.3s ease;
        }
        
        .sidebar-toggle:hover {
            border-color: var(--purple-primary);
        }
        
        .sidebar-toggle i {
            transition: transform 0.3s ease;
        }
        
        .sidebar-toggle .fa-chevron-up {
            transform: rotate(180deg);
        }
        
        /* ----- Sidebar ----- */
        .mobile-sidebar {
            display: none;
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: 8px 0;
            margin-bottom: var(--spacing-sm);
            max-height: 350px;
            overflow-y: auto;
            box-shadow: var(--shadow-sm);
        }
        
        .mobile-sidebar.open {
            display: block;
            animation: slideDown 0.3s ease;
        }
        
        @keyframes slideDown {
            0% { opacity: 0; transform: translateY(-10px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        
        .mobile-sidebar::-webkit-scrollbar {
            width: 4px;
        }
        
        .mobile-sidebar::-webkit-scrollbar-track {
            background: var(--bg-card-secondary);
            border-radius: var(--radius-full);
        }
        
        .mobile-sidebar::-webkit-scrollbar-thumb {
            background: var(--purple-primary);
            border-radius: var(--radius-full);
        }
        
        .mobile-sidebar .sidebar-title {
            padding: 6px 14px 8px;
            font-weight: 700;
            font-size: 0.85rem;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-primary);
        }
        
        .mobile-sidebar .sidebar-title i {
            color: var(--purple-primary);
            margin-right: 6px;
        }
        
        .mobile-sidebar .lesson-group {
            margin: 2px 0;
        }
        
        .mobile-sidebar .lesson-group .lesson-label {
            padding: 6px 14px;
            font-weight: 600;
            font-size: 0.75rem;
            background: var(--bg-card-secondary);
            color: var(--text-secondary);
            border-left: 3px solid var(--purple-primary);
        }
        
        .mobile-sidebar .class-link {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px 5px 28px;
            font-size: 0.75rem;
            text-decoration: none;
            color: var(--text-secondary);
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        
        .mobile-sidebar .class-link:hover:not(.locked) {
            background: var(--purple-bg);
        }
        
        .mobile-sidebar .class-link.locked {
            color: var(--text-light) !important;
            cursor: not-allowed;
        }
        
        .mobile-sidebar .class-link.active {
            background: var(--purple-bg);
            border-left-color: var(--purple-primary);
        }
        
        .mobile-sidebar .class-link.completed {
            color: var(--text-success);
        }
        
        .mobile-sidebar .class-link .class-number {
            font-weight: 600;
            color: var(--purple-primary);
            min-width: 22px;
        }
        
        .mobile-sidebar .class-link .class-title-text {
            flex: 1;
        }
        
        .mobile-sidebar .class-link .class-status-icon {
            font-size: 0.7rem;
        }
        
        /* ----- Class Section ----- */
        .class-section {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-md);
            margin-bottom: var(--spacing-sm);
            box-shadow: var(--shadow-sm);
        }
        
        .class-section .class-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 var(--spacing-sm) 0;
        }
        
        .class-section .class-content {
            font-size: 0.92rem;
            line-height: 1.8;
            color: var(--text-secondary);
        }
        
        .class-section .class-content h1,
        .class-section .class-content h2,
        .class-section .class-content h3 {
            color: var(--text-primary);
            margin-top: var(--spacing-md);
            margin-bottom: var(--spacing-sm);
        }
        
        .class-section .class-content p {
            margin-bottom: var(--spacing-sm);
        }
        
        .class-section .class-content ul,
        .class-section .class-content ol {
            padding-left: var(--spacing-md);
            margin-bottom: var(--spacing-sm);
        }
        
        .class-section .class-content li {
            margin-bottom: 4px;
        }
        
        .class-section .class-content strong,
        .class-section .class-content b {
            color: var(--text-primary);
        }
        
        .class-section .class-content hr {
            border: none;
            border-top: 2px solid var(--border-color);
            margin: var(--spacing-md) 0;
        }
        
        .class-section .class-image {
            margin: var(--spacing-sm) 0;
        }
        
        .class-section .class-image img {
            max-width: 100%;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }
        
        .class-section .class-video {
            margin: var(--spacing-sm) 0;
        }
        
        .class-section .class-video iframe {
            width: 100%;
            aspect-ratio: 16/9;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }
        
        .class-section .class-external {
            margin: var(--spacing-sm) 0;
        }
        
        .class-section .class-external .btn-external {
            width: 100%;
            padding: 10px;
            border-radius: var(--radius-full);
            background: var(--bg-card-secondary);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            text-decoration: none;
            display: block;
            text-align: center;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .class-section .class-external .btn-external:hover {
            border-color: var(--purple-primary);
            color: var(--purple-primary);
        }
        
        .class-section .class-external .btn-external i {
            margin-right: 6px;
        }
        
        .class-section .class-status {
            font-size: 0.78rem;
            margin-top: var(--spacing-sm);
            padding-top: var(--spacing-sm);
            border-top: 1px solid var(--border-color);
        }
        
        .class-section .class-status .status-completed {
            color: var(--text-success);
            font-weight: 600;
        }
        
        .class-section .class-status .status-locked {
            color: var(--text-light);
            font-weight: 600;
        }
        
        .class-section .class-status .status-pending {
            color: var(--text-muted);
            font-weight: 600;
        }
        
        /* ----- Navigation Buttons ----- */
        .nav-buttons {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-sm);
            margin-top: var(--spacing-sm);
        }
        
        .nav-buttons .nav-row {
            display: flex;
            gap: var(--spacing-sm);
        }
        
        .nav-buttons .nav-row .btn {
            flex: 1;
            font-size: 0.85rem;
            padding: 10px;
            min-height: 44px;
            border-radius: var(--radius-full);
            justify-content: center;
            border: none;
            text-decoration: none;
            display: block;
            text-align: center;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .nav-buttons .nav-row .btn:hover:not(:disabled) {
            transform: translateY(-2px);
        }
        
        .nav-buttons .nav-row .btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
        
        .nav-buttons .btn-complete {
            width: 100%;
            font-size: 0.85rem;
            padding: 10px;
            min-height: 44px;
            border-radius: var(--radius-full);
            background: var(--text-success);
            color: #fff;
            border: none;
            text-decoration: none;
            display: block;
            text-align: center;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .nav-buttons .btn-complete:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);
        }
        
        .nav-buttons .btn-complete:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
        
        /* ----- Test Section ----- */
        .test-section {
            margin-top: var(--spacing-md);
            padding: var(--spacing-md);
            border-radius: var(--radius-lg);
            border: 2px solid var(--text-warning);
            background: var(--bg-card);
        }
        
        .test-section .test-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 4px;
            margin-bottom: 4px;
        }
        
        .test-section .test-header h4 {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        
        .test-section .test-header h4 i {
            color: var(--text-warning);
            margin-right: 6px;
        }
        
        .test-section .test-header .test-badge {
            font-size: 0.65rem;
            padding: 2px 12px;
            border-radius: var(--radius-full);
            font-weight: 600;
        }
        
        .test-section .test-header .test-badge.passed {
            background: var(--bg-alert-success);
            color: var(--text-success);
        }
        
        .test-section .test-header .test-badge.failed {
            background: var(--bg-alert-error);
            color: var(--text-error);
        }
        
        .test-section .test-subtitle {
            font-size: 0.82rem;
            color: var(--text-secondary);
            margin: 0 0 var(--spacing-sm) 0;
        }
        
        .test-section .test-result {
            padding: var(--spacing-sm) var(--spacing-md);
            border-radius: var(--radius-sm);
            margin-top: var(--spacing-sm);
        }
        
        .test-section .test-result.passed {
            background: var(--bg-alert-success);
            color: var(--text-success);
        }
        
        .test-section .test-result.failed {
            background: var(--bg-alert-error);
            color: var(--text-error);
        }
        
        .test-section .test-result .result-score {
            font-weight: 700;
            font-size: 1rem;
        }
        
        .test-section .test-result .result-message {
            margin: 2px 0 0 0;
            font-size: 0.85rem;
        }
        
        .test-section .test-result .result-date {
            font-size: 0.7rem;
            opacity: 0.7;
            margin: 4px 0 0 0;
        }
        
        .test-section .test-question {
            padding: var(--spacing-sm) 0;
            border-bottom: 1px solid var(--border-color);
        }
        
        .test-section .test-question:last-child {
            border-bottom: none;
        }
        
        .test-section .test-question .q-text {
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .test-section .test-options label {
            font-size: 0.82rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 8px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .test-section .test-options label:hover {
            background: var(--purple-bg);
        }
        
        .test-section .test-options input[type="radio"] {
            width: 18px;
            height: 18px;
            accent-color: var(--purple-primary);
            cursor: pointer;
        }
        
        .test-section .btn-submit-test {
            width: 100%;
            margin-top: var(--spacing-sm);
            padding: 10px;
            border-radius: var(--radius-full);
            background: var(--text-warning);
            color: #fff;
            border: none;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .test-section .btn-submit-test:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(243, 156, 18, 0.3);
        }
        
        .test-section .test-locked {
            font-size: 0.82rem;
            color: var(--text-muted);
            margin-top: 6px;
        }
        
        .test-section .test-locked i {
            margin-right: 6px;
        }
        
        /* ----- Empty State ----- */
        .empty-state {
            padding: var(--spacing-xl) var(--spacing-md);
            border-radius: var(--radius-lg);
            text-align: center;
            background: var(--bg-card-secondary);
            border: 1px solid var(--border-color);
        }
        
        .empty-state .empty-icon {
            font-size: 2.5rem;
            display: block;
            margin-bottom: var(--spacing-sm);
            opacity: 0.5;
        }
        
        .empty-state h3 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
        }
        
        .empty-state p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin: 0;
        }
        
        /* ----- Alert ----- */
        .mobile-alert {
            font-size: 0.82rem;
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            margin-bottom: var(--spacing-sm);
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 400px) {
            .level-header .level-top h1 {
                font-size: 1rem;
            }
            
            .nav-buttons .nav-row {
                flex-direction: column;
            }
            
            .class-section .class-title {
                font-size: 1rem;
            }
            
            .class-section .class-content {
                font-size: 0.88rem;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    MOBILE HEADER (Built-in)
    ============================================================ -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:10px 14px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; flex-wrap:wrap; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="/course/<%= course.id %>" style="color:rgba(255,255,255,0.9); font-size:0.75rem; padding:4px 8px; text-decoration:none; display:flex; align-items:center; gap:4px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
                <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                <div>
                    <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); updateThemeToggle();" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 8px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon" id="themeIconMobile"></i>
            </button>
            <a href="/dashboard" style="background:rgba(255,255,255,0.2); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-user"></i>
            </a>
            <a href="/logout" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>
    </header>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <main class="main-content">
        <div class="mobile-level-container">

            <!-- Flash Messages -->
            <% if (messages && messages.success) { %>
                <div class="alert alert-success mobile-alert flash-message" data-type="success">
                    <i class="fas fa-check-circle"></i> <%= messages.success %>
                </div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger mobile-alert flash-message" data-type="error">
                    <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                </div>
            <% } %>

            <!-- ===== LEVEL HEADER ===== -->
            <div class="level-header">
                <div class="level-top">
                    <h1><%= level.name %></h1>
                    <span class="level-badge">
                        <i class="fas fa-book"></i> <%= totalClasses || 0 %> classes
                    </span>
                </div>
                <div class="level-progress">
                    <div class="progress-label">
                        <span><i class="fas fa-tasks"></i> Progress</span>
                        <span><%= completedClasses %>/<%= totalClasses %></span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: <%= progress || 0 %>%;"></div>
                    </div>
                    <div class="level-score">
                        <i class="fas fa-star"></i> <%= score || 0 %> points earned
                    </div>
                </div>
            </div>

            <!-- ===== SIDEBAR TOGGLE ===== -->
            <button class="sidebar-toggle" onclick="toggleSidebar()">
                <span><i class="fas fa-list"></i> Class List</span>
                <i class="fas fa-chevron-down" id="sidebarArrow"></i>
            </button>

            <!-- ===== SIDEBAR ===== -->
            <div class="mobile-sidebar" id="mobileSidebar">
                <div class="sidebar-title">
                    <i class="fas fa-layer-group"></i> <%= level.name %>
                </div>
                <% if (level.lessons && level.lessons.length > 0) { %>
                    <% level.lessons.forEach((lesson, lessonIndex) => { %>
                        <div class="lesson-group">
                            <div class="lesson-label">
                                Lesson <%= lessonIndex + 1 %>: <%= lesson.title %>
                            </div>
                            <% if (lesson.classes && lesson.classes.length > 0) { %>
                                <% lesson.classes.forEach((cls, classIndex) => { 
                                    const classData = allClasses ? allClasses.find(c => c.id === cls.id) : null;
                                    if (!classData) return;
                                %>
                                    <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= cls.id %>" 
                                       class="class-link <%= classData.locked ? 'locked' : '' %> <%= classData.completed ? 'completed' : '' %> <%= (currentClass && currentClass.id === cls.id) ? 'active' : '' %>"
                                       <% if (classData.locked) { %> onclick="return false;" <% } %>>
                                        <span class="class-number"><%= classIndex + 1 %></span>
                                        <span class="class-title-text"><%= cls.title %></span>
                                        <span class="class-status-icon">
                                            <% if (classData.completed) { %>
                                                <i class="fas fa-check-circle" style="color:var(--text-success);"></i>
                                            <% } else if (classData.locked) { %>
                                                <i class="fas fa-lock" style="color:var(--text-light);"></i>
                                            <% } else { %>
                                                <i class="far fa-circle" style="color:var(--text-muted);"></i>
                                            <% } %>
                                        </span>
                                    </a>
                                <% }) %>
                            <% } else { %>
                                <div style="padding:4px 14px 4px 28px; font-size:0.7rem; color:var(--text-muted);">
                                    <i class="fas fa-info-circle"></i> No classes
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div style="padding:12px 16px; color:var(--text-muted); font-size:0.8rem;">
                        <i class="fas fa-info-circle"></i> No lessons yet.
                    </div>
                <% } %>
            </div>

            <!-- ===== CLASS CONTENT ===== -->
            <div class="class-section">
                <% if (currentClass) { %>
                    <h2 class="class-title"><%= currentClass.title %></h2>
                    
                    <div class="class-content">
                        <%= currentClass.content ? currentClass.content : '<p>No content available.</p>' %>
                    </div>
                    
                    <!-- Image -->
                    <% if (currentClass.imageUrl) { %>
                        <div class="class-image">
                            <img src="<%= currentClass.imageUrl %>" alt="<%= currentClass.title %>" loading="lazy">
                        </div>
                    <% } %>
                    
                    <!-- Video -->
                    <% if (currentClass.videoUrl) { %>
                        <div class="class-video">
                            <iframe src="<%= currentClass.videoUrl %>" frameborder="0" allowfullscreen></iframe>
                        </div>
                    <% } %>
                    
                    <!-- External Link -->
                    <% if (currentClass.externalLink) { %>
                        <div class="class-external">
                            <a href="<%= currentClass.externalLink %>" target="_blank" class="btn-external">
                                <i class="fas fa-external-link-alt"></i> Open External Resource
                            </a>
                        </div>
                    <% } %>
                    
                    <!-- Status -->
                    <div class="class-status">
                        <% if (currentClass.completed) { %>
                            <span class="status-completed"><i class="fas fa-check-circle"></i> Completed</span>
                        <% } else if (currentClass.locked) { %>
                            <span class="status-locked"><i class="fas fa-lock"></i> Locked – Complete previous class</span>
                        <% } else { %>
                            <span class="status-pending"><i class="far fa-circle"></i> Not completed</span>
                        <% } %>
                    </div>
                    
                <% } else { %>
                    <div class="empty-state">
                        <span class="empty-icon">📖</span>
                        <h3>No Class Selected</h3>
                        <p>Select a class from the list above to start learning.</p>
                    </div>
                <% } %>
            </div>

            <!-- ===== NAVIGATION BUTTONS ===== -->
            <div class="nav-buttons">
                <div class="nav-row">
                    <% if (prevClassId) { %>
                        <a href="/level/<%= course.id %>/<%= level.id %>/prev/<%= prevClassId %>" class="btn btn-secondary" style="background:var(--bg-card-secondary); color:var(--text-primary);">
                            <i class="fas fa-arrow-left"></i> Previous
                        </a>
                    <% } else { %>
                        <span class="btn btn-secondary" style="background:var(--bg-card-secondary); color:var(--text-muted); opacity:0.4; cursor:not-allowed;">
                            <i class="fas fa-arrow-left"></i> Previous
                        </span>
                    <% } %>
                    
                    <% if (nextClassId && !nextLocked) { %>
                        <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= nextClassId %>" class="btn btn-primary" style="background:var(--purple-primary); color:#fff;">
                            Next <i class="fas fa-arrow-right"></i>
                        </a>
                    <% } else if (nextClassId && nextLocked) { %>
                        <span class="btn btn-secondary" style="background:var(--bg-card-secondary); color:var(--text-muted); opacity:0.5; cursor:not-allowed;">
                            <i class="fas fa-lock"></i> Locked
                        </span>
                    <% } else { %>
                        <span class="btn btn-secondary" style="background:var(--bg-card-secondary); color:var(--text-muted); opacity:0.4; cursor:not-allowed;">
                            <i class="fas fa-check"></i> Complete!
                        </span>
                    <% } %>
                </div>
                
                <% if (currentClass && !currentClass.completed && !currentClass.locked) { %>
                    <a href="/level/<%= course.id %>/<%= level.id %>/next/<%= currentClass.id %>" class="btn-complete">
                        <i class="fas fa-check"></i> Complete &amp; Next
                    </a>
                <% } else if (currentClass && currentClass.completed) { %>
                    <span class="btn-complete" style="opacity:0.6; cursor:default; background:var(--text-success);">
                        <i class="fas fa-check-circle"></i> Completed
                    </span>
                <% } %>
            </div>

            <!-- ===== LEVEL TEST ===== -->
            <% if (level.test && level.test.questions && level.test.questions.length > 0) { 
                const testResult = user && user.testResults && user.testResults[level.id];
            %>
                <div class="test-section">
                    <div class="test-header">
                        <h4><i class="fas fa-pencil-alt"></i> Level Test</h4>
                        <% if (testResult) { %>
                            <span class="test-badge <%= testResult.passed ? 'passed' : 'failed' %>">
                                <%= testResult.score %>/<%= testResult.total %> 
                                <%= testResult.passed ? '✅' : '❌' %>
                            </span>
                        <% } %>
                    </div>
                    <p class="test-subtitle">Test your knowledge after completing all classes.</p>
                    
                    <% if (testResult) { %>
                        <div class="test-result <%= testResult.passed ? 'passed' : 'failed' %>">
                            <div class="result-score">
                                <%= testResult.score %> out of <%= testResult.total %> correct
                            </div>
                            <div class="result-message">
                                <%= testResult.passed ? '🎉 Congratulations, you passed this level!' : '📚 Keep reviewing and try again.' %>
                            </div>
                            <div class="result-date">
                                Completed: <%= new Date(testResult.date).toLocaleDateString() %>
                            </div>
                        </div>
                    <% } else if (completedClasses === totalClasses && totalClasses > 0) { %>
                        <form action="/level/<%= course.id %>/<%= level.id %>/test/submit" method="POST">
                            <% level.test.questions.forEach((q, qIndex) => { %>
                                <div class="test-question">
                                    <p class="q-text"><%= qIndex + 1 %>. <%= q.question %></p>
                                    <div class="test-options">
                                        <% q.options.forEach((opt, oIndex) => { %>
                                            <label>
                                                <input type="radio" name="q_<%= q.id %>" value="<%= oIndex %>" required>
                                                <%= opt %>
                                            </label>
                                        <% }) %>
                                    </div>
                                </div>
                            <% }) %>
                            <button type="submit" class="btn-submit-test">
                                <i class="fas fa-paper-plane"></i> Submit Test
                            </button>
                        </form>
                    <% } else { %>
                        <div class="test-locked">
                            <i class="fas fa-lock"></i> 
                            Complete all classes (<%= completedClasses %>/<%= totalClasses %>) to unlock the test.
                        </div>
                    <% } %>
                </div>
            <% } %>

        </div>
    </main>

    <!-- ============================================================
    MOBILE FOOTER (Built-in)
    ============================================================ -->
