<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title><%= level.name %> – <%= course.title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-level-container { padding: 10px 12px 24px; max-width: 500px; margin: 0 auto; }
        .mobile-level-header { padding: 14px 16px !important; border-radius: 12px !important; margin-bottom: 12px !important; background: linear-gradient(135deg, #8B5CF6, #6a3dcf) !important; color: #fff !important; }
        .mobile-level-header h1 { font-size: 1.1rem !important; margin: 0 !important; color: #fff !important; }
        .mobile-level-header .level-badge { font-size: 0.7rem !important; padding: 2px 10px !important; background: rgba(255,255,255,0.2) !important; color: #fff !important; border-radius: 20px !important; }
        .mobile-progress-bar { margin: 8px 0 4px; }
        .mobile-progress-bar .progress-label { font-size: 0.7rem !important; color: #d4c4f0 !important; }
        .mobile-progress-bar .progress-wrap { height: 6px !important; background: rgba(255,255,255,0.2) !important; border-radius: 10px !important; }
        .mobile-progress-bar .progress-fill { height: 100% !important; background: #fff !important; border-radius: 10px !important; }
        .mobile-score-display { font-size: 0.7rem !important; color: #d4c4f0 !important; margin-top: 2px !important; }
        .mobile-class-section { background: var(--bg-light); border-radius: 12px; border: 1px solid #ede8f5; padding: 14px 16px; margin-bottom: 12px; }
        body.dark-mode .mobile-class-section { background: var(--dark-card); border-color: var(--dark-border); }
        .mobile-class-title { font-size: 1.1rem !important; font-weight: 700 !important; margin: 0 0 8px !important; color: var(--text-dark); }
        .mobile-class-content { font-size: 0.92rem !important; line-height: 1.7 !important; color: var(--text-dark); }
        .mobile-class-content img { max-width: 100% !important; height: auto !important; border-radius: 8px !important; }
        .mobile-class-content iframe { width: 100% !important; aspect-ratio: 16/9 !important; border-radius: 8px !important; }
        .mobile-class-status { font-size: 0.78rem !important; margin-top: 10px !important; padding-top: 10px !important; border-top: 1px solid #ede8f5; }
        body.dark-mode .mobile-class-status { border-color: var(--dark-border); }
        .mobile-nav-buttons { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
        .mobile-nav-buttons .btn { width: 100%; font-size: 0.85rem !important; padding: 10px !important; min-height: 44px !important; border-radius: 30px !important; justify-content: center; border: none !important; text-decoration: none; display: block; text-align: center; }
        .mobile-nav-row { display: flex; gap: 8px; }
        .mobile-nav-row .btn { flex: 1; }
        .mobile-sidebar-toggle { width: 100%; padding: 10px; background: #f0ebfb; border: 1px solid #ede8f5; border-radius: 10px; font-weight: 600; font-size: 0.85rem; color: var(--text-dark); cursor: pointer; display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        body.dark-mode .mobile-sidebar-toggle { background: var(--dark-card); border-color: var(--dark-border); color: var(--text-light); }
        .mobile-sidebar { display: none; background: var(--bg-light); border-radius: 12px; border: 1px solid #ede8f5; padding: 8px 0; margin-bottom: 12px; max-height: 300px; overflow-y: auto; }
        body.dark-mode .mobile-sidebar { background: var(--dark-card); border-color: var(--dark-border); }
        .mobile-sidebar.open { display: block; }
        .mobile-sidebar .sidebar-header { padding: 6px 14px 8px; font-weight: 700; font-size: 0.85rem; border-bottom: 1px solid #ede8f5; color: var(--text-dark); }
        body.dark-mode .mobile-sidebar .sidebar-header { border-color: var(--dark-border); color: var(--text-light); }
        .mobile-sidebar .lesson-header { padding: 6px 14px; font-weight: 600; font-size: 0.8rem; background: #f8f6fc; color: var(--text-dark); }
        body.dark-mode .mobile-sidebar .lesson-header { background: #1a1a1a; color: var(--text-light); }
        .mobile-sidebar .class-link { display: flex; align-items: center; gap: 6px; padding: 5px 14px 5px 28px; font-size: 0.75rem; text-decoration: none; color: #4a3a60; }
        body.dark-mode .mobile-sidebar .class-link { color: #cccccc; }
        .mobile-sidebar .class-link.locked { color: #b0a3c4 !important; cursor: not-allowed; }
        .mobile-sidebar .class-link.active { background: #f0ebfb; border-left: 3px solid #8B5CF6; padding-left: 25px; }
        body.dark-mode .mobile-sidebar .class-link.active { background: #2a1a4a; }
        .mobile-sidebar .class-link.completed { color: #27ae60; }
        .mobile-test-section { margin-top: 12px; padding: 14px 16px !important; border-radius: 12px !important; border: 2px solid #f7d44a !important; background: var(--bg-light) !important; }
        body.dark-mode .mobile-test-section { background: var(--dark-card) !important; }
        .mobile-test-section h4 { font-size: 0.95rem !important; margin: 0 0 4px !important; color: var(--text-dark); }
        .mobile-test-section p { font-size: 0.82rem !important; color: var(--text-muted); }
        .mobile-test-question { padding: 10px 0; border-bottom: 1px solid #ede8f5; }
        body.dark-mode .mobile-test-question { border-color: var(--dark-border); }
        .mobile-test-question:last-child { border-bottom: none; }
        .mobile-test-question .q-text { font-weight: 600; font-size: 0.88rem !important; color: var(--text-dark); }
        .mobile-test-options label { font-size: 0.82rem !important; padding: 4px 8px !important; color: var(--text-dark); display: flex; align-items: center; gap: 8px; }
        .mobile-test-options input[type="radio"] { width: 18px !important; height: 18px !important; accent-color: #8B5CF6; }
        .mobile-test-result { padding: 12px; border-radius: 8px; margin-top: 8px; }
        .mobile-test-result.passed { background: #d5f5e3; color: #1a7a4a; }
        .mobile-test-result.failed { background: #fadbd8; color: #922b21; }
        body.dark-mode .mobile-test-result.passed { background: #1a3a2a; color: #7dcea0; }
        body.dark-mode .mobile-test-result.failed { background: #3a1a1a; color: #f1948a; }
        .mobile-alert { font-size: 0.82rem !important; padding: 10px 14px !important; border-radius: 8px !important; margin-bottom: 10px !important; }
        .empty-state { padding: 24px !important; border-radius: 12px !important; text-align: center !important; background: #f8f6fc !important; border: 1px solid #ede8f5 !important; }
        .empty-state .empty-icon { font-size: 2rem; display: block; margin-bottom: 8px; opacity: 0.3; }
        .empty-state h3 { font-size: 1rem !important; margin: 0 0 4px !important; color: var(--text-dark); }
        .empty-state p { font-size: 0.85rem !important; margin: 0 !important; color: var(--text-muted); }
        body.dark-mode .empty-state { background: #1a1a1a !important; border-color: var(--dark-border) !important; }
        @media (max-width: 400px) { .mobile-nav-row { flex-direction: column; } .mobile-class-content { font-size: 0.88rem !important; } }
    </style>
</head>
<body>
    <!-- ===== MOBILE HEADER ===== -->
    <header class="header" style="padding:8px 12px; flex-wrap:nowrap;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="javascript:history.back()" class="back-btn" style="font-size:0.75rem; padding:4px 8px; color:rgba(255,255,255,0.9); text-decoration:none; display:flex; align-items:center; gap:4px;"><i class="fas fa-arrow-left"></i></a>
            <a href="/" class="logo-container" style="gap:8px; text-decoration:none;">
                <div class="logo" style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:10px;">SLC</div>
                <div style="line-height:1.1;">
                    <div class="logo-text" style="font-size:13px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div class="logo-sub" style="font-size:6px; color:rgba(255,255,255,0.7);">LEARNING</div>
                </div>
            </a>
        </div>
        <div class="header-actions" style="gap:4px; flex-wrap:nowrap;">
            <button class="dark-toggle" id="darkToggleMobile" onclick="toggleDarkModeMobile()" style="padding:4px 8px; font-size:1rem; background:rgba(255,255,255,0.15); border:none; border-radius:30px; color:#fff; cursor:pointer;">🌙</button>
        </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="mobile-level-container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success mobile-alert"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger mobile-alert"><%= messages.error %></div>
            <% } %>

            <!-- Level Header -->
            <div class="mobile-level-header">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap;">
                    <h1><%= level.name %></h1>
                    <span class="level-badge"><%= totalClasses || 0 %> classes</span>
                </div>
                <div class="mobile-progress-bar">
                    <div class="progress-label" style="display:flex; justify-content:space-between;">
                        <span>Progress</span>
                        <span><%= completedClasses %>/<%= totalClasses %></span>
                    </div>
                    <div class="progress-wrap"><div class="progress-fill" style="width:<%= progress || 0 %>%;"></div></div>
                    <div class="mobile-score-display"><i class="fas fa-star"></i> <%= score || 0 %> points</div>
                </div>
            </div>

            <!-- Sidebar Toggle -->
            <button class="mobile-sidebar-toggle" onclick="toggleSidebar()">
                <span><i class="fas fa-list"></i> Class List</span>
                <i class="fas fa-chevron-down" id="sidebarArrow"></i>
            </button>

            <!-- Sidebar -->
            <div class="mobile-sidebar" id="mobileSidebar">
                <div class="sidebar-header"><%= level.name %></div>
                <% if (level.lessons && level.lessons.length) { %>
                    <% level.lessons.forEach((lesson, li) => { %>
                        <div class="lesson-header">Lesson <%= li+1 %>: <%= lesson.title %></div>
                        <% lesson.classes.forEach((cls, ci) => { 
                            const classData = allClasses.find(c => c.id === cls.id);
                            if (!classData) return;
                        %>
                            <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= cls.id %>" 
                               class="class-link <%= (classData.locked) ? 'locked' : '' %> <%= (classData.completed) ? 'completed' : '' %> <%= (currentClass && currentClass.id === cls.id) ? 'active' : '' %>"
                               <% if (classData.locked) { %> onclick="return false;" <% } %>>
                                <span><%= ci+1 %></span>
                                <span style="flex:1;"><%= cls.title %></span>
                                <% if (classData.completed) { %><i class="fas fa-check-circle" style="color:#27ae60;"></i>
                                <% } else if (classData.locked) { %><i class="fas fa-lock" style="color:#b0a3c4;"></i>
                                <% } else { %><i class="far fa-circle" style="color:#b0a3c4;"></i><% } %>
                            </a>
                        <% }) %>
                    <% }) %>
                <% } else { %>
                    <div style="padding:12px 16px; color:var(--text-muted); font-size:0.8rem;">No lessons yet.</div>
                <% } %>
            </div>

            <!-- Class Content -->
            <div class="mobile-class-section">
                <% if (currentClass) { %>
                    <h2 class="mobile-class-title"><%= currentClass.title %></h2>
                    <div class="mobile-class-content">
                        <%= currentClass.content ? currentClass.content : '<p>No content available.</p>' %>
                    </div>
                    <% if (currentClass.imageUrl) { %>
                        <div style="margin:8px 0;"><img src="<%= currentClass.imageUrl %>" alt="<%= currentClass.title %>" loading="lazy" style="max-width:100%; border-radius:8px;"></div>
                    <% } %>
                    <% if (currentClass.videoUrl) { %>
                        <div style="margin:8px 0;"><iframe src="<%= currentClass.videoUrl %>" frameborder="0" allowfullscreen></iframe></div>
                    <% } %>
                    <% if (currentClass.externalLink) { %>
                        <div style="margin:8px 0;"><a href="<%= currentClass.externalLink %>" target="_blank" class="btn btn-secondary btn-sm" style="width:100%; border-radius:30px; background:#ede8f5; color:#1A0A2E; text-decoration:none; display:block; text-align:center; padding:8px;"><i class="fas fa-external-link-alt"></i> Open External Resource</a></div>
                    <% } %>
                    <div class="mobile-class-status">
                        <% if (currentClass.completed) { %>
                            <span style="color:#27ae60; font-weight:600;"><i class="fas fa-check-circle"></i> Completed</span>
                        <% } else if (currentClass.locked) { %>
                            <span style="color:#b0a3c4; font-weight:600;"><i class="fas fa-lock"></i> Locked – Complete previous class</span>
                        <% } else { %>
                            <span style="color:#b0a3c4; font-weight:600;"><i class="far fa-circle"></i> Not completed</span>
                        <% } %>
                    </div>
                <% } else { %>
                    <div style="text-align:center; padding:20px 0; color:var(--text-muted);"><i class="fas fa-book" style="font-size:2rem; display:block; margin-bottom:8px; opacity:0.3;"></i><p style="font-size:0.9rem;">No class selected.</p></div>
                <% } %>
            </div>

            <!-- Navigation -->
            <div class="mobile-nav-buttons">
                <div class="mobile-nav-row">
                    <% if (prevClassId) { %>
                        <a href="/level/<%= course.id %>/<%= level.id %>/prev/<%= prevClassId %>" class="btn btn-secondary" style="background:#ede8f5; color:#1A0A2E;"><i class="fas fa-arrow-left"></i> Previous</a>
                    <% } else { %>
                        <span class="btn btn-secondary" style="opacity:0.4; cursor:not-allowed; background:#ede8f5; color:#1A0A2E;"><i class="fas fa-arrow-left"></i> Previous</span>
                    <% } %>
                    <% if (nextClassId && !nextLocked) { %>
                        <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= nextClassId %>" class="btn btn-primary" style="background:#8B5CF6; color:#fff;">Next <i class="fas fa-arrow-right"></i></a>
                    <% } else if (nextClassId && nextLocked) { %>
                        <span class="btn btn-secondary" style="opacity:0.5; cursor:not-allowed; background:#ede8f5; color:#1A0A2E;"><i class="fas fa-lock"></i> Locked</span>
                    <% } else { %>
                        <span class="btn btn-secondary" style="opacity:0.4; cursor:not-allowed; background:#ede8f5; color:#1A0A2E;"><i class="fas fa-check"></i> Complete!</span>
                    <% } %>
                </div>
                <% if (currentClass && !currentClass.completed && !currentClass.locked) { %>
                    <a href="/level/<%= course.id %>/<%= level.id %>/next/<%= currentClass.id %>" class="btn btn-success" style="background:#27ae60; color:#fff;"><i class="fas fa-check"></i> Complete &amp; Next</a>
                <% } else if (currentClass && currentClass.completed) { %>
                    <span class="btn btn-success" style="opacity:0.6; cursor:default; background:#27ae60; color:#fff;"><i class="fas fa-check-circle"></i> Completed</span>
                <% } %>
            </div>

            <!-- ===== LEVEL TEST ===== -->
            <% if (level.test && level.test.questions && level.test.questions.length > 0) { 
                const testResult = user && user.testResults && user.testResults[level.id];
            %>
                <div class="mobile-test-section">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap;">
                        <div><h4><i class="fas fa-pencil-alt"></i> Level Test</h4><p>Test your knowledge after completing all classes.</p></div>
                        <% if (testResult) { %>
                            <span class="badge <%= testResult.passed ? 'badge-green' : 'badge-red' %>" style="font-size:0.65rem;"><%= testResult.score %>/<%= testResult.total %> <%= testResult.passed ? '✅' : '❌' %></span>
                        <% } %>
                    </div>
                    <% if (testResult) { %>
                        <div class="mobile-test-result <%= testResult.passed ? 'passed' : 'failed' %>">
                            <strong><%= testResult.score %> out of <%= testResult.total %> correct</strong>
                            <p style="margin:2px 0 0; font-size:0.8rem;"><%= testResult.passed ? '🎉 Congratulations, you passed this level!' : '📚 Keep reviewing and try again.' %></p>
                            <p style="font-size:0.7rem; margin:4px 0 0; opacity:0.7;">Completed: <%= new Date(testResult.date).toLocaleDateString() %></p>
                        </div>
                    <% } else if (completedClasses === totalClasses && totalClasses > 0) { %>
                        <form action="/level/<%= course.id %>/<%= level.id %>/test/submit" method="POST" style="margin-top:8px;">
                            <% level.test.questions.forEach((q, qi) => { %>
                                <div class="mobile-test-question">
                                    <p class="q-text"><%= qi+1 %>. <%= q.question %></p>
                                    <div class="mobile-test-options">
                                        <% q.options.forEach((opt, oi) => { %>
                                            <label><input type="radio" name="q_<%= q.id %>" value="<%= oi %>" required> <%= opt %></label>
                                        <% }) %>
                                    </div>
                                </div>
                            <% }) %>
                            <button type="submit" class="btn btn-gold" style="width:100%; margin-top:6px; border-radius:30px; background:#f39c12; color:#fff; border:none; padding:10px; font-size:0.85rem;"><i class="fas fa-paper-plane"></i> Submit Test</button>
                        </form>
                    <% } else { %>
                        <p style="font-size:0.82rem; color:var(--text-muted); margin-top:6px;"><i class="fas fa-info-circle"></i> Complete all classes (<%= completedClasses %>/<%= totalClasses %>) to unlock the test.</p>
                    <% } %>
                </div>
            <% } %>
        </div>
    </main>

    <!-- ===== MOBILE FOOTER ===== -->
    <footer class="footer" style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div class="container">
            <div style="text-align:center;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:6px;">
                    <div class="logo" style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div><div class="logo-text" style="font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div></div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:4px 0 8px;">Learn. Understand. Protect.</p>
                <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px 16px; margin:12px 0;">
                    <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Home</a>
                    <a href="/courses" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Courses</a>
                    <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Services</a>
                    <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">About</a>
                    <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Contact</a>
                    <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">FAQ</a>
                </div>
                <div style="display:flex; justify-content:center; gap:12px; margin:8px 0 12px;">
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-twitter"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-instagram"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-whatsapp"></i></a>
                </div>
                <div class="footer-bottom" style="border-top:1px solid rgba(255,255,255,0.1); padding-top:10px; font-size:0.7rem; color:rgba(255,255,255,0.6);">&copy; <%= new Date().getFullYear() %> SHINEX Learning Circle</div>
            </div>
        </div>
    </footer>

    <!-- ===== AI BOT ===== -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:26px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">🤖<span class="ai-bot-pulse" style="position:absolute; width:60px; height:60px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span></button>
    </div>
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:#fff; border-radius:14px; border:1px solid #ede8f5; box-shadow:0 20px 60px rgba(0,0,0,0.15); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:#8B5CF6; color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px;">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:10px; font-size:0.9rem; max-width:85%; line-height:1.5; background:#f0ebfb; color:#1A0A2E; align-self:flex-start; border-bottom-left-radius:4px;">👋 Hi! I'm your SHINEX AI Tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid #ede8f5; display:flex; gap:8px;">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:8px; border:1px solid #ede8f5; font-size:0.85rem;">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:30px; background:#8B5CF6; color:#fff; font-weight:600; cursor:pointer;">Send</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js"></script>
    <script src="/js/main.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('mobileSidebar');
            const arrow = document.getElementById('sidebarArrow');
            sidebar.classList.toggle('open');
            arrow.classList.toggle('fa-chevron-down');
            arrow.classList.toggle('fa-chevron-up');
        }
        function toggleDarkModeMobile() {
            const body = document.body;
            body.classList.toggle('dark-mode');
            const isDark = body.classList.contains('dark-mode');
            localStorage.setItem('shinex-dark-mode', isDark);
            const btn = document.getElementById('darkToggleMobile');
            if (btn) btn.textContent = isDark ? '☀️' : '🌙';
        }
        document.addEventListener('DOMContentLoaded', function() {
            const savedDark = localStorage.getItem('shinex-dark-mode');
            if (savedDark === 'true') {
                document.body.classList.add('dark-mode');
                const btn = document.getElementById('darkToggleMobile');
                if (btn) btn.textContent = '☀️';
            }
        });
    </script>
</body>
</html>