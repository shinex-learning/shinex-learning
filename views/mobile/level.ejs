<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title><%= level.name %> – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .class-link-mobile.locked {
            color: #b0a3c4;
            cursor: not-allowed;
            opacity: 0.5;
            pointer-events: none;
        }
        .class-link-mobile.locked::after { content: ' 🔒'; font-size: 0.6rem; }
        .class-link-mobile.unlocked { color: var(--text-dark); cursor: pointer; }
        body.dark-mode .class-link-mobile.unlocked { color: var(--text-light); }
        .class-link-mobile.unlocked::after { content: ' 🔓'; font-size: 0.6rem; }
        .class-link-mobile.completed { color: #27ae60 !important; }
        .class-link-mobile.completed::after { content: ' ✅'; font-size: 0.6rem; }
        .class-link-mobile.current {
            background: var(--primary-bg);
            border-left: 3px solid var(--primary);
            font-weight: 600;
        }
        body.dark-mode .class-link-mobile.current { background: #2a1a4a; }
        .class-link-mobile {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px 4px 16px;
            font-size: 0.75rem;
            transition: all 0.2s ease;
            text-decoration: none;
            border-left: 3px solid transparent;
            border-radius: 4px;
        }
        .class-link-mobile:hover:not(.locked):not(.completed) { background: #f0ebfb; }
        body.dark-mode .class-link-mobile:hover:not(.locked):not(.completed) { background: #2a1a4a; }
        .lesson-header-mobile.locked { opacity: 0.5; }
        .lesson-header-mobile .lock-icon { margin-left: auto; font-size: 0.6rem; color: var(--text-muted); }
        .lesson-header-mobile .check-icon { margin-left: auto; font-size: 0.6rem; color: #27ae60; }
        .progress-fill { transition: width 0.8s ease; }
        .auto-complete-badge-mobile {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.55rem;
            background: var(--primary-bg);
            color: var(--primary);
            font-weight: 600;
        }
        body.dark-mode .auto-complete-badge-mobile { background: #2a1a4a; }
        .btn.loading { opacity: 0.7; pointer-events: none; }
        .class-grid-mobile { display: flex; flex-direction: column; gap: 4px; margin-top: 6px; }
        .class-item-mobile { padding: 2px 0; }
        .status-completed-mobile { color: #27ae60; font-weight: 600; font-size: 0.75rem; }
        .status-pending-mobile { color: #b0a3c4; font-weight: 600; font-size: 0.75rem; }
        .status-locked-mobile { color: #b0a3c4; font-size: 0.75rem; }
        .progress-wrap-mobile {
            background: #ede8f5;
            border-radius: 20px;
            overflow: hidden;
            height: 6px;
        }
        body.dark-mode .progress-wrap-mobile { background: #2a2a2a; }
        .progress-fill-mobile {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--primary-light));
            border-radius: 20px;
            transition: width 0.8s ease;
        }
        .nav-buttons-mobile { display: flex; flex-direction: column; gap: 8px; }
        .nav-buttons-mobile .btn { width: 100%; text-align: center; }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <div>
                    <div style="font-size:0.7rem; color:var(--text-muted);">
                        <a href="/course/<%= course.id %>" style="color:var(--text-muted); text-decoration:none;">
                            <i class="fas fa-arrow-left"></i> <%= course.title %>
                        </a>
                    </div>
                    <div style="font-weight:700; font-size:1rem; color:var(--text-dark);"><%= level.name %></div>
                </div>
                <span class="badge badge-purple" style="font-size:0.6rem;"><%= course.level || 'Beginner' %></span>
            </div>

            <!-- Progress Bar -->
            <div style="background:#fff; border-radius:10px; padding:10px 14px; border:1px solid #ede8f5; margin-bottom:10px;">
                <div style="display:flex; justify-content:space-between; font-size:0.7rem; font-weight:500; color:var(--text-dark);">
                    <span>Progress</span>
                    <span>
                        <% 
                            let allClassIds = [];
                            if (level.lessons) {
                                level.lessons.forEach(function(lesson) {
                                    if (lesson.classes) {
                                        lesson.classes.forEach(function(cls) {
                                            allClassIds.push(cls.id);
                                        });
                                    }
                                });
                            }
                            let completed = 0;
                            let total = allClassIds.length;
                            if (session && session.progress) {
                                allClassIds.forEach(function(id) {
                                    if (session.progress[id]) completed++;
                                });
                            }
                            let progressPercent = total > 0 ? Math.round((completed / total) * 100) : 0;
                        %>
                        <%= completed %> / <%= total %> • <%= progressPercent %>% 
                    </span>
                </div>
                <div class="progress-wrap-mobile" style="margin-top:2px;">
                    <div class="progress-fill-mobile" style="width:<%= progressPercent %>%;"></div>
                </div>
                <div style="font-size:0.65rem; color:var(--text-muted); margin-top:2px;">
                    <i class="fas fa-star" style="color:#f39c12;"></i> Score: <strong><%= completed * 10 %></strong> points
                </div>
            </div>

            <!-- Class Content -->
            <% if (currentClass) { 
                let allClassIds = [];
                if (level.lessons) {
                    level.lessons.forEach(function(lesson) {
                        if (lesson.classes) {
                            lesson.classes.forEach(function(cls) {
                                allClassIds.push(cls.id);
                            });
                        }
                    });
                }
                let currentIndex = allClassIds.indexOf(currentClass.id);
                let isClassLocked = false;
                if (currentIndex > 0) {
                    let prevClassId = allClassIds[currentIndex - 1];
                    if (!(session && session.progress && session.progress[prevClassId])) {
                        isClassLocked = true;
                    }
                }
            %>
                <div style="background:#fff; border-radius:10px; padding:14px 16px; border:1px solid #ede8f5; margin-bottom:10px;">
                    <div style="font-weight:600; font-size:0.9rem; color:var(--text-dark); margin-bottom:4px;">
                        <%= currentLesson ? currentLesson.title : '' %>: <%= currentClass.title %>
                    </div>
                    <div style="font-size:0.85rem; line-height:1.7; color:var(--text-dark);">
                        <% if (currentClass.videoUrl) { %>
                            <div style="margin:6px 0;">
                                <iframe src="<%= currentClass.videoUrl %>" frameborder="0" allowfullscreen style="width:100%; aspect-ratio:16/9; border-radius:8px;"></iframe>
                            </div>
                        <% } %>
                        <% if (currentClass.imageUrl) { %>
                            <div style="margin:6px 0;">
                                <img src="<%= currentClass.imageUrl %>" alt="<%= currentClass.title %>" style="width:100%; border-radius:8px;">
                            </div>
                        <% } %>
                        <%- currentClass.content || 'No content available.' %>
                    </div>

                    <div style="margin-top:10px; padding-top:10px; border-top:1px solid #ede8f5; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:6px;">
                        <% if (isClassLocked) { %>
                            <span class="status-locked-mobile"><i class="fas fa-lock"></i> Complete previous class to unlock</span>
                        <% } else if (session && session.progress && session.progress[currentClass.id]) { %>
                            <span class="status-completed-mobile"><i class="fas fa-check-circle"></i> Completed ✓</span>
                        <% } else { %>
                            <span class="status-pending-mobile"><i class="far fa-circle"></i> Not completed</span>
                        <% } %>
                    </div>
                </div>

                <!-- Navigation -->
                <div class="nav-buttons-mobile">
                    <div style="display:flex; gap:8px;">
                        <% if (prevClassId && !isClassLocked) { %>
                            <a href="/level/<%= course.id %>/<%= level.id %>/prev/<%= currentClass.id %>" class="btn btn-secondary btn-sm" style="flex:1; font-size:0.8rem; padding:8px;">
                                <i class="fas fa-arrow-left"></i> Prev
                            </a>
                        <% } else { %>
                            <span style="flex:1;"></span>
                        <% } %>

                        <a href="/course/<%= course.id %>" class="btn btn-outline btn-sm" style="font-size:0.8rem; padding:8px;">
                            <i class="fas fa-list"></i>
                        </a>

                        <% if (!isClassLocked && !(session && session.progress && session.progress[currentClass.id])) { %>
                            <a href="/level/<%= course.id %>/<%= level.id %>/next/<%= currentClass.id %>" 
                               class="btn btn-primary btn-sm next-btn" style="flex:1; font-size:0.8rem; padding:8px;"
                               onclick="this.classList.add('loading'); this.innerHTML='<i class=\'fas fa-spinner fa-spin\'></i>';">
                                <i class="fas fa-check"></i> Complete & Next
                            </a>
                        <% } else if (nextClassId && !isClassLocked) { %>
                            <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= nextClassId %>" class="btn btn-primary btn-sm" style="flex:1; font-size:0.8rem; padding:8px;">
                                Next <i class="fas fa-arrow-right"></i>
                            </a>
                        <% } else if (isClassLocked) { %>
                            <span class="btn btn-secondary btn-sm" style="flex:1; font-size:0.8rem; padding:8px; opacity:0.5; cursor:not-allowed;">
                                <i class="fas fa-lock"></i> Locked
                            </span>
                        <% } else { %>
                            <a href="/course/<%= course.id %>" class="btn btn-success btn-sm" style="flex:1; font-size:0.8rem; padding:8px;">
                                <i class="fas fa-check"></i> Done
                            </a>
                        <% } %>
                    </div>
                </div>

            <% } else { %>
                <div style="background:#fff; border-radius:10px; padding:24px 16px; border:1px solid #ede8f5; text-align:center;">
                    <h3 style="font-size:1rem; color:var(--text-dark);">No classes available</h3>
                    <a href="/course/<%= course.id %>" class="btn btn-primary btn-sm">Back to Course</a>
                </div>
            <% } %>

            <!-- All Classes List -->
            <div style="margin-top:12px;">
                <div style="font-weight:600; font-size:0.8rem; color:var(--text-dark); margin-bottom:4px;">
                    <i class="fas fa-list-ul" style="color:var(--primary);"></i> All Classes
                </div>
                <% if (level.lessons && level.lessons.length > 0) { %>
                    <% 
                        let allClassIds = [];
                        if (level.lessons) {
                            level.lessons.forEach(function(lesson) {
                                if (lesson.classes) {
                                    lesson.classes.forEach(function(cls) {
                                        allClassIds.push(cls.id);
                                    });
                                }
                            });
                        }
                    %>
                    <% level.lessons.forEach(function(lesson) { %>
                        <div style="background:#f8f6fc; border-radius:8px; padding:8px 12px; margin-bottom:4px; border:1px solid #ede8f5;">
                            <div style="font-weight:600; font-size:0.75rem; color:var(--text-dark);">
                                <%= lesson.title %>
                                <span style="font-size:0.6rem; color:var(--text-muted); font-weight:400;">
                                    (<%= lesson.classes ? lesson.classes.length : 0 %> classes)
                                </span>
                            </div>
                            <% if (lesson.classes && lesson.classes.length > 0) { %>
                                <div class="class-grid-mobile">
                                    <% lesson.classes.forEach(function(cls) { 
                                        let isCompleted = session && session.progress && session.progress[cls.id];
                                        let isCurrent = currentClass && currentClass.id === cls.id;
                                        let isLockedClass = false;
                                        
                                        let currentIdx = allClassIds.indexOf(cls.id);
                                        if (currentIdx > 0) {
                                            let prevClassId = allClassIds[currentIdx - 1];
                                            if (!(session && session.progress && session.progress[prevClassId])) {
                                                isLockedClass = true;
                                            }
                                        }
                                        if (currentIdx === 0) {
                                            isLockedClass = false;
                                        }
                                    %>
                                        <div class="class-item-mobile">
                                            <a href="<%= isLockedClass ? '#' : '/level/' + course.id + '/' + level.id + '?classId=' + cls.id %>" 
                                               class="class-link-mobile <%= isLockedClass ? 'locked' : 'unlocked' %> <%= isCompleted ? 'completed' : '' %> <%= isCurrent ? 'current' : '' %>"
                                               <% if (isLockedClass) { %>onclick="return false;"<% } %>>
                                                <span style="font-weight:600; color:var(--primary); font-size:0.7rem; min-width:18px;">
                                                    <%= String.fromCharCode(97 + allClassIds.indexOf(cls.id)) %>
                                                </span>
                                                <span style="flex:1;"><%= cls.title %></span>
                                                <% if (isCompleted) { %>
                                                    <span style="color:#27ae60; font-size:0.6rem;">✅</span>
                                                <% } else if (isLockedClass) { %>
                                                    <span style="color:#b0a3c4; font-size:0.6rem;">🔒</span>
                                                <% } else if (isCurrent) { %>
                                                    <span style="color:var(--primary); font-size:0.6rem;">▶</span>
                                                <% } %>
                                            </a>
                                        </div>
                                    <% }); %>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <!-- Test Section -->
            <% if (level.test && level.test.questions && level.test.questions.length > 0) { 
                let allCompleted = true;
                let allClassIds = [];
                if (level.lessons) {
                    level.lessons.forEach(function(lesson) {
                        if (lesson.classes) {
                            lesson.classes.forEach(function(cls) {
                                allClassIds.push(cls.id);
                            });
                        }
                    });
                }
                if (session && session.progress) {
                    allClassIds.forEach(function(id) {
                        if (!session.progress[id]) allCompleted = false;
                    });
                }
            %>
                <div style="margin-top:12px; padding:14px 16px; background:#fffbf0; border:2px solid #f7d44a; border-radius:10px;">
                    <h4 style="font-weight:700; color:var(--text-dark); font-size:0.9rem; margin:0 0 4px 0;">
                        <i class="fas fa-puzzle-piece"></i> Level Test
                    </h4>
                    <p style="font-size:0.8rem; color:var(--text-muted); margin:0 0 8px 0;">Test your knowledge after completing all classes!</p>
                    <% if (allCompleted) { %>
                        <button class="btn btn-gold btn-sm" style="width:100%; font-size:0.8rem; padding:8px;" onclick="alert('Test feature coming soon!')">
                            <i class="fas fa-play"></i> Start Test
                        </button>
                    <% } else { %>
                        <span style="color:var(--text-muted); font-size:0.75rem;">
                            <i class="fas fa-lock"></i> Complete all classes to unlock test
                        </span>
                    <% } %>
                </div>
            <% } %>

        </div>
    </main>

    <%- include('../partials/footer-mobile') %>

    <script src="/js/script.js"></script>
</body>
</html>