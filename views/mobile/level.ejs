<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title><%= level.name %> – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <!-- Level Header -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <div>
                    <div style="font-size:0.7rem; color:var(--text-muted);">
                        <a href="/course/<%= course.id %>" style="color:var(--text-muted); text-decoration:none;">
                            <i class="fas fa-arrow-left"></i> <%= course.title %>
                        </a>
                    </div>
                    <div style="font-weight:700; font-size:1rem; color:var(--text-dark);"><%= level.name %></div>
                </div>
                <span class="badge badge-purple" style="font-size:0.65rem;"><%= course.level || 'Beginner' %></span>
            </div>

            <!-- Progress -->
            <div style="background:#fff; border-radius:10px; padding:10px 14px; border:1px solid #ede8f5; margin-bottom:10px;">
                <div style="display:flex; justify-content:space-between; font-size:0.75rem; font-weight:500; color:var(--text-dark);">
                    <span>Progress</span>
                    <span><%= completedClasses %> / <%= totalClasses %> • <%= progress %>%</span>
                </div>
                <div class="progress-wrap" style="height:6px; margin-top:2px;">
                    <div class="progress-fill" style="width:<%= progress %>%; height:100%;"></div>
                </div>
                <div style="font-size:0.7rem; color:var(--text-muted); margin-top:2px;">
                    <i class="fas fa-star" style="color:#f39c12;"></i> Score: <strong><%= score %></strong>
                </div>
            </div>

            <!-- Class Content -->
            <% if (currentClass) { %>
                <div style="background:#fff; border-radius:10px; padding:14px 16px; border:1px solid #ede8f5; margin-bottom:10px;">
                    <div style="font-weight:600; font-size:0.9rem; color:var(--text-dark); margin-bottom:4px;">
                        <%= currentLesson ? currentLesson.title : '' %>: <%= currentClass.title %>
                    </div>
                    <div style="font-size:0.85rem; line-height:1.7; color:var(--text-dark);">
                        <% if (currentClass.videoUrl) { %>
                            <div style="margin:6px 0;">
                                <iframe src="<%= currentClass.videoUrl %>" frameborder="0" allowfullscreen style="width:100%; aspect-ratio:16/9; border-radius:8px;"></iframe>
                            </div>
                        <% } %>
                        <% if (currentClass.imageUrl) { %>
                            <div style="margin:6px 0;">
                                <img src="<%= currentClass.imageUrl %>" alt="<%= currentClass.title %>" style="width:100%; border-radius:8px;">
                            </div>
                        <% } %>
                        <%- currentClass.content || 'No content available.' %>
                    </div>
                </div>

                <!-- Navigation -->
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <% if (prevClassId) { %>
                        <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= prevClassId %>" class="btn btn-secondary btn-sm" style="flex:1; font-size:0.8rem; padding:8px;">
                            <i class="fas fa-arrow-left"></i> Prev
                        </a>
                    <% } else { %>
                        <span style="flex:1;"></span>
                    <% } %>

                    <a href="/course/<%= course.id %>" class="btn btn-outline btn-sm" style="font-size:0.8rem; padding:8px;">
                        <i class="fas fa-list"></i>
                    </a>

                    <% if (nextClassId) { %>
                        <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= nextClassId %>" class="btn btn-primary btn-sm" style="flex:1; font-size:0.8rem; padding:8px;">
                            Next <i class="fas fa-arrow-right"></i>
                        </a>
                    <% } else { %>
                        <a href="/course/<%= course.id %>" class="btn btn-success btn-sm" style="flex:1; font-size:0.8rem; padding:8px;">
                            <i class="fas fa-check"></i> Done
                        </a>
                    <% } %>
                </div>

            <% } else { %>
                <div class="empty-state" style="padding:24px 16px;">
                    <h3 style="font-size:1rem;">No classes available</h3>
                    <a href="/course/<%= course.id %>" class="btn btn-primary btn-sm">Back to Course</a>
                </div>
            <% } %>

            <!-- Class List (Mobile Accordion) -->
            <div style="margin-top:12px;">
                <div style="font-weight:600; font-size:0.85rem; color:var(--text-dark); margin-bottom:4px;">
                    <i class="fas fa-list-ul" style="color:var(--primary);"></i> All Classes
                </div>
                <% if (level.lessons && level.lessons.length > 0) { %>
                    <% level.lessons.forEach(function(lesson) { %>
                        <div style="background:#f8f6fc; border-radius:8px; padding:8px 12px; margin-bottom:4px; border:1px solid #ede8f5;">
                            <div style="font-weight:600; font-size:0.8rem; color:var(--text-dark);"><%= lesson.title %></div>
                            <% if (lesson.classes && lesson.classes.length > 0) { %>
                                <div style="display:flex; flex-wrap:wrap; gap:4px; margin-top:4px;">
                                    <% lesson.classes.forEach(function(cls) { %>
                                        <% let isActive = currentClass && currentClass.id === cls.id; %>
                                        <a href="/level/<%= course.id %>/<%= level.id %>?classId=<%= cls.id %>" 
                                           style="font-size:0.7rem; padding:2px 10px; border-radius:12px; text-decoration:none; 
                                                  background:<%= isActive ? 'var(--primary)' : '#ede8f5' %>; 
                                                  color:<%= isActive ? '#fff' : 'var(--text-muted)' %>;">
                                            <%= cls.title %>
                                        </a>
                                    <% }); %>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <%- include(getAdBox()) %>
        </div>
    </main>

    <%- include(getFooter()) %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; font-size:20px;"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Ask me about this class!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>