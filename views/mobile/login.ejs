<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Login – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ===== PASSWORD VISIBILITY TOGGLE ===== */
        .password-wrapper {
            position: relative;
            width: 100%;
        }
        .password-wrapper input {
            width: 100%;
            padding-right: 40px !important;
        }
        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 1rem;
            padding: 4px 6px;
            transition: color 0.3s ease;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .toggle-password:hover {
            color: #8B5CF6;
        }
        body.dark-mode .toggle-password {
            color: #888;
        }
        body.dark-mode .toggle-password:hover {
            color: #a78bfa;
        }
        .alert {
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 0.8rem;
            margin-bottom: 10px;
            text-align: center;
        }
        .alert-danger {
            background: #fadbd8;
            color: #922b21;
            border-left: 4px solid #e74c3c;
        }
        .alert-success {
            background: #d5f5e3;
            color: #1a7a4a;
            border-left: 4px solid #27ae60;
        }
        body.dark-mode .alert-danger {
            background: #3a1a1a;
            color: #f1948a;
        }
        body.dark-mode .alert-success {
            background: #1a3a2a;
            color: #7dcea0;
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <div style="background:#fff; border-radius:12px; padding:20px 16px; border:1px solid #ede8f5;">
                <div style="text-align:center; margin-bottom:16px;">
                    <h1 style="font-size:1.4rem; font-weight:800; color:#8B5CF6; margin:0;">SHINEX</h1>
                    <p style="color:var(--text-muted); font-size:0.7rem; letter-spacing:2px; margin:0;">LEARNING CIRCLE</p>
                </div>

                <div style="font-size:1.1rem; font-weight:700; color:var(--text-dark); text-align:center; margin-bottom:4px;">Welcome Back</div>
                <div style="font-size:0.8rem; color:var(--text-muted); text-align:center; margin-bottom:16px;">Login with your Student ID or Email</div>

                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger"><%= messages.error %></div>
                <% } %>
                <% if (messages && messages.success) { %>
                    <div class="alert alert-success"><%= messages.success %></div>
                <% } %>

                <form action="/login" method="POST">
                    <div style="margin-bottom:12px;">
                        <label style="font-size:0.8rem; font-weight:600; color:var(--text-dark); display:block; margin-bottom:4px;">Student ID or Email</label>
                        <input type="text" name="identifier" placeholder="Enter your Student ID or Email" style="width:100%; padding:10px 12px; border:2px solid #ede8f5; border-radius:8px; font-size:0.9rem; background:#fff; color:var(--text-dark);">
                    </div>
                    <div style="margin-bottom:16px;">
                        <label style="font-size:0.8rem; font-weight:600; color:var(--text-dark); display:block; margin-bottom:4px;">Password</label>
                        <div class="password-wrapper">
                            <input type="password" name="password" id="mobileLoginPassword" placeholder="Enter your password" style="width:100%; padding:10px 12px; border:2px solid #ede8f5; border-radius:8px; font-size:0.9rem; background:#fff; color:var(--text-dark);">
                            <button type="button" class="toggle-password" onclick="togglePassword('mobileLoginPassword', this)" aria-label="Toggle password visibility">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit" style="width:100%; padding:12px; border:none; border-radius:30px; font-weight:600; font-size:1rem; background:#8B5CF6; color:#fff; cursor:pointer;">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </button>
                </form>

                <div style="text-align:center; margin-top:16px; padding-top:16px; border-top:1px solid #ede8f5;">
                    <p style="font-size:0.85rem; color:var(--text-muted); margin:0;">
                        Don't have an account? <a href="/register" style="color:#8B5CF6; font-weight:600; text-decoration:none;">Register</a>
                    </p>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer-mobile') %>
    
    <script>
        // ===== PASSWORD VISIBILITY TOGGLE =====
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            if (!input) return;
            
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
            
            // Prevent form submission
            event.preventDefault();
        }
    </script>
    <script src="/js/script.js"></script>
</body>
</html>