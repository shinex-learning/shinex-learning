<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Login – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ===== PAGE WRAPPER - FLEX CENTER ===== */
        .mobile-login-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 70vh;
            padding: 20px 12px;
            background: transparent;
        }
        body.dark-mode .mobile-login-wrapper {
            background: transparent !important;
        }

        /* ===== LOGIN CARD ===== */
        .mobile-login-card {
            background: #ffffff;
            border-radius: 12px;
            padding: 28px 20px;
            border: 1px solid #ede8f5;
            width: 100%;
            max-width: 420px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(26, 10, 46, 0.08);
        }
        body.dark-mode .mobile-login-card {
            background: #151320 !important;
            border-color: #2a1a4a !important;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4) !important;
        }

        /* ===== LOGO ===== */
        .mobile-login-card .auth-logo {
            text-align: center;
            margin-bottom: 16px;
        }
        .mobile-login-card .auth-logo h1 {
            font-size: 1.4rem;
            font-weight: 800;
            color: #1A0A2E;
            margin: 0;
        }
        body.dark-mode .mobile-login-card .auth-logo h1 {
            color: #ffffff !important;
        }
        .mobile-login-card .auth-logo h1 span {
            color: #8B5CF6;
        }
        .mobile-login-card .auth-logo p {
            color: #7a6a8f;
            font-size: 0.7rem;
            margin: 0;
            letter-spacing: 2px;
        }
        body.dark-mode .mobile-login-card .auth-logo p {
            color: #b0a0c0 !important;
        }

        /* ===== TITLE ===== */
        .mobile-login-card .auth-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1A0A2E;
            text-align: center;
            margin: 0 0 2px 0;
        }
        body.dark-mode .mobile-login-card .auth-title {
            color: #ffffff !important;
        }
        .mobile-login-card .auth-subtitle {
            font-size: 0.8rem;
            color: #7a6a8f;
            text-align: center;
            margin: 0 0 16px 0;
        }
        body.dark-mode .mobile-login-card .auth-subtitle {
            color: #b0a0c0 !important;
        }

        /* ===== FORM ===== */
        .mobile-login-card .form-group {
            margin-bottom: 14px;
        }
        .mobile-login-card .form-group label {
            font-weight: 600;
            font-size: 0.8rem;
            color: #1A0A2E;
            display: block;
            margin-bottom: 4px;
        }
        body.dark-mode .mobile-login-card .form-group label {
            color: #ffffff !important;
        }
        .mobile-login-card .form-group input {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #ede8f5;
            border-radius: 8px;
            font-size: 0.9rem;
            font-family: inherit;
            transition: all 0.3s ease;
            background: #ffffff;
            color: #1A0A2E;
        }
        body.dark-mode .mobile-login-card .form-group input {
            background: #2a2a2a !important;
            color: #ffffff !important;
            border-color: #3a3a4a !important;
        }
        .mobile-login-card .form-group input:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
            outline: none;
        }
        body.dark-mode .mobile-login-card .form-group input:focus {
            border-color: #8B5CF6 !important;
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.2) !important;
        }
        .mobile-login-card .form-group input::placeholder {
            color: #b0a3c4;
        }
        body.dark-mode .mobile-login-card .form-group input::placeholder {
            color: #666 !important;
        }
        .mobile-login-card .help-text {
            font-size: 0.7rem;
            color: #7a6a8f;
            margin-top: 3px;
        }
        body.dark-mode .mobile-login-card .help-text {
            color: #888 !important;
        }

        /* ===== PASSWORD TOGGLE ===== */
        .password-wrapper {
            position: relative;
            width: 100%;
        }
        .password-wrapper input {
            width: 100%;
            padding-right: 40px !important;
        }
        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #7a6a8f;
            font-size: 1rem;
            padding: 4px 6px;
            transition: color 0.3s ease;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .toggle-password:hover {
            color: #8B5CF6;
        }
        body.dark-mode .toggle-password {
            color: #888 !important;
        }
        body.dark-mode .toggle-password:hover {
            color: #a78bfa !important;
        }

        /* ===== BUTTON ===== */
        .btn-mobile-login {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 1rem;
            background: #8B5CF6;
            color: #fff;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 4px;
        }
        .btn-mobile-login:hover {
            background: #6a3dcf;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
        }

        /* ===== ALERTS ===== */
        .alert {
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 0.8rem;
            margin-bottom: 10px;
            text-align: center;
        }
        .alert-danger {
            background: #fadbd8;
            color: #922b21;
            border-left: 4px solid #e74c3c;
        }
        .alert-success {
            background: #d5f5e3;
            color: #1a7a4a;
            border-left: 4px solid #27ae60;
        }
        body.dark-mode .alert-danger {
            background: #3a1a1a !important;
            color: #f1948a !important;
        }
        body.dark-mode .alert-success {
            background: #1a3a2a !important;
            color: #7dcea0 !important;
        }

        /* ===== FOOTER ===== */
        .mobile-login-card .auth-footer {
            text-align: center;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid #ede8f5;
        }
        body.dark-mode .mobile-login-card .auth-footer {
            border-color: #2a1a4a !important;
        }
        .mobile-login-card .auth-footer a {
            color: #8B5CF6;
            text-decoration: none;
            font-weight: 600;
        }
        .mobile-login-card .auth-footer a:hover {
            text-decoration: underline;
        }
        .mobile-login-card .auth-footer p {
            color: #7a6a8f;
            font-size: 0.8rem;
            margin: 0;
        }
        body.dark-mode .mobile-login-card .auth-footer p {
            color: #b0a0c0 !important;
        }
        .mobile-login-card .slc-note {
            text-align: center;
            font-size: 0.7rem;
            color: #7a6a8f;
            margin-top: 10px;
            padding-top: 8px;
            border-top: 1px solid #ede8f5;
        }
        body.dark-mode .mobile-login-card .slc-note {
            border-color: #2a1a4a !important;
            color: #888 !important;
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:0; min-height:auto;">
        <div class="mobile-login-wrapper">
            <div class="mobile-login-card">
                <!-- Logo -->
                <div class="auth-logo">
                    <h1>SHINEX<span>.</span></h1>
                    <p>LEARNING CIRCLE</p>
                </div>

                <div class="auth-title">Welcome Back</div>
                <div class="auth-subtitle">Login with your Student ID or Email</div>

                <!-- Messages -->
                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger"><%= messages.error %></div>
                <% } %>
                <% if (messages && messages.success) { %>
                    <div class="alert alert-success"><%= messages.success %></div>
                <% } %>

                <!-- Form -->
                <form action="/login" method="POST">
                    <div class="form-group">
                        <label for="identifier">Student ID or Email</label>
                        <input type="text" id="identifier" name="identifier" placeholder="Enter your Student ID or Email" required>
                        <div class="help-text">Enter your Student ID or registered email address</div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="password-wrapper">
                            <input type="password" id="mobileLoginPassword" name="password" placeholder="Enter your password" required>
                            <button type="button" class="toggle-password" onclick="togglePassword('mobileLoginPassword', this)" aria-label="Toggle password visibility">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-mobile-login">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </button>
                </form>

                <!-- Footer -->
                <div class="auth-footer">
                    <p>Don't have an account? <a href="/register">Register Now</a></p>
                </div>

                <div class="slc-note">
                    <i class="fas fa-shield-alt" style="color:#8B5CF6;"></i> SHINEX Learning Circle
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer-mobile') %>

    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            if (!input) return;
            
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
            
            event.preventDefault();
        }
    </script>
    <script src="/js/script.js"></script>
</body>
</html>