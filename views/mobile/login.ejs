<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Login – SHINEX</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-login-container {
            padding: 16px 16px 30px;
            max-width: 420px;
            margin: 0 auto;
        }
        .mobile-login-box {
            padding: 24px 20px !important;
            border-radius: 14px !important;
        }
        .mobile-login-box h2 {
            font-size: 1.4rem !important;
        }
        .mobile-login-box p {
            font-size: 0.85rem !important;
        }
        .mobile-login-box input {
            font-size: 0.95rem !important;
            padding: 12px 14px !important;
            min-height: 44px !important;
        }
        .mobile-login-box .btn {
            font-size: 0.95rem !important;
            padding: 12px !important;
            min-height: 48px !important;
        }
        .mobile-login-box label {
            font-size: 0.85rem !important;
        }
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            margin-bottom: 12px;
            padding: 6px 0;
        }
        .back-link:hover {
            color: var(--primary);
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: true }) %>

    <main class="main-content">
        <div class="mobile-login-container">
            <div class="card mobile-login-box" style="box-shadow:var(--shadow);">
                <h2 style="font-weight:700; margin:0 0 2px; text-align:center;">Welcome Back</h2>
                <p style="text-align:center; color:var(--text-muted); margin-bottom:20px;">Login with your Student ID or Email</p>

                <% if (messages && messages.success) { %>
                    <div class="alert alert-success" style="font-size:0.82rem; padding:10px 14px; border-radius:8px;"><%= messages.success %></div>
                <% } %>
                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger" style="font-size:0.82rem; padding:10px 14px; border-radius:8px;"><%= messages.error %></div>
                <% } %>

                <form action="/login" method="POST">
                    <div class="settings-group">
                        <label for="identifier">Student ID or Email</label>
                        <input type="text" id="identifier" name="identifier" placeholder="SLC-2026-01-001 or email@example.com" required>
                    </div>
                    <div class="settings-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Enter your password" required>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" style="margin-top:4px;">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </button>
                </form>

                <div style="text-align:center; margin-top:16px; font-size:0.85rem;">
                    <p style="color:var(--text-muted);">Don't have an account? <a href="/register" style="color:var(--primary); font-weight:600;">Register here</a></p>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer-mobile') %>
    <script src="/js/main.js"></script>
</body>
</html>