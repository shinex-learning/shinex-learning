<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Settings – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-settings-container {
            padding: 12px 12px 24px;
            max-width: 500px;
            margin: 0 auto;
        }
        .mobile-settings-card {
            padding: 16px 14px !important;
            border-radius: 12px !important;
            margin-bottom: 12px !important;
        }
        .mobile-settings-card h3 {
            font-size: 1rem !important;
            font-weight: 700 !important;
            margin: 0 0 4px !important;
        }
        .mobile-settings-card p {
            font-size: 0.8rem !important;
            margin: 0 0 12px !important;
            color: var(--text-muted);
        }
        .mobile-settings-card label {
            font-size: 0.82rem !important;
        }
        .mobile-settings-card input,
        .mobile-settings-card select,
        .mobile-settings-card textarea {
            font-size: 0.9rem !important;
            padding: 10px 12px !important;
            min-height: 40px !important;
            border-radius: 8px !important;
        }
        .mobile-settings-card .btn {
            font-size: 0.85rem !important;
            padding: 10px !important;
            min-height: 44px !important;
            width: 100%;
            justify-content: center;
        }
        .mobile-settings-card .help-text {
            font-size: 0.7rem !important;
        }
        .mobile-settings-toggle {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
        }
        .mobile-settings-toggle input[type="checkbox"] {
            width: 44px !important;
            height: 24px !important;
            min-height: unset !important;
            appearance: none;
            background: #ccc;
            border-radius: 12px;
            position: relative;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0 !important;
            flex-shrink: 0;
        }
        .mobile-settings-toggle input[type="checkbox"]:checked {
            background: var(--primary);
        }
        .mobile-settings-toggle input[type="checkbox"]::before {
            content: '';
            position: absolute;
            width: 18px;
            height: 18px;
            background: #fff;
            border-radius: 50%;
            top: 3px;
            left: 3px;
            transition: all 0.3s ease;
        }
        .mobile-settings-toggle input[type="checkbox"]:checked::before {
            left: 23px;
        }
        body.dark-mode .mobile-settings-toggle input[type="checkbox"] {
            background: #444;
        }
        .mobile-text-size {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 0;
        }
        .mobile-text-size input[type="range"] {
            flex: 1;
            min-height: unset !important;
            padding: 0 !important;
            height: 4px !important;
            background: var(--primary-bg);
            border-radius: 4px;
            appearance: none;
        }
        .mobile-text-size input[type="range"]::-webkit-slider-thumb {
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--primary);
            cursor: pointer;
        }
        .mobile-text-size input[type="range"]::-moz-range-thumb {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--primary);
            cursor: pointer;
        }
        .mobile-text-size .text-size-value {
            font-weight: 700;
            color: var(--primary);
            min-width: 40px;
            font-size: 0.85rem;
        }
        .mobile-danger-zone {
            border: 2px solid #e74c3c !important;
            border-radius: 12px !important;
            padding: 16px !important;
            margin-top: 4px;
        }
        .mobile-danger-zone h4 {
            color: #e74c3c;
            font-size: 0.95rem !important;
            margin: 0 0 4px !important;
        }
        .mobile-danger-zone p {
            font-size: 0.8rem !important;
            margin: 0 0 10px !important;
        }
        .btn-danger-zone-mobile {
            background: #e74c3c;
            color: #fff;
            padding: 10px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            width: 100%;
            font-size: 0.85rem;
            cursor: pointer;
            min-height: 44px;
        }
        .btn-danger-zone-mobile:hover {
            background: #c0392b;
        }
        .mobile-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        @media (max-width: 400px) {
            .mobile-grid-2 {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }
        .mobile-section-divider {
            height: 1px;
            background: #ede8f5;
            margin: 4px 0 12px;
        }
        body.dark-mode .mobile-section-divider {
            background: var(--dark-border);
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: true }) %>

    <main class="main-content">
        <div class="mobile-settings-container">
            <h2 style="font-size:1.3rem; font-weight:700; margin:0 0 2px;">⚙️ Settings</h2>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">Manage your account and preferences.</p>

            <% if (messages && messages.success) { %>
                <div class="alert alert-success" style="font-size:0.82rem; padding:10px 14px; border-radius:8px; margin-bottom:10px;"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger" style="font-size:0.82rem; padding:10px 14px; border-radius:8px; margin-bottom:10px;"><%= messages.error %></div>
            <% } %>

            <!-- ===== 1. PROFILE ===== -->
            <div class="card mobile-settings-card">
                <h3><i class="fas fa-user" style="color:var(--primary);"></i> Profile</h3>
                <p>Update your personal information.</p>
                <form id="profileFormMobile">
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="firstNameMobile">First Name</label>
                            <input type="text" id="firstNameMobile" name="firstName" value="<%= user.firstName || '' %>">
                        </div>
                        <div class="settings-group">
                            <label for="lastNameMobile">Last Name</label>
                            <input type="text" id="lastNameMobile" name="lastName" value="<%= user.lastName || '' %>">
                        </div>
                    </div>
                    <div class="settings-group">
                        <label for="bioMobile">Bio</label>
                        <textarea id="bioMobile" name="bio" rows="2"><%= user.bio || '' %></textarea>
                    </div>
                    <div class="settings-group">
                        <label>Student ID</label>
                        <input type="text" value="<%= user.studentId || '' %>" disabled style="background:#f0f0f0;">
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save Profile
                    </button>
                </form>
            </div>

            <!-- ===== 2. ACCOUNT ===== -->
            <div class="card mobile-settings-card">
                <h3><i class="fas fa-key" style="color:var(--primary);"></i> Account</h3>
                <p>Change your password.</p>
                <form id="passwordFormMobile">
                    <div class="settings-group">
                        <label for="currentPasswordMobile">Current Password</label>
                        <input type="password" id="currentPasswordMobile" name="currentPassword" placeholder="Enter current password">
                    </div>
                    <div class="settings-group">
                        <label for="newPasswordMobile">New Password</label>
                        <input type="password" id="newPasswordMobile" name="newPassword" placeholder="Min 6 characters">
                    </div>
                    <div class="settings-group">
                        <label for="confirmPasswordMobile">Confirm New Password</label>
                        <input type="password" id="confirmPasswordMobile" name="confirmPassword" placeholder="Confirm new password">
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Change Password
                    </button>
                </form>
            </div>

            <!-- ===== 3. SECURITY ===== -->
            <div class="card mobile-settings-card">
                <h3><i class="fas fa-shield-alt" style="color:var(--primary);"></i> Security</h3>
                <p>Protect your account with additional security.</p>
                <div class="mobile-settings-toggle">
                    <input type="checkbox" id="twoFactorMobile" name="twoFactorEnabled" <%= user.twoFactorEnabled ? 'checked' : '' %>>
                    <label for="twoFactorMobile" style="margin:0; font-weight:600;">Two-Factor Authentication (2FA)</label>
                </div>
                <p class="help-text">Add an extra layer of security to your account.</p>
                <button id="logoutAllMobile" class="btn btn-secondary" style="margin-top:4px;">
                    <i class="fas fa-sign-out-alt"></i> Logout from All Sessions
                </button>
            </div>

            <!-- ===== 4. APPEARANCE ===== -->
            <div class="card mobile-settings-card">
                <h3><i class="fas fa-palette" style="color:var(--primary);"></i> Appearance</h3>
                <p>Customize how SHINEX looks.</p>
                <div class="mobile-settings-toggle">
                    <input type="checkbox" id="darkModeMobileSetting" name="darkMode" <%= user.darkMode ? 'checked' : '' %>>
                    <label for="darkModeMobileSetting" style="margin:0; font-weight:600;">Dark Mode</label>
                </div>
                <p class="help-text">Toggle between light and dark mode.</p>
                <div class="mobile-text-size">
                    <i class="fas fa-font" style="color:var(--primary);"></i>
                    <input type="range" class="text-size-slider" min="12" max="24" value="<%= user.textSize || 16 %>" step="1">
                    <span class="text-size-value"><%= user.textSize || 16 %>px</span>
                </div>
            </div>

            <!-- ===== 5. NOTIFICATIONS ===== -->
            <div class="card mobile-settings-card">
                <h3><i class="fas fa-bell" style="color:var(--primary);"></i> Notifications</h3>
                <p>Choose how you receive updates.</p>
                <div class="mobile-settings-toggle">
                    <input type="checkbox" id="emailNotifMobile" name="emailNotifications" class="notification-checkbox" <%= user.emailNotifications ? 'checked' : '' %>>
                    <label for="emailNotifMobile" style="margin:0; font-weight:600;">Email Notifications</label>
                </div>
                <div class="mobile-settings-toggle">
                    <input type="checkbox" id="browserNotifMobile" name="browserNotifications" class="notification-checkbox" <%= user.browserNotifications ? 'checked' : '' %>>
                    <label for="browserNotifMobile" style="margin:0; font-weight:600;">Browser Notifications</label>
                </div>
                <div class="mobile-settings-toggle">
                    <input type="checkbox" id="courseUpdateMobile" name="courseUpdates" class="notification-checkbox" <%= user.courseUpdates ? 'checked' : '' %>>
                    <label for="courseUpdateMobile" style="margin:0; font-weight:600;">Course Updates</label>
                </div>
            </div>

            <!-- ===== 6. PRIVACY ===== -->
            <div class="card mobile-settings-card">
                <h3><i class="fas fa-lock" style="color:var(--primary);"></i> Privacy</h3>
                <p>Control who can see your information.</p>
                <div class="settings-group">
                    <label for="profileVisibilityMobile">Profile Visibility</label>
                    <select id="profileVisibilityMobile" name="profileVisibility">
                        <option value="public" <%= user.profileVisibility === 'public' ? 'selected' : '' %>>Public – Anyone can see</option>
                        <option value="private" <%= user.profileVisibility === 'private' ? 'selected' : '' %>>Private – Only you and admins</option>
                    </select>
                </div>
            </div>

            <!-- ===== 7. LEARNING ===== -->
            <div class="card mobile-settings-card">
                <h3><i class="fas fa-graduation-cap" style="color:var(--primary);"></i> Learning</h3>
                <p>Customize your learning experience.</p>
                <div class="settings-group">
                    <label for="learningLevelMobile">Learning Level</label>
                    <select id="learningLevelMobile" name="learningLevel">
                        <option value="Beginner" <%= user.learningLevel === 'Beginner' ? 'selected' : '' %>>🌱 Beginner</option>
                        <option value="Intermediate" <%= user.learningLevel === 'Intermediate' ? 'selected' : '' %>>🌿 Intermediate</option>
                        <option value="Advanced" <%= user.learningLevel === 'Advanced' ? 'selected' : '' %>>🚀 Advanced</option>
                    </select>
                </div>
                <div class="settings-group">
                    <label for="learningInterestsMobile">Learning Interests</label>
                    <textarea id="learningInterestsMobile" name="learningInterests" rows="2"><%= user.learningInterests || '' %></textarea>
                    <p class="help-text">What topics interest you?</p>
                </div>
            </div>

            <!-- ===== 8. HELP & SUPPORT ===== -->
            <div class="card mobile-settings-card">
                <h3><i class="fas fa-headset" style="color:var(--primary);"></i> Help & Support</h3>
                <p>Need help? We're here for you.</p>
                <a href="/faq" class="btn btn-secondary" style="margin-bottom:6px;">
                    <i class="fas fa-question-circle"></i> View FAQs
                </a>
                <a href="/contact" class="btn btn-primary">
                    <i class="fas fa-envelope"></i> Contact Support
                </a>
            </div>

            <!-- ===== 9. DANGER ZONE ===== -->
            <div class="mobile-danger-zone">
                <h4><i class="fas fa-exclamation-triangle"></i> Danger Zone</h4>
                <p>Once you delete your account, there is no going back.</p>
                <button id="deleteAccountMobile" class="btn-danger-zone-mobile">
                    <i class="fas fa-trash-alt"></i> Delete Account
                </button>
            </div>
        </div>
    </main>

    <%- include('partials/footer-mobile') %>

    <script>
        // Re-initialize settings for mobile
        document.addEventListener('DOMContentLoaded', function() {
            // Profile form
            const profileForm = document.getElementById('profileFormMobile');
            if (profileForm) {
                profileForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const formData = new FormData(this);
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('✅ Profile updated successfully!', 'success');
                        } else {
                            showToast('❌ ' + data.error, 'error');
                        }
                    })
                    .catch(() => showToast('❌ Something went wrong.', 'error'));
                });
            }

            // Password form
            const passwordForm = document.getElementById('passwordFormMobile');
            if (passwordForm) {
                passwordForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const formData = new FormData(this);
                    const newPass = formData.get('newPassword');
                    const confirmPass = formData.get('confirmPassword');
                    
                    if (newPass !== confirmPass) {
                        showToast('❌ Passwords do not match!', 'error');
                        return;
                    }
                    if (newPass.length < 6) {
                        showToast('❌ Password must be at least 6 characters.', 'error');
                        return;
                    }
                    
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('✅ Password changed successfully!', 'success');
                            this.reset();
                        } else {
                            showToast('❌ ' + data.error, 'error');
                        }
                    })
                    .catch(() => showToast('❌ Something went wrong.', 'error'));
                });
            }

            // Dark mode toggle
            const darkModeSetting = document.getElementById('darkModeMobileSetting');
            if (darkModeSetting) {
                darkModeSetting.addEventListener('change', function() {
                    const body = document.body;
                    body.classList.toggle('dark-mode', this.checked);
                    localStorage.setItem('shinex-dark-mode', this.checked);
                    updateAllToggles(this.checked);
                    showToast(this.checked ? '🌙 Dark mode enabled' : '☀️ Light mode enabled', 'success');
                });
            }

            // 2FA toggle
            const twoFactor = document.getElementById('twoFactorMobile');
            if (twoFactor) {
                twoFactor.addEventListener('change', function() {
                    const formData = new FormData();
                    formData.append('twoFactorEnabled', this.checked ? 'on' : 'off');
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast(this.checked ? '🔐 2FA enabled' : '🔓 2FA disabled', 'success');
                        }
                    })
                    .catch(() => {});
                });
            }

            // Notification checkboxes
            document.querySelectorAll('.notification-checkbox').forEach(cb => {
                cb.addEventListener('change', function() {
                    const formData = new FormData();
                    formData.append(this.name, this.checked ? 'on' : 'off');
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('✅ Preference updated', 'success');
                        }
                    })
                    .catch(() => {});
                });
            });

            // Privacy
            const privacySelect = document.getElementById('profileVisibilityMobile');
            if (privacySelect) {
                privacySelect.addEventListener('change', function() {
                    const formData = new FormData();
                    formData.append('profileVisibility', this.value);
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('✅ Privacy updated', 'success');
                        }
                    })
                    .catch(() => {});
                });
            }

            // Learning level
            const levelSelect = document.getElementById('learningLevelMobile');
            if (levelSelect) {
                levelSelect.addEventListener('change', function() {
                    const formData = new FormData();
                    formData.append('learningLevel', this.value);
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('✅ Learning level updated', 'success');
                        }
                    })
                    .catch(() => {});
                });
            }

            // Learning interests
            const interests = document.getElementById('learningInterestsMobile');
            if (interests) {
                let timeoutId;
                interests.addEventListener('input', function() {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => {
                        const formData = new FormData();
                        formData.append('learningInterests', this.value);
                        fetch('/settings/update', {
                            method: 'POST',
                            body: new URLSearchParams(formData)
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                showToast('✅ Interests saved', 'success');
                            }
                        })
                        .catch(() => {});
                    }, 1000);
                });
            }

            // Logout all
            const logoutAll = document.getElementById('logoutAllMobile');
            if (logoutAll) {
                logoutAll.addEventListener('click', function() {
                    if (confirm('Logout from all devices?')) {
                        fetch('/logout-all', { method: 'POST' })
                        .then(() => {
                            showToast('✅ Logged out from all sessions.', 'success');
                            setTimeout(() => window.location.reload(), 1000);
                        });
                    }
                });
            }

            // Delete account
            const deleteBtn = document.getElementById('deleteAccountMobile');
            if (deleteBtn) {
                deleteBtn.addEventListener('click', function() {
                    if (confirm('⚠️ Delete your account? This cannot be undone!')) {
                        const confirmText = prompt('Type "DELETE" to confirm:');
                        if (confirmText === 'DELETE') {
                            fetch('/delete-account', { method: 'POST' })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    showToast('✅ Account deleted.', 'success');
                                    setTimeout(() => window.location.href = '/', 2000);
                                } else {
                                    showToast('❌ ' + data.error, 'error');
                                }
                            })
                            .catch(() => showToast('❌ Something went wrong.', 'error'));
                        }
                    }
                });
            }
        });
    </script>

    <script src="/js/main.js"></script>
</body>
</html>