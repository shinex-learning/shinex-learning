<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Settings – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <h1 style="font-size:1.2rem; font-weight:800; color:var(--text-dark); margin:0 0 4px 0;">
                <i class="fas fa-cog" style="color:var(--primary);"></i> Settings
            </h1>
            
            <!-- Profile Section -->
            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5; margin-bottom:12px;">
                <h3 style="font-size:0.95rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-user" style="color:var(--primary);"></i> Profile
                </h3>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 12px 0;">Update your personal information</p>
                <form>
                    <div style="margin-bottom:12px;">
                        <label style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">First Name</label>
                        <input type="text" placeholder="Your first name" style="width:100%; font-size:0.85rem; padding:8px 12px; border:2px solid #ede8f5; border-radius:8px;">
                    </div>
                    <div style="margin-bottom:12px;">
                        <label style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">Last Name</label>
                        <input type="text" placeholder="Your last name" style="width:100%; font-size:0.85rem; padding:8px 12px; border:2px solid #ede8f5; border-radius:8px;">
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" style="width:100%; font-size:0.85rem; padding:10px; border-radius:30px; background:#8B5CF6; color:#fff; border:none; font-weight:600;">
                        <i class="fas fa-save"></i> Save Profile
                    </button>
                </form>
            </div>

            <!-- Appearance Section -->
            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5; margin-bottom:12px;">
                <h3 style="font-size:0.95rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-palette" style="color:var(--primary);"></i> Appearance
                </h3>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 12px 0;">Customize your visual experience</p>
                <div style="display:flex; align-items:center; gap:12px; padding:8px 0;">
                    <label style="font-size:0.8rem; font-weight:500; margin:0; cursor:pointer;">
                        <i class="fas fa-moon"></i> Dark Mode
                    </label>
                    <input type="checkbox" id="darkModeMobile" style="width:auto; height:18px; width:18px; accent-color:#8B5CF6; cursor:pointer;">
                </div>
                <div style="margin-top:8px;">
                    <label style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">Font Size</label>
                    <input type="range" min="12" max="24" value="16" step="1" style="width:100%; accent-color:#8B5CF6;">
                    <div style="display:flex; justify-content:space-between; font-size:0.6rem; color:var(--text-muted);">
                        <span>Small</span>
                        <span>Medium</span>
                        <span>Large</span>
                    </div>
                </div>
                <button class="btn btn-primary btn-block" style="width:100%; font-size:0.85rem; padding:10px; border-radius:30px; background:#8B5CF6; color:#fff; border:none; font-weight:600; margin-top:8px;">
                    <i class="fas fa-save"></i> Save Appearance
                </button>
            </div>

            <!-- Security Section -->
            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5; margin-bottom:12px;">
                <h3 style="font-size:0.95rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-shield-alt" style="color:var(--primary);"></i> Security
                </h3>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 12px 0;">Protect your account</p>
                <div style="display:flex; align-items:center; gap:12px; padding:8px 0;">
                    <input type="checkbox" id="twoFactorMobile" style="width:auto; height:18px; width:18px; accent-color:#8B5CF6; cursor:pointer;">
                    <label style="font-size:0.8rem; font-weight:500; margin:0; cursor:pointer;">Enable Two-Factor Authentication (2FA)</label>
                </div>
                <button class="btn btn-secondary btn-block" style="width:100%; font-size:0.85rem; padding:10px; border-radius:30px; background:#ede8f5; color:#1A0A2E; border:none; font-weight:600; margin-top:8px;">
                    <i class="fas fa-sign-out-alt"></i> Logout from all sessions
                </button>
            </div>

            <!-- Notifications Section -->
            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5; margin-bottom:12px;">
                <h3 style="font-size:0.95rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-bell" style="color:var(--primary);"></i> Notifications
                </h3>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 12px 0;">Manage your notification preferences</p>
                <div style="display:flex; align-items:center; gap:12px; padding:6px 0;">
                    <input type="checkbox" id="notifEmailM" checked style="width:auto; height:18px; width:18px; accent-color:#8B5CF6; cursor:pointer;">
                    <label style="font-size:0.8rem; font-weight:400; margin:0; cursor:pointer;">Email Notifications</label>
                </div>
                <div style="display:flex; align-items:center; gap:12px; padding:6px 0;">
                    <input type="checkbox" id="notifBrowserM" checked style="width:auto; height:18px; width:18px; accent-color:#8B5CF6; cursor:pointer;">
                    <label style="font-size:0.8rem; font-weight:400; margin:0; cursor:pointer;">Browser Notifications</label>
                </div>
                <div style="display:flex; align-items:center; gap:12px; padding:6px 0;">
                    <input type="checkbox" id="notifCourseM" checked style="width:auto; height:18px; width:18px; accent-color:#8B5CF6; cursor:pointer;">
                    <label style="font-size:0.8rem; font-weight:400; margin:0; cursor:pointer;">Course Updates</label>
                </div>
                <button class="btn btn-primary btn-block" style="width:100%; font-size:0.85rem; padding:10px; border-radius:30px; background:#8B5CF6; color:#fff; border:none; font-weight:600; margin-top:8px;">
                    <i class="fas fa-save"></i> Save Notifications
                </button>
            </div>

            <!-- Privacy Section -->
            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5; margin-bottom:12px;">
                <h3 style="font-size:0.95rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-eye" style="color:var(--primary);"></i> Privacy
                </h3>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 12px 0;">Control your privacy settings</p>
                <div style="margin-bottom:8px;">
                    <label style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">Profile Visibility</label>
                    <select style="width:100%; font-size:0.85rem; padding:8px 12px; border:2px solid #ede8f5; border-radius:8px; background:#fff;">
                        <option value="public">Public</option>
                        <option value="private" selected>Private</option>
                    </select>
                </div>
                <button class="btn btn-primary btn-block" style="width:100%; font-size:0.85rem; padding:10px; border-radius:30px; background:#8B5CF6; color:#fff; border:none; font-weight:600;">
                    <i class="fas fa-save"></i> Save Privacy
                </button>
            </div>

            <!-- Learning Settings Section -->
            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5; margin-bottom:12px;">
                <h3 style="font-size:0.95rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-graduation-cap" style="color:var(--primary);"></i> Learning Settings
                </h3>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 12px 0;">Customize your learning experience</p>
                <div style="margin-bottom:8px;">
                    <label style="font-size:0.8rem; font-weight:600; display:block; margin-bottom:4px;">Preferred Course Level</label>
                    <select style="width:100%; font-size:0.85rem; padding:8px 12px; border:2px solid #ede8f5; border-radius:8px; background:#fff;">
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                    </select>
                </div>
                <button class="btn btn-primary btn-block" style="width:100%; font-size:0.85rem; padding:10px; border-radius:30px; background:#8B5CF6; color:#fff; border:none; font-weight:600;">
                    <i class="fas fa-save"></i> Save Learning Settings
                </button>
            </div>

            <!-- Danger Zone -->
            <div style="background:#fff; border-radius:12px; padding:16px; border:2px solid #e74c3c; margin-bottom:12px;">
                <h3 style="font-size:0.95rem; font-weight:700; color:#e74c3c; margin:0 0 4px 0;">
                    <i class="fas fa-exclamation-triangle"></i> Danger Zone
                </h3>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 12px 0;">These actions are irreversible. Proceed with caution.</p>
                <button class="btn btn-danger btn-block" style="width:100%; font-size:0.85rem; padding:10px; border-radius:30px; background:#e74c3c; color:#fff; border:none; font-weight:600;">
                    <i class="fas fa-trash"></i> Delete Account
                </button>
                <p style="font-size:0.65rem; color:#e74c3c; margin-top:6px; text-align:center;">Deleting your account will permanently remove all your data.</p>
            </div>

        </div>
    </main>

    <%- include('../partials/footer-mobile') %>

    <script src="/js/script.js"></script>
</body>
</html>