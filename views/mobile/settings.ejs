<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Settings – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           MOBILE SETTINGS PAGE STYLES
           ============================================================ */
        
        .mobile-settings-container {
            padding: var(--spacing-sm) var(--spacing-sm) var(--spacing-xl);
            max-width: 500px;
            margin: 0 auto;
        }
        
        /* ----- Page Header ----- */
        .page-header {
            margin-bottom: var(--spacing-md);
        }
        
        .page-header h1 {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
        }
        
        .page-header h1 i {
            color: var(--purple-primary);
        }
        
        .page-header p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 2px 0 0 0;
        }
        
        /* ----- Settings Cards ----- */
        .settings-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            padding: var(--spacing-md);
            margin-bottom: var(--spacing-sm);
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
        }
        
        .settings-card:hover {
            box-shadow: var(--shadow-md);
        }
        
        .settings-card .card-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .settings-card .card-title i {
            color: var(--purple-primary);
        }
        
        .settings-card .card-subtitle {
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin: 0 0 var(--spacing-md) 0;
        }
        
        /* ----- Form Groups ----- */
        .form-group {
            margin-bottom: var(--spacing-sm);
        }
        
        .form-group label {
            font-weight: 600;
            font-size: 0.82rem;
            color: var(--text-primary);
            display: block;
            margin-bottom: 4px;
        }
        
        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.9rem;
            font-family: inherit;
            transition: all 0.3s ease;
            background: var(--bg-input);
            color: var(--text-primary);
            min-height: 40px;
        }
        
        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: var(--purple-primary);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
            outline: none;
        }
        
        .form-group input:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        
        .form-group textarea {
            resize: vertical;
            min-height: 60px;
        }
        
        .form-group .help-text {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 4px;
        }
        
        .form-group .help-text i {
            margin-right: 4px;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        
        /* ----- Toggle Switch ----- */
        .toggle-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 0;
        }
        
        .toggle-row .toggle-switch {
            position: relative;
            width: 44px;
            height: 24px;
            flex-shrink: 0;
        }
        
        .toggle-row .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        
        .toggle-row .toggle-switch .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--bg-card-secondary);
            border: 2px solid var(--border-color);
            border-radius: var(--radius-full);
            transition: all 0.3s ease;
        }
        
        .toggle-row .toggle-switch .slider::before {
            content: '';
            position: absolute;
            height: 16px;
            width: 16px;
            left: 2px;
            bottom: 2px;
            background: #fff;
            border-radius: 50%;
            transition: all 0.3s ease;
        }
        
        .toggle-row .toggle-switch input:checked + .slider {
            background: var(--purple-primary);
            border-color: var(--purple-primary);
        }
        
        .toggle-row .toggle-switch input:checked + .slider::before {
            transform: translateX(20px);
        }
        
        .toggle-row .toggle-label {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-primary);
            cursor: pointer;
            flex: 1;
        }
        
        .toggle-row .toggle-label i {
            margin-right: 6px;
            color: var(--purple-primary);
        }
        
        /* ----- Text Size Slider ----- */
        .text-size-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 6px 0;
        }
        
        .text-size-row .text-size-icon {
            color: var(--purple-primary);
            font-size: 1rem;
        }
        
        .text-size-row input[type="range"] {
            flex: 1;
            min-height: unset;
            padding: 0;
            height: 4px;
            background: var(--bg-card-secondary);
            border-radius: var(--radius-full);
            appearance: none;
            border: none;
            cursor: pointer;
        }
        
        .text-size-row input[type="range"]::-webkit-slider-thumb {
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--purple-primary);
            cursor: pointer;
            border: 2px solid #fff;
            box-shadow: 0 2px 8px rgba(139, 92, 246, 0.3);
        }
        
        .text-size-row input[type="range"]::-moz-range-thumb {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--purple-primary);
            cursor: pointer;
            border: 2px solid #fff;
        }
        
        .text-size-row .text-size-value {
            font-weight: 700;
            color: var(--purple-primary);
            min-width: 40px;
            font-size: 0.85rem;
            text-align: center;
        }
        
        /* ----- Buttons ----- */
        .btn-settings {
            width: 100%;
            font-size: 0.85rem;
            padding: 10px;
            min-height: 44px;
            border-radius: var(--radius-full);
            background: var(--purple-gradient);
            color: #fff;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .btn-settings:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
        }
        
        .btn-settings-secondary {
            width: 100%;
            font-size: 0.85rem;
            padding: 10px;
            min-height: 44px;
            border-radius: var(--radius-full);
            background: var(--bg-card-secondary);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
        }
        
        .btn-settings-secondary:hover {
            border-color: var(--purple-primary);
            color: var(--purple-primary);
        }
        
        /* ----- Danger Zone ----- */
        .danger-zone {
            border: 2px solid var(--text-error) !important;
            border-radius: var(--radius-lg);
            padding: var(--spacing-md);
            margin-top: 4px;
        }
        
        .danger-zone .danger-title {
            color: var(--text-error);
            font-size: 0.95rem;
            font-weight: 700;
            margin: 0 0 4px 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .danger-zone .danger-title i {
            font-size: 1.1rem;
        }
        
        .danger-zone p {
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin: 0 0 var(--spacing-md) 0;
        }
        
        .btn-danger-zone {
            width: 100%;
            padding: 10px;
            border: none;
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 0.85rem;
            background: var(--text-error);
            color: #fff;
            cursor: pointer;
            transition: all 0.3s ease;
            min-height: 44px;
        }
        
        .btn-danger-zone:hover {
            background: #c0392b;
            transform: translateY(-2px);
        }
        
        /* ----- Divider ----- */
        .settings-divider {
            height: 1px;
            background: var(--border-color);
            margin: var(--spacing-sm) 0 var(--spacing-md) 0;
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 400px) {
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
            
            .settings-card {
                padding: var(--spacing-sm);
            }
            
            .toggle-row {
                flex-wrap: wrap;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    MOBILE HEADER (Built-in)
    ============================================================ -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:10px 14px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; flex-wrap:wrap; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="/dashboard" style="color:rgba(255,255,255,0.9); font-size:0.75rem; padding:4px 8px; text-decoration:none; display:flex; align-items:center; gap:4px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
                <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                <div>
                    <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); updateThemeToggle();" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 8px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon" id="themeIconMobile"></i>
            </button>
            <a href="/logout" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>
    </header>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <main class="main-content">
        <div class="mobile-settings-container">

            <!-- ===== PAGE HEADER ===== -->
            <div class="page-header">
                <h1><i class="fas fa-cog"></i> Settings</h1>
                <p>Manage your account and preferences.</p>
            </div>

            <!-- ===== FLASH MESSAGES ===== -->
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success">
                    <i class="fas fa-check-circle"></i> <%= messages.success %>
                </div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error">
                    <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                </div>
            <% } %>

            <!-- ===== 1. PROFILE ===== -->
            <div class="settings-card">
                <div class="card-title">
                    <i class="fas fa-user"></i> Profile
                </div>
                <p class="card-subtitle">Update your personal information.</p>
                <form id="profileForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="firstName">First Name</label>
                            <input type="text" id="firstName" name="firstName" value="<%= user.firstName || '' %>">
                        </div>
                        <div class="form-group">
                            <label for="lastName">Last Name</label>
                            <input type="text" id="lastName" name="lastName" value="<%= user.lastName || '' %>">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="bio">Bio</label>
                        <textarea id="bio" name="bio" rows="2" placeholder="Tell us a little about yourself"><%= user.bio || '' %></textarea>
                    </div>
                    <div class="form-group">
                        <label>Student ID</label>
                        <input type="text" value="<%= user.studentId || '' %>" disabled>
                        <div class="help-text">
                            <i class="fas fa-info-circle"></i> Your Student ID is permanent
                        </div>
                    </div>
                    <button type="submit" class="btn-settings">
                        <i class="fas fa-save"></i> Save Profile
                    </button>
                </form>
            </div>

            <!-- ===== 2. ACCOUNT ===== -->
            <div class="settings-card">
                <div class="card-title">
                    <i class="fas fa-key"></i> Account
                </div>
                <p class="card-subtitle">Change your password.</p>
                <form id="passwordForm">
                    <div class="form-group">
                        <label for="currentPassword">Current Password</label>
                        <input type="password" id="currentPassword" name="currentPassword" placeholder="Enter current password">
                    </div>
                    <div class="form-group">
                        <label for="newPassword">New Password</label>
                        <input type="password" id="newPassword" name="newPassword" placeholder="Min 6 characters">
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword">Confirm New Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password">
                    </div>
                    <button type="submit" class="btn-settings">
                        <i class="fas fa-save"></i> Change Password
                    </button>
                </form>
            </div>

            <!-- ===== 3. SECURITY ===== -->
            <div class="settings-card">
                <div class="card-title">
                    <i class="fas fa-shield-alt"></i> Security
                </div>
                <p class="card-subtitle">Protect your account with additional security.</p>
                
                <div class="toggle-row">
                    <div class="toggle-switch">
                        <input type="checkbox" id="twoFactor" name="twoFactorEnabled" <%= user.twoFactorEnabled ? 'checked' : '' %>>
                        <span class="slider"></span>
                    </div>
                    <span class="toggle-label">
                        <i class="fas fa-lock"></i> Two-Factor Authentication
                    </span>
                </div>
                <div class="help-text" style="margin-bottom:var(--spacing-sm);">
                    <i class="fas fa-info-circle"></i> Add an extra layer of security to your account
                </div>
                
                <button id="logoutAll" class="btn-settings-secondary">
                    <i class="fas fa-sign-out-alt"></i> Logout from All Sessions
                </button>
            </div>

            <!-- ===== 4. APPEARANCE ===== -->
            <div class="settings-card">
                <div class="card-title">
                    <i class="fas fa-palette"></i> Appearance
                </div>
                <p class="card-subtitle">Customize how SHINEX looks.</p>
                
                <div class="toggle-row">
                    <div class="toggle-switch">
                        <input type="checkbox" id="darkModeSetting" name="darkMode" <%= user.darkMode ? 'checked' : '' %>>
                        <span class="slider"></span>
                    </div>
                    <span class="toggle-label">
                        <i class="fas fa-moon"></i> Dark Mode
                    </span>
                </div>
                <div class="help-text" style="margin-bottom:var(--spacing-sm);">
                    <i class="fas fa-info-circle"></i> Toggle between light and dark mode
                </div>
                
                <div class="text-size-row">
                    <span class="text-size-icon"><i class="fas fa-font"></i></span>
                    <input type="range" class="text-size-slider" min="12" max="24" value="<%= user.textSize || 16 %>" step="1">
                    <span class="text-size-value"><%= user.textSize || 16 %>px</span>
                </div>
                <div class="help-text">
                    <i class="fas fa-info-circle"></i> Adjust the text size across the platform
                </div>
            </div>

            <!-- ===== 5. NOTIFICATIONS ===== -->
            <div class="settings-card">
                <div class="card-title">
                    <i class="fas fa-bell"></i> Notifications
                </div>
                <p class="card-subtitle">Choose how you receive updates.</p>
                
                <div class="toggle-row">
                    <div class="toggle-switch">
                        <input type="checkbox" id="emailNotif" name="emailNotifications" class="notification-checkbox" <%= user.emailNotifications ? 'checked' : '' %>>
                        <span class="slider"></span>
                    </div>
                    <span class="toggle-label">
                        <i class="fas fa-envelope"></i> Email Notifications
                    </span>
                </div>
                
                <div class="toggle-row">
                    <div class="toggle-switch">
                        <input type="checkbox" id="browserNotif" name="browserNotifications" class="notification-checkbox" <%= user.browserNotifications ? 'checked' : '' %>>
                        <span class="slider"></span>
                    </div>
                    <span class="toggle-label">
                        <i class="fas fa-browser"></i> Browser Notifications
                    </span>
                </div>
                
                <div class="toggle-row">
                    <div class="toggle-switch">
                        <input type="checkbox" id="courseUpdate" name="courseUpdates" class="notification-checkbox" <%= user.courseUpdates ? 'checked' : '' %>>
                        <span class="slider"></span>
                    </div>
                    <span class="toggle-label">
                        <i class="fas fa-graduation-cap"></i> Course Updates
                    </span>
                </div>
            </div>

            <!-- ===== 6. PRIVACY ===== -->
            <div class="settings-card">
                <div class="card-title">
                    <i class="fas fa-lock"></i> Privacy
                </div>
                <p class="card-subtitle">Control who can see your information.</p>
                
                <div class="form-group">
                    <label for="profileVisibility">Profile Visibility</label>
                    <select id="profileVisibility" name="profileVisibility">
                        <option value="public" <%= user.profileVisibility === 'public' ? 'selected' : '' %>>Public – Anyone can see</option>
                        <option value="private" <%= user.profileVisibility === 'private' ? 'selected' : '' %>>Private – Only you and admins</option>
                    </select>
                    <div class="help-text">
                        <i class="fas fa-info-circle"></i> Public profiles are visible to all users
                    </div>
                </div>
            </div>

            <!-- ===== 7. LEARNING ===== -->
            <div class="settings-card">
                <div class="card-title">
                    <i class="fas fa-graduation-cap"></i> Learning
                </div>
                <p class="card-subtitle">Customize your learning experience.</p>
                
                <div class="form-group">
                    <label for="learningLevel">Learning Level</label>
                    <select id="learningLevel" name="learningLevel">
                        <option value="Beginner" <%= user.learningLevel === 'Beginner' ? 'selected' : '' %>>🌱 Beginner</option>
                        <option value="Intermediate" <%= user.learningLevel === 'Intermediate' ? 'selected' : '' %>>🌿 Intermediate</option>
                        <option value="Advanced" <%= user.learningLevel === 'Advanced' ? 'selected' : '' %>>🚀 Advanced</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="learningInterests">Learning Interests</label>
                    <textarea id="learningInterests" name="learningInterests" rows="2" placeholder="What topics interest you?"><%= user.learningInterests || '' %></textarea>
                    <div class="help-text">
                        <i class="fas fa-info-circle"></i> We'll recommend courses based on your interests
                    </div>
                </div>
            </div>

            <!-- ===== 8. HELP & SUPPORT ===== -->
            <div class="settings-card">
                <div class="card-title">
                    <i class="fas fa-headset"></i> Help & Support
                </div>
                <p class="card-subtitle">Need help? We're here for you.</p>
                
                <a href="/faq" class="btn-settings-secondary" style="margin-bottom:var(--spacing-sm);">
                    <i class="fas fa-question-circle"></i> View FAQs
                </a>
                <a href="/contact" class="btn-settings">
                    <i class="fas fa-envelope"></i> Contact Support
                </a>
            </div>

            <!-- ===== 9. DANGER ZONE ===== -->
            <div class="settings-card danger-zone">
                <div class="danger-title">
                    <i class="fas fa-exclamation-triangle"></i> Danger Zone
                </div>
                <p>Once you delete your account, there is no going back. All your data will be permanently removed.</p>
                <button id="deleteAccount" class="btn-danger-zone">
                    <i class="fas fa-trash-alt"></i> Delete Account
                </button>
            </div>

        </div>
    </main>

    <!-- ============================================================
    MOBILE FOOTER (Built-in)
    ============================================================ -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div style="max-width:500px; margin:0 auto; padding:0 16px;">
            <!-- Logo -->
            <div style="text-align:center; margin-bottom:12px;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:4px;">
                    <div style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div>
                        <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                        <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                    </div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:0;">Learn. Understand. Protect. 🛡️</p>
            </div>

            <!-- Footer Links -->
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:6px 12px; margin:12px 0;">
                <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Home</a>
                <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">About</a>
                <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Services</a>
                <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">FAQ</a>
                <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Contact</a>
                <a href="/terms" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Terms</a>
                <a href="/privacy" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Privacy</a>
            </div>

            <!-- Social Icons -->
            <div style="display:flex; justify-content:center; gap:12px; margin:12px 0 16px;">
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-whatsapp"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-youtube"></i>
                </a>
            </div>

            <!-- Copyright -->
            <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:12px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.5);">
                &copy; <%= new Date().getFullYear() %> SHINEX Learning Circle. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:20px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:50px; height:50px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    👋 Hi! I'm your SHINEX AI Tutor. Need help with your settings?
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script>
        // ============================================================
        // THEME TOGGLE
        // ============================================================
        
        function updateThemeToggle() {
            const isDark = document.body.classList.contains('dark-mode');
            const icon = document.getElementById('themeIconMobile');
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }
        
        // ============================================================
        // TOAST NOTIFICATION
        // ============================================================
        
        function showToast(message, type) {
            const existing = document.querySelector('.toast-notification');
            if (existing) existing.remove();
            
            const toast = document.createElement('div');
            toast.className = 'toast-notification toast-' + type;
            toast.textContent = message;
            toast.style.cssText = `
                position: fixed;
                bottom: 100px;
                left: 50%;
                transform: translateX(-50%);
                padding: 14px 28px;
                border-radius: 12px;
                font-weight: 600;
                font-size: 0.95rem;
                z-index: 99999;
                background: ${type === 'success' ? '#27ae60' : type === 'error' ? '#e74c3c' : '#3498db'};
                color: #fff;
                box-shadow: 0 8px 30px rgba(0,0,0,0.2);
                max-width: 90%;
                text-align: center;
                font-family: 'Inter', sans-serif;
            `;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(-50%) translateY(20px)';
                toast.style.transition = 'all 0.4s ease';
                setTimeout(() => toast.remove(), 400);
            }, 3500);
        }
        
        // ============================================================
        // SETTINGS HANDLERS
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            
            // ----- Profile Form -----
            const profileForm = document.getElementById('profileForm');
            if (profileForm) {
                profileForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const formData = new FormData(this);
                    
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('✅ Profile updated successfully!', 'success');
                        } else {
                            showToast('❌ ' + data.error, 'error');
                        }
                    })
                    .catch(() => showToast('❌ Something went wrong.', 'error'));
                });
            }
            
            // ----- Password Form -----
            const passwordForm = document.getElementById('passwordForm');
            if (passwordForm) {
                passwordForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const formData = new FormData(this);
                    const newPass = formData.get('newPassword');
                    const confirmPass = formData.get('confirmPassword');
                    
                    if (newPass !== confirmPass) {
                        showToast('❌ Passwords do not match!', 'error');
                        return;
                    }
                    if (newPass.length < 6) {
                        showToast('❌ Password must be at least 6 characters.', 'error');
                        return;
                    }
                    
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('✅ Password changed successfully!', 'success');
                            this.reset();
                        } else {
                            showToast('❌ ' + data.error, 'error');
                        }
                    })
                    .catch(() => showToast('❌ Something went wrong.', 'error'));
                });
            }
            
            // ----- Dark Mode Setting -----
            const darkModeSetting = document.getElementById('darkModeSetting');
            if (darkModeSetting) {
                darkModeSetting.addEventListener('change', function() {
                    const body = document.body;
                    body.classList.toggle('dark-mode', this.checked);
                    localStorage.setItem('shinex-theme', this.checked ? 'dark' : 'light');
                    updateThemeToggle();
                    showToast(this.checked ? '🌙 Dark mode enabled' : '☀️ Light mode enabled', 'success');
                });
            }
            
            // ----- 2FA Toggle -----
            const twoFactor = document.getElementById('twoFactor');
            if (twoFactor) {
                twoFactor.addEventListener('change', function() {
                    const formData = new FormData();
                    formData.append('twoFactorEnabled', this.checked ? 'on' : 'off');
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast(this.checked ? '🔐 2FA enabled' : '🔓 2FA disabled', 'success');
                        }
                    })
                    .catch(() => {});
                });
            }
            
            // ----- Notification Checkboxes -----
            document.querySelectorAll('.notification-checkbox').forEach(cb => {
                cb.addEventListener('change', function() {
                    const formData = new FormData();
                    formData.append(this.name, this.checked ? 'on' : 'off');
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('✅ Preference updated', 'success');
                        }
                    })
                    .catch(() => {});
                });
            });
            
            // ----- Privacy Visibility -----
            const privacySelect = document.getElementById('profileVisibility');
            if (privacySelect) {
                privacySelect.addEventListener('change', function() {
                    const formData = new FormData();
                    formData.append('profileVisibility', this.value);
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('✅ Privacy updated', 'success');
                        }
                    })
                    .catch(() => {});
                });
            }
            
            // ----- Learning Level -----
            const levelSelect = document.getElementById('learningLevel');
            if (levelSelect) {
                levelSelect.addEventListener('change', function() {
                    const formData = new FormData();
                    formData.append('learningLevel', this.value);
                    fetch('/settings/update', {
                        method: 'POST',
                        body: new URLSearchParams(formData)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('✅ Learning level updated', 'success');
                        }
                    })
                    .catch(() => {});
                });
            }
            
            // ----- Learning Interests -----
            const interests = document.getElementById('learningInterests');
            if (interests) {
                let timeoutId;
                interests.addEventListener('input', function() {
                    clearTimeout(timeoutId);
                    timeoutId = setTimeout(() => {
                        const formData = new FormData();
                        formData.append('learningInterests', this.value);
                        fetch('/settings/update', {
                            method: 'POST',
                            body: new URLSearchParams(formData)
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                showToast('✅ Interests saved', 'success');
                            }
                        })
                        .catch(() => {});
                    }, 1000);
                });
            }
            
            // ----- Text Size Slider -----
            document.querySelectorAll('.text-size-slider').forEach(slider => {
                const valueDisplay = slider.parentElement.querySelector('.text-size-value');
                
                slider.addEventListener('input', function() {
                    const size = this.value;
                    document.body.style.fontSize = size + 'px';
                    if (valueDisplay) valueDisplay.textContent = size + 'px';
                    localStorage.setItem('shinex-text-size', size);
                    
                    // Sync all sliders
                    document.querySelectorAll('.text-size-slider').forEach(s => {
                        if (s !== this) s.value = size;
                        const display = s.parentElement.querySelector('.text-size-value');
                        if (display) display.textContent = size + 'px';
                    });
                });
            });
            
            // ----- Logout All -----
            const logoutAll = document.getElementById('logoutAll');
            if (logoutAll) {
                logoutAll.addEventListener('click', function() {
                    if (confirm('⚠️ Logout from all devices? You will need to login again on every device.')) {
                        fetch('/logout-all', { method: 'POST' })
                        .then(() => {
                            showToast('✅ Logged out from all sessions.', 'success');
                            setTimeout(() => window.location.reload(), 1000);
                        });
                    }
                });
            }
            
            // ----- Delete Account -----
            const deleteBtn = document.getElementById('deleteAccount');
            if (deleteBtn) {
                deleteBtn.addEventListener('click', function() {
                    if (confirm('⚠️ Delete your account? This cannot be undone!\n\nAll your data, progress, and courses will be permanently deleted.')) {
                        const confirmText = prompt('Type "DELETE" to confirm:');
                        if (confirmText === 'DELETE') {
                            fetch('/delete-account', { method: 'POST' })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    showToast('✅ Account deleted successfully.', 'success');
                                    setTimeout(() => window.location.href = '/', 2000);
                                } else {
                                    showToast('❌ ' + data.error, 'error');
                                }
                            })
                            .catch(() => showToast('❌ Something went wrong.', 'error'));
                        } else {
                            showToast('❌ Deletion cancelled.', 'error');
                        }
                    }
                });
            }
        });
        
        // ============================================================
        // AI BOT
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const botBtn = document.getElementById('aiBotBtn');
            const chatModal = document.getElementById('aiChatModal');
            const chatClose = document.getElementById('aiChatClose');
            const chatInput = document.getElementById('aiChatInput');
            const chatSend = document.getElementById('aiChatSend');
            const chatMessages = document.getElementById('aiChatMessages');
            
            if (!botBtn || !chatModal) return;
            
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
            
            if (chatClose) {
                chatClose.addEventListener('click', function() {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                });
            }
            
            document.addEventListener('click', function(e) {
                if (chatModal.classList.contains('open')) {
                    if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                        chatModal.classList.remove('open');
                        chatModal.style.display = 'none';
                    }
                }
            });
            
            function addChatMessage(text, type) {
                const div = document.createElement('div');
                div.className = 'ai-chat-msg ' + type;
                let formatted = text;
                formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\n/g, '<br>');
                div.innerHTML = formatted;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            
            function sendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;
                
                addChatMessage(message, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                chatSend.disabled = true;
                
                const loadingMsg = document.createElement('div');
                loadingMsg.className = 'ai-chat-msg bot';
                loadingMsg.innerHTML = '⏳ Thinking...';
                loadingMsg.id = 'aiChatLoading';
                chatMessages.appendChild(loadingMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                fetch('/api/ai-tutor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userPrompt: message })
                })
                .then(response => response.json())
                .then(data => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    
                    if (data.error) {
                        addChatMessage('❌ ' + data.error, 'bot');
                    } else {
                        addChatMessage(data.answer, 'bot');
                    }
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                    chatInput.focus();
                })
                .catch(error => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                });
            }
            
            if (chatSend) {
                chatSend.addEventListener('click', sendMessage);
            }
            
            if (chatInput) {
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            }
        });
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
            updateThemeToggle();
        }
        
        // ============================================================
        // AUTO DISMISS FLASH MESSAGES
        // ============================================================
        
        document.querySelectorAll('.flash-message').forEach(msg => {
            setTimeout(() => {
                msg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                msg.style.opacity = '0';
                msg.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    if (msg.parentNode) msg.remove();
                }, 500);
            }, 5000);
        });
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('⚙️ SHINEX Settings Page');
        console.log('👤 Welcome, <%= user.firstName %>!');
        console.log('🔧 Customize your experience');
        console.log('🤖 AI Tutor ready to help!');
    </script>

</body>
</html>