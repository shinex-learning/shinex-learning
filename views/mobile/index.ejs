<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>SHINEX – Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* Mobile Course Card */
        .mobile-course-card {
            background: #fff;
            border-radius: 10px;
            padding: 14px 16px;
            border: 1px solid #ede8f5;
            margin-bottom: 10px;
            cursor: default;
        }
        body.dark-mode .mobile-course-card {
            background: #1a1a1a;
            border-color: #333;
        }
        body.dark-mode .mobile-course-card .course-title {
            color: #fff;
        }
        body.dark-mode .mobile-course-card .course-desc {
            color: #b0a0c0;
        }
        body.dark-mode .mobile-course-card .course-lock {
            color: #888;
            border-top-color: #333;
        }
        .mobile-course-card .course-title {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text-dark);
            margin: 4px 0 2px;
        }
        .mobile-course-card .course-desc {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-bottom: 6px;
        }
        .mobile-course-card .course-lock {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid #ede8f5;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.6rem;
        }
        .mobile-course-card .course-lock i {
            color: #8B5CF6;
        }
        .mobile-course-card .badge-meta-sm {
            background: #ede8f5;
            color: var(--text-dark);
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.5rem;
            font-weight: 600;
        }
        body.dark-mode .mobile-course-card .badge-meta-sm {
            background: #333;
            color: #d0d0d0;
        }
        .mobile-course-card .badge-level-sm {
            background: var(--primary-bg);
            color: #8B5CF6;
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.55rem;
            font-weight: 600;
        }
        body.dark-mode .mobile-course-card .badge-level-sm {
            background: #2a1a4a;
            color: #a78bfa;
        }
        .mobile-course-card .badge-duration-sm {
            font-size: 0.6rem;
            color: var(--text-muted);
        }
        body.dark-mode .mobile-course-card .badge-duration-sm {
            color: #888;
        }

        /* Mobile Service Card */
        .mobile-service-card {
            background: #fff;
            border-radius: 10px;
            padding: 12px 14px;
            border: 1px solid #ede8f5;
            margin-bottom: 8px;
        }
        body.dark-mode .mobile-service-card {
            background: #1a1a1a;
            border-color: #333;
        }
        body.dark-mode .mobile-service-card .service-name {
            color: #fff;
        }
        body.dark-mode .mobile-service-card .service-desc {
            color: #b0a0c0;
        }
        body.dark-mode .mobile-service-card .service-price {
            color: #a78bfa;
        }
        .mobile-service-card .service-name {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-dark);
        }
        .mobile-service-card .service-desc {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin: 2px 0 6px;
        }
        .mobile-service-card .service-price {
            font-weight: 700;
            color: #8B5CF6;
            font-size: 1rem;
        }
        .mobile-service-card .service-category-sm {
            background: var(--primary-bg);
            color: #8B5CF6;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.5rem;
            font-weight: 600;
        }
        body.dark-mode .mobile-service-card .service-category-sm {
            background: #2a1a4a;
            color: #a78bfa;
        }
        .mobile-service-card .service-order-btn-sm {
            width: 100%;
            text-align: center;
            font-size: 0.75rem;
            padding: 6px;
            border-radius: 30px;
            background: #8B5CF6;
            color: #fff;
            border: none;
            font-weight: 600;
            text-decoration: none;
            display: block;
            margin-top: 6px;
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">

            <!-- Hero -->
            <div style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); border-radius:12px; padding:20px 16px; text-align:center; color:#fff; margin-bottom:16px;">
                <h1 style="font-size:1.3rem; font-weight:800; margin:0;">SHINEX Learning</h1>
                <p style="font-size:0.9rem; opacity:0.8; margin:4px 0 0;">Learn. Grow. Succeed.</p>
                <div style="display:flex; gap:8px; justify-content:center; margin-top:10px; flex-wrap:wrap;">
                    <a href="#courses" style="background:rgba(255,255,255,0.2); color:#fff; padding:6px 14px; border-radius:30px; font-size:0.75rem; text-decoration:none;">
                        <i class="fas fa-arrow-down"></i> Courses
                    </a>
                    <a href="/services" style="background:rgba(255,255,255,0.2); color:#fff; padding:6px 14px; border-radius:30px; font-size:0.75rem; text-decoration:none;">
                        <i class="fas fa-cogs"></i> Services
                    </a>
                </div>
            </div>

            <!-- Courses -->
            <div id="courses">
                <h3 style="font-size:1rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-graduation-cap" style="color:#8B5CF6;"></i> Our Courses
                </h3>
                <p style="font-size:0.7rem; color:var(--text-muted); margin:0 0 10px 0;">
                    Available to registered students
                </p>

                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(function(c) { %>
                        <div class="mobile-course-card">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span class="badge-level-sm"><%= c.level || 'Beginner' %></span>
                                <span class="badge-duration-sm"><i class="far fa-clock"></i> <%= c.duration || 'N/A' %></span>
                            </div>
                            <div class="course-title"><%= c.title %></div>
                            <div class="course-desc"><%= c.description ? c.description.substring(0, 50) + (c.description.length > 50 ? '...' : '') : '' %></div>
                            <div style="display:flex; flex-wrap:wrap; gap:4px;">
                                <span class="badge-meta-sm">
                                    <i class="fas fa-layer-group"></i> <%= c.levels ? c.levels.length : 0 %> Levels
                                </span>
                                <span class="badge-meta-sm">
                                    <i class="fas fa-book"></i> 
                                    <% let totalClasses = 0; %>
                                    <% if (c.levels) { %>
                                        <% c.levels.forEach(function(l) { if (l.lessons) { l.lessons.forEach(function(ls) { if (ls.classes) totalClasses += ls.classes.length; }); } }); %>
                                    <% } %>
                                    <%= totalClasses %> Classes
                                </span>
                            </div>
                            <div class="course-lock">
                                <i class="fas fa-lock"></i> Login to access
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div style="text-align:center; padding:20px; color:#7a6a8f;">
                        <p>No courses available yet.</p>
                    </div>
                <% } %>
            </div>

            <!-- Services -->
            <h3 style="font-size:1rem; font-weight:700; color:var(--text-dark); margin:16px 0 4px 0;">
                <i class="fas fa-cogs" style="color:#8B5CF6;"></i> Our Services
            </h3>
            <p style="font-size:0.7rem; color:var(--text-muted); margin:0 0 10px 0;">
                Click "Order" to contact us
            </p>

            <% if (services && services.length > 0) { %>
                <% services.forEach(function(service) { %>
                    <div class="mobile-service-card">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:6px;">
                            <div class="service-name"><%= service.name %></div>
                            <span class="service-category-sm"><%= service.category || 'Service' %></span>
                        </div>
                        <div class="service-desc"><%= service.description ? service.description.substring(0, 40) + (service.description.length > 40 ? '...' : '') : 'Professional service.' %></div>
                        <div class="service-price">₦<%= service.price %></div>
                        <a href="/contact" class="service-order-btn-sm">
                            <i class="fas fa-arrow-right"></i> Order
                        </a>
                    </div>
                <% }); %>
            <% } else { %>
                <div style="text-align:center; padding:20px; color:#7a6a8f;">
                    <p>No services available yet.</p>
                </div>
            <% } %>

            <!-- Services Button -->
            <div style="text-align:center; background:var(--primary-bg); border-radius:12px; padding:16px; margin-top:12px;">
                <a href="/services" style="width:100%; text-align:center; font-size:0.85rem; padding:10px; border-radius:30px; background:#8B5CF6; color:#fff; border:none; font-weight:600; text-decoration:none; display:block;">
                    <i class="fas fa-arrow-right"></i> View All Services
                </a>
            </div>

        </div>
    </main>

    <%- include('../partials/footer-mobile') %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; font-size:20px;"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hello! I'm your AI tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>