<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>SHINEX – Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ===== MOBILE HOMEPAGE ===== */
        .mobile-hero {
            padding: 28px 18px;
            text-align: center;
            background: linear-gradient(135deg, #8B5CF6, #6a3dcf);
            border-radius: 16px;
            margin: 12px 0 28px;
            color: #fff;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.2);
        }
        .mobile-hero h1 {
            font-size: 1.6rem;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.5px;
        }
        .mobile-hero p {
            font-size: 0.9rem;
            color: #d4c4f0;
            margin: 6px 0 18px;
        }
        .mobile-hero .btn {
            background: #fff;
            color: #8B5CF6;
            padding: 12px 28px;
            border-radius: 30px;
            font-weight: 600;
            border: none;
            font-size: 1rem;
            box-shadow: 0 4px 14px rgba(0,0,0,0.15);
        }
        .mobile-section-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #1A0A2E;
            margin: 28px 0 4px;
        }
        body.dark-mode .mobile-section-title {
            color: #f0f0f0;
        }
        .mobile-section-sub {
            color: #7a6a8f;
            font-size: 0.85rem;
            margin: 0 0 16px;
        }
        body.dark-mode .mobile-section-sub {
            color: #b0a0c0;
        }
        .mobile-course-card {
            background: #fff;
            border-radius: 14px;
            padding: 18px 16px;
            margin-bottom: 16px;
            border: 1px solid #ede8f5;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }
        body.dark-mode .mobile-course-card {
            background: #1e1e1e;
            border-color: #333;
        }
        .mobile-course-card .course-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: #1A0A2E;
            margin: 4px 0 2px;
        }
        body.dark-mode .mobile-course-card .course-title {
            color: #f0f0f0;
        }
        .mobile-course-card .course-desc {
            font-size: 0.85rem;
            color: #5a4a70;
            margin: 4px 0 10px;
            line-height: 1.5;
        }
        body.dark-mode .mobile-course-card .course-desc {
            color: #a090b0;
        }
        .mobile-course-card .course-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 6px 0 12px;
        }
        .mobile-course-card .course-action .btn {
            width: 100%;
        }
        .mobile-empty-state {
            text-align: center;
            padding: 40px 20px;
            background: #f8f6fc;
            border-radius: 14px;
            border: 1px solid #ede8f5;
            margin: 10px 0;
        }
        body.dark-mode .mobile-empty-state {
            background: #1a1a1a;
            border-color: #333;
        }
        .mobile-empty-state .empty-icon {
            font-size: 2.5rem;
            color: #d4c4f0;
            display: block;
            margin-bottom: 10px;
        }
        .mobile-empty-state p {
            color: #7a6a8f;
            font-size: 0.9rem;
            margin: 0;
        }
        body.dark-mode .mobile-empty-state p {
            color: #a090b0;
        }
        .mobile-empty-state .empty-sub {
            font-size: 0.75rem;
            color: #b0a3c4;
            margin-top: 4px;
        }
        .mobile-ad-section {
            margin-top: 24px;
        }
        /* Fix spacing between elements */
        .mobile-spacer {
            height: 4px;
        }
    </style>
</head>
<body>
    <%- include('partials/header', { user, showBack: false }) %>

    <main class="main-content" style="padding: 8px 12px 30px;">
        <% if (messages && messages.error) { %>
            <div class="alert alert-danger" style="margin-bottom:12px;"><%= messages.error %></div>
        <% } %>
        <% if (messages && messages.success) { %>
            <div class="alert alert-success" style="margin-bottom:12px;"><%= messages.success %></div>
        <% } %>

        <!-- ===== HERO ===== -->
        <div class="mobile-hero">
            <h1>SHINEX Learning Circle</h1>
            <p>Empowering minds with cutting-edge courses in tech, design, and data.</p>
            <a href="/dashboard" class="btn">
                <i class="fas fa-arrow-right"></i> Explore Courses
            </a>
        </div>

        <!-- ===== COURSES ===== -->
        <div class="mobile-section-title"><i class="fas fa-graduation-cap" style="color:#8B5CF6;"></i> Our Courses</div>
        <p class="mobile-section-sub">Choose a course to start learning</p>

        <% if (courses && courses.length > 0) { %>
            <% courses.forEach(function(c) { %>
                <div class="mobile-course-card">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                        <span class="badge badge-purple"><%= c.level || 'N/A' %></span>
                        <span style="font-size:0.7rem; color:#7a6a8f;"><i class="far fa-clock"></i> <%= c.duration || 'N/A' %></span>
                    </div>
                    <div class="course-title"><%= c.title %></div>
                    <div class="course-desc"><%= c.description %></div>
                    <div class="course-meta">
                        <span class="badge badge-dark">
                            <i class="fas fa-layer-group"></i> <%= c.levels ? c.levels.length : 0 %> Levels
                        </span>
                        <span class="badge badge-dark">
                            <i class="fas fa-book"></i> 
                            <% let totalClasses = 0; %>
                            <% if (c.levels) { %>
                                <% c.levels.forEach(function(l) { if (l.lessons) { l.lessons.forEach(function(ls) { if (ls.classes) totalClasses += ls.classes.length; }); } }); %>
                            <% } %>
                            <%= totalClasses %> Classes
                        </span>
                        <% if (user && user.courseId === c.id) { %>
                            <span class="badge badge-green"><i class="fas fa-check-circle"></i> Enrolled</span>
                        <% } %>
                    </div>
                    <div class="course-action">
                        <a href="/course/<%= c.id %>" class="btn btn-primary btn-sm">
                            <i class="fas fa-eye"></i> View Course
                        </a>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="mobile-empty-state">
                <span class="empty-icon"><i class="fas fa-info-circle"></i></span>
                <p>No courses available yet.</p>
                <p class="empty-sub">Check back soon for new courses!</p>
            </div>
        <% } %>

        <!-- ===== AD BOX ===== -->
        <div class="mobile-ad-section">
            <%- include('../partials/ad-box') %>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>