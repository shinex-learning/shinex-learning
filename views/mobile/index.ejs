<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>SHINEX – Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .mobile-hero {
            padding: 24px 16px;
            text-align: center;
            background: linear-gradient(135deg, #8B5CF6, #6a3dcf);
            border-radius: 14px;
            margin: 12px 0 20px;
            color: #fff;
        }
        .mobile-hero h1 { font-size: 1.5rem; font-weight: 800; margin: 0; }
        .mobile-hero p { font-size: 0.85rem; color: #d4c4f0; margin: 4px 0 12px; }
        .mobile-hero .btn { background: #fff; color: #8B5CF6; padding: 10px 20px; border-radius: 30px; font-weight: 600; }
        .mobile-course-card {
            background: #fff;
            border-radius: 12px;
            padding: 14px 12px;
            margin-bottom: 12px;
            border: 1px solid #ede8f5;
        }
        body.dark-mode .mobile-course-card {
            background: #1e1e1e;
            border-color: #333;
        }
        .mobile-course-card .course-title {
            font-size: 1rem;
            font-weight: 700;
            color: #1A0A2E;
            margin: 2px 0;
        }
        body.dark-mode .mobile-course-card .course-title { color: #f0f0f0; }
        .mobile-course-card .course-desc {
            font-size: 0.8rem;
            color: #5a4a70;
            margin: 2px 0 6px;
        }
        body.dark-mode .mobile-course-card .course-desc { color: #a090b0; }
        .mobile-section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1A0A2E;
            margin: 12px 0 8px;
        }
        body.dark-mode .mobile-section-title { color: #f0f0f0; }
    </style>
</head>
<body>
    <%- include('partials/header', { user, showBack: false }) %>

    <main class="main-content" style="padding: 8px 12px 20px;">
        <!-- Messages -->
        <% if (messages && messages.error) { %>
            <div class="alert alert-danger" style="margin-bottom:10px;"><%= messages.error %></div>
        <% } %>
        <% if (messages && messages.success) { %>
            <div class="alert alert-success" style="margin-bottom:10px;"><%= messages.success %></div>
        <% } %>

        <!-- Hero -->
        <div class="mobile-hero">
            <h1>SHINEX Learning Circle</h1>
            <p>Empowering minds with cutting-edge courses</p>
            <% if (user) { %>
                <a href="/dashboard" class="btn">My Dashboard</a>
            <% } else { %>
                <a href="/register/step1" class="btn" style="margin-right:8px;">Get Started</a>
                <a href="/login" class="btn" style="background:transparent; color:#fff; border:2px solid #fff;">Login</a>
            <% } %>
        </div>

        <!-- Courses -->
        <div class="mobile-section-title"><i class="fas fa-graduation-cap" style="color:#8B5CF6;"></i> Our Courses</div>
        <p style="color:#7a6a8f; font-size:0.8rem; margin:0 0 10px;">Choose a course to start learning</p>

        <% if (courses && courses.length > 0) { %>
            <% courses.forEach(function(c) { %>
                <div class="mobile-course-card">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                        <span class="badge badge-purple"><%= c.level || 'N/A' %></span>
                        <span style="font-size:0.7rem; color:#7a6a8f;"><i class="far fa-clock"></i> <%= c.duration || 'N/A' %></span>
                    </div>
                    <div class="course-title"><%= c.title %></div>
                    <div class="course-desc"><%= c.description %></div>
                    <div style="display:flex; flex-wrap:wrap; gap:4px; margin:4px 0 8px;">
                        <span class="badge badge-dark"><i class="fas fa-layer-group"></i> <%= c.levels ? c.levels.length : 0 %> Levels</span>
                        <span class="badge badge-dark">
                            <i class="fas fa-book"></i> 
                            <% let totalClasses = 0; %>
                            <% if (c.levels) { %>
                                <% c.levels.forEach(function(l) { if (l.lessons) { l.lessons.forEach(function(ls) { if (ls.classes) totalClasses += ls.classes.length; }); } }); %>
                            <% } %>
                            <%= totalClasses %> Classes
                        </span>
                        <% if (user && user.courseId === c.id) { %>
                            <span class="badge badge-green"><i class="fas fa-check-circle"></i> Enrolled</span>
                        <% } %>
                    </div>
                    <% if (user && user.courseId === c.id) { %>
                        <a href="/course/<%= c.id %>" class="btn btn-primary btn-sm" style="width:100%;">Continue Learning</a>
                    <% } else if (user) { %>
                        <button class="btn btn-secondary btn-sm" style="width:100%;" disabled>Enroll via Admin</button>
                    <% } else { %>
                        <a href="/login" class="btn btn-secondary btn-sm" style="width:100%;">Login to Enroll</a>
                    <% } %>
                </div>
            <% }); %>
        <% } else { %>
            <div style="text-align:center; padding:30px 16px; background:#f8f6fc; border-radius:12px; border:1px solid #ede8f5;">
                <i class="fas fa-info-circle" style="font-size:2rem; color:#d4c4f0;"></i>
                <p style="color:#7a6a8f; margin:8px 0 0;">No courses available yet.</p>
            </div>
        <% } %>

        <!-- Ad Box -->
        <%- include('../partials/ad-box') %>
    </main>

    <%- include('partials/footer') %>
</body>
</html>