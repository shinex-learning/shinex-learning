<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>SHINEX – Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include(getHeader()) %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger flash-message" data-type="error"><%= messages.error %></div>
            <% } %>
            <% if (messages && messages.success) { %>
                <div class="alert alert-success flash-message" data-type="success"><%= messages.success %></div>
            <% } %>

            <!-- Hero -->
            <div class="card card-purple" style="padding:20px 16px; text-align:center; margin-bottom:16px; border-radius:12px;">
                <h1 style="font-size:1.4rem; font-weight:800; color:#fff; margin:0;">SHINEX</h1>
                <p style="color:#d4c4f0; font-size:0.9rem; margin:4px 0 0;">Learn. Grow. Succeed.</p>
            </div>

            <!-- Courses -->
            <h3 style="font-size:1rem; font-weight:700; color:var(--text-dark); margin:0 0 2px 0;">
                <i class="fas fa-graduation-cap" style="color:var(--primary);"></i> Courses
            </h3>

            <div style="display:flex; flex-direction:column; gap:12px; margin-top:8px;">
                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(function(c) { %>
                        <div style="background:#fff; border-radius:12px; padding:14px 16px; border:1px solid #ede8f5;">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                                <span class="badge badge-purple" style="font-size:0.6rem;"><%= c.level || 'Beginner' %></span>
                                <span style="font-size:0.7rem; color:var(--text-muted);"><i class="far fa-clock"></i> <%= c.duration || 'N/A' %></span>
                            </div>
                            <div style="font-size:1rem; font-weight:700; color:var(--text-dark); margin:4px 0 2px;"><%= c.title %></div>
                            <div style="font-size:0.8rem; color:var(--text-muted); margin:0 0 6px;"><%= c.description ? c.description.substring(0,60) + '...' : '' %></div>
                            <a href="/course/<%= c.id %>" class="btn btn-primary btn-sm" style="width:100%; text-align:center; font-size:0.8rem; padding:8px;"><i class="fas fa-eye"></i> View</a>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-state" style="padding:24px 16px;">
                        <span class="empty-icon"><i class="fas fa-info-circle"></i></span>
                        <h3 style="font-size:1rem;">No courses yet</h3>
                    </div>
                <% } %>
            </div>

            <%- include(getAdBox()) %>
        </div>
    </main>

    <%- include(getFooter()) %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; font-size:20px;"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hi! Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>