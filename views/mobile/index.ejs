<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>SHINEX – Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">

            <!-- Hero -->
            <div style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); border-radius:12px; padding:20px 16px; text-align:center; color:#fff; margin-bottom:16px;">
                <h1 style="font-size:1.3rem; font-weight:800; margin:0;">SHINEX Learning</h1>
                <p style="font-size:0.9rem; opacity:0.8; margin:4px 0 0;">Learn. Grow. Succeed.</p>
                <div style="display:flex; gap:8px; justify-content:center; margin-top:10px; flex-wrap:wrap;">
                    <a href="#courses" style="background:rgba(255,255,255,0.2); color:#fff; padding:6px 14px; border-radius:30px; font-size:0.75rem; text-decoration:none;">
                        <i class="fas fa-arrow-down"></i> Courses
                    </a>
                    <a href="/services" style="background:rgba(255,255,255,0.2); color:#fff; padding:6px 14px; border-radius:30px; font-size:0.75rem; text-decoration:none;">
                        <i class="fas fa-cogs"></i> Services
                    </a>
                </div>
            </div>

            <!-- Courses (SHOWCASE ONLY - UNCLICKABLE) -->
            <div id="courses">
                <h3 style="font-size:1rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-graduation-cap" style="color:#8B5CF6;"></i> Our Courses
                </h3>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 10px 0;">
                    Available to registered students
                </p>

                <% if (courses && courses.length > 0) { %>
                    <% courses.forEach(function(c) { %>
                        <div style="background:#fff; border-radius:10px; padding:14px 16px; border:1px solid #ede8f5; margin-bottom:10px; cursor:default;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span style="background:#f0ebfb; color:#8B5CF6; padding:2px 10px; border-radius:12px; font-size:0.6rem; font-weight:600;"><%= c.level || 'Beginner' %></span>
                                <span style="font-size:0.65rem; color:#7a6a8f;"><i class="far fa-clock"></i> <%= c.duration || 'N/A' %></span>
                            </div>
                            <div style="font-weight:700; font-size:1rem; color:#1A0A2E; margin:4px 0 2px;"><%= c.title %></div>
                            <div style="font-size:0.8rem; color:#7a6a8f; margin-bottom:8px;"><%= c.description ? c.description.substring(0,50) + '...' : '' %></div>
                            <div style="display:flex; flex-wrap:wrap; gap:4px;">
                                <span style="background:#ede8f5; color:#1A0A2E; padding:2px 8px; border-radius:10px; font-size:0.55rem; font-weight:600;">
                                    <i class="fas fa-layer-group"></i> <%= c.levels ? c.levels.length : 0 %> Levels
                                </span>
                                <span style="background:#ede8f5; color:#1A0A2E; padding:2px 8px; border-radius:10px; font-size:0.55rem; font-weight:600;">
                                    <i class="fas fa-book"></i> 
                                    <% let totalClasses = 0; %>
                                    <% if (c.levels) { %>
                                        <% c.levels.forEach(function(l) { if (l.lessons) { l.lessons.forEach(function(ls) { if (ls.classes) totalClasses += ls.classes.length; }); } }); %>
                                    <% } %>
                                    <%= totalClasses %> Classes
                                </span>
                            </div>
                            <div style="margin-top:8px; padding-top:8px; border-top:1px solid #ede8f5; text-align:center; color:var(--text-muted); font-size:0.65rem;">
                                <i class="fas fa-lock" style="color:#8B5CF6;"></i> Login to access
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div style="text-align:center; padding:20px; color:#7a6a8f;">
                        <p>No courses available yet.</p>
                    </div>
                <% } %>
            </div>

            <!-- Services Button -->
            <div style="text-align:center; background:var(--primary-bg); border-radius:12px; padding:20px 16px; margin-top:12px;">
                <h3 style="font-size:1rem; font-weight:700; color:var(--text-dark); margin:0 0 4px 0;">
                    <i class="fas fa-cogs" style="color:#8B5CF6;"></i> Need Services?
                </h3>
                <p style="font-size:0.75rem; color:var(--text-muted); margin:0 0 12px 0;">
                    School registration, design, campaigns and more.
                </p>
                <a href="/services" style="width:100%; text-align:center; font-size:0.85rem; padding:10px; border-radius:30px; background:#8B5CF6; color:#fff; border:none; font-weight:600; text-decoration:none; display:block;">
                    <i class="fas fa-arrow-right"></i> View All Services
                </a>
            </div>

        </div>
    </main>

    <%- include('../partials/footer-mobile') %>

    <!-- AI Bot -->
    <div class="ai-bot" id="aiBot">
        <div class="ai-bot-pulse"></div>
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; font-size:20px;"><i class="fas fa-robot"></i></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal">
        <div class="ai-chat-header"><h4><i class="fas fa-robot"></i> AI Tutor</h4><button class="ai-chat-close" id="aiChatClose">&times;</button></div>
        <div class="ai-chat-body" id="aiChatBody">
            <div class="ai-chat-messages" id="aiChatMessages">
                <div class="ai-chat-msg bot">👋 Hello! I'm your AI tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." maxlength="500">
            <button class="btn btn-primary" id="aiChatSend"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>