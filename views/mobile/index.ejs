<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>SHINEX Learning Circle – Learn. Understand. Protect.</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-hero { padding: 28px 16px !important; border-radius: 16px !important; margin-bottom: 20px !important; }
        .mobile-hero h1 { font-size: 1.6rem !important; margin: 0 0 4px !important; }
        .mobile-hero p { font-size: 0.9rem !important; }
        .mobile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .mobile-grid .card { padding: 12px 10px !important; text-align: center; margin-bottom: 0 !important; border-radius: 10px !important; }
        .mobile-grid .card h4 { font-size: 0.8rem !important; margin: 4px 0 2px !important; }
        .mobile-grid .card p { font-size: 0.7rem !important; }
        .mobile-grid .card .price { font-size: 0.85rem !important; }
        .mobile-section-title { font-size: 1.2rem !important; margin-top: 20px !important; }
        .mobile-course-card { padding: 14px 12px !important; border-radius: 12px !important; }
        .mobile-course-card .course-title { font-size: 0.9rem !important; }
        .mobile-course-card .course-desc { font-size: 0.78rem !important; }
        .mobile-btn-block { width: 100%; }
        .mobile-btn-block .btn { width: 100%; text-align: center; justify-content: center; font-size: 0.85rem !important; padding: 10px !important; min-height: 44px !important; }
        .hero-buttons { flex-direction: column !important; gap: 8px !important; }
        .hero-buttons .btn { min-height: 44px !important; font-size: 0.9rem !important; }
        .btn-sm { min-height: 36px !important; padding: 6px 14px !important; }
        .badge { font-size: 0.6rem !important; padding: 2px 8px !important; }
        .container { padding: 0 12px !important; max-width: 500px; margin: 0 auto; }
        .main-content { padding: 12px 0 20px !important; }
        .mobile-alert { font-size: 0.82rem !important; padding: 10px 14px !important; border-radius: 8px !important; margin-bottom: 12px !important; }
        .empty-state { padding: 24px !important; border-radius: 12px !important; text-align: center !important; }
        .empty-state .empty-icon { font-size: 2rem; display: block; margin-bottom: 8px; opacity: 0.3; }
        .empty-state h3 { font-size: 1rem !important; margin: 0 0 4px !important; }
        .empty-state p { font-size: 0.85rem !important; margin: 0 !important; }
    </style>
</head>
<body>
    <!-- ===== MOBILE HEADER ===== -->
    <header class="header" style="padding:8px 12px; flex-wrap:nowrap;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="/" class="logo-container" style="gap:8px; text-decoration:none;">
                <div class="logo" style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:10px;">SLC</div>
                <div style="line-height:1.1;">
                    <div class="logo-text" style="font-size:13px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div class="logo-sub" style="font-size:6px; color:rgba(255,255,255,0.7);">LEARNING</div>
                </div>
            </a>
        </div>
        <div class="header-actions" style="gap:4px; flex-wrap:nowrap;">
            <button class="dark-toggle" id="darkToggleMobile" onclick="toggleDarkModeMobile()" style="padding:4px 8px; font-size:1rem; background:rgba(255,255,255,0.15); border:none; border-radius:30px; color:#fff; cursor:pointer;">🌙</button>
            <% if (user) { %>
                <a href="/dashboard" class="btn btn-secondary btn-sm" style="min-height:30px; padding:2px 10px; font-size:0.7rem; background:rgba(255,255,255,0.2); color:#fff; border-radius:30px; text-decoration:none;"><i class="fas fa-user"></i></a>
                <a href="/logout" class="btn btn-danger btn-sm" style="min-height:30px; padding:2px 10px; font-size:0.7rem; background:#e74c3c; color:#fff; border-radius:30px; text-decoration:none;"><i class="fas fa-sign-out-alt"></i></a>
            <% } else { %>
                <a href="/login" class="btn btn-secondary btn-sm" style="min-height:30px; padding:2px 10px; font-size:0.7rem; background:rgba(255,255,255,0.2); color:#fff; border-radius:30px; text-decoration:none;">Login</a>
                <a href="/register" class="btn btn-primary btn-sm" style="min-height:30px; padding:2px 10px; font-size:0.7rem; background:#8B5CF6; color:#fff; border-radius:30px; text-decoration:none;">Register</a>
            <% } %>
        </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="container">
            <% if (messages && messages.success) { %>
                <div class="alert alert-success mobile-alert"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger mobile-alert"><%= messages.error %></div>
            <% } %>

            <div class="hero-section card-purple mobile-hero" style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff;">
                <h1 style="color:#fff;">Welcome to SHINEX</h1>
                <p style="color:#d4c4f0;">Learn. Understand. Protect.<br>Explore 10+ cutting‑edge courses.</p>
                <div class="hero-buttons">
                    <a href="/courses" class="btn btn-secondary" style="background:#fff; color:#6a3dcf; font-weight:700; border-radius:30px; text-align:center; text-decoration:none; display:block; padding:10px;">Explore Courses</a>
                    <% if (!user) { %>
                        <a href="/register" class="btn btn-primary" style="background:rgba(255,255,255,0.2); color:#fff; border:2px solid #fff; border-radius:30px; text-align:center; text-decoration:none; display:block; padding:10px;">Get Started Free</a>
                    <% } else { %>
                        <a href="/dashboard" class="btn btn-primary" style="background:rgba(255,255,255,0.2); color:#fff; border:2px solid #fff; border-radius:30px; text-align:center; text-decoration:none; display:block; padding:10px;">Go to Dashboard</a>
                    <% } %>
                </div>
            </div>

            <h2 class="mobile-section-title" style="font-weight:700; margin-bottom:2px; color:var(--text-dark);">Our Courses</h2>
            <p style="color:var(--text-muted); font-size:0.82rem; margin-bottom:12px;">Choose your path and start learning.</p>
            
            <div style="display:flex; flex-direction:column; gap:10px;">
                <% if (courses && courses.length) { %>
                    <% courses.slice(0,4).forEach(course => { %>
                        <div class="course-card mobile-course-card" style="background:var(--bg-light); border:1px solid #ede8f5;">
                            <div style="display:flex; justify-content:space-between; align-items:start; flex-wrap:wrap; gap:4px;">
                                <span class="badge badge-purple"><%= course.level || 'Beginner' %></span>
                                <span class="badge badge-dark"><%= course.duration || 'Self‑paced' %></span>
                            </div>
                            <h3 class="course-title" style="color:var(--text-dark); margin:4px 0 2px;"><%= course.title %></h3>
                            <p class="course-desc" style="color:var(--text-muted); margin:2px 0 8px;"><%= course.description ? course.description.substring(0,80)+'...' : 'Learn the fundamentals and advance your skills.' %></p>
                            <a href="/course/<%= course.id %>" class="btn btn-primary btn-sm mobile-btn-block" style="font-size:0.8rem; padding:8px; min-height:38px; border-radius:30px; background:#8B5CF6; color:#fff; text-align:center; text-decoration:none; display:block;">View Course</a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state" style="background:#f8f6fc; border:1px solid #ede8f5;">
                        <span class="empty-icon">📚</span>
                        <h3>No Courses Available</h3>
                        <p style="color:var(--text-muted);">Check back soon.</p>
                    </div>
                <% } %>
            </div>

            <div style="text-align:center; margin:12px 0 16px;">
                <a href="/courses" class="btn btn-outline btn-sm" style="font-size:0.82rem; padding:8px 20px; min-height:38px; border-radius:30px; border:2px solid #8B5CF6; color:#8B5CF6; background:transparent; text-decoration:none; display:inline-block;">View All Courses</a>
            </div>

            <h2 class="mobile-section-title" style="font-weight:700; margin-top:16px; margin-bottom:2px; color:var(--text-dark);">Our Services</h2>
            <p style="color:var(--text-muted); font-size:0.82rem; margin-bottom:12px;">Professional services to support you.</p>

            <div class="mobile-grid">
                <% if (services && services.length) { %>
                    <% services.slice(0,4).forEach(service => { %>
                        <div class="card" style="background:var(--bg-light); border:1px solid #ede8f5;">
                            <h4 style="color:var(--text-dark);"><%= service.name %></h4>
                            <p style="color:var(--text-muted);"><%= service.description ? service.description.substring(0,30) : '' %></p>
                            <p class="price" style="color:#8B5CF6;">₦<%= service.price.toLocaleString() %></p>
                            <a href="/services" class="btn btn-secondary btn-sm" style="font-size:0.7rem; padding:4px 12px; min-height:30px; margin-top:4px; width:100%; border-radius:30px; background:#ede8f5; color:#1A0A2E; text-align:center; text-decoration:none; display:block;">Learn More</a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state" style="grid-column:1/-1; padding:16px; background:#f8f6fc; border:1px solid #ede8f5;">
                        <p style="color:var(--text-muted); font-size:0.85rem;">Services coming soon.</p>
                    </div>
                <% } %>
            </div>

            <div style="text-align:center; margin:12px 0 8px;">
                <a href="/services" class="btn btn-outline btn-sm" style="font-size:0.82rem; padding:8px 20px; min-height:38px; border-radius:30px; border:2px solid #8B5CF6; color:#8B5CF6; background:transparent; text-decoration:none; display:inline-block;">View All Services</a>
            </div>
        </div>
    </main>

    <!-- ===== MOBILE FOOTER ===== -->
    <footer class="footer" style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div class="container">
            <div style="text-align:center;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:6px;">
                    <div class="logo" style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div>
                        <div class="logo-text" style="font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    </div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:4px 0 8px;">Learn. Understand. Protect.</p>
                <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px 16px; margin:12px 0;">
                    <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Home</a>
                    <a href="/courses" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Courses</a>
                    <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Services</a>
                    <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">About</a>
                    <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Contact</a>
                    <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">FAQ</a>
                </div>
                <div style="display:flex; justify-content:center; gap:12px; margin:8px 0 12px;">
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-twitter"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-instagram"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-whatsapp"></i></a>
                </div>
                <div class="footer-bottom" style="border-top:1px solid rgba(255,255,255,0.1); padding-top:10px; font-size:0.7rem; color:rgba(255,255,255,0.6);">
                    &copy; <%= new Date().getFullYear() %> SHINEX Learning Circle
                </div>
            </div>
        </div>
    </footer>

    <!-- ===== AI BOT ===== -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:26px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">🤖<span class="ai-bot-pulse" style="position:absolute; width:60px; height:60px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span></button>
    </div>

    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:#fff; border-radius:14px; border:1px solid #ede8f5; box-shadow:0 20px 60px rgba(0,0,0,0.15); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:#8B5CF6; color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px;">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:10px; font-size:0.9rem; max-width:85%; line-height:1.5; background:#f0ebfb; color:#1A0A2E; align-self:flex-start; border-bottom-left-radius:4px;">👋 Hi! I'm your SHINEX AI Tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid #ede8f5; display:flex; gap:8px;">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:8px; border:1px solid #ede8f5; font-size:0.85rem;">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:30px; background:#8B5CF6; color:#fff; font-weight:600; cursor:pointer;">Send</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js"></script>
    <script src="/js/main.js"></script>
    <script>
        function toggleDarkModeMobile() {
            const body = document.body;
            body.classList.toggle('dark-mode');
            const isDark = body.classList.contains('dark-mode');
            localStorage.setItem('shinex-dark-mode', isDark);
            const btn = document.getElementById('darkToggleMobile');
            if (btn) btn.textContent = isDark ? '☀️' : '🌙';
        }
        document.addEventListener('DOMContentLoaded', function() {
            const savedDark = localStorage.getItem('shinex-dark-mode');
            if (savedDark === 'true') {
                document.body.classList.add('dark-mode');
                const btn = document.getElementById('darkToggleMobile');
                if (btn) btn.textContent = '☀️';
            }
        });
    </script>
</body>
</html>