<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>SHINEX Learning Circle – Learn. Understand. Protect.</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Mobile specific overrides */
        .mobile-hero {
            padding: 28px 16px !important;
            margin-bottom: 20px !important;
            border-radius: 16px !important;
        }
        .mobile-hero h1 {
            font-size: 1.6rem !important;
            margin-bottom: 4px !important;
        }
        .mobile-hero p {
            font-size: 0.9rem !important;
        }
        .mobile-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .mobile-grid .card {
            padding: 12px 10px !important;
            text-align: center;
            margin-bottom: 0 !important;
        }
        .mobile-grid .card h4 {
            font-size: 0.8rem !important;
            margin: 4px 0 2px !important;
        }
        .mobile-grid .card p {
            font-size: 0.7rem !important;
        }
        .mobile-grid .card .price {
            font-size: 0.85rem !important;
        }
        .mobile-section-title {
            font-size: 1.2rem !important;
            margin-top: 20px !important;
        }
        .mobile-course-card {
            padding: 14px 12px !important;
        }
        .mobile-course-card .course-title {
            font-size: 0.9rem !important;
        }
        .mobile-course-card .course-desc {
            font-size: 0.78rem !important;
        }
        .mobile-btn-block {
            width: 100%;
        }
        .mobile-btn-block .btn {
            width: 100%;
            text-align: center;
            justify-content: center;
            font-size: 0.85rem !important;
            padding: 10px !important;
            min-height: 44px !important;
        }
        .hero-buttons {
            flex-direction: column !important;
            gap: 8px !important;
        }
        .hero-buttons .btn {
            min-height: 44px !important;
            font-size: 0.9rem !important;
        }
        /* Better touch targets */
        .btn-sm {
            min-height: 36px !important;
            padding: 6px 14px !important;
        }
        .badge {
            font-size: 0.6rem !important;
            padding: 2px 8px !important;
        }
        /* Mobile container padding */
        .container {
            padding: 0 12px !important;
        }
        .main-content {
            padding: 12px 0 20px !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: false }) %>

    <main class="main-content">
        <div class="container">
            <!-- Flash Messages -->
            <% if (messages && messages.success) { %>
                <div class="alert alert-success" style="font-size:0.82rem; padding:10px 14px; border-radius:8px; margin-bottom:12px;"><%= messages.success %></div>
            <% } %>
            <% if (messages && messages.error) { %>
                <div class="alert alert-danger" style="font-size:0.82rem; padding:10px 14px; border-radius:8px; margin-bottom:12px;"><%= messages.error %></div>
            <% } %>

            <!-- Mobile Hero -->
            <div class="hero-section card-purple mobile-hero">
                <h1>Welcome to SHINEX</h1>
                <p>Learn. Understand. Protect.<br>Explore 10+ cutting‑edge courses.</p>
                <div class="hero-buttons">
                    <a href="/courses" class="btn btn-secondary" style="background:#fff; color:#6a3dcf; font-weight:700;">Explore Courses</a>
                    <% if (!user) { %>
                        <a href="/register" class="btn btn-primary" style="background:rgba(255,255,255,0.2); color:#fff; border:2px solid #fff;">Get Started Free</a>
                    <% } else { %>
                        <a href="/dashboard" class="btn btn-primary" style="background:rgba(255,255,255,0.2); color:#fff; border:2px solid #fff;">Go to Dashboard</a>
                    <% } %>
                </div>
            </div>

            <!-- Courses Preview -->
            <h2 class="mobile-section-title" style="font-weight:700; margin-bottom:2px;">Our Courses</h2>
            <p style="color:var(--text-muted); font-size:0.82rem; margin-bottom:12px;">Choose your path and start learning.</p>
            
            <div style="display:flex; flex-direction:column; gap:10px;">
                <% if (courses && courses.length) { %>
                    <% courses.slice(0,4).forEach(course => { %>
                        <div class="course-card mobile-course-card" style="padding:14px 12px; border-radius:12px;">
                            <div style="display:flex; justify-content:space-between; align-items:start; flex-wrap:wrap; gap:4px;">
                                <span class="badge badge-purple"><%= course.level || 'Beginner' %></span>
                                <span class="badge badge-dark"><%= course.duration || 'Self‑paced' %></span>
                            </div>
                            <h3 class="course-title" style="margin:4px 0 2px;"><%= course.title %></h3>
                            <p class="course-desc" style="margin:2px 0 8px;"><%= course.description ? course.description.substring(0,80)+'...' : 'Learn the fundamentals and advance your skills.' %></p>
                            <a href="/course/<%= course.id %>" class="btn btn-primary btn-sm mobile-btn-block" style="font-size:0.8rem; padding:8px; min-height:38px;">View Course</a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state" style="padding:24px; border-radius:12px;">
                        <span class="empty-icon">📚</span>
                        <h3 style="font-size:1rem;">No Courses Available</h3>
                        <p style="font-size:0.85rem;">Check back soon.</p>
                    </div>
                <% } %>
            </div>

            <!-- View All Courses -->
            <div style="text-align:center; margin:12px 0 16px;">
                <a href="/courses" class="btn btn-outline btn-sm" style="font-size:0.82rem; padding:8px 20px; min-height:38px;">View All Courses</a>
            </div>

            <!-- Services Preview -->
            <h2 class="mobile-section-title" style="font-weight:700; margin-top:16px; margin-bottom:2px;">Our Services</h2>
            <p style="color:var(--text-muted); font-size:0.82rem; margin-bottom:12px;">Professional services to support you.</p>

            <div class="mobile-grid">
                <% if (services && services.length) { %>
                    <% services.slice(0,4).forEach(service => { %>
                        <div class="card" style="padding:12px 10px; border-radius:10px; margin-bottom:0;">
                            <h4 style="font-size:0.8rem; font-weight:700; margin:0 0 2px;"><%= service.name %></h4>
                            <p style="font-size:0.68rem; color:var(--text-muted); margin:0 0 4px;"><%= service.description ? service.description.substring(0,30) : '' %></p>
                            <p class="price" style="font-weight:700; color:var(--primary); font-size:0.85rem; margin:0;">₦<%= service.price.toLocaleString() %></p>
                            <a href="/services" class="btn btn-secondary btn-sm" style="font-size:0.7rem; padding:4px 12px; min-height:30px; margin-top:4px; width:100%;">Learn More</a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="empty-state" style="grid-column:1/-1; padding:16px; border-radius:10px;">
                        <p style="font-size:0.85rem;">Services coming soon.</p>
                    </div>
                <% } %>
            </div>

            <div style="text-align:center; margin:12px 0 8px;">
                <a href="/services" class="btn btn-outline btn-sm" style="font-size:0.82rem; padding:8px 20px; min-height:38px;">View All Services</a>
            </div>
        </div>
    </main>

    <%- include('partials/footer-mobile') %>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>