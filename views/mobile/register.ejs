<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Register – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/style.css">
    <style>
        /* ============================================================
           MOBILE REGISTER PAGE STYLES
           ============================================================ */
        
        /* ----- Page Wrapper ----- */
        .register-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 70vh;
            padding: var(--spacing-lg) var(--spacing-sm);
            background: var(--bg-page);
        }
        
        /* ----- Register Card ----- */
        .register-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: var(--spacing-xl) var(--spacing-lg);
            border: 1px solid var(--border-color);
            width: 100%;
            max-width: 480px;
            box-shadow: var(--shadow-md);
            transition: all 0.3s ease;
        }
        
        .register-card:hover {
            box-shadow: var(--shadow-lg);
        }
        
        /* ----- Logo ----- */
        .register-card .auth-logo {
            text-align: center;
            margin-bottom: var(--spacing-md);
        }
        
        .register-card .auth-logo .logo-icon {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--purple-gradient);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 18px;
            letter-spacing: 1px;
            box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
            margin-bottom: var(--spacing-sm);
        }
        
        .register-card .auth-logo h1 {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--text-primary);
            margin: 0;
        }
        
        .register-card .auth-logo h1 span {
            color: var(--purple-primary);
        }
        
        .register-card .auth-logo p {
            color: var(--text-muted);
            font-size: 0.65rem;
            margin: 0;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        
        /* ----- Title ----- */
        .register-card .auth-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-primary);
            text-align: center;
            margin: 0 0 2px 0;
        }
        
        .register-card .auth-subtitle {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-align: center;
            margin: 0 0 var(--spacing-md) 0;
        }
        
        /* ----- Form Sections ----- */
        .form-section {
            background: var(--bg-card-secondary);
            border-radius: var(--radius-sm);
            padding: var(--spacing-md);
            margin-bottom: var(--spacing-md);
            border: 1px solid var(--border-color);
            transition: all 0.3s ease;
        }
        
        .form-section.highlight {
            border: 2px solid var(--purple-primary);
        }
        
        .form-section .section-title {
            font-weight: 700;
            color: var(--text-primary);
            margin: 0 0 2px 0;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .form-section .section-title i {
            color: var(--purple-primary);
        }
        
        .form-section .section-subtitle {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin: 0 0 var(--spacing-sm) 0;
        }
        
        /* ----- Form Fields ----- */
        .form-group {
            margin-bottom: var(--spacing-sm);
        }
        
        .form-group label {
            font-weight: 600;
            font-size: 0.75rem;
            color: var(--text-primary);
            display: block;
            margin-bottom: 3px;
        }
        
        .form-group label .required {
            color: var(--text-error);
        }
        
        .form-group input,
        .form-group select {
            width: 100%;
            padding: 8px 12px;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            font-family: inherit;
            background: var(--bg-input);
            color: var(--text-primary);
            transition: all 0.3s ease;
        }
        
        .form-group input:focus,
        .form-group select:focus {
            border-color: var(--purple-primary);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.12);
            outline: none;
        }
        
        .form-group input::placeholder {
            color: var(--text-muted);
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-sm);
        }
        
        /* ----- Password Toggle ----- */
        .password-wrapper {
            position: relative;
            width: 100%;
        }
        
        .password-wrapper input {
            width: 100%;
            padding-right: 40px !important;
        }
        
        .password-wrapper .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 1rem;
            padding: 4px 6px;
            transition: all 0.3s ease;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .password-wrapper .toggle-password:hover {
            color: var(--purple-primary);
        }
        
        /* ----- Password Requirements ----- */
        .password-requirements {
            list-style: none;
            padding: 6px 0 0 0;
            margin: 2px 0 0 0;
            font-size: 0.7rem;
            color: var(--text-muted);
        }
        
        .password-requirements li {
            padding: 1px 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .password-requirements li .req-icon {
            font-size: 0.5rem;
            width: 14px;
            text-align: center;
        }
        
        .password-requirements li .req-icon.valid {
            color: var(--text-success);
        }
        
        .password-requirements li .req-icon.invalid {
            color: var(--text-muted);
        }
        
        .password-requirements li .req-text.valid {
            color: var(--text-success);
        }
        
        .password-requirements li .req-text.invalid {
            color: var(--text-muted);
        }
        
        .password-match-status {
            font-size: 0.7rem;
            margin-top: 4px;
            padding: 2px 0;
        }
        
        .password-match-status .match-valid {
            color: var(--text-success);
        }
        
        .password-match-status .match-invalid {
            color: var(--text-error);
        }
        
        /* ----- Help Text ----- */
        .help-text {
            font-size: 0.65rem;
            color: var(--text-muted);
            margin-top: 2px;
        }
        
        .help-text i {
            margin-right: 4px;
        }
        
        /* ----- Register Button ----- */
        .btn-register {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: var(--radius-full);
            font-weight: 600;
            font-size: 1rem;
            background: var(--purple-gradient);
            color: #fff;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .btn-register:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.3);
        }
        
        .btn-register:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .btn-register i {
            font-size: 1rem;
        }
        
        /* ----- Footer ----- */
        .register-card .auth-footer {
            text-align: center;
            margin-top: var(--spacing-md);
            padding-top: var(--spacing-md);
            border-top: 1px solid var(--border-color);
        }
        
        .register-card .auth-footer p {
            color: var(--text-secondary);
            font-size: 0.82rem;
            margin: 0;
        }
        
        .register-card .auth-footer a {
            color: var(--purple-primary);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .register-card .auth-footer a:hover {
            text-decoration: underline;
        }
        
        /* ----- Alerts ----- */
        .register-card .alert {
            padding: 8px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.82rem;
            margin-bottom: var(--spacing-sm);
            text-align: center;
            border-left: 4px solid;
        }
        
        .register-card .alert-danger {
            background: var(--bg-alert-error);
            color: var(--text-error);
            border-left-color: var(--text-error);
        }
        
        .register-card .alert-success {
            background: var(--bg-alert-success);
            color: var(--text-success);
            border-left-color: var(--text-success);
        }
        
        /* ----- Responsive ----- */
        @media (max-width: 400px) {
            .form-row {
                grid-template-columns: 1fr;
            }
            
            .register-card {
                padding: var(--spacing-lg) var(--spacing-md);
            }
            
            .register-card .auth-logo h1 {
                font-size: 1.2rem;
            }
            
            .register-card .auth-title {
                font-size: 1rem;
            }
            
            .btn-register {
                font-size: 0.9rem;
                padding: 10px;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    PAGE LOADER
    ============================================================ -->
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <!-- ============================================================
    MOBILE HEADER (Built-in)
    ============================================================ -->
    <header style="background:linear-gradient(135deg, #8B5CF6, #6a3dcf); padding:10px 14px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; flex-wrap:wrap; gap:4px;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="/" style="color:rgba(255,255,255,0.9); font-size:0.75rem; padding:4px 8px; text-decoration:none; display:flex; align-items:center; gap:4px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:8px;">
                <div style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                <div>
                    <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                </div>
            </a>
        </div>
        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
            <button onclick="document.body.classList.toggle('dark-mode'); localStorage.setItem('shinex-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); updateThemeToggle();" style="background:rgba(255,255,255,0.15); border:none; color:#fff; padding:4px 8px; border-radius:20px; font-size:14px; cursor:pointer;">
                <i class="fas fa-moon" id="themeIconMobile"></i>
            </button>
            <a href="/login" style="background:rgba(255,255,255,0.2); border:none; color:#fff; padding:4px 10px; border-radius:20px; font-size:12px; text-decoration:none;">
                <i class="fas fa-sign-in-alt"></i> Login
            </a>
        </div>
    </header>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <main class="main-content" style="padding:0; min-height:auto;">
        <div class="register-wrapper">
            <div class="register-card">

                <!-- ===== LOGO ===== -->
                <div class="auth-logo">
                    <div class="logo-icon">SLC</div>
                    <h1>SHINEX<span>.</span></h1>
                    <p>Learning Circle</p>
                </div>

                <!-- ===== TITLE ===== -->
                <div class="auth-title">Student Registration</div>
                <div class="auth-subtitle">Join SHINEX Learning Circle (SLC)</div>

                <!-- ===== FLASH MESSAGES ===== -->
                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger flash-message" data-type="error">
                        <i class="fas fa-exclamation-circle"></i> <%= messages.error %>
                    </div>
                <% } %>

                <!-- ===== REGISTRATION FORM ===== -->
                <form action="/register" method="POST" id="registerForm">

                    <!-- ===== PERSONAL INFORMATION ===== -->
                    <div class="form-section">
                        <div class="section-title">
                            <i class="fas fa-user"></i> Personal Information
                        </div>
                        <p class="section-subtitle">Tell us about yourself</p>

                        <div class="form-row">
                            <div class="form-group">
                                <label>First Name <span class="required">*</span></label>
                                <input type="text" name="firstName" placeholder="John" required>
                            </div>
                            <div class="form-group">
                                <label>Middle Name</label>
                                <input type="text" name="middleName" placeholder="(Optional)">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Last Name <span class="required">*</span></label>
                            <input type="text" name="lastName" placeholder="Doe" required>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Date of Birth</label>
                                <input type="date" name="dateOfBirth">
                            </div>
                            <div class="form-group">
                                <label>Gender <span class="required">*</span></label>
                                <select name="gender" required>
                                    <option value="">Select...</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Country <span class="required">*</span></label>
                            <select name="country" required>
                                <option value="">Select...</option>
                                <option value="Nigeria">Nigeria</option>
                                <option value="USA">USA</option>
                                <option value="UK">UK</option>
                                <option value="Canada">Canada</option>
                                <option value="Australia">Australia</option>
                                <option value="Ghana">Ghana</option>
                                <option value="Kenya">Kenya</option>
                                <option value="South Africa">South Africa</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>State <span class="required">*</span></label>
                                <input type="text" name="state" placeholder="e.g., Ogun State" required>
                            </div>
                            <div class="form-group">
                                <label>City/Town <span class="required">*</span></label>
                                <input type="text" name="city" placeholder="e.g., Abeokuta" required>
                            </div>
                        </div>
                    </div>

                    <!-- ===== CONTACT INFORMATION ===== -->
                    <div class="form-section">
                        <div class="section-title">
                            <i class="fas fa-phone"></i> Contact Information
                        </div>
                        <p class="section-subtitle">How can we reach you?</p>

                        <div class="form-group">
                            <label>Email Address <span class="required">*</span></label>
                            <input type="email" name="email" placeholder="you@email.com" required>
                            <div class="help-text">
                                <i class="fas fa-info-circle"></i> We'll send verification to this email
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Phone Number <span class="required">*</span></label>
                                <input type="tel" name="phone" placeholder="080 1234 5678" required>
                            </div>
                            <div class="form-group">
                                <label>WhatsApp Number</label>
                                <input type="tel" name="whatsapp" placeholder="080 1234 5678">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Home Address</label>
                            <input type="text" name="homeAddress" placeholder="Your home address">
                        </div>
                    </div>

                    <!-- ===== ACADEMIC INFORMATION ===== -->
                    <div class="form-section">
                        <div class="section-title">
                            <i class="fas fa-graduation-cap"></i> Academic Information
                        </div>
                        <p class="section-subtitle">Tell us about your education</p>

                        <div class="form-group">
                            <label>School/Institution <span class="required">*</span></label>
                            <input type="text" name="school" placeholder="e.g., TASUED" required>
                        </div>

                        <div class="form-group">
                            <label>Department <span class="required">*</span></label>
                            <input type="text" name="department" placeholder="e.g., Computer Science" required>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Current Level <span class="required">*</span></label>
                                <input type="text" name="currentLevel" placeholder="e.g., Year 1" required>
                            </div>
                            <div class="form-group">
                                <label>Student Status</label>
                                <select name="studentStatus">
                                    <option value="">Select...</option>
                                    <option value="Full-time">Full-time</option>
                                    <option value="Part-time">Part-time</option>
                                    <option value="Graduate">Graduate</option>
                                    <option value="Working Professional">Working Professional</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- ===== COURSE SELECTION ===== -->
                    <div class="form-section">
                        <div class="section-title">
                            <i class="fas fa-book-open"></i> Choose Your Course
                        </div>
                        <p class="section-subtitle">Select the course you want to study</p>

                        <div class="form-group">
                            <label>Course <span class="required">*</span></label>
                            <select name="courseName" required>
                                <option value="">Select a course...</option>
                                <% if (courses && courses.length > 0) { %>
                                    <% courses.forEach(function(c) { %>
                                        <option value="<%= c %>"><%= c %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                    </div>

                    <!-- ===== LEARNING LEVEL ===== -->
                    <div class="form-section">
                        <div class="section-title">
                            <i class="fas fa-chart-line"></i> Learning Level
                        </div>
                        <p class="section-subtitle">Choose your experience level</p>

                        <div class="form-group">
                            <label>Learning Level <span class="required">*</span></label>
                            <select name="learningLevel" required>
                                <option value="Beginner">Beginner</option>
                                <option value="Intermediate">Intermediate</option>
                                <option value="Advanced">Advanced</option>
                            </select>
                        </div>
                    </div>

                    <!-- ===== ACCOUNT DETAILS ===== -->
                    <div class="form-section highlight">
                        <div class="section-title">
                            <i class="fas fa-lock"></i> Account Details
                        </div>
                        <p class="section-subtitle">Create your login credentials</p>

                        <div class="form-group">
                            <label>Email Address <span class="required">*</span></label>
                            <input type="email" name="email" placeholder="you@email.com" required>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Password <span class="required">*</span></label>
                                <div class="password-wrapper">
                                    <input type="password" name="password" id="registerPassword" placeholder="Min 6 chars" required>
                                    <button type="button" class="toggle-password" onclick="togglePassword('registerPassword', this)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <ul class="password-requirements" id="passwordRequirements">
                                    <li>
                                        <span class="req-icon invalid" id="reqLengthIcon"><i class="fas fa-circle"></i></span>
                                        <span class="req-text invalid" id="reqLengthText">At least 6 characters</span>
                                    </li>
                                    <li>
                                        <span class="req-icon invalid" id="reqUpperIcon"><i class="fas fa-circle"></i></span>
                                        <span class="req-text invalid" id="reqUpperText">At least 1 uppercase letter</span>
                                    </li>
                                    <li>
                                        <span class="req-icon invalid" id="reqLowerIcon"><i class="fas fa-circle"></i></span>
                                        <span class="req-text invalid" id="reqLowerText">At least 1 lowercase letter</span>
                                    </li>
                                    <li>
                                        <span class="req-icon invalid" id="reqNumberIcon"><i class="fas fa-circle"></i></span>
                                        <span class="req-text invalid" id="reqNumberText">At least 1 number</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="form-group">
                                <label>Confirm Password <span class="required">*</span></label>
                                <div class="password-wrapper">
                                    <input type="password" name="confirmPassword" id="registerConfirmPassword" placeholder="Confirm" required>
                                    <button type="button" class="toggle-password" onclick="togglePassword('registerConfirmPassword', this)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <div class="password-match-status" id="passwordMatchStatus">
                                    <span class="match-invalid"><i class="fas fa-times-circle"></i> Passwords do not match</span>
                                </div>
                            </div>
                        </div>

                        <div class="help-text">
                            <i class="fas fa-info-circle"></i> 
                            Your Student ID will be generated automatically: <strong>SLC-2026-XX-XXX</strong>
                        </div>
                    </div>

                    <!-- ===== SUBMIT BUTTON ===== -->
                    <button type="submit" class="btn-register" id="registerBtn">
                        <i class="fas fa-user-plus"></i> Register
                    </button>

                </form>

                <!-- ===== FOOTER ===== -->
                <div class="auth-footer">
                    <p>Already have an account? <a href="/login">Login</a></p>
                </div>

            </div>
        </div>
    </main>

    <!-- ============================================================
    MOBILE FOOTER (Built-in)
    ============================================================ -->
    <footer style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div style="max-width:500px; margin:0 auto; padding:0 16px;">
            <!-- Logo -->
            <div style="text-align:center; margin-bottom:12px;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:4px;">
                    <div style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div>
                        <div style="font-weight:700; font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                        <div style="font-size:6px; color:rgba(255,255,255,0.6); letter-spacing:2px;">LEARNING CIRCLE</div>
                    </div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:0;">Learn. Understand. Protect. 🛡️</p>
            </div>

            <!-- Footer Links -->
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:6px 12px; margin:12px 0;">
                <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Home</a>
                <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">About</a>
                <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Services</a>
                <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">FAQ</a>
                <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none; transition:color 0.3s ease;">Contact</a>
                <a href="/terms" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Terms</a>
                <a href="/privacy" style="color:rgba(255,255,255,0.6); font-size:0.7rem; text-decoration:none; transition:color 0.3s ease;">Privacy</a>
            </div>

            <!-- Social Icons -->
            <div style="display:flex; justify-content:center; gap:12px; margin:12px 0 16px;">
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-whatsapp"></i>
                </a>
                <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem; transition:all 0.3s ease;">
                    <i class="fab fa-youtube"></i>
                </a>
            </div>

            <!-- Copyright -->
            <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:12px; text-align:center; font-size:0.7rem; color:rgba(255,255,255,0.5);">
                &copy; <%= new Date().getFullYear() %> SHINEX Learning Circle. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- ============================================================
    AI BOT
    ============================================================ -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:50px; height:50px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:20px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">
            🤖
            <span class="ai-bot-pulse" style="position:absolute; width:50px; height:50px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span>
        </button>
    </div>

    <!-- AI Chat Modal -->
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:var(--bg-card); border-radius:var(--radius-lg); border:1px solid var(--border-color); box-shadow:var(--shadow-xl); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:var(--purple-gradient); color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px; background:var(--bg-page);">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:var(--radius-md); font-size:0.9rem; max-width:85%; line-height:1.5; background:var(--purple-bg); color:var(--text-primary); align-self:flex-start; border-bottom-left-radius:4px;">
                    👋 Hi! I'm your SHINEX AI Tutor. Need help with registration?
                </div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid var(--border-color); display:flex; gap:8px; background:var(--bg-card);">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-size:0.85rem; background:var(--bg-input); color:var(--text-primary);">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:var(--radius-full); background:var(--purple-primary); color:#fff; font-weight:600; cursor:pointer; transition:all 0.3s ease;">
                Send
            </button>
        </div>
    </div>

    <!-- ============================================================
    SCRIPTS
    ============================================================ -->
    <script>
        // ============================================================
        // PAGE LOADER
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const loader = document.getElementById('page-loader');
            if (loader) {
                setTimeout(function() {
                    loader.classList.add('hidden');
                }, 1200);
            }
        });
        
        // ============================================================
        // TOGGLE PASSWORD
        // ============================================================
        
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            if (!input) return;
            
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
        }
        
        // ============================================================
        // PASSWORD VALIDATION
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const passwordInput = document.getElementById('registerPassword');
            const confirmInput = document.getElementById('registerConfirmPassword');
            const submitBtn = document.getElementById('registerBtn');
            
            const reqLengthIcon = document.getElementById('reqLengthIcon');
            const reqUpperIcon = document.getElementById('reqUpperIcon');
            const reqLowerIcon = document.getElementById('reqLowerIcon');
            const reqNumberIcon = document.getElementById('reqNumberIcon');
            const reqLengthText = document.getElementById('reqLengthText');
            const reqUpperText = document.getElementById('reqUpperText');
            const reqLowerText = document.getElementById('reqLowerText');
            const reqNumberText = document.getElementById('reqNumberText');
            const matchStatus = document.getElementById('passwordMatchStatus');
            
            function validatePassword(password) {
                const hasLength = password.length >= 6;
                const hasUpper = /[A-Z]/.test(password);
                const hasLower = /[a-z]/.test(password);
                const hasNumber = /[0-9]/.test(password);
                
                updateRequirement(reqLengthIcon, reqLengthText, hasLength);
                updateRequirement(reqUpperIcon, reqUpperText, hasUpper);
                updateRequirement(reqLowerIcon, reqLowerText, hasLower);
                updateRequirement(reqNumberIcon, reqNumberText, hasNumber);
                
                return hasLength && hasUpper && hasLower && hasNumber;
            }
            
            function updateRequirement(iconEl, textEl, isValid) {
                if (isValid) {
                    iconEl.className = 'req-icon valid';
                    iconEl.innerHTML = '<i class="fas fa-check-circle"></i>';
                    textEl.className = 'req-text valid';
                } else {
                    iconEl.className = 'req-icon invalid';
                    iconEl.innerHTML = '<i class="fas fa-circle"></i>';
                    textEl.className = 'req-text invalid';
                }
            }
            
            function checkPasswordMatch() {
                const password = passwordInput.value;
                const confirm = confirmInput.value;
                
                if (confirm.length === 0) {
                    matchStatus.innerHTML = '<span class="match-invalid"><i class="fas fa-times-circle"></i> Confirm your password</span>';
                    return false;
                }
                
                if (password === confirm) {
                    matchStatus.innerHTML = '<span class="match-valid"><i class="fas fa-check-circle"></i> Passwords match ✓</span>';
                    return true;
                } else {
                    matchStatus.innerHTML = '<span class="match-invalid"><i class="fas fa-times-circle"></i> Passwords do not match</span>';
                    return false;
                }
            }
            
            passwordInput.addEventListener('input', function() {
                const password = this.value;
                const isValid = validatePassword(password);
                const passwordsMatch = checkPasswordMatch();
                const allValid = isValid && passwordsMatch && password.length > 0;
                submitBtn.disabled = !allValid;
            });
            
            confirmInput.addEventListener('input', function() {
                const password = passwordInput.value;
                const isValid = validatePassword(password);
                const passwordsMatch = checkPasswordMatch();
                const allValid = isValid && passwordsMatch && password.length > 0;
                submitBtn.disabled = !allValid;
            });
            
            // Initial state - button disabled
            submitBtn.disabled = true;
        });
        
        // ============================================================
        // THEME TOGGLE
        // ============================================================
        
        function updateThemeToggle() {
            const isDark = document.body.classList.contains('dark-mode');
            const icon = document.getElementById('themeIconMobile');
            if (icon) {
                icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
            }
        }
        
        // ============================================================
        // AI BOT
        // ============================================================
        
        document.addEventListener('DOMContentLoaded', function() {
            const botBtn = document.getElementById('aiBotBtn');
            const chatModal = document.getElementById('aiChatModal');
            const chatClose = document.getElementById('aiChatClose');
            const chatInput = document.getElementById('aiChatInput');
            const chatSend = document.getElementById('aiChatSend');
            const chatMessages = document.getElementById('aiChatMessages');
            
            if (!botBtn || !chatModal) return;
            
            botBtn.addEventListener('click', function() {
                chatModal.classList.toggle('open');
                if (chatModal.classList.contains('open')) {
                    chatModal.style.display = 'flex';
                    chatInput.focus();
                } else {
                    chatModal.style.display = 'none';
                }
            });
            
            if (chatClose) {
                chatClose.addEventListener('click', function() {
                    chatModal.classList.remove('open');
                    chatModal.style.display = 'none';
                });
            }
            
            document.addEventListener('click', function(e) {
                if (chatModal.classList.contains('open')) {
                    if (!chatModal.contains(e.target) && e.target !== botBtn && !botBtn.contains(e.target)) {
                        chatModal.classList.remove('open');
                        chatModal.style.display = 'none';
                    }
                }
            });
            
            function addChatMessage(text, type) {
                const div = document.createElement('div');
                div.className = 'ai-chat-msg ' + type;
                let formatted = text;
                formatted = formatted.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                formatted = formatted.replace(/\n/g, '<br>');
                div.innerHTML = formatted;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
            
            function sendMessage() {
                const message = chatInput.value.trim();
                if (!message) return;
                
                addChatMessage(message, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                chatSend.disabled = true;
                
                const loadingMsg = document.createElement('div');
                loadingMsg.className = 'ai-chat-msg bot';
                loadingMsg.innerHTML = '⏳ Thinking...';
                loadingMsg.id = 'aiChatLoading';
                chatMessages.appendChild(loadingMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                
                fetch('/api/ai-tutor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userPrompt: message })
                })
                .then(response => response.json())
                .then(data => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    
                    if (data.error) {
                        addChatMessage('❌ ' + data.error, 'bot');
                    } else {
                        addChatMessage(data.answer, 'bot');
                    }
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                    chatInput.focus();
                })
                .catch(error => {
                    const loading = document.getElementById('aiChatLoading');
                    if (loading) loading.remove();
                    addChatMessage('❌ Sorry, I\'m having trouble connecting. Please try again.', 'bot');
                    chatInput.disabled = false;
                    chatSend.disabled = false;
                });
            }
            
            if (chatSend) {
                chatSend.addEventListener('click', sendMessage);
            }
            
            if (chatInput) {
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });
            }
        });
        
        // ============================================================
        // DARK MODE INIT
        // ============================================================
        
        if (localStorage.getItem('shinex-theme') === 'dark') {
            document.body.classList.add('dark-mode');
            updateThemeToggle();
        }
        
        // ============================================================
        // AUTO DISMISS FLASH MESSAGES
        // ============================================================
        
        document.querySelectorAll('.flash-message').forEach(msg => {
            setTimeout(() => {
                msg.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                msg.style.opacity = '0';
                msg.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    if (msg.parentNode) msg.remove();
                }, 500);
            }, 5000);
        });
        
        // ============================================================
        // CONSOLE WELCOME
        // ============================================================
        
        console.log('📝 SHINEX Registration Page');
        console.log('📚 Join SHINEX Learning Circle');
        console.log('📧 Verify your email after registration');
        console.log('🤖 AI Tutor ready to help!');
    </script>

</body>
</html>