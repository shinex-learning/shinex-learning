<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Register – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .mobile-form-group {
            margin-bottom: 12px;
        }
        .mobile-form-group label {
            font-weight: 600;
            font-size: 0.8rem;
            color: var(--text-dark);
            display: block;
            margin-bottom: 3px;
        }
        body.dark-mode .mobile-form-group label {
            color: var(--text-light);
        }
        .mobile-form-group input,
        .mobile-form-group select {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #ede8f5;
            border-radius: 8px;
            font-size: 0.9rem;
            font-family: inherit;
            background: #fff;
            color: var(--text-dark);
        }
        body.dark-mode .mobile-form-group input,
        body.dark-mode .mobile-form-group select {
            background: #2a2a2a;
            color: var(--text-light);
            border-color: #333;
        }
        .mobile-form-group input:focus,
        .mobile-form-group select:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.12);
            outline: none;
        }
        .mobile-form-section {
            background: var(--primary-bg);
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 12px;
        }
        body.dark-mode .mobile-form-section {
            background: #1a1a1a;
        }
        .mobile-form-section h4 {
            font-weight: 700;
            color: var(--text-dark);
            margin: 0 0 2px 0;
            font-size: 0.9rem;
        }
        body.dark-mode .mobile-form-section h4 {
            color: var(--text-light);
        }
        .mobile-form-section .sub {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin: 0 0 10px 0;
        }
        .mobile-form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .mobile-required {
            color: #e74c3c;
        }
        .mobile-help-text {
            font-size: 0.65rem;
            color: var(--text-muted);
            margin-top: 2px;
        }
        .btn-mobile-auth {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 1rem;
            background: #8B5CF6;
            color: #fff;
            cursor: pointer;
        }
        .btn-mobile-auth:hover {
            background: #6a3dcf;
        }
        .alert {
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 0.8rem;
            margin-bottom: 10px;
            text-align: center;
        }
        .alert-danger {
            background: #fadbd8;
            color: #922b21;
            border-left: 4px solid #e74c3c;
        }
        .alert-success {
            background: #d5f5e3;
            color: #1a7a4a;
            border-left: 4px solid #27ae60;
        }
        body.dark-mode .alert-danger {
            background: #3a1a1a;
            color: #f1948a;
        }
        body.dark-mode .alert-success {
            background: #1a3a2a;
            color: #7dcea0;
        }

        /* ===== PASSWORD VISIBILITY TOGGLE ===== */
        .password-wrapper {
            position: relative;
            width: 100%;
        }
        .password-wrapper input {
            width: 100%;
            padding-right: 40px !important;
        }
        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 1rem;
            padding: 4px 6px;
            transition: color 0.3s ease;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .toggle-password:hover {
            color: #8B5CF6;
        }
        body.dark-mode .toggle-password {
            color: #888;
        }
        body.dark-mode .toggle-password:hover {
            color: #a78bfa;
        }

        @media (max-width: 400px) {
            .mobile-form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div id="page-loader">
        <div class="loader-logo"><span>SLC</span><div class="loader-water"></div></div>
        <div class="loader-text">SHINEX</div>
        <div class="loader-sub">LEARNING CIRCLE</div>
    </div>

    <%- include('../partials/header-mobile') %>

    <main class="main-content" style="padding:12px 0 24px;">
        <div class="container" style="padding:0 12px;">
            <div style="background:#fff; border-radius:12px; padding:16px; border:1px solid #ede8f5;">
                <div style="text-align:center; margin-bottom:12px;">
                    <h1 style="font-size:1.3rem; font-weight:800; color:#8B5CF6; margin:0;">SHINEX</h1>
                    <p style="color:var(--text-muted); font-size:0.65rem; letter-spacing:2px; margin:0;">LEARNING CIRCLE</p>
                </div>

                <div style="font-size:1.1rem; font-weight:700; color:var(--text-dark); text-align:center; margin-bottom:2px;">Student Registration</div>
                <div style="font-size:0.75rem; color:var(--text-muted); text-align:center; margin-bottom:12px;">Join SHINEX Learning Circle (SLC)</div>

                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger"><%= messages.error %></div>
                <% } %>
                <% if (messages && messages.success) { %>
                    <div class="alert alert-success"><%= messages.success %></div>
                <% } %>

                <form action="/register" method="POST">

                    <!-- Personal Information -->
                    <div class="mobile-form-section">
                        <h4><i class="fas fa-user" style="color:#8B5CF6;"></i> Personal Information</h4>
                        <p class="sub">Tell us about yourself</p>

                        <div class="mobile-form-row">
                            <div class="mobile-form-group">
                                <label>First Name <span class="mobile-required">*</span></label>
                                <input type="text" name="firstName" placeholder="John" required>
                            </div>
                            <div class="mobile-form-group">
                                <label>Middle Name</label>
                                <input type="text" name="middleName" placeholder="(Optional)">
                            </div>
                        </div>

                        <div class="mobile-form-group">
                            <label>Last Name <span class="mobile-required">*</span></label>
                            <input type="text" name="lastName" placeholder="Doe" required>
                        </div>

                        <div class="mobile-form-row">
                            <div class="mobile-form-group">
                                <label>Date of Birth</label>
                                <input type="date" name="dateOfBirth">
                            </div>
                            <div class="mobile-form-group">
                                <label>Gender <span class="mobile-required">*</span></label>
                                <select name="gender" required>
                                    <option value="">Select...</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                            </div>
                        </div>

                        <div class="mobile-form-group">
                            <label>Country <span class="mobile-required">*</span></label>
                            <select name="country" required>
                                <option value="">Select...</option>
                                <option value="Nigeria">Nigeria</option>
                                <option value="USA">USA</option>
                                <option value="UK">UK</option>
                                <option value="Canada">Canada</option>
                                <option value="Australia">Australia</option>
                                <option value="Ghana">Ghana</option>
                                <option value="Kenya">Kenya</option>
                                <option value="South Africa">South Africa</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="mobile-form-row">
                            <div class="mobile-form-group">
                                <label>State <span class="mobile-required">*</span></label>
                                <input type="text" name="state" placeholder="e.g., Ogun State" required>
                            </div>
                            <div class="mobile-form-group">
                                <label>City/Town <span class="mobile-required">*</span></label>
                                <input type="text" name="city" placeholder="e.g., Abeokuta" required>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div class="mobile-form-section">
                        <h4><i class="fas fa-phone" style="color:#8B5CF6;"></i> Contact Information</h4>
                        <p class="sub">How can we reach you?</p>

                        <div class="mobile-form-group">
                            <label>Email Address <span class="mobile-required">*</span></label>
                            <input type="email" name="email" placeholder="you@email.com" required>
                        </div>

                        <div class="mobile-form-row">
                            <div class="mobile-form-group">
                                <label>Phone Number <span class="mobile-required">*</span></label>
                                <input type="tel" name="phone" placeholder="080 1234 5678" required>
                            </div>
                            <div class="mobile-form-group">
                                <label>WhatsApp Number</label>
                                <input type="tel" name="whatsapp" placeholder="080 1234 5678">
                            </div>
                        </div>

                        <div class="mobile-form-group">
                            <label>Home Address</label>
                            <input type="text" name="homeAddress" placeholder="Your home address">
                        </div>
                    </div>

                    <!-- Academic Information -->
                    <div class="mobile-form-section">
                        <h4><i class="fas fa-graduation-cap" style="color:#8B5CF6;"></i> Academic Information</h4>
                        <p class="sub">Tell us about your education</p>

                        <div class="mobile-form-group">
                            <label>School/Institution <span class="mobile-required">*</span></label>
                            <input type="text" name="school" placeholder="e.g., TASUED" required>
                        </div>

                        <div class="mobile-form-group">
                            <label>Department <span class="mobile-required">*</span></label>
                            <input type="text" name="department" placeholder="e.g., Computer Science" required>
                        </div>

                        <div class="mobile-form-row">
                            <div class="mobile-form-group">
                                <label>Current Level <span class="mobile-required">*</span></label>
                                <input type="text" name="currentLevel" placeholder="e.g., Year 1" required>
                            </div>
                            <div class="mobile-form-group">
                                <label>Student Status</label>
                                <select name="studentStatus">
                                    <option value="">Select...</option>
                                    <option value="Full-time">Full-time</option>
                                    <option value="Part-time">Part-time</option>
                                    <option value="Graduate">Graduate</option>
                                    <option value="Working Professional">Working Professional</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Choose Course -->
                    <div class="mobile-form-section">
                        <h4><i class="fas fa-book-open" style="color:#8B5CF6;"></i> Choose Your Course</h4>
                        <p class="sub">Select the course you want to study</p>

                        <div class="mobile-form-group">
                            <label>Course <span class="mobile-required">*</span></label>
                            <select name="courseName" required>
                                <option value="">Select a course...</option>
                                <% if (courses && courses.length > 0) { %>
                                    <% courses.forEach(function(c) { %>
                                        <option value="<%= c %>"><%= c %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                    </div>

                    <!-- Learning Level -->
                    <div class="mobile-form-section">
                        <h4><i class="fas fa-chart-line" style="color:#8B5CF6;"></i> Learning Level</h4>
                        <p class="sub">Choose your experience level</p>

                        <div class="mobile-form-group">
                            <label>Learning Level <span class="mobile-required">*</span></label>
                            <select name="learningLevel" required>
                                <option value="Beginner">Beginner</option>
                                <option value="Intermediate">Intermediate</option>
                                <option value="Advanced">Advanced</option>
                            </select>
                        </div>
                    </div>

                    <!-- Account Details -->
                    <div class="mobile-form-section" style="border:2px solid #8B5CF6;">
                        <h4><i class="fas fa-lock" style="color:#8B5CF6;"></i> Account Details</h4>
                        <p class="sub">Create your login credentials</p>

                        <div class="mobile-form-group">
                            <label>Email Address <span class="mobile-required">*</span></label>
                            <input type="email" name="email" placeholder="you@email.com" required>
                        </div>

                        <div class="mobile-form-row">
                            <div class="mobile-form-group">
                                <label>Password <span class="mobile-required">*</span></label>
                                <div class="password-wrapper">
                                    <input type="password" name="password" id="mobileRegisterPassword" placeholder="Min 6 chars" required>
                                    <button type="button" class="toggle-password" onclick="togglePassword('mobileRegisterPassword', this)" aria-label="Toggle password visibility">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="mobile-form-group">
                                <label>Confirm <span class="mobile-required">*</span></label>
                                <div class="password-wrapper">
                                    <input type="password" name="confirmPassword" id="mobileRegisterConfirmPassword" placeholder="Confirm" required>
                                    <button type="button" class="toggle-password" onclick="togglePassword('mobileRegisterConfirmPassword', this)" aria-label="Toggle password visibility">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="mobile-help-text">
                            <i class="fas fa-info-circle"></i> Student ID will be generated: <strong>SLC-2026-XX-XXX</strong>
                        </div>
                    </div>

                    <button type="submit" class="btn-mobile-auth">
                        <i class="fas fa-user-plus"></i> Register
                    </button>
                </form>

                <div style="text-align:center; margin-top:12px; padding-top:12px; border-top:1px solid #ede8f5;">
                    <p style="font-size:0.8rem; color:var(--text-muted); margin:0;">
                        Already have an account? <a href="/login" style="color:#8B5CF6; font-weight:600; text-decoration:none;">Login</a>
                    </p>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer-mobile') %>
    
    <script>
        // ===== PASSWORD VISIBILITY TOGGLE =====
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            if (!input) return;
            
            const icon = button.querySelector('i');
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
            
            // Prevent form submission
            event.preventDefault();
        }
    </script>
    <script src="/js/script.js"></script>
</body>
</html>