<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Register – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-register-container { padding: 12px 12px 30px; max-width: 500px; margin: 0 auto; }
        .mobile-register-box { padding: 20px 16px !important; border-radius: 14px !important; background: var(--bg-light) !important; }
        .mobile-register-box h2 { font-size: 1.3rem !important; color: var(--text-dark); }
        .mobile-register-box p { font-size: 0.82rem !important; color: var(--text-muted); }
        .mobile-register-box input, .mobile-register-box select, .mobile-register-box textarea { font-size: 0.9rem !important; padding: 10px 12px !important; min-height: 40px !important; border-radius: 8px !important; border: 2px solid #ede8f5 !important; background: #fff !important; color: var(--text-dark) !important; width: 100% !important; }
        .mobile-register-box .btn { font-size: 0.9rem !important; padding: 12px !important; min-height: 48px !important; border-radius: 30px !important; background: #8B5CF6 !important; color: #fff !important; border: none !important; width: 100% !important; }
        .mobile-register-box label { font-size: 0.8rem !important; color: var(--text-dark); }
        .mobile-register-box .help-text { font-size: 0.7rem !important; color: var(--text-muted); }
        .mobile-section-title { font-size: 0.8rem !important; padding: 8px 12px !important; margin: 12px 0 10px !important; background: #f0ebfb !important; border-radius: 8px !important; font-weight: 700 !important; color: #8B5CF6 !important; }
        .mobile-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .mobile-alert { font-size: 0.82rem !important; padding: 10px 14px !important; border-radius: 8px !important; margin-bottom: 12px !important; }
        body.dark-mode .mobile-register-box { background: var(--dark-card) !important; }
        body.dark-mode .mobile-register-box input, body.dark-mode .mobile-register-box select, body.dark-mode .mobile-register-box textarea { background: #2a2a2a !important; border-color: var(--dark-border) !important; color: var(--text-light) !important; }
        body.dark-mode .mobile-section-title { background: #2a1a4a !important; color: #a78bfa !important; }
        @media (max-width: 400px) { .mobile-grid-2 { grid-template-columns: 1fr; gap: 0; } }
    </style>
</head>
<body>
    <!-- ===== MOBILE HEADER ===== -->
    <header class="header" style="padding:8px 12px; flex-wrap:nowrap;">
        <div style="display:flex; align-items:center; gap:8px; flex:1; min-width:0;">
            <a href="javascript:history.back()" class="back-btn" style="font-size:0.75rem; padding:4px 8px; color:rgba(255,255,255,0.9); text-decoration:none; display:flex; align-items:center; gap:4px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <a href="/" class="logo-container" style="gap:8px; text-decoration:none;">
                <div class="logo" style="width:32px; height:32px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:10px;">SLC</div>
                <div style="line-height:1.1;">
                    <div class="logo-text" style="font-size:13px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div>
                    <div class="logo-sub" style="font-size:6px; color:rgba(255,255,255,0.7);">LEARNING</div>
                </div>
            </a>
        </div>
        <div class="header-actions" style="gap:4px; flex-wrap:nowrap;">
            <button class="dark-toggle" id="darkToggleMobile" onclick="toggleDarkModeMobile()" style="padding:4px 8px; font-size:1rem; background:rgba(255,255,255,0.15); border:none; border-radius:30px; color:#fff; cursor:pointer;">🌙</button>
        </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="main-content">
        <div class="mobile-register-container">
            <div class="card mobile-register-box" style="box-shadow:var(--shadow);">
                <div style="text-align:center; margin-bottom:16px;">
                    <h2 style="font-weight:700; margin:0 0 2px;">Create Account</h2>
                    <p>Join SHINEX Learning Circle</p>
                </div>

                <% if (messages && messages.success) { %>
                    <div class="alert alert-success mobile-alert"><%= messages.success %></div>
                <% } %>
                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger mobile-alert"><%= messages.error %></div>
                <% } %>

                <form action="/register" method="POST">
                    <!-- 1. Personal Information -->
                    <div class="mobile-section-title"><i class="fas fa-user"></i> Personal Information</div>
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="firstName">First Name *</label>
                            <input type="text" id="firstName" name="firstName" placeholder="John" required>
                        </div>
                        <div class="settings-group">
                            <label for="lastName">Last Name *</label>
                            <input type="text" id="lastName" name="lastName" placeholder="Doe" required>
                        </div>
                    </div>
                    <div class="settings-group">
                        <label for="middleName">Middle Name</label>
                        <input type="text" id="middleName" name="middleName" placeholder="Michael">
                    </div>
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="dateOfBirth">Date of Birth</label>
                            <input type="date" id="dateOfBirth" name="dateOfBirth">
                        </div>
                        <div class="settings-group">
                            <label for="gender">Gender</label>
                            <select id="gender" name="gender">
                                <option value="">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="country">Country</label>
                            <input type="text" id="country" name="country" placeholder="Nigeria">
                        </div>
                        <div class="settings-group">
                            <label for="state">State</label>
                            <input type="text" id="state" name="state" placeholder="Lagos">
                        </div>
                    </div>
                    <div class="settings-group">
                        <label for="city">City/Town</label>
                        <input type="text" id="city" name="city" placeholder="Ikeja">
                    </div>

                    <!-- 2. Contact Information -->
                    <div class="mobile-section-title"><i class="fas fa-address-card"></i> Contact Information</div>
                    <div class="settings-group">
                        <label for="email">Email Address *</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required>
                    </div>
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="phone">Phone Number</label>
                            <input type="tel" id="phone" name="phone" placeholder="+234 800 000 0000">
                        </div>
                        <div class="settings-group">
                            <label for="whatsapp">WhatsApp</label>
                            <input type="tel" id="whatsapp" name="whatsapp" placeholder="+234 800 000 0000">
                        </div>
                    </div>
                    <div class="settings-group">
                        <label for="homeAddress">Home Address</label>
                        <input type="text" id="homeAddress" name="homeAddress" placeholder="Enter your address">
                    </div>

                    <!-- 3. Academic Information -->
                    <div class="mobile-section-title"><i class="fas fa-graduation-cap"></i> Academic Information</div>
                    <div class="settings-group">
                        <label for="school">School/Institution</label>
                        <input type="text" id="school" name="school" placeholder="University of Lagos">
                    </div>
                    <div class="settings-group">
                        <label for="department">Department / Field of Study</label>
                        <input type="text" id="department" name="department" placeholder="Computer Science">
                    </div>
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="currentLevel">Current Level</label>
                            <input type="text" id="currentLevel" name="currentLevel" placeholder="100, 200, Final Year">
                        </div>
                        <div class="settings-group">
                            <label for="studentStatus">Student Status</label>
                            <input type="text" id="studentStatus" name="studentStatus" placeholder="Full-time">
                        </div>
                    </div>

                    <!-- 4. Choose Course -->
                    <div class="mobile-section-title"><i class="fas fa-book-open"></i> Choose Your Course *</div>
                    <div class="settings-group">
                        <select id="courseName" name="courseName" required style="font-size:0.9rem;">
                            <option value="">— Select a course —</option>
                            <option value="Cybersecurity">🔐 Cybersecurity</option>
                            <option value="Data Analysis">📊 Data Analysis</option>
                            <option value="Digital Marketing">📱 Digital Marketing</option>
                            <option value="Graphic Design">🎨 Graphic Design</option>
                            <option value="Motion Design">🎬 Motion Design</option>
                            <option value="Networking">🌐 Networking</option>
                            <option value="Programming">💻 Programming</option>
                            <option value="UI/UX Design">📐 UI/UX Design</option>
                            <option value="Web Development">🖥️ Web Development</option>
                            <option value="WordPress Development">📝 WordPress Development</option>
                        </select>
                        <p class="help-text"><i class="fas fa-info-circle"></i> Your Student ID will include the course code.</p>
                    </div>

                    <!-- 5. Learning Level -->
                    <div class="mobile-section-title"><i class="fas fa-chart-line"></i> Learning Level</div>
                    <div class="settings-group">
                        <select id="learningLevel" name="learningLevel">
                            <option value="Beginner">🌱 Beginner</option>
                            <option value="Intermediate">🌿 Intermediate</option>
                            <option value="Advanced">🚀 Advanced</option>
                        </select>
                    </div>

                    <!-- 6. Account Details -->
                    <div class="mobile-section-title"><i class="fas fa-lock"></i> Account Details</div>
                    <div class="settings-group">
                        <label for="password">Password (min 6 chars) *</label>
                        <input type="password" id="password" name="password" minlength="6" placeholder="Create a strong password" required>
                    </div>
                    <div class="settings-group">
                        <label for="confirmPassword">Confirm Password *</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm your password" required>
                    </div>

                    <button type="submit" class="btn" style="margin-top:12px;">
                        <i class="fas fa-user-plus"></i> Create Account
                    </button>
                </form>

                <div style="text-align:center; margin-top:12px; font-size:0.82rem;">
                    <p style="color:var(--text-muted);">Already have an account? <a href="/login" style="color:#8B5CF6; font-weight:600; text-decoration:none;">Login here</a></p>
                </div>
            </div>
        </div>
    </main>

    <!-- ===== MOBILE FOOTER ===== -->
    <footer class="footer" style="background:linear-gradient(135deg, #6a3dcf, #4a1a8a); padding:24px 0 16px; margin-top:24px;">
        <div class="container">
            <div style="text-align:center;">
                <div style="display:flex; justify-content:center; align-items:center; gap:8px; margin-bottom:6px;">
                    <div class="logo" style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,0.2); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px;">SLC</div>
                    <div><div class="logo-text" style="font-size:14px; color:#fff;">SHINEX<span style="color:#fff;">.</span></div></div>
                </div>
                <p style="color:rgba(255,255,255,0.7); font-size:0.8rem; margin:4px 0 8px;">Learn. Understand. Protect.</p>
                <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px 16px; margin:12px 0;">
                    <a href="/" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Home</a>
                    <a href="/courses" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Courses</a>
                    <a href="/services" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Services</a>
                    <a href="/about" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">About</a>
                    <a href="/contact" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">Contact</a>
                    <a href="/faq" style="color:rgba(255,255,255,0.7); font-size:0.75rem; text-decoration:none;">FAQ</a>
                </div>
                <div style="display:flex; justify-content:center; gap:12px; margin:8px 0 12px;">
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-twitter"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-instagram"></i></a>
                    <a href="#" style="color:rgba(255,255,255,0.7); font-size:1.2rem;"><i class="fab fa-whatsapp"></i></a>
                </div>
                <div class="footer-bottom" style="border-top:1px solid rgba(255,255,255,0.1); padding-top:10px; font-size:0.7rem; color:rgba(255,255,255,0.6);">&copy; <%= new Date().getFullYear() %> SHINEX Learning Circle</div>
            </div>
        </div>
    </footer>

    <!-- ===== AI BOT ===== -->
    <div class="ai-bot" id="aiBot" style="position:fixed; bottom:30px; right:30px; z-index:999; cursor:pointer;">
        <button class="ai-bot-btn" id="aiBotBtn" style="width:60px; height:60px; border-radius:50%; background:linear-gradient(135deg, #8B5CF6, #6a3dcf); color:#fff; border:none; font-size:26px; box-shadow:0 8px 30px rgba(139,92,246,0.4); cursor:pointer; position:relative; z-index:2;">🤖<span class="ai-bot-pulse" style="position:absolute; width:60px; height:60px; border-radius:50%; background:rgba(139,92,246,0.3); animation:pulseRing 2s ease-out infinite; z-index:1; top:0; left:0;"></span></button>
    </div>
    <div class="ai-chat-modal" id="aiChatModal" style="position:fixed; bottom:100px; right:30px; width:380px; max-width:calc(100vw - 40px); max-height:500px; background:#fff; border-radius:14px; border:1px solid #ede8f5; box-shadow:0 20px 60px rgba(0,0,0,0.15); z-index:1000; display:none; flex-direction:column; overflow:hidden;">
        <div class="ai-chat-header" style="padding:14px 18px; background:#8B5CF6; color:#fff; display:flex; justify-content:space-between; align-items:center;">
            <h4 style="font-size:0.95rem; font-weight:700; margin:0;">🤖 AI Tutor</h4>
            <button class="ai-chat-close" id="aiChatClose" style="background:none; border:none; color:#fff; font-size:1.2rem; cursor:pointer; padding:4px;">&times;</button>
        </div>
        <div class="ai-chat-body" id="aiChatBody" style="padding:16px 18px; flex:1; overflow-y:auto; max-height:300px;">
            <div class="ai-chat-messages" id="aiChatMessages" style="display:flex; flex-direction:column; gap:8px;">
                <div class="ai-chat-msg bot" style="padding:10px 14px; border-radius:10px; font-size:0.9rem; max-width:85%; line-height:1.5; background:#f0ebfb; color:#1A0A2E; align-self:flex-start; border-bottom-left-radius:4px;">👋 Hi! I'm your SHINEX AI Tutor. Ask me anything!</div>
            </div>
        </div>
        <div class="ai-chat-footer" style="padding:12px 18px; border-top:1px solid #ede8f5; display:flex; gap:8px;">
            <input type="text" id="aiChatInput" placeholder="Ask a question..." autocomplete="off" style="flex:1; padding:8px 12px; border-radius:8px; border:1px solid #ede8f5; font-size:0.85rem;">
            <button class="btn btn-primary" id="aiChatSend" style="padding:8px 16px; border:none; border-radius:30px; background:#8B5CF6; color:#fff; font-weight:600; cursor:pointer;">Send</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/js/all.min.js"></script>
    <script src="/js/main.js"></script>
    <script>
        function toggleDarkModeMobile() {
            const body = document.body;
            body.classList.toggle('dark-mode');
            const isDark = body.classList.contains('dark-mode');
            localStorage.setItem('shinex-dark-mode', isDark);
            const btn = document.getElementById('darkToggleMobile');
            if (btn) btn.textContent = isDark ? '☀️' : '🌙';
        }
        document.addEventListener('DOMContentLoaded', function() {
            const savedDark = localStorage.getItem('shinex-dark-mode');
            if (savedDark === 'true') {
                document.body.classList.add('dark-mode');
                const btn = document.getElementById('darkToggleMobile');
                if (btn) btn.textContent = '☀️';
            }
        });
    </script>
</body>
</html>