<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Register – SHINEX Learning Circle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .mobile-register-container {
            padding: 12px 12px 30px;
            max-width: 500px;
            margin: 0 auto;
        }
        .mobile-register-box {
            padding: 20px 16px !important;
            border-radius: 14px !important;
        }
        .mobile-register-box h2 {
            font-size: 1.3rem !important;
        }
        .mobile-register-box p {
            font-size: 0.82rem !important;
        }
        .mobile-register-box input,
        .mobile-register-box select,
        .mobile-register-box textarea {
            font-size: 0.9rem !important;
            padding: 10px 12px !important;
            min-height: 40px !important;
        }
        .mobile-register-box .btn {
            font-size: 0.9rem !important;
            padding: 12px !important;
            min-height: 48px !important;
        }
        .mobile-register-box label {
            font-size: 0.8rem !important;
        }
        .mobile-register-box .help-text {
            font-size: 0.7rem !important;
        }
        .mobile-section-title {
            font-size: 0.8rem !important;
            padding: 8px 12px !important;
            margin: 12px 0 10px !important;
        }
        .mobile-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        @media (max-width: 400px) {
            .mobile-grid-2 {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/header-mobile', { showBack: true }) %>

    <main class="main-content">
        <div class="mobile-register-container">
            <div class="card mobile-register-box" style="box-shadow:var(--shadow);">
                <div style="text-align:center; margin-bottom:16px;">
                    <h2 style="font-weight:700; margin:0 0 2px;">Create Account</h2>
                    <p style="color:var(--text-muted);">Join SHINEX Learning Circle</p>
                </div>

                <% if (messages && messages.success) { %>
                    <div class="alert alert-success" style="font-size:0.8rem; padding:10px 14px; border-radius:8px;"><%= messages.success %></div>
                <% } %>
                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger" style="font-size:0.8rem; padding:10px 14px; border-radius:8px;"><%= messages.error %></div>
                <% } %>

                <form action="/register" method="POST">
                    <!-- 1. Personal Information -->
                    <div class="mobile-section-title" style="background:var(--primary-bg); border-radius:8px; font-weight:700; color:var(--primary);">
                        <i class="fas fa-user"></i> Personal Information
                    </div>
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="firstName">First Name *</label>
                            <input type="text" id="firstName" name="firstName" placeholder="John" required>
                        </div>
                        <div class="settings-group">
                            <label for="lastName">Last Name *</label>
                            <input type="text" id="lastName" name="lastName" placeholder="Doe" required>
                        </div>
                    </div>
                    <div class="settings-group">
                        <label for="middleName">Middle Name</label>
                        <input type="text" id="middleName" name="middleName" placeholder="Michael">
                    </div>
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="dateOfBirth">Date of Birth</label>
                            <input type="date" id="dateOfBirth" name="dateOfBirth">
                        </div>
                        <div class="settings-group">
                            <label for="gender">Gender</label>
                            <select id="gender" name="gender">
                                <option value="">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                    </div>
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="country">Country</label>
                            <input type="text" id="country" name="country" placeholder="Nigeria">
                        </div>
                        <div class="settings-group">
                            <label for="state">State</label>
                            <input type="text" id="state" name="state" placeholder="Lagos">
                        </div>
                    </div>
                    <div class="settings-group">
                        <label for="city">City/Town</label>
                        <input type="text" id="city" name="city" placeholder="Ikeja">
                    </div>

                    <!-- 2. Contact Information -->
                    <div class="mobile-section-title" style="background:var(--primary-bg); border-radius:8px; font-weight:700; color:var(--primary); margin-top:16px;">
                        <i class="fas fa-address-card"></i> Contact Information
                    </div>
                    <div class="settings-group">
                        <label for="email">Email Address *</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" required>
                    </div>
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="phone">Phone Number</label>
                            <input type="tel" id="phone" name="phone" placeholder="+234 800 000 0000">
                        </div>
                        <div class="settings-group">
                            <label for="whatsapp">WhatsApp</label>
                            <input type="tel" id="whatsapp" name="whatsapp" placeholder="+234 800 000 0000">
                        </div>
                    </div>
                    <div class="settings-group">
                        <label for="homeAddress">Home Address</label>
                        <input type="text" id="homeAddress" name="homeAddress" placeholder="Enter your address">
                    </div>

                    <!-- 3. Academic Information -->
                    <div class="mobile-section-title" style="background:var(--primary-bg); border-radius:8px; font-weight:700; color:var(--primary); margin-top:16px;">
                        <i class="fas fa-graduation-cap"></i> Academic Information
                    </div>
                    <div class="settings-group">
                        <label for="school">School/Institution</label>
                        <input type="text" id="school" name="school" placeholder="University of Lagos">
                    </div>
                    <div class="settings-group">
                        <label for="department">Department / Field of Study</label>
                        <input type="text" id="department" name="department" placeholder="Computer Science">
                    </div>
                    <div class="mobile-grid-2">
                        <div class="settings-group">
                            <label for="currentLevel">Current Level</label>
                            <input type="text" id="currentLevel" name="currentLevel" placeholder="100, 200, Final Year">
                        </div>
                        <div class="settings-group">
                            <label for="studentStatus">Student Status</label>
                            <input type="text" id="studentStatus" name="studentStatus" placeholder="Full-time">
                        </div>
                    </div>

                    <!-- 4. Choose Course -->
                    <div class="mobile-section-title" style="background:var(--primary-bg); border-radius:8px; font-weight:700; color:var(--primary); margin-top:16px;">
                        <i class="fas fa-book-open"></i> Choose Your Course *
                    </div>
                    <div class="settings-group">
                        <select id="courseName" name="courseName" required style="font-size:0.9rem;">
                            <option value="">— Select a course —</option>
                            <option value="Cybersecurity">🔐 Cybersecurity</option>
                            <option value="Data Analysis">📊 Data Analysis</option>
                            <option value="Digital Marketing">📱 Digital Marketing</option>
                            <option value="Graphic Design">🎨 Graphic Design</option>
                            <option value="Motion Design">🎬 Motion Design</option>
                            <option value="Networking">🌐 Networking</option>
                            <option value="Programming">💻 Programming</option>
                            <option value="UI/UX Design">📐 UI/UX Design</option>
                            <option value="Web Development">🖥️ Web Development</option>
                            <option value="WordPress Development">📝 WordPress Development</option>
                        </select>
                        <p class="help-text" style="font-size:0.7rem; color:var(--text-muted); margin-top:2px;">
                            <i class="fas fa-info-circle"></i> Your Student ID will include the course code.
                        </p>
                    </div>

                    <!-- 5. Learning Level -->
                    <div class="mobile-section-title" style="background:var(--primary-bg); border-radius:8px; font-weight:700; color:var(--primary); margin-top:16px;">
                        <i class="fas fa-chart-line"></i> Learning Level
                    </div>
                    <div class="settings-group">
                        <select id="learningLevel" name="learningLevel">
                            <option value="Beginner">🌱 Beginner</option>
                            <option value="Intermediate">🌿 Intermediate</option>
                            <option value="Advanced">🚀 Advanced</option>
                        </select>
                    </div>

                    <!-- 6. Account Details -->
                    <div class="mobile-section-title" style="background:var(--primary-bg); border-radius:8px; font-weight:700; color:var(--primary); margin-top:16px;">
                        <i class="fas fa-lock"></i> Account Details
                    </div>
                    <div class="settings-group">
                        <label for="password">Password (min 6 chars) *</label>
                        <input type="password" id="password" name="password" minlength="6" placeholder="Create a strong password" required>
                    </div>
                    <div class="settings-group">
                        <label for="confirmPassword">Confirm Password *</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm your password" required>
                    </div>

                    <button type="submit" class="btn btn-primary btn-block" style="margin-top:12px;">
                        <i class="fas fa-user-plus"></i> Create Account
                    </button>
                </form>

                <div style="text-align:center; margin-top:12px; font-size:0.82rem;">
                    <p style="color:var(--text-muted);">Already have an account? <a href="/login" style="color:var(--primary); font-weight:600;">Login here</a></p>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer-mobile') %>
    <script src="/js/main.js"></script>
</body>
</html>