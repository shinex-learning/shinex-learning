<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Register – SHINEX</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .register-wrapper {
            max-width: 520px;
            margin: 0 auto;
            padding: 0 16px;
        }
        .register-card {
            padding: 28px 24px;
            border-radius: 16px;
            background: #fff;
            border: 1px solid #ede8f5;
        }
        .register-card .logo-area {
            text-align: center;
            margin-bottom: 20px;
        }
        .register-card .logo-area .icon {
            background: #8B5CF6;
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 8px;
        }
        .register-card .logo-area .icon i {
            font-size: 1.5rem;
            color: #fff;
        }
        .register-card .logo-area h1 {
            font-size: 1.4rem;
            font-weight: 800;
            color: #1A0A2E;
            margin: 0;
        }
        .register-card .logo-area p {
            color: #7a6a8f;
            font-size: 0.85rem;
            margin: 2px 0 0;
        }
        .register-card .progress-area {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }
        .register-card .progress-area .step-badge {
            background: #8B5CF6;
            color: #fff;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 0.65rem;
            font-weight: 600;
        }
        .register-card .progress-area .progress-wrap {
            flex: 1;
            height: 8px;
        }
        .register-card .progress-area .progress-percent {
            color: #7a6a8f;
            font-size: 0.65rem;
            font-weight: 500;
        }
        .register-card .btn-primary {
            width: 100%;
            padding: 14px;
            font-size: 1rem;
            margin-top: 4px;
        }
        .register-card .login-link {
            text-align: center;
            margin-top: 14px;
            font-size: 0.85rem;
            color: #7a6a8f;
        }
        .register-card .login-link a {
            color: #8B5CF6;
            font-weight: 600;
        }
        @media (max-width: 480px) {
            .register-card {
                padding: 16px 12px;
                margin: 0 4px;
            }
            .register-card .logo-area h1 {
                font-size: 1.2rem;
            }
        }
        /* Dark mode */
        body.dark-mode .register-card {
            background: #111111 !important;
            border-color: #333 !important;
        }
        body.dark-mode .register-card .logo-area h1 {
            color: #ffffff !important;
        }
        body.dark-mode .register-card .logo-area p {
            color: #cccccc !important;
        }
        body.dark-mode .register-card .login-link {
            color: #cccccc !important;
        }
        body.dark-mode .register-card .progress-area .progress-percent {
            color: #cccccc !important;
        }
    </style>
</head>
<body>
    <%- include('partials/header', { user: null, showBack: false }) %>

    <main class="main-content">
        <div class="register-wrapper">
            <div class="register-card">
                <div class="logo-area">
                    <div class="icon">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <h1>Create Account</h1>
                    <p>Step 1 of 2</p>
                </div>

                <% if (messages && messages.error) { %>
                    <div class="alert alert-danger" style="margin-bottom:12px;"><%= messages.error %></div>
                <% } %>
                <% if (messages && messages.success) { %>
                    <div class="alert alert-success" style="margin-bottom:12px;"><%= messages.success %></div>
                <% } %>

                <div class="progress-area">
                    <span class="step-badge">Step 1</span>
                    <div class="progress-wrap"><div class="progress-fill" style="width:50%; height:100%;"></div></div>
                    <span class="progress-percent">50%</span>
                </div>

                <form action="/register/step1" method="POST" autocomplete="off">
                    <div class="form-group">
                        <label for="fullName">Full Name</label>
                        <input type="text" id="fullName" name="fullName" class="form-control" placeholder="Enter your full name" required autocomplete="off">
                    </div>
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email address" required autocomplete="off">
                    </div>
                    <div class="form-group">
                        <label for="password">Password <span class="label-hint">(min 6 chars)</span></label>
                        <div class="password-wrapper">
                            <input type="password" id="password" name="password" class="form-control" placeholder="Create a password" required minlength="6" autocomplete="new-password">
                            <i class="fas fa-eye password-toggle" onclick="togglePassword('password', this)"></i>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="confirmPassword">Confirm Password</label>
                        <div class="password-wrapper">
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Confirm your password" required minlength="6" autocomplete="new-password">
                            <i class="fas fa-eye password-toggle" onclick="togglePassword('confirmPassword', this)"></i>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-arrow-right"></i> Continue to Profile
                    </button>
                    <div class="login-link">
                        Already have an account? <a href="/login">Login</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        function togglePassword(id, icon) {
            const input = document.getElementById(id);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>