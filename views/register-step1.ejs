<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHINEX Learning Circle – Step 1</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/header', { user: null, showBack: false }) %>

    <main class="main-content">
        <div class="container" style="max-width: 520px;">

            <div class="card" style="padding: 36px 32px;">
                <div style="text-align: center; margin-bottom: 24px;">
                    <div style="background: #8B5CF6; width: 56px; height: 56px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                        <i class="fas fa-user-plus" style="font-size: 1.8rem; color: #fff;"></i>
                    </div>
                    <h1 style="font-size: 1.6rem; font-weight: 800; color: #1A0A2E;">Create Account</h1>
                    <p style="color: #7a6a8f; font-size: 0.95rem;">Step 1 of 2</p>
                </div>

                <!-- Progress indicator -->
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
                    <span style="background: #8B5CF6; color: #fff; padding: 4px 14px; border-radius: 30px; font-size: 0.75rem; font-weight: 600;">Step 1</span>
                    <div class="progress-wrap" style="flex:1;">
                        <div class="progress-fill" style="width:50%;"></div>
                    </div>
                    <span style="color: #7a6a8f; font-size: 0.75rem; font-weight: 500;">50%</span>
                </div>

                <form action="/register/step1" method="POST">
                    <div class="form-group">
                        <label for="fullName">Full Name</label>
                        <input type="text" id="fullName" name="fullName" class="form-control" placeholder="e.g. John Doe" required>
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="you@example.com" required>
                    </div>

                    <div class="form-group">
                        <label for="password">Password <span class="label-hint">(min 6 characters)</span></label>
                        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required minlength="6">
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="••••••••" required minlength="6">
                    </div>

                    <button type="submit" class="btn btn-primary" style="width:100%; margin-top: 8px;">
                        <i class="fas fa-arrow-right"></i> Continue to Profile
                    </button>

                    <p style="text-align: center; margin-top: 16px; font-size: 0.9rem; color: #7a6a8f;">
                        Already have an account? <a href="/login" style="color: #8B5CF6; font-weight: 600;">Login</a>
                    </p>
                </form>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>